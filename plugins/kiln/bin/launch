#!/usr/bin/env python3
"""Launch a Kiln seat using its pinned native family contract."""
import argparse
import copy
import errno
import fcntl
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import subprocess
import sys
import tomllib
import tempfile
from contextlib import contextmanager

PLUGIN = Path(__file__).resolve().parents[1]
CONFIG = PLUGIN / "config"
HOOKS = PLUGIN / "hooks"
sys.path.insert(0, str(PLUGIN))
from lib.ledger import markers, records

SCHEMA = json.loads((CONFIG / "seat.schema.json").read_text())


REVIEW_STEPS = """2. For one-time review, launch from an empty plain folder: `CODEX_HOME=/absolute/codex-home codex --no-daemon --no-alt-screen -s read-only -C /absolute/empty-folder`. The tested isolated home was this task's `home`; never substitute it for the production home unintentionally.
3. At startup choose **Continue without trusting**, then type `/hooks`, Enter. Inspect the list. When only vetted Kiln entries need trust, press **t** (trust all); otherwise review/trust only Kiln entries individually. The tested path used one three-line Stop script (`kiln-stop.sh:1`) and `/hooks` → `t` (`evidence/experiment-notes.txt:8`).
4. Confirm the entry is active, exit with Esc then Ctrl-D. The hash entry persists automatically. Repeat review after changing the definition or source identity."""


def absolute(value):
    return str(Path(value).resolve())


def family(model):
    return "claude" if model.startswith("claude-") else "codex" if model.startswith("gpt-") else "agy"


def team_config():
    home = os.environ.get("KILN_HOME")
    path = Path(home) / "team.toml" if home else None
    return tomllib.loads(path.read_text()) if path and path.exists() else {}


def routing(args, all_entries=False):
    config = tomllib.loads((CONFIG / "routing.toml").read_text())
    team = team_config()
    lane = team.get("lane", config["active"])
    bosses = team.get("bosses", config["bosses"])
    if lane not in config["lanes"] or bosses not in ("claude", "gpt"):
        raise ValueError("team.toml must select a known lane and bosses claude|gpt")
    key = args.role
    if key == "worker":
        key = "review_of_gpt" if (args.family or (family(args.model) if args.model else None)) == "claude" else "implementer"
    route = getattr(args, "route", None)
    try:
        choice = config["lanes"][lane]
        for part in (route or key).split("."):
            if isinstance(choice, list):
                if not part.isdecimal():
                    raise ValueError("list routes require a nonnegative index")
                choice = choice[int(part)]
            else:
                choice = choice[part]
        entries = choice if all_entries and isinstance(choice, list) else [choice]
        if not all(isinstance(entry, dict) and {"model", "effort"} <= entry.keys() for entry in entries):
            raise ValueError("route must select one model/effort entry")
    except (KeyError, IndexError, TypeError, ValueError) as error:
        raise ValueError(f"invalid routing entry: {route or key}") from error
    if not route and args.role in ("boss", "orchestrator") and bosses == "gpt":
        choice = config["boss_lanes"]["gpt"][args.role]
    if all_entries:
        return [(entry["model"], entry["effort"]) for entry in entries]
    model, effort = args.model or choice["model"], args.effort or choice["effort"]
    if args.family is not None and family(model) != args.family:
        raise ValueError("model family differs from --family; supply --model or change routing.toml")
    return lane, model, effort


def hooks(role, family="codex"):
    events = {"Stop": "stop", "PreToolUse": "fence"}
    if role != "worker":
        events["SessionStart"] = "start"
    config = {}
    for event, script in events.items():
        guard = ('[ -n "$KILN_SEAT" ] && [ -f "$KILN_SEAT" ] && [ -n "$KILN_PLUGIN" ] '
                 f'|| exit 0; exec "$KILN_PLUGIN/hooks/{script}.sh"')
        group = {"hooks": [{"type": "command", "command": "sh -c " + shlex.quote(guard)}]}
        if event == "PreToolUse":
            group["matcher"] = "Bash|Edit|Write|NotebookEdit|MultiEdit" if family == "claude" else "Bash|apply_patch"
        config[event] = [group]
    return config


def native(seat, hook_config, home):
    model, effort, root = seat["model"], seat["effort"], seat["root"]
    if seat["family"] == "claude":
        hook_config = runpy.run_path(str(HOOKS / "lib/claude.py"))["with_listener"](hook_config, seat["role"])
        settings = dict(fallbackModel=[], switchModelsOnFlag=False, hooks=hook_config)
        flags = ["--model", model, "--effort", effort,
                 "--settings", json.dumps(settings, separators=(",", ":"))]
    elif seat["family"] == "codex":
        flags = ["--model", model, "-c", f"model_reasoning_effort={effort}",
                 "-s", "workspace-write", "-C", root, "-c", "approval_policy=never",
                 "--add-dir", str(home)]
        if seat["role"] != "worker":
            flags += ["-c", "sandbox_workspace_write.network_access=true"]
    for directory in seat["extra_roots"]:
        flags += ["--add-dir", directory]
    return flags


def validate(seat):
    """Validate the flat seat schema, including the wait timeout."""
    if set(SCHEMA["required"]) - seat.keys() or seat.keys() - SCHEMA["properties"].keys():
        raise ValueError("seat fields do not match schema")
    for key, value in seat.items():
        prop = SCHEMA["properties"][key]
        if prop["type"] == "string" and not isinstance(value, str):
            raise ValueError(f"{key} must be a string")
        if prop["type"] == "array" and (not isinstance(value, list) or any(not isinstance(v, str) for v in value)):
            raise ValueError(f"{key} must be a string array")
        if prop["type"] == "integer" and (type(value) is not int or value < prop.get("minimum", 0)):
            raise ValueError(f"invalid {key}: {value}")
        if "enum" in prop and value not in prop["enum"]:
            raise ValueError(f"invalid {key}: {value}")
        if "pattern" in prop and not re.fullmatch(prop["pattern"], value):
            raise ValueError(f"invalid {key}: {value}")


def write_json(path, data, dry_run):
    if dry_run:
        print(f"# write {path}: {json.dumps(data, ensure_ascii=False)}")
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary = path.with_suffix(".tmp")
        with temporary.open("w") as stream:
            json.dump(data, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        if path.exists():
            temporary.chmod(path.stat().st_mode & 0o777)
        temporary.replace(path)


def codex_home():
    return Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))


def hooks_path():
    return (codex_home() / "hooks.json").resolve()


def hook_events(path):
    if not path.exists():
        return {}, {}
    with path.open() as stream:
        data = json.load(stream)
    if not isinstance(data, dict) or not isinstance(data.get("hooks", {}), dict):
        raise ValueError("hooks.json must be an object with a hooks object")
    return data, data.get("hooks", {})


def is_kiln(handler):
    return isinstance(handler, dict) and "KILN_SEAT" in str(handler.get("command", ""))


def kiln_keys(path, events):
    return [f"{path}:{re.sub(r'(?<!^)(?=[A-Z])', '_', event).lower()}:{i}:{j}"
            for event, groups in events.items() for i, group in enumerate(groups)
            for j, handler in enumerate(group.get("hooks", [])) if is_kiln(handler)]


def manage_hooks(install, dry_run):
    path = hooks_path()
    if not install and not path.exists():
        return
    data, events = hook_events(path)
    original = copy.deepcopy(data)
    for event, groups in events.items():
        if not isinstance(groups, list):
            raise ValueError(f"hooks.{event} must be an array")
        kept = []
        for group in groups:
            if not isinstance(group, dict) or not isinstance(group.get("hooks", []), list):
                raise ValueError(f"hooks.{event} groups must have hooks arrays")
            old = group.get("hooks", [])
            handlers = [handler for handler in old if not is_kiln(handler)]
            if handlers or not old:
                if handlers != old:
                    group["hooks"] = handlers
                kept.append(group)
        events[event] = kept
    if install:
        for event, groups in hooks("manager").items():
            events.setdefault(event, []).extend(groups)
    if install or "hooks" in data:
        data["hooks"] = events
    if data != original:
        write_json(path, data, dry_run)
    if install:
        print(REVIEW_STEPS)
        print("Expected hooks.state keys (created by Codex review):")
        for key in kiln_keys(codex_home().resolve() / "hooks.json", events):
            print(key)


def warn_missing_hooks():
    try:
        path = hooks_path()
        _, events = hook_events(path)
        keys = kiln_keys(codex_home().resolve() / "hooks.json", events)
        installed = all(any(is_kiln(h) for group in events.get(event, []) for h in group.get("hooks", []))
                        for event in ("Stop", "SessionStart", "PreToolUse"))
    except (OSError, ValueError, TypeError, AttributeError):
        keys, installed = [], False
    try:
        with (codex_home() / "config.toml").open("rb") as stream:
            state = tomllib.load(stream).get("hooks", {}).get("state", {})
        if not isinstance(state, dict):
            raise ValueError("hooks.state must be a table")
    except (OSError, ValueError, AttributeError):
        state = {}
    missing = [key for key in keys if not isinstance(state.get(key), dict) or not state[key].get("trusted_hash")]
    warnings = []
    if not installed:
        warnings.append("Codex Kiln hooks are not installed; run launch install-hooks --family codex")
    if missing:
        warnings.append("Kiln entries need /hooks review: " + ", ".join(missing))
    if warnings:
        print("launch: warning: " + "; ".join(warnings), file=sys.stderr)


def atomic_bytes(path, content, mode):
    descriptor, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def backup_once(path, original, mode, dry_run):
    backup = path.with_name(path.name + ".bak-kiln")
    if not path.exists() or backup.exists():
        return
    if dry_run:
        print(f"# backup {path} -> {backup}")
        return
    descriptor, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(original)
            stream.flush()
            os.fsync(stream.fileno())
        try:
            os.link(temporary, backup)
        except FileExistsError:
            pass
    finally:
        Path(temporary).unlink(missing_ok=True)


@contextmanager
def trust_lock(path, dry_run):
    if dry_run:
        yield
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.with_name(path.name + ".kiln.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def trust_flag(content, root):
    data = json.loads(content)
    if not isinstance(data, dict) or not isinstance(data.get("projects", {}), dict):
        raise ValueError("Claude trust config must contain a projects object")
    projects = data.get("projects", {})
    directory = Path(root).resolve()
    return any(isinstance(project := projects.get(str(parent)), dict)
               and project.get("hasTrustDialogAccepted") is True
               for parent in (directory, *directory.parents))


def pretrust(root, dry_run):
    root = absolute(root)
    path = (Path.home() / ".claude.json").resolve()
    try:
        # Trusted ancestors are sufficient, even when the profile is read-only.
        if trust_flag(path.read_bytes() if path.exists() else b"{}", root):
            return
        with trust_lock(path, dry_run):
            exists = path.exists()
            original = path.read_bytes() if exists else b"{}"
            mode = path.stat().st_mode & 0o777 if exists else 0o600
            if trust_flag(original, root):
                return
            data = json.loads(original)
            project = data.setdefault("projects", {}).setdefault(root, {})
            if not isinstance(project, dict):
                raise ValueError("Claude project state must be an object")
            project["hasTrustDialogAccepted"] = True
            updated = (json.dumps(data, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
            backup_once(path, original, mode, dry_run)
            if dry_run:
                print(f"# set {path}: projects[{json.dumps(root)}].hasTrustDialogAccepted = true")
            else:
                atomic_bytes(path, updated, mode)
                # Claude may write independently of our lock; confirm the installed record.
                if not trust_flag(path.read_bytes(), root):
                    raise ValueError(f"Claude folder trust is missing for {root} after re-apply; refusing launch")
    except OSError as error:
        if error.errno not in (errno.EACCES, errno.EPERM, errno.EROFS):
            raise
        raise ValueError(f"cannot pre-trust Claude root {root}: put seat roots under a folder Claude already trusts "
                         "(team bootstrap trusts the team folder from the bridge)") from error


def herdr(args, dry_run):
    if dry_run:
        print(shlex.join(["herdr", *args]))
        return None
    result = subprocess.run(["herdr", *args], capture_output=True, text=True,
                            stdin=subprocess.DEVNULL, timeout=35)
    if result.returncode:
        raise ValueError(result.stderr.strip() or "Herdr failed")
    return json.loads(result.stdout)["result"]


def target_pane(tab, workspace, root, dry_run):
    tabs = herdr(["tab", "list", "--workspace", workspace], dry_run)
    if not dry_run:
        matches = [t for t in tabs["tabs"] if tab in (t["tab_id"], t["label"])]
        if not matches:
            created = herdr(["tab", "create", "--workspace", workspace, "--label", tab,
                             "--cwd", root, "--no-focus"], False)
            return created["root_pane"]["pane_id"], created["tab"]["label"]
        if len(matches) != 1:
            raise ValueError("--tab must identify exactly one tab in the seat workspace")
        tab = matches[0]["tab_id"]
    panes = herdr(["pane", "list", "--workspace", workspace], dry_run)
    if dry_run:
        print("# if tab is missing: " + shlex.join(["herdr", "tab", "create", "--workspace", workspace,
                                                   "--label", tab, "--cwd", root, "--no-focus"]))
        return "<tab-pane>", tab
    return next(p["pane_id"] for p in panes["panes"] if p["tab_id"] == tab), matches[0]["label"]


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     epilog="Hook setup: launch {install-hooks,uninstall-hooks} --family codex [--dry-run]")
    if sys.argv[1:2] in (["install-hooks"], ["uninstall-hooks"]):
        parser.add_argument("command", choices=("install-hooks", "uninstall-hooks"))
        parser.add_argument("--family", required=True, choices=("codex",))
        parser.add_argument("--dry-run", action="store_true")
        args = parser.parse_args()
        try:
            manage_hooks(args.command == "install-hooks", args.dry_run)
        except (OSError, ValueError, KeyError, TypeError) as error:
            parser.exit(1, f"launch: {error}\n")
        return
    for key in ("tab", "address", "parent"):
        parser.add_argument(f"--{key}", required=True)
    parser.add_argument("--role", required=True, choices=SCHEMA["properties"]["role"]["enum"])
    parser.add_argument("--family", choices=SCHEMA["properties"]["family"]["enum"])
    parser.add_argument("--root")
    parser.add_argument("--route", help="active lane entry, e.g. research_gpt or conceptual.0")
    for key in ("model", "effort"):
        parser.add_argument(f"--{key}", choices=SCHEMA["properties"][key]["enum"])
    for key in ("name", "card", "handoff", "worktree", "run"):
        parser.add_argument(f"--{key}")
    parser.add_argument("--wait-ms", type=int, default=1800000)
    parser.add_argument("--direction", choices=("right", "down"), default="down")
    parser.add_argument("--extra-root", action="append", default=[])
    parser.add_argument("--dry-run", action="store_true", help="print commands and file contents without side effects")
    args = parser.parse_args()
    seat_path = None
    previous = None
    try:
        home_value = os.environ.get("KILN_HOME")
        if not home_value and not args.dry_run:
            raise ValueError("KILN_HOME is required")
        home = Path(home_value).resolve() if home_value else Path("<KILN_HOME>")
        if not re.fullmatch(SCHEMA["properties"]["parent"]["pattern"], args.parent):
            raise ValueError("invalid parent address")
        workspace = os.environ.get("HERDR_WORKSPACE_ID")
        if not workspace and args.parent:
            parent_path = home / "seats" / f"{args.parent}.json"
            parent = json.loads(parent_path.read_text()) if parent_path.exists() else {}
            if not isinstance(parent, dict):
                raise ValueError("parent seat must be an object")
            workspace = parent.get("workspace")
        if not workspace:
            if not args.dry_run:
                raise ValueError("HERDR_WORKSPACE_ID or a parent seat workspace is required")
            workspace = "<workspace>"
        lane, model, effort = routing(args)
        args.family = family(model)
        if args.family == "agy":
            raise ValueError("agy runs as a plain command, not a seat")
        if not (args.worktree or args.root):
            raise ValueError("--root or --worktree is required")
        if args.role == "worker" and not args.run:
            raise ValueError("--run is required for a worker seat")
        root = absolute(args.worktree or args.root)
        extra_roots = list(dict.fromkeys(absolute(p) for p in args.extra_root + ([args.run] if args.run else [])))
        seat = dict(address=args.address, role=args.role, family=args.family, tab=args.tab,
                    root=root, run=absolute(args.run) if args.role == "worker" else root,
                    extra_roots=extra_roots, parent=args.parent, model=model,
                    effort=effort, lane=lane, pane="", workspace=workspace, wait_ms=args.wait_ms,
                    inbox="" if args.role == "worker" else str(home / "inbox" / f"{args.address}.json"))
        for key in ("name", "card", "handoff"):
            value = getattr(args, key)
            if value is not None:
                seat[key] = value if key == "name" else absolute(value)
        if args.handoff is None:
            seat["handoff"] = str(Path(root) / f"handoff-{args.address}.md")
        validate(seat)
        config = hooks(args.role, args.family)
        if args.family == "codex":
            warn_missing_hooks()
        if args.family == "claude":
            pretrust(root, args.dry_run)
        target, seat["tab"] = target_pane(args.tab, workspace, root, args.dry_run)
        if args.card is None and args.role != "worker":
            card = f"manager-{seat['tab']}" if args.role == "manager" else args.role
            card_path = PLUGIN / "cards" / f"{card}.md"
            if not card_path.is_file():
                raise ValueError(f"default card not found: {card_path}")
            seat["card"] = str(card_path)
        team = team_config()
        if args.family == "codex" and seat["tab"] in ("build", "verify", "deploy") and team.get("project"):
            git = subprocess.run(["git", "-C", team["project"], "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                 capture_output=True, text=True, timeout=30)
            if git.returncode:
                raise ValueError(git.stderr.strip() or "cannot resolve project git common dir")
            common = git.stdout.strip()
            if common not in extra_roots:
                extra_roots.append(common)
        flags = native(seat, config, home)
        candidate = home / "seats" / f"{args.address}.json"
        if candidate.exists():
            try:
                previous = json.loads(candidate.read_text())
                if not isinstance(previous, dict):
                    raise ValueError("expected a seat object")
            except ValueError as error:
                previous = None
                print(f"launch: warning: ignoring corrupt previous seat {args.address}: {error}", file=sys.stderr)
        write_json(candidate, seat, args.dry_run)
        seat_path = candidate
        result = herdr(["pane", "split", target, "--direction", args.direction, "--cwd", root, "--no-focus",
                        "--env", f"KILN_SEAT={seat_path}", "--env", f"KILN_HOME={home}",
                        "--env", f"KILN_PLUGIN={PLUGIN}"], args.dry_run)
        seat["pane"] = "<new-pane>" if args.dry_run else result["pane"]["pane_id"]
        if previous and previous.get("pane") != seat["pane"]:
            print(f"launch: warning: replacing {args.address} from pane {previous.get('pane')} with {seat['pane']}", file=sys.stderr)
        write_json(seat_path, seat, args.dry_run)
        short = {"claude-opus-5-5": "opus-5.5", "claude-fable-5-1": "fable-5.1",
                 "claude-sonnet-5-5": "sonnet-5.5", "gpt-6.1-sol": "sol-6.1",
                 "gpt-6-astra": "astra", "gemini-4-argon-high": "argon-high"}[model]
        role_text = {"manager": f"{seat['tab']} manager", "chunkmaster": "chunk master"}.get(args.role, args.role)
        label = f"{args.name or args.address} · {role_text} · {short}"
        herdr(["pane", "rename", seat["pane"], label], args.dry_run)
        # Re-read immediately before start and re-apply once if the flag disappeared.
        if args.family == "claude" and not args.dry_run:
            try:
                pretrust(root, False)
            except (OSError, ValueError, KeyError, TypeError):
                try:
                    herdr(["pane", "close", seat["pane"]], False)
                except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as cleanup_error:
                    print(f"launch: could not close pane {seat['pane']}: {cleanup_error}", file=sys.stderr)
                raise
        herdr(["agent", "start", args.address, "--kind", args.family, "--pane", seat["pane"],
               "--timeout", "30000", "--", *flags], args.dry_run)
        try:
            received = markers(seat)
            unread = any(row.get("to") == args.address and row.get("id") not in received
                         for row in records(home))
            if unread:
                herdr(["agent", "prompt", args.address, "inbox"], args.dry_run)
        except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
            print(f"launch: seat started; inbox nudge failed: {error}", file=sys.stderr)
    except (OSError, ValueError, KeyError, TypeError, StopIteration, subprocess.TimeoutExpired) as error:
        if seat_path is not None and not args.dry_run:
            if previous is not None:
                write_json(seat_path, previous, False)
            else:
                seat_path.unlink(missing_ok=True)
        parser.exit(1, f"launch: {error}\n")


if __name__ == "__main__":
    main()
