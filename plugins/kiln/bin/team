#!/usr/bin/env python3
"""Kiln ledger transport. Receipt is separate from completion."""
import argparse
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys
import time
from contextlib import contextmanager

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib.ledger import live_pid, markers, pending, read_json, records, workers


def address(value):
    if not re.fullmatch(r"[a-z][a-z0-9-]*", value):
        raise ValueError(f"invalid address: {value}")
    return value


@contextmanager
def locked(home):
    home.mkdir(parents=True, exist_ok=True)
    with (home / "ledger.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def environment(name):
    value = os.environ.get(name)
    if not value:
        raise ValueError(f"{name} is required")
    return value


def emit(rows):
    for row in rows:
        print(json.dumps(row, ensure_ascii=False))


def herdr(*args):
    result = subprocess.run(["herdr", *args], capture_output=True, text=True,
                            stdin=subprocess.DEVNULL, timeout=30)
    if result.returncode:
        raise ValueError(result.stderr.strip() or "Herdr failed")
    return json.loads(result.stdout)["result"]


def nudge(home, receiver, row, delay):
    """At most one prompt; the delayed status check closes the busy/idle gap."""
    if receiver["family"] not in ("claude", "codex"):
        return
    try:
        addr = receiver["address"]
        listener = home / "listeners" / f"{addr}.pid"
        if receiver["family"] == "claude" and live_pid(listener, listener=True):
            return
        state = herdr("agent", "get", addr)["agent"]["agent_status"]
        if state == "working":
            time.sleep(delay)
            state = herdr("agent", "get", addr)["agent"]["agent_status"]
        with locked(home):
            unread = row["id"] not in markers(receiver)
        if (unread and state in ("idle", "done")
                and not (receiver["family"] == "claude" and live_pid(listener, listener=True))):
            herdr("agent", "prompt", addr, "inbox")
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
        print(f"team: row {row['id']} saved; nudge failed: {error}", file=sys.stderr)


def mark_read(seat, ids):
    """Caller holds the ledger lock, including across receipt read and replace."""
    if not seat["inbox"]:
        return
    path = Path(seat["inbox"])
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(".tmp")
    temp.write_text(json.dumps({"read": sorted(markers(seat) | set(ids))}) + "\n")
    temp.replace(path)


def send(args, home, seat):
    sender = address(seat["address"])
    if args.sender is not None and args.sender != sender:
        raise ValueError("--from must match KILN_SEAT address")
    if "\n" in args.headline or "\r" in args.headline:
        raise ValueError("headline must be one line")
    if len(args.headline) > 100:
        print("team: warning: headline exceeds 100 characters", file=sys.stderr)
    if seat["role"] == "worker" and args.kind != "question":
        raise ValueError("workers may send only question")
    if args.cites is not None and args.kind not in ("done", "answer"):
        raise ValueError("only done/answer may cite a row")
    receiver = read_json(home / "seats" / f"{address(args.to)}.json")
    if receiver is None:
        raise ValueError("receiver seat not found")
    if receiver["role"] == "worker":
        raise ValueError("no row may be addressed to a worker")
    with locked(home):
        rows = records(home)
        if args.kind in ("done", "answer"):
            cited = next((r for r in rows if r.get("id") == args.cites), None)
            if cited is None or cited.get("kind") not in ("request", "question"):
                raise ValueError("done/answer must cite a request/question id")
            destination = cited.get("from")
            if args.kind == "answer" and cited.get("kind") == "question":
                destination = cited.get("via", destination)
            if cited.get("to") != sender or args.to != destination:
                raise ValueError("reply must come from the receiver and go to the asker or its worker launcher")
        now = dt.datetime.now(dt.timezone.utc)
        row = dict(id=f"{now:%Y%m%dT%H%M%S%fZ}-{secrets.token_hex(2)}",
                   **{"from": sender}, to=args.to, kind=args.kind, task=args.task,
                   headline=args.headline, path=args.path, time=now.isoformat(), cites=args.cites)
        if seat["role"] == "worker":
            row["via"] = address(seat["parent"])
        with (home / "ledger.jsonl").open("a") as stream:
            # Separate a torn final line from the next complete row.
            path = home / "ledger.jsonl"
            with path.open("rb") as existing:
                if existing.seek(0, os.SEEK_END):
                    existing.seek(-1, os.SEEK_END)
                    if existing.read(1) != b"\n":
                        stream.write("\n")
            stream.write(json.dumps(row, ensure_ascii=False) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        self_answer = args.kind == "answer" and args.to == sender
        if self_answer:
            mark_read(seat, [row["id"]])
    emit([row])
    sys.stdout.flush()
    if seat["role"] != "worker" and not self_answer:
        nudge(home, receiver, row, args.recheck_seconds)


def relay(args, home, seat):
    if seat["role"] == "worker":
        raise ValueError("workers may not relay questions")
    with locked(home):
        row = next((r for r in records(home) if r.get("id") == args.question_id), None)
        if row is None or row.get("kind") != "question" or row.get("via") != seat["address"]:
            raise ValueError("relay requires a worker question routed via this launcher")
        if row.get("to") == seat["address"]:
            print("team: question is addressed to this launcher; no relay needed")
            return
        receiver = read_json(home / "seats" / f"{address(row['to'])}.json")
        if receiver is None or receiver.get("role") == "worker":
            raise ValueError("question receiver must be a persistent seat")
    nudge(home, receiver, row, args.recheck_seconds)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    send_parser = commands.add_parser("send", help="append a row and wake a receiver without an active listener")
    send_parser.add_argument("--from", dest="sender", help="defaults to KILN_SEAT address")
    for key in ("to", "task", "headline"):
        send_parser.add_argument(f"--{key}", required=True)
    send_parser.add_argument("--kind", required=True, choices=("request", "done", "question", "answer", "update"))
    send_parser.add_argument("--path")
    send_parser.add_argument("--cites")
    send_parser.add_argument("--recheck-seconds", type=float, default=5,
                             help="one busy receiver recheck delay (default: 5)")
    relay_parser = commands.add_parser("relay", help="wake the receiver of a worker question routed via this launcher")
    relay_parser.add_argument("question_id")
    relay_parser.add_argument("--recheck-seconds", type=float, default=5)
    commands.add_parser("inbox", help="print unread rows").add_argument("--mark", action="store_true")
    commands.add_parser("overdue", help="print uncompleted requests").add_argument("--minutes", type=float, default=0)
    commands.add_parser("ledger", help="print ledger rows").add_argument("--tail", type=int)
    commands.add_parser("workers", help="list seats whose parent is this seat")
    commands.add_parser("pending", help="print received rows with no done/answer citation")
    close_parser = commands.add_parser("close", help="remove an accepted worker's seat record")
    close_parser.add_argument("address")
    close_parser.add_argument("--force", action="store_true", help="also allow closing a persistent seat")
    args = parser.parse_args()
    try:
        home = Path(environment("KILN_HOME")).resolve()
        seat = None
        if args.command in ("send", "relay", "inbox", "workers", "pending"):
            seat = read_json(Path(environment("KILN_SEAT")))
            if seat is None:
                raise ValueError("KILN_SEAT file not found")
        if args.command in ("send", "relay"):
            if args.recheck_seconds < 0:
                raise ValueError("recheck seconds must be nonnegative")
            if args.command == "send":
                send(args, home, seat)
            else:
                relay(args, home, seat)
            return
        if args.command == "close":
            with locked(home):
                path = home / "seats" / f"{address(args.address)}.json"
                target = read_json(path)
                if target is not None and target.get("role") not in ("worker", "advisor") and not args.force:
                    raise ValueError("closing a persistent seat requires --force")
                path.unlink(missing_ok=True)
            if target and target.get("pane"):
                try:
                    herdr("pane", "close", target["pane"])
                except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
                    print(f"team: seat removed; pane {target['pane']} already gone or could not close: {error}", file=sys.stderr)
            return
        with locked(home):
            if args.command == "workers":
                emit(workers(home, seat))
                return
            rows = records(home)
            if args.command in ("inbox", "pending"):
                addr = address(seat["address"])
                read = markers(seat)
                if args.command == "pending":
                    emit(pending(rows, seat))
                    return
                rows = [r for r in rows if r.get("to") == addr and r.get("id") not in read]
                emit(rows)
                sys.stdout.flush()
                if args.mark:
                    mark_read(seat, [r["id"] for r in rows])
                return
            if args.command == "overdue":
                completed = {r.get("cites") for r in rows if r.get("kind") in ("done", "answer")}
                cutoff = dt.datetime.now(dt.timezone.utc) - dt.timedelta(minutes=args.minutes)
                rows = [r for r in rows if r.get("kind") in ("request", "question") and r.get("id") not in completed
                        and dt.datetime.fromisoformat(r["time"]) <= cutoff]
            elif args.tail is not None:
                if args.tail < 0:
                    raise ValueError("tail must be nonnegative")
                rows = rows[-args.tail:] if args.tail else []
            emit(rows)
    except (OSError, ValueError, KeyError, TypeError) as error:
        parser.exit(1, f"team: {error}\n")


if __name__ == "__main__":
    main()
