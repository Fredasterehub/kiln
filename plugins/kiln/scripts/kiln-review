#!/usr/bin/env node
'use strict'

const { createHash, randomBytes, randomUUID } = require('node:crypto')
const {
  appendFileSync,
  closeSync,
  constants: FS,
  existsSync,
  fstatSync,
  linkSync,
  lstatSync,
  mkdirSync,
  openSync,
  readdirSync,
  readFileSync,
  readlinkSync,
  realpathSync,
  renameSync,
  statSync,
  unlinkSync,
  writeFileSync,
} = require('node:fs')
const { basename, dirname, join, resolve, sep } = require('node:path')
const { homedir } = require('node:os')
const { spawnSync } = require('node:child_process')

const ACCEPT = 0
// W2-S7b (item 11): the read-only membership answer for a PROVEN absence — the exit grammar the
// audited-skip check has always spoken (0 present, 1 absent, anything else untrusted and held).
const NO_MEMBER = 1
const REJECT = 10
const BLOCKED = 11
const TRANSPORT_FAILURE = 20
const CODEX_UNAVAILABLE = 21
// W2-S3 (C2 / B04 / ruling 2): the LAW seal covers all THREE trio files — LAW.md, the
// executable law/check.sh, and the slice plan slices.json — each digested individually into
// .kiln/law/trio.hash. TRIO_MISMATCH is the closed exit a live file that no longer matches
// its sealed digest earns; it is DISTINCT from a transport failure (an absent or torn
// trio.hash) so a caller can tell a tamper apart from a missing seal.
const TRIO_MISMATCH = 22
const EFFORTS = ['low', 'medium', 'high', 'xhigh']
const LAW_HASH = /^[0-9a-f]{64}$/
const BROKEN_CODEX = /(?:unknown|unrecognized|unexpected|invalid).*(?:argument|option|subcommand)|(?:argument|option).*(?:not found|not recognized)/i
const SCHEMA = join(__dirname, 'review-schema.json')
// W8-S2: the screen family's shipped instrument and bounds. Keyframes ≤6, references ≤2,
// and the TOTAL image transport (2 required viewports + keyframes + references) capped
// at 10 — the whole pixel budget a grader ever sees. The DOM rides as a bounded text
// excerpt: enough to substantiate a clip-vs-authored call without flooding the packet.
const PERCEPTUAL_RUBRIC = join(__dirname, '..', 'data', 'perceptual-rubric.json')
const SCREEN_KEYFRAMES_MAX = 6
const SCREEN_REFERENCES_MAX = 2
const SCREEN_IMAGES_MAX = 10
const SCREEN_DOM_EXCERPT_LIMIT = 20000
// Screen findings pin evidence, not source: a viewport capture has no line number, so
// the location is an evidence path with an OPTIONAL :frame (film.webm:3) — the one
// place the screen family relaxes the shared path:line discipline.
const SCREEN_LOCATION = { pattern: /^[^:]+(?::\d+)?$/, message: 'location must be an evidence path with an optional :frame' }

function stop(fact, message, code) {
  process.stdout.write(`${fact}\n`)
  process.stderr.write(`kiln-review: ${message}\n`)
  process.exit(code)
}

function discard(file) {
  try {
    if (existsSync(file)) unlinkSync(file)
  } catch {
    // The original failure remains the machine fact.
  }
}

function readJson(file, label, discardOnFailure) {
  try {
    return JSON.parse(readFileSync(resolve(file), 'utf8'))
  } catch (error) {
    if (discardOnFailure) discard(discardOnFailure)
    stop('transport_failure', `${label}: ${error.message}`, TRANSPORT_FAILURE)
  }
}

function isObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value)
}

function stringArray(value) {
  return Array.isArray(value) && value.every((item) => typeof item === 'string')
}

// W2-S8: the ONE containment gate for a path that reaches the filesystem from model-written
// content. It answers with an absolute path INSIDE root or it HOLDs — never a falsy value a caller
// could read as absence. Containment is proven twice: lexically against the root, then PHYSICALLY
// over the deepest EXISTING ancestor of the target, so a link is an outside path wearing an inside
// name whether it stands at the target or at a directory above it, while the not-yet-created tail
// carries no link to follow — one gate serves a read and a first write alike. A root, an ancestor
// or a dangling link that cannot be resolved HOLDs: a containment question that cannot be answered
// is never answered yes. It proves the PATH, not the open; a caller needing race-proof bytes opens
// by descriptor, as the manifest apparatus already does for its own reads.
function containedPath(root, rel, label) {
  const fail = (why) => stop('transport_failure', `${label}: ${why}`, TRANSPORT_FAILURE)
  // The boundary is the root plus exactly one separator, so a sibling whose name merely begins with
  // the root is outside. A root that ALREADY ends in a separator — the filesystem root itself — must
  // not grow a second one, or the check would refuse its own children.
  const within = (path, base) => path === base || path.startsWith(base.endsWith(sep) ? base : base + sep)
  if (typeof rel !== 'string' || rel.trim() === '') fail('the path must be a nonempty string')
  const rootAbs = resolve(root)
  const abs = resolve(rootAbs, rel)
  if (!within(abs, rootAbs)) fail(`${rel} resolves outside ${rootAbs}`)
  let rootReal
  try {
    rootReal = realpathSync(rootAbs)
  } catch (error) {
    fail(`the containment root ${rootAbs} is unresolvable: ${error.message}`)
  }
  // The walk is bounded by the lexical proof above: abs lies under rootAbs, which exists.
  let probe = abs
  while (probe !== rootAbs) {
    try {
      lstatSync(probe)
      break
    } catch (error) {
      if (error.code !== 'ENOENT') fail(`${probe} could not be examined: ${error.message}`)
      probe = dirname(probe)
    }
  }
  let real
  try {
    real = realpathSync(probe)
  } catch (error) {
    fail(`${rel} does not physically resolve: ${error.message}`)
  }
  if (!within(real, rootReal)) fail(`${rel} physically resolves outside ${rootAbs}`)
  return abs
}

// W2-S4 (C1 / B03 / Sol Model A): the builder request survives ONLY as non-authoritative
// evidence hints — what the builder covered, touched, observed and ran. The authoritative gate
// facts (law_hash, law_text, reviewer model/effort, slice) are derived CLI-side over the sealed
// trio and ride argv; a hint may orient the reviewer but never narrows or overrides the LAW.
// The request stays a required, well-formed deliverable (its absence is the existing
// builder-failure hold); its contents are demoted, not removed. reviewer_model/reviewer_effort/
// law_hash are no longer read here — the builder no longer authors the contract.
function hintsFrom(file) {
  const raw = readJson(file, 'invalid request')
  if (!isObject(raw)) stop('transport_failure', 'request must be a JSON object', TRANSPORT_FAILURE)
  if (typeof raw.criteria !== 'string' || raw.criteria.trim() === '') {
    stop('transport_failure', 'request criteria must be a nonempty string', TRANSPORT_FAILURE)
  }
  for (const field of ['paths', 'failures', 'commands']) {
    if (!stringArray(raw[field])) stop('transport_failure', `request ${field} must be an array of strings`, TRANSPORT_FAILURE)
  }
  return { criteria: raw.criteria, paths: raw.paths, failures: raw.failures, commands: raw.commands }
}

// A ratify request names the readable artifact, carries its own review_id (the caller
// issues it — unlike a slice review, which mints one), and picks the reviewer. There is
// no law_hash to supply: the bytes of the ratified artifact become the digest, computed at
// dispatch. W2-S8: it no longer names a rubric — the instrument is a shipped constant the
// family word selects, so no request can point the grader at a file of its own choosing.
function ratifyRequestFrom(file) {
  const raw = readJson(file, 'invalid ratify request')
  if (!isObject(raw)) stop('transport_failure', 'ratify request must be a JSON object', TRANSPORT_FAILURE)
  if (typeof raw.review_id !== 'string' || raw.review_id.trim() === '') {
    stop('transport_failure', 'ratify request review_id must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof raw.reviewer_model !== 'string' || raw.reviewer_model.trim() === '') {
    stop('transport_failure', 'ratify request reviewer_model must be a nonempty string', TRANSPORT_FAILURE)
  }
  // W2-S7a (B-D1): reviewer_alias is the durable tiers fact the codex identity records as
  // requested_alias — it rides this kernel-authored request beside the concrete reviewer_model, a
  // closed token, distinct from the resolved model. The kernel and the research sweep both supply it.
  if (typeof raw.reviewer_alias !== 'string' || !LOCK_TOKEN.test(raw.reviewer_alias)) {
    stop('transport_failure', 'ratify request reviewer_alias must be a closed token of letters, digits, dot, underscore or hyphen', TRANSPORT_FAILURE)
  }
  const reviewerEffort = raw.reviewer_effort === undefined ? 'high' : raw.reviewer_effort
  if (!EFFORTS.includes(reviewerEffort)) {
    stop('reviewer_effort_invalid', `request reviewer_effort must be one of ${EFFORTS.join('|')} (absent defaults to high); ultra and unknown values are rejected`, TRANSPORT_FAILURE)
  }
  if (typeof raw.artifact !== 'string' || raw.artifact.trim() === '') {
    stop('transport_failure', 'ratify request artifact must be a nonempty path string', TRANSPORT_FAILURE)
  }
  return {
    reviewerModel: raw.reviewer_model,
    reviewerAlias: raw.reviewer_alias,
    reviewerEffort,
    reviewId: raw.review_id,
    artifact: raw.artifact,
  }
}

function rubricFrom(file) {
  const raw = readJson(file, 'invalid rubric')
  if (!isObject(raw) || !Array.isArray(raw.criteria) || raw.criteria.length === 0) {
    stop('transport_failure', 'rubric must be a JSON object with a nonempty criteria array', TRANSPORT_FAILURE)
  }
  for (const criterion of raw.criteria) {
    if (!isObject(criterion) || ['id', 'requirement', 'pass', 'fail'].some((key) => typeof criterion[key] !== 'string' || criterion[key].trim() === '')) {
      stop('transport_failure', 'each rubric criterion needs nonempty id, requirement, pass and fail strings', TRANSPORT_FAILURE)
    }
  }
  return raw.criteria
}

// W2-S8: the ratify family grades against a SHIPPED instrument selected by its family word — a
// rubric path that cannot be supplied cannot escape the plugin, and both transports are guaranteed
// to grade the same artifact against the same criteria. The map is also the closed family set: a
// family with no shipped rubric HOLDs here, before any compose, store or spawn. A Map, not an
// object, so no inherited key ever answers a lookup.
const RATIFY_RUBRIC = new Map([
  ['ratify', join(__dirname, '..', 'data', 'law-rubric.json')],
  ['feasibility', join(__dirname, '..', 'data', 'feasibility-rubric.json')],
])

function shippedRubric(family, verb) {
  const path = RATIFY_RUBRIC.get(family)
  if (path === undefined) {
    stop('transport_failure', `${verb} purpose must be ${[...RATIFY_RUBRIC.keys()].join(' or ')} — no other family has a shipped rubric`, TRANSPORT_FAILURE)
  }
  return rubricFrom(path)
}

// W7-A1: the audit argv contract — closed facts only ride argv. Model, alias and effort arrive
// as argv words (the kernel resolves them from tiers.json); the effort gate halts an unknown
// effort by name before any spawn. W8-S2: the screen family shares the identical contract, so
// the family label parameterizes the halt message and nothing else. W2-S4: the build review
// and recheck verbs join this contract — model and effort ride argv, no longer builder-relayed.
// W2-S7a (B-D1): the reviewer ALIAS rides argv beside the concrete model — the durable tiers fact
// the codex identity records as requested_alias, distinct from the resolved --model value. It is a
// closed token (LOCK_TOKEN), the kernel supplies it from resolveTier; a malformed alias halts.
function auditRequest(model, alias, effort, family = 'audit') {
  if (typeof model !== 'string' || model.trim() === '') {
    stop('transport_failure', `${family} reviewer model must be a nonempty string`, TRANSPORT_FAILURE)
  }
  if (typeof alias !== 'string' || !LOCK_TOKEN.test(alias)) {
    stop('transport_failure', `${family} reviewer alias must be a closed token of letters, digits, dot, underscore or hyphen`, TRANSPORT_FAILURE)
  }
  if (!EFFORTS.includes(effort)) {
    stop('reviewer_effort_invalid', `${family} effort must be one of ${EFFORTS.join('|')}; ultra and unknown values are rejected`, TRANSPORT_FAILURE)
  }
  return { reviewerModel: model, reviewerAlias: alias, reviewerEffort: effort }
}

// W2-S3: the sealed trio, in the fixed order seal-law writes and every reader checks.
// LAW.md and slices.json sit at the kiln root; the executable check.sh sits under law/.
const TRIO_MEMBERS = ['LAW.md', 'check.sh', 'slices.json']
const trioMemberPath = (kilnDir, name) => (name === 'check.sh' ? join(kilnDir, 'law', name) : join(kilnDir, name))
const trioHashPath = (kilnDir) => join(kilnDir, 'law', 'trio.hash')

// W2-S3 (B01): the sealed law is ONE coherent authority, not three loose files. seal-law
// writes trio.hash (per-member digests), lock.hash (the LAW.md digest) and the lock.seal
// sidecar (`<digest> <label>`); a crashed reseal could otherwise promote a new trio.hash
// beside stale locks. sealedAuthority admits ONLY a whole, cross-bound seal — all three
// present and well-formed, and trio[LAW.md] === lock.hash === the lock.seal digest — and
// returns its verified facts. Any PARTIAL or MISMATCHED combination is a TRIO_MISMATCH hold,
// the integrity class (B02) every sealed consumer holds on. NONE of the three present is an
// honest unsealed law (returns {sealed:false}) for the pre-seal flows. This is the single
// gate so the rule cannot drift per-site.
function sealedAuthority(kilnDir) {
  const read = (p) => {
    try {
      return readFileSync(p, 'utf8')
    } catch (error) {
      if (error.code === 'ENOENT') return null
      stop('trio_mismatch', `the sealed law could not be read: ${error.message}`, TRIO_MISMATCH)
    }
  }
  const trioRaw = read(trioHashPath(kilnDir))
  const lockRaw = read(join(kilnDir, 'law', 'lock.hash'))
  const sealRaw = read(join(kilnDir, 'law', 'lock.seal'))
  if (trioRaw === null && lockRaw === null && sealRaw === null) return { sealed: false }
  // Some seal artifact exists — the law claims to be sealed, so ALL THREE must be whole.
  const fail = (why) => stop('trio_mismatch', `the sealed law is not whole: ${why} — reseal the law before it is consumed`, TRIO_MISMATCH)
  if (trioRaw === null) fail('law/trio.hash is absent beside a lock')
  const lines = trioRaw.split('\n')
  if (lines.length !== TRIO_MEMBERS.length + 1 || lines[TRIO_MEMBERS.length] !== '') fail('law/trio.hash is not three trailing-newline lines')
  const trio = {}
  for (let i = 0; i < TRIO_MEMBERS.length; i += 1) {
    const parts = lines[i].split(' ')
    if (parts.length !== 2 || parts[0] !== TRIO_MEMBERS[i] || !LAW_HASH.test(parts[1])) fail(`law/trio.hash line ${i + 1} is malformed`)
    trio[TRIO_MEMBERS[i]] = parts[1]
  }
  // The authority gate holds the legacy locks to their BYTE-EXACT shipped shapes — no trim, no
  // first-token parse — so an extra newline, surrounding space, wrong label, or trailing
  // garbage is a torn seal, never a whole one. (The ratify and audit consumers that trim their
  // OWN lock.hash reads stay as they are; only this gate is byte-exact.)
  if (lockRaw === null) fail('law/lock.hash is absent beside the trio')
  if (!/^[0-9a-f]{64}\n$/.test(lockRaw)) fail('law/lock.hash is not exactly a 64-hex digest and one newline')
  const lockHash = lockRaw.slice(0, 64)
  if (sealRaw === null) fail('law/lock.seal is absent beside the trio')
  if (!/^[0-9a-f]{64} (?:dual|single-family)\n$/.test(sealRaw)) fail('law/lock.seal is not exactly <digest> <dual|single-family> and one newline')
  const sealDigest = sealRaw.slice(0, 64)
  if (trio['LAW.md'] !== lockHash || lockHash !== sealDigest) fail('trio.hash, lock.hash and lock.seal disagree on the LAW digest')
  return { sealed: true, trio, lockHash, sealDigest }
}

// Read the bytes a verb is about to parse and, if the law is sealed, confirm they still match
// the sealed trio digest BEFORE the parse — verification and consumption are ONE operation
// over the SAME bytes (B04), never a verify call a tamper can slip between and a separate
// read. auth is the sealedAuthority result: sealed verifies, unsealed passes bytes through for
// the pre-seal flows. A member that vanished from a sealed law is a torn seal (TRIO_MISMATCH).
function verifyMember(auth, kilnDir, name, label) {
  let bytes
  try {
    bytes = readFileSync(trioMemberPath(kilnDir, name))
  } catch (error) {
    stop(auth.sealed ? 'trio_mismatch' : 'transport_failure', `${label} could not read ${name}: ${error.message}`, auth.sealed ? TRIO_MISMATCH : TRANSPORT_FAILURE)
  }
  if (auth.sealed && createHash('sha256').update(bytes).digest('hex') !== auth.trio[name]) {
    stop('trio_mismatch', `${label}: ${name} no longer matches the sealed law/trio.hash digest`, TRIO_MISMATCH)
  }
  return bytes
}
function readSealedMember(kilnDir, name, label) {
  return verifyMember(sealedAuthority(kilnDir), kilnDir, name, label)
}

// The audit CLI reads the CHECKED slices.json projection itself and derives every
// milestone fact: the closing block is the maximal contiguous run of same-label slices
// ending at the seam slice; the cumulative prefix is every slice up to and including it.
// Milestone labels may contain spaces — they ride only inside the composed prompt, so no
// stop() on this path ever interpolates a label into a log line. law_hash binds to the
// sealed digest at <kilnDir>/law/lock.hash, required present.
function auditFacts(kilnDir, seamSliceId) {
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'audit kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof seamSliceId !== 'string' || seamSliceId.trim() === '') {
    stop('transport_failure', 'audit seam slice id must be a nonempty string', TRANSPORT_FAILURE)
  }
  // W2-S3 (B01): the audit rests on ONE coherent sealed authority. law_hash binds to the
  // cross-bound lock.hash it returns, and the slices.json it derives scope from is verified
  // against the same seal in one operation — the bytes parsed are the bytes verified.
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'audit requires the sealed law', TRANSPORT_FAILURE)
  let slices
  try {
    slices = JSON.parse(verifyMember(auth, kilnDir, 'slices.json', 'audit').toString('utf8'))
  } catch (error) {
    stop('transport_failure', `invalid slices projection: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (!Array.isArray(slices) || slices.length === 0) {
    stop('transport_failure', 'slices.json must be a nonempty array', TRANSPORT_FAILURE)
  }
  // The kernel slice contract (parseSliceEntry), not a stricter one: a legacy bare
  // string entry is its own id with no label; an object entry carries id + optional
  // milestone. Ids and labels normalize by trim — the projection-agreement normalization
  // — so the audit, the kernel seam fact and the checked projection read identical
  // bytes, and every kernel-valid slices.json can derive its audit facts.
  const entries = slices.map((slice) => (typeof slice === 'string'
    ? { id: slice.trim(), milestone: '' }
    : {
      id: String((slice && slice.id) || '').trim(),
      milestone: String((slice && slice.milestone) || '').trim(),
    }))
  if (entries.some((entry) => entry.id === '')) {
    stop('transport_failure', 'every slices.json entry must carry a nonempty id', TRANSPORT_FAILURE)
  }
  const seam = entries.findIndex((entry) => entry.id === seamSliceId)
  if (seam < 0) stop('transport_failure', 'seam slice id not found in slices.json', TRANSPORT_FAILURE)
  let start = seam
  while (start > 0 && entries[start - 1].milestone === entries[seam].milestone) start -= 1
  return {
    lawHash: auth.lockHash,
    milestone: entries[seam].milestone,
    closingBlock: entries.slice(start, seam + 1).map((entry) => entry.id),
    sealedPrefix: entries.slice(0, seam + 1).map((entry) => entry.id),
  }
}

// W2-S4 (C1 / B03 / Sol Model A): the verified-whole-LAW gate facts. The build gate's
// authority is the SEALED LAW.md itself — verified against the trio in the act of reading it
// (B04), the auditFacts/screenLawFacts discipline — never a builder-relayed contract. law_hash
// binds the cross-bound lock.hash the authority returns; law_text is the SAME verified bytes,
// embedded so the reviewer judges the exact sealed LAW (embedding over digest-plus-reread: the
// ratify full-artifact and screen verifier-row precedent). The reviewer scopes law_text to the
// named slice; a torn seal or a post-seal LAW.md drift holds TRIO_MISMATCH before any spawn.
function buildGateFacts(kilnDir, sliceId) {
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'build gate kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof sliceId !== 'string' || sliceId.trim() === '') {
    stop('transport_failure', 'build gate slice id must be a nonempty string', TRANSPORT_FAILURE)
  }
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'build gate requires the sealed law', TRANSPORT_FAILURE)
  const lawText = verifyMember(auth, kilnDir, 'LAW.md', 'build gate').toString('utf8')
  return { lawHash: auth.lockHash, lawText }
}

// W8-S2: the screen-family law facts — the verb derives the LAW Perceptual table rows
// ITSELF, with the PERCEPTUAL_TABLE_CHECK parser discipline (heading anchor, exact
// seven-cell header, GFM delimiter row, split on UNESCAPED `|` only so a lawful proxy
// command's GFM `\|` unescapes to the real operator), and binds the sealed lock.hash
// as packet TEXT — the schema's law_hash field belongs to the evidence digest here.
function screenLawFacts(kilnDir) {
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'screen kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  // W2-S3 (B01/B04): verify-and-parse over ONE coherent sealed authority. The screen binds to
  // the SEALED ALL-THREE trio — every live member is re-verified against the seal, so a
  // post-seal check.sh or slices.json drift is a TRIO_MISMATCH hold, not just a LAW.md check —
  // and law_lock_hash binds to the cross-bound lock.hash the authority returns.
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'screen requires the sealed law', TRANSPORT_FAILURE)
  for (const name of TRIO_MEMBERS) if (name !== 'LAW.md') verifyMember(auth, kilnDir, name, 'screen')
  const law = verifyMember(auth, kilnDir, 'LAW.md', 'screen').toString('utf8')
  const head = ['criterion id', 'owning slice', 'dim', 'requirement', 'proxy command', 'expected', 'reference']
  const cells = (s) => s.split(/(?<!\\)\|/).slice(1, -1).map((x) => x.replace(/\\\|/g, '|').trim())
  const rows = []
  let state = 0
  for (const line of law.split('\n')) {
    const t = line.trim()
    const row = t.slice(0, 1) === '|'
    if (state === 0) {
      if (t.slice(0, 3) === '## ' && t.slice(3).trim().toLowerCase() === 'perceptual') state = 1
      continue
    }
    if (state === 1) {
      if (t.slice(0, 1) === '#') break
      if (!row) continue
      const c = cells(t)
      if (c.length === 7 && c.every((x, i) => x.toLowerCase() === head[i])) { state = 2; continue }
      stop('transport_failure', 'the LAW Perceptual table header row is malformed', TRANSPORT_FAILURE)
    }
    if (state === 2) {
      const c = t.split('|').slice(1, -1).map((x) => x.trim())
      if (row && c.length === 7 && c.every((x) => /^:?-{3,}:?$/.test(x))) { state = 3; continue }
      stop('transport_failure', 'the LAW Perceptual table delimiter row is malformed', TRANSPORT_FAILURE)
    }
    if (!row) break
    const c = cells(t)
    if (c.length !== 7) stop('transport_failure', 'every LAW Perceptual row must carry seven cells', TRANSPORT_FAILURE)
    rows.push({ criterion: c[0], slice: c[1], dim: c[2], requirement: c[3], proxy: c[4], expected: c[5], reference: c[6] })
  }
  if (state !== 3 || rows.length === 0) {
    stop('transport_failure', 'screen requires the sealed LAW.md to carry a Perceptual table with at least one row', TRANSPORT_FAILURE)
  }
  return { rows, lockHash: auth.lockHash }
}

// W8-S2 (Sol r3, adopted verbatim): CURRENT generation = the highest
// .kiln/evidence/gen-<n> dir containing a valid manifest.json. Validity here is the
// reader's floor — the bytes parse as a JSON object — because completeness is judged
// AFTER selection: an incomplete CURRENT manifest is an honest reject, never a silent
// fall-back onto a stale generation's evidence. A manifest-less dir (crash residue)
// occupies its number for the allocator but is invisible to every reader.
function currentGeneration(kilnDir) {
  const root = join(kilnDir, 'evidence')
  let names = []
  try {
    names = readdirSync(root)
  } catch {
    // No evidence root at all — the same honest no-CURRENT outcome as an empty one.
  }
  const numbers = names
    .map((name) => /^gen-(\d+)$/.exec(name))
    .filter(Boolean)
    .map((found) => Number(found[1]))
    .sort((a, b) => b - a)
  for (const number of numbers) {
    const dir = resolve(join(root, `gen-${number}`))
    let bytes, manifest
    try {
      bytes = readFileSync(join(dir, 'manifest.json'))
      manifest = JSON.parse(bytes.toString('utf8'))
    } catch {
      continue
    }
    if (!isObject(manifest)) continue
    return { number, dir, manifest, digest: createHash('sha256').update(bytes).digest('hex') }
  }
  stop('transport_failure', 'no CURRENT evidence generation — no .kiln/evidence/gen-* dir carries a valid manifest.json; the capture recipe runs first', TRANSPORT_FAILURE)
}

// W8-S2: the manifest completeness gate + the bounded image transport. Metadata floor:
// the manifest's gen number matches its dir, the probed runtime versions are recorded,
// and the counts equal the named files — a manifest that misdescribes itself never
// grades. Required classes: meta, dom, console, the two viewports, the film, and at
// least one labeled keyframe; references are optional. Bounds: keyframes ≤6,
// references ≤2, TOTAL image transport ≤10. Every named file resolves INSIDE the
// generation dir AND exists there physically — realpath containment, because a symlink
// pointing out is an outside path wearing an inside name. Any violation is a pre-spawn
// reject: exit 20, nothing published.
function screenEvidence(generation) {
  if (generation.manifest.generation !== generation.number) {
    stop('transport_failure', `manifest generation must equal its dir number ${generation.number}`, TRANSPORT_FAILURE)
  }
  const runtimes = isObject(generation.manifest.runtimes) ? generation.manifest.runtimes : {}
  for (const runtime of ['playwright', 'ffmpeg']) {
    if (typeof runtimes[runtime] !== 'string' || runtimes[runtime].trim() === '') {
      stop('transport_failure', `manifest missing recorded runtime version: ${runtime}`, TRANSPORT_FAILURE)
    }
  }
  const files = isObject(generation.manifest.files) ? generation.manifest.files : {}
  const entry = (name) => (typeof files[name] === 'string' && files[name].trim() !== '' ? files[name] : null)
  const list = (name) => (Array.isArray(files[name]) && files[name].every((p) => typeof p === 'string' && p.trim() !== '') ? files[name] : null)
  const required = {
    meta: entry('meta'),
    dom: entry('dom'),
    console: entry('console'),
    viewport_desktop: entry('viewport_desktop'),
    viewport_mobile: entry('viewport_mobile'),
    film: entry('film'),
  }
  const missing = Object.keys(required).find((name) => required[name] === null)
  if (missing) stop('transport_failure', `manifest missing required class ${missing}`, TRANSPORT_FAILURE)
  const keyframes = list('keyframes')
  if (!keyframes || keyframes.length === 0) {
    stop('transport_failure', 'manifest missing required class keyframes — at least one labeled keyframe', TRANSPORT_FAILURE)
  }
  const references = files.references === undefined ? [] : list('references')
  if (!references) stop('transport_failure', 'manifest references must be an array of nonempty paths', TRANSPORT_FAILURE)
  if (keyframes.length > SCREEN_KEYFRAMES_MAX) {
    stop('transport_failure', `manifest exceeds the keyframe bound: ${keyframes.length} > ${SCREEN_KEYFRAMES_MAX}`, TRANSPORT_FAILURE)
  }
  if (references.length > SCREEN_REFERENCES_MAX) {
    stop('transport_failure', `manifest exceeds the reference bound: ${references.length} > ${SCREEN_REFERENCES_MAX}`, TRANSPORT_FAILURE)
  }
  const imageNames = [required.viewport_desktop, required.viewport_mobile, ...keyframes, ...references]
  if (imageNames.length > SCREEN_IMAGES_MAX) {
    stop('transport_failure', `manifest exceeds the total image transport cap: ${imageNames.length} > ${SCREEN_IMAGES_MAX}`, TRANSPORT_FAILURE)
  }
  const counts = isObject(generation.manifest.counts) ? generation.manifest.counts : {}
  if (counts.keyframes !== keyframes.length || counts.references !== references.length || counts.images !== imageNames.length) {
    stop('transport_failure', 'manifest counts do not match its named files', TRANSPORT_FAILURE)
  }
  // W2-S8: containment is the shared gate now — this is the site the shared gate was generalized
  // FROM, and the manifest names are model-written like every other guarded path. What stays local
  // is the class check the shared gate deliberately does not make: an evidence entry must be a
  // REGULAR FILE that already exists, never a directory and never a name the capture has yet to write.
  const inside = (p) => {
    const abs = containedPath(generation.dir, p, `manifest entry ${p}`)
    try {
      if (!statSync(abs).isFile()) {
        stop('transport_failure', `manifest names a path that is not a regular file: ${p}`, TRANSPORT_FAILURE)
      }
    } catch (error) {
      stop('transport_failure', `manifest names a file that is not on disk: ${p}: ${error.message}`, TRANSPORT_FAILURE)
    }
    return abs
  }
  // The film never rides the transport (its keyframes carry the story), but it is a
  // required class of the generation — it must exist physically like every other file.
  inside(required.film)
  return {
    images: imageNames.map(inside),
    imageNames,
    references,
    meta: inside(required.meta),
    dom: inside(required.dom),
    console: inside(required.console),
  }
}

// W8-S2: the shared screen packet body — the LAW Perceptual rows the verb derived, the
// whole shipped instrument (the rows' dims select from it), the evidence text (meta +
// console verbatim, the DOM as a bounded excerpt), and the attachment naming so the
// grader knows what each `-i` image is. The sealed LAW lock rides as text only — the
// schema's law_hash belongs to the manifest digest.
function screenPacket(facts, generation, evidence) {
  const text = (file, label) => {
    try {
      return readFileSync(file, 'utf8')
    } catch (error) {
      stop('transport_failure', `screen could not read ${label}: ${error.message}`, TRANSPORT_FAILURE)
    }
  }
  return {
    law_lock_hash: facts.lockHash,
    generation: generation.number,
    perceptual_criteria: facts.rows,
    rubric: rubricFrom(PERCEPTUAL_RUBRIC),
    attached_images: evidence.imageNames,
    reference_images: evidence.references,
    meta: text(evidence.meta, 'meta.json'),
    console_log: text(evidence.console, 'console.log'),
    dom_excerpt: text(evidence.dom, 'dom.html').slice(0, SCREEN_DOM_EXCERPT_LIMIT),
  }
}

function validateShape(value, expectedReviewId, expectedLawHash, allowedFindingIds, location) {
  // Every family but screen pins findings to source as path:line; the screen family
  // passes SCREEN_LOCATION because its findings pin evidence files where a line
  // number does not exist. Absent, the default preserves the baseline byte-for-byte.
  const locationRule = location || { pattern: /^.+:\d+(?::\d+)?$/, message: 'location must be path:line' }
  if (!isObject(value)) return 'gate output must be a JSON object'
  const keys = Object.keys(value)
  const expectedKeys = ['review_id', 'law_hash', 'findings', 'blockers', 'verdict']
  if (keys.length !== expectedKeys.length || expectedKeys.some((key) => !keys.includes(key))) {
    return 'gate output fields do not match review-schema.json'
  }
  if (typeof value.review_id !== 'string' || value.review_id.trim() === '') return 'review_id must be a nonempty string'
  if (!LAW_HASH.test(value.law_hash)) return 'law_hash must be a lowercase SHA-256 hex digest'
  if (value.review_id !== expectedReviewId) return 'review_id does not match the issued review id'
  // Locked-LAW equality holds its baseline precedence — right here, after the
  // review_id match and before the findings/verdict checks — so the slice and recheck
  // paths stay byte-for-byte behavior-identical. Ratify grades a not-yet-sealed LAW
  // and omits expectedLawHash, so this is skipped and ratify asserts the artifact's
  // own candidate digest instead.
  if (expectedLawHash !== undefined && value.law_hash !== expectedLawHash) return 'law_hash does not match the locked LAW'
  if (!Array.isArray(value.findings) || !stringArray(value.blockers)) return 'findings and blockers must be arrays'
  if (value.blockers.some((blocker) => blocker.trim() === '')) return 'blockers must be nonempty strings'
  if (!['accept', 'changes_required', 'blocked'].includes(value.verdict)) return 'verdict is not recognized'

  const ids = new Set()
  const findingKeys = ['id', 'criterion', 'location', 'failure_mode', 'evidence', 'minimal_fix']
  for (const finding of value.findings) {
    if (!isObject(finding)) return 'each finding must be an object'
    const keys = Object.keys(finding)
    if (keys.length !== findingKeys.length || findingKeys.some((key) => !keys.includes(key))) {
      return 'finding fields do not match review-schema.json'
    }
    if (findingKeys.some((key) => typeof finding[key] !== 'string' || finding[key].trim() === '')) {
      return 'finding fields must be nonempty strings'
    }
    if (!locationRule.pattern.test(finding.location)) return `finding ${finding.id} ${locationRule.message}`
    if (ids.has(finding.id)) return `duplicate finding id ${finding.id}`
    if (allowedFindingIds && !allowedFindingIds.has(finding.id)) return `recheck introduced out-of-scope finding id ${finding.id}`
    ids.add(finding.id)
  }

  if (value.verdict === 'accept' && (value.findings.length !== 0 || value.blockers.length !== 0)) {
    return 'accept requires empty findings and blockers'
  }
  if (value.verdict === 'changes_required' && (value.findings.length === 0 || value.blockers.length !== 0)) {
    return 'changes_required requires nonempty findings and empty blockers'
  }
  if (value.verdict === 'blocked' && value.blockers.length === 0) {
    return 'blocked requires nonempty blockers'
  }
  return null
}

// W7-02: the audit verb-level shape rules, layered ON TOP of the shared validateShape —
// review-schema.json stays byte-untouched. Every blockers entry must equal a findings id,
// so a blocker always carries criterion, location and minimal_fix through its finding; a
// blocked verdict with empty findings has nothing behind its blockers and is invalid.
// Violations take the validateShape failure path: transport_failure, exit 20, and the
// verdict is never published.
function auditShapeInvalid(gate) {
  if (gate.verdict === 'blocked' && gate.findings.length === 0) {
    return 'audit blocked verdict requires findings carrying its blocker ids'
  }
  const findingIds = new Set(gate.findings.map((finding) => finding.id))
  const orphan = gate.blockers.find((blocker) => !findingIds.has(blocker))
  if (orphan !== undefined) return `audit blocker ${orphan} does not equal any finding id`
  return null
}

// W8-S2: the screen verb-level rules, layered on the shared validateShape —
// review-schema.json stays byte-untouched. A perceptual grade can never block: hard
// failure belongs to the deterministic proxies (a proxy red is a law red through
// check.sh), so a blocked verdict or any blocker is invalid here; and every finding
// must pin a LAW perceptual criterion id — the cross-family ownership key. Violations
// take the validateShape failure path: transport_failure, exit 20, never published.
function screenShapeInvalid(gate, criterionIds) {
  if (gate.verdict === 'blocked') return 'screen verdict must be accept or changes_required — hard failure belongs to the law proxies'
  if (gate.blockers.length !== 0) return 'screen blockers must be empty — hard failure belongs to the law proxies'
  const off = gate.findings.find((finding) => !criterionIds.has(finding.criterion))
  if (off !== undefined) return `finding ${off.id} criterion ${off.criterion} is not a LAW perceptual criterion id`
  return null
}

// W2-S7a (FORK 1): the transport + canonical-contract tail every codex prompt ends on. review_id and
// law_hash are TRANSPORT facts the reviewer echoes, never judged criteria; the receipt text rides
// verbatim for the receipt families (referenced by receipt_sha256 in the contract); the canonical
// contract is the SOLE authoritative block, embedded byte-exact so the digest publication binds covers
// exactly what the reviewer judged. The contract must remain the LAST block so a machine parse reads it
// cleanly, and the prose introduces no authoritative fact absent from it.
function contractTail(packet, contractBytes, receipt) {
  const transport = JSON.stringify({ review_id: packet.review_id, law_hash: packet.law_hash })
  const receiptBlock = receipt === undefined ? '' : `Kernel check receipt (executed kernel-side; the only execution evidence), verbatim:\n${receipt}\n`
  return `Echo these transport facts exactly in your output; they are not judged criteria: ${transport}\n${receiptBlock}Canonical contract:\n${contractBytes}\n`
}

// CE5 T3: the recheck scoping paragraph, defined ONCE. All four prompts carried it verbatim apart
// from the evidence they recheck against, so the words a reviewer is bound by lived in four places
// and could drift in three of them. The evidence noun is the only thing that legitimately differs.
const recheckScope = (against) => `\nRecheck only the listed finding_ids against ${against}. The prior findings are supplied in full in the packet as prior_findings — confirm each one resolved, or preserve its id unresolved. Preserve each unresolved finding ID. Do not discover, add, or reopen any other finding. Accept when every listed finding is repaired.\n`

function instructions(packet, contractBytes) {
  return `You are the terminal semantic gate reviewer. Inspect the repository at the working root and return only the schema-forced JSON object.

The canonical contract below carries the sealed, verified LAW as law_text and the slice under review as slice_id: scope law_text to slice_id and judge that slice against it — law_text is the sole authority for the criteria. builder_hints (criteria, paths, failures, commands) are the builder's non-authoritative notes; they may orient you but never narrow or override the law, and no finding derives from them. Report only substantiated criterion violations, never optional improvements. Creative direction, visual taste, and aesthetic choices belong to the builder — never raise them as a finding and never let them color a verdict; you rule on correctness against the locked criteria alone. For each finding, cite an exact repo-relative path:line location, the concrete failure, its evidence, and the smallest repair. Use stable finding IDs. The commands in check_receipt were already executed kernel-side; their full output rides in check_receipt verbatim. Read the repository freely — read-only file inspection (opening files, listing directories) is how you judge the diff against the law, and the sandbox enforces read-only. Beyond reading, execute nothing: no tests, no builds, no project or state-changing commands — rule with check_receipt as the only execution evidence. Receipt rows owned by slices not yet built in this run are expected pre-build evidence — judge only this slice's criteria, never treat them as findings, and never filter or rewrite the receipt. Do not infer authorship, persona, or another reviewer's verdict.

Copy review_id and law_hash exactly. Verdict rules: accept only when findings and blockers are both empty; changes_required only for one or more repairable findings with no blockers; blocked only when the review cannot be completed, with one or more blocker reasons.
${packet.mode === 'recheck' ? recheckScope('the repair_delta and current repository') : ''}
${contractTail(packet, contractBytes, packet.check_receipt)}`
}

function ratifyInstructions(packet, contractBytes) {
  return `You are the ratification reviewer. Grade the readable artifact below against the rubric and return only the schema-forced JSON object.

Judge the artifact against the rubric criteria alone. Report only substantiated criterion violations, never optional improvements and never matters of taste. For each finding, cite the artifact location as path:line, the concrete failure, evidence quoted from the artifact, and the smallest repair. Use stable finding IDs. Execute nothing: rule by reading the artifact text supplied in full below — do not inspect the repository and do not run any command.

Copy review_id and law_hash exactly into your output. law_hash is the sha256 digest of the artifact bytes; it seals the ratified content, so return it unchanged. Verdict rules: accept only when findings and blockers are both empty; changes_required only for one or more repairable findings with no blockers; blocked only when the review cannot be completed, with one or more blocker reasons.
${packet.mode === 'ratify-recheck' ? recheckScope('the regenerated artifact') : ''}
${contractTail(packet, contractBytes)}`
}

// W7-A1: the milestone audit prompt — review()'s prompt discipline, milestone-flavored
// instead of slice-flavored. The reviewer derives the milestone goal itself from LAW.md
// and the vision in-repo, judges goal-backward over the cumulative sealed prefix with
// focus on the closing block, pins LAW criterion ids and path:line locations, and
// executes nothing — the kernel-side check receipt rides the packet verbatim as the
// only execution evidence.
function auditInstructions(packet, contractBytes) {
  return `You are the milestone audit reviewer. Inspect the repository at the working root and return only the schema-forced JSON object.

Derive the milestone goal from .kiln/LAW.md and the vision documents in the repository, then judge goal-backward: over the cumulative sealed prefix in the audit packet, with focus on the closing block, check integrated reachability, the connections between slices, and delivery of the milestone goal. Report only substantiated criterion violations, never optional improvements. Creative direction, visual taste, and aesthetic choices belong to the builder — never raise them as a finding and never let them color a verdict. For each finding, pin the failed LAW criterion id in criterion and an exact repo-relative path:line in location, with the concrete failure, its evidence, and the smallest repair. Use stable finding IDs. The commands whose output rides in check_receipt were already executed kernel-side. Read the repository freely — read-only file inspection (opening files, listing directories) is how you judge the milestone against the law, and the sandbox enforces read-only. Beyond reading, execute nothing: no tests, no builds, no project or state-changing commands — rule with check_receipt as the only execution evidence. Do not infer authorship, persona, or another reviewer's verdict.

Copy review_id and law_hash exactly. Every blockers entry must equal the id of one of your findings, so each blocker carries its criterion, location, and minimal fix through that finding. Verdict rules: accept only when findings and blockers are both empty; changes_required only for one or more repairable findings with no blockers; blocked only when the audit cannot be completed or the milestone goal is undeliverable, with one or more blocker ids naming findings.
${packet.mode === 'audit-recheck' ? recheckScope('the repair_delta and current repository') : ''}
${contractTail(packet, contractBytes, packet.check_receipt)}`
}

// W8-S2: the perceptual grading prompt — the review family's discipline pointed at
// pixels. The reviewer judges ONLY the LAW Perceptual rows, each on its named rubric
// dim per the shipped anchors; insufficient evidence is a finding, never a blocker;
// and law_hash binds the grade to the evidence — the sha256 of the graded generation's
// manifest.json (the ratify-family artifact-digest precedent, atomic and in-schema).
function screenInstructions(packet, contractBytes) {
  return `You are the perceptual grading reviewer. The attached images are the evidence generation named in the packet — the two required viewports, then the labeled keyframes, then any reference images, in the packet's attached_images order. Grade the rendered surface and return only the schema-forced JSON object.

Judge ONLY the perceptual criteria rows in the packet, each on its named rubric dim per the shipped rubric's anchors — never any other dimension, and never general taste beyond what a row's requirement pins. Report only substantiated criterion violations. For each finding, pin criterion = the row's LAW perceptual criterion id and location = an evidence path with an optional :frame (for example viewport-mobile.png or film.webm:3), with the concrete failure, its visual evidence, and the smallest repair. Use stable finding IDs. Insufficient evidence on a dim is a finding citing the rubric's insufficient_evidence line as its evidence — never a blocker. Execute nothing and install nothing: rule from the attached images and the packet text alone.

Copy review_id and law_hash exactly — law_hash is the sha256 digest of the graded generation's manifest.json and binds this verdict to that evidence. Verdict rules: accept only when findings and blockers are both empty; changes_required for one or more repairable findings. Never return blocked and never write a blocker: hard failure belongs to the law's deterministic proxies, not to this grade.
${packet.mode === 'screen-recheck' ? recheckScope('the fresh evidence generation') : ''}${packet.mode === 'screen-escalate' ? '\nThis is a bounded second-family escalation of a held verdict: the packet carries ONLY the surviving criteria — grade them alone, on the same evidence generation; a finding on any other criterion invalidates the verdict.\n' : ''}
${contractTail(packet, contractBytes)}`
}

function classifyFailure(run) {
  if (run.error && ['ENOENT', 'EACCES', 'ENOEXEC'].includes(run.error.code)) return CODEX_UNAVAILABLE
  if (run.error) return TRANSPORT_FAILURE
  const stderr = run.stderr || ''
  const incompatibleCli = BROKEN_CODEX.test(stderr) && /Usage:\s+codex(?: exec)?\b/i.test(stderr)
  if ([126, 127].includes(run.status) || incompatibleCli) return CODEX_UNAVAILABLE
  return TRANSPORT_FAILURE
}

// The shared codex-gate core: spawn the schema-forced reviewer, classify any
// failure honestly, hand the returned gate to the caller's own validator, then
// publish it and exit on the verdict. The prompt and the validator are the only
// things the slice and ratify paths differ on — everything else is identical, so
// both flows converge here rather than duplicate the spawn and the exit mapping.
// W8-S2: the screen family adds bounded `-i` image attachments — absent, the argv
// is byte-identical to the baseline.
function runGate(repo, request, prompt, outputFile, validate, family, images, subject, contract, kilnDirArg) {
  const output = resolve(outputFile)
  // W2-S7a (F5): the trust root is EXPLICIT — every calling verb supplies its kilnDir, and the gate
  // output must sit directly under it. runGate derives the store/archive/manifest/receipt root from
  // dirname(output), so a gate written outside the supplied kilnDir would silently retarget every
  // trust-bearing write; that divergence HOLDs before any spawn, killing the implicit-selector class.
  if (resolve(dirname(output)) !== resolve(kilnDirArg)) {
    stop('transport_failure', 'runGate output path is not directly under the supplied kilnDir — refusing an implicit trust-root switch', TRANSPORT_FAILURE)
  }
  const temporary = join(dirname(output), `.gate-review.tmp-${process.pid}-${randomUUID()}`)
  const args = [
    'exec',
    '--ephemeral',
    '--sandbox', 'read-only',
    '--skip-git-repo-check',
    '-C', repo,
    '--model', request.reviewerModel,
    '-c', `model_reasoning_effort="${request.reviewerEffort}"`,
    '--output-schema', SCHEMA,
  ]
  for (const image of images || []) args.push('-i', image)
  args.push('-o', temporary, '-')
  const run = spawnSync('codex', args, {
    cwd: repo,
    input: prompt,
    encoding: 'utf8',
    maxBuffer: 4 * 1024 * 1024,
  })

  if (run.error || run.status !== 0) {
    discard(temporary)
    const code = classifyFailure(run)
    const detail = run.error ? run.error.message : (run.stderr || `codex exited ${run.status}`).trim().slice(-2000)
    stop(code === CODEX_UNAVAILABLE ? 'codex_unavailable' : 'transport_failure', detail, code)
  }
  if (!existsSync(temporary)) stop('transport_failure', 'codex produced no gate output', TRANSPORT_FAILURE)

  const gate = readJson(temporary, 'invalid codex gate output', temporary)
  const invalid = validate(gate)
  if (invalid) {
    discard(temporary)
    stop('transport_failure', invalid, TRANSPORT_FAILURE)
  }
  // W2-S7a (ruling A-prime): the codex reviewer identity is captured SYNCHRONOUSLY here — no
  // async workflow_progress resolution, because the concrete model was decided at spawn: the exact
  // string handed to --model IS resolved_model. W2-S7a (B-D1): requested_alias is now the DISTINCT
  // tiers fact the kernel threaded beside the model (request.reviewerAlias), never the resolved
  // value re-used, so the row records genuine provenance a later resolver change cannot muddy. The
  // codex output carries no reliable runtime model confirmation, so confirmation is a null the
  // ruling permits. W2-S7a (B-CODEX-ROLE): the role is the reviewer-class role of the invoking
  // family, so a codex leg validates by position exactly like a claude leg. A failed identity write
  // fails the gate closed exactly as a failed archive does.
  const kilnDir = dirname(output)
  const legId = randomBytes(16).toString('hex')
  const identityError = appendIdentityRow(kilnDir, {
    type: 'codex-identity', run_id: runIdFromLock(kilnDir), leg_id: legId, role: CODEX_ROLE[family],
    requested_alias: request.reviewerAlias, resolved_model: request.reviewerModel, source: 'argv',
    confirmation: null, subject: typeof subject === 'string' ? subject : '', ts: new Date().toISOString(),
  })
  if (identityError) {
    discard(temporary)
    stop('transport_failure', identityError, TRANSPORT_FAILURE)
  }
  // W2-S7a (FORK 3): the review family recomputes its control-derived manifest here — the SAME drift
  // gate the claude publish-gate path runs — before this codex verdict archives and publishes. subject
  // is the slice for the review family; other families carry no manifest (their subject is not a
  // slice), so the digest stays null. A drift or a capture fault discards the temp and holds closed,
  // exactly as a failed archive does.
  let manifestSha = null
  if (family === 'review') {
    const drift = manifestRecompute(kilnDir, repo, subject)
    if (drift.error) {
      discard(temporary)
      stop('transport_failure', drift.error, TRANSPORT_FAILURE)
    }
    manifestSha = drift.value.sha
  }
  // W2-S7a (FORK 1): store the composed contract CONTENT-ADDRESSED under this gate's kilnDir (the codex
  // reviewer already judged the identical bytes embedded in its prompt), then re-verify that store entry
  // before archive+rename — the SAME publication binding the claude publish-gate path runs. The write
  // and the verify share one kilnDir, so a torn store or a mismatched digest discards the temp and holds
  // closed, exactly as a failed archive does. A defensive null skips the binding for a caller that
  // composed nothing.
  let contractSha = null
  if (contract) {
    try {
      writeContractStore(kilnDir, contract.bytes, contract.sha)
    } catch (error) {
      discard(temporary)
      stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
    }
    const contractError = verifyContractStore(kilnDir, contract.sha)
    if (contractError) {
      discard(temporary)
      stop('transport_failure', contractError, TRANSPORT_FAILURE)
    }
    contractSha = contract.sha
  }
  // W2-S5 + W2-S7a (B-D2): the archive digests the EXACT bytes codex wrote, and the sidecar surfaces
  // the minted reviewer leg to the kernel over a trusted mechanical channel (<gate>.leg). The kernel
  // threads that leg into the seal reviewer position and append-seal re-validates it against
  // identity.jsonl, so the sidecar is a pointer the trust anchor still checks, never an authority.
  const failure = publishVerdict(kilnDir, family, readFileSync(temporary),
    { legId, manifestSha, contractSha, sidecar: { path: output + '.leg', bytes: legId + '\n' } }, temporary, output)
  if (failure) {
    discard(temporary)
    const wording = { archive: failure.message, sidecar: `could not write the reviewer leg sidecar: ${failure.message}`, rename: `could not publish gate output: ${failure.message}` }
    stop('transport_failure', wording[failure.step], TRANSPORT_FAILURE)
  }

  const exits = { accept: ACCEPT, changes_required: REJECT, blocked: BLOCKED }
  const facts = { accept: 'accept', changes_required: 'reject', blocked: 'blocked' }
  process.stdout.write(`${facts[gate.verdict]}\n`)
  process.exit(exits[gate.verdict])
}

function invoke(repo, kilnDir, request, packet, outputFile, allowedFindingIds) {
  // The reviewer never executes: the kernel side runs the law checks and writes the check receipt under
  // kilnDir before every gate call. The receipt rides the packet verbatim; a missing receipt is a broken
  // contract, never a license to execute. W2-S7a (F5): kilnDir is the EXPLICIT trust root the review verb
  // threads from argv — the receipt, the manifest, the contract store and the archive all key on it.
  let checkReceipt
  try {
    checkReceipt = readFileSync(join(kilnDir, 'check-receipt.txt'), 'utf8')
  } catch (error) {
    stop('transport_failure', `check receipt unreadable: ${error.message} — the kernel executes the checks and writes .kiln/check-receipt.txt before the gate call; the reviewer executes nothing`, TRANSPORT_FAILURE)
  }
  packet.check_receipt = checkReceipt
  // W2-S7a (FORK 1): compose and store the slice-review contract from the SAME sealed facts the packet
  // carries, plus the durable receipt digest and the digest-verified reviewed_manifest for the current
  // generation (an honest null on a legacy no-manifest slice). A torn manifest or contract store HOLDs.
  const receipt = receiptDigestAtPublication(kilnDir, 'review')
  if (receipt.error) stop('transport_failure', receipt.error, TRANSPORT_FAILURE)
  let contract
  try {
    contract = composeContract('slice-review', packet.mode === 'recheck' ? 'recheck' : 'initial',
      sliceReviewFacts(kilnDir, { ...packet, receipt_sha256: receipt.digest },
        { finding_ids: packet.finding_ids, prior_findings: packet.prior_findings, repair_delta: packet.repair_delta }))
  } catch (error) {
    stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
  }
  runGate(repo, request, instructions(packet, contract.bytes), outputFile, (gate) =>
    validateShape(gate, packet.review_id, packet.law_hash, allowedFindingIds), 'review', undefined, packet.slice_id, contract, kilnDir)
}

// W7-A1: the audit-family invoke — the SAME receipt gate as invoke() (the kernel runs
// the law checks and writes .kiln/check-receipt.txt before every gate call; the reviewer
// executes nothing; a missing receipt is a broken contract), then the shared runGate
// with the audit prompt and the audit verb-level shape rules layered on validateShape.
function invokeAudit(repo, kilnDir, request, packet, outputFile, allowedFindingIds) {
  let checkReceipt
  try {
    checkReceipt = readFileSync(join(kilnDir, 'check-receipt.txt'), 'utf8')
  } catch (error) {
    stop('transport_failure', `check receipt unreadable: ${error.message} — the kernel executes the checks and writes .kiln/check-receipt.txt before the gate call; the reviewer executes nothing`, TRANSPORT_FAILURE)
  }
  packet.check_receipt = checkReceipt
  // W2-S7a (FORK 1): compose and store the milestone-audit contract — the sealed facts the packet
  // carries, the durable receipt digest, and the coverage tuples over the sealed prefix (each covered
  // slice's last sealed generation and its manifest digest, null when legacy). A torn covered store HOLDs.
  // W2-S7a (F5): kilnDir is the explicit trust root the audit verb threads from argv.
  const receipt = receiptDigestAtPublication(kilnDir, 'audit')
  if (receipt.error) stop('transport_failure', receipt.error, TRANSPORT_FAILURE)
  let contract
  try {
    contract = composeContract('milestone-audit', packet.mode === 'audit-recheck' ? 'recheck' : 'initial',
      milestoneAuditFacts(kilnDir, { ...packet, receipt_sha256: receipt.digest },
        { finding_ids: packet.finding_ids, prior_findings: packet.prior_findings, repair_delta: packet.repair_delta }))
  } catch (error) {
    stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
  }
  runGate(repo, request, auditInstructions(packet, contract.bytes), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, packet.law_hash, allowedFindingIds)
    if (shape) return shape
    return auditShapeInvalid(gate)
  }, 'audit', undefined, packet.seam_slice, contract, kilnDir)
}

function repository(path) {
  try {
    const root = realpathSync(resolve(path))
    if (!statSync(root).isDirectory()) throw new Error('not a directory')
    return root
  } catch (error) {
    stop('transport_failure', `invalid repository: ${error.message}`, TRANSPORT_FAILURE)
  }
}

// W1-S2 (Defect B): the state-commit vocabulary. The kernel persisted STATE.md by
// handing a courier a bash heredoc that spelled out the whole ledger; a safety-tuned
// model reads that as forging a transition past validation and REFUSES, converting even
// honest holds into persist-failed. Here the courier speaks only closed words — a
// transition token, the stage, the slice, a next-action KEY, the density, and pointer
// paths — and this verb owns the document, the hint prose and the clock. The token names
// the transition kind (advance/seal-advance move forward, hold/degrade/boundary stop);
// an unsupported token, stage, key or density fails closed and nothing is written.
const STATE_TOKENS = new Set(['advance', 'seal-advance', 'hold', 'degrade', 'boundary'])
const STATE_STAGES = new Set(['law', 'build', 'validate', 'report'])
const STATE_SLICE_ID = /^[A-Za-z0-9._/-]+$/
// A pointer is a repo-relative path of safe characters only — no shell metacharacter,
// whitespace, or parent-escape rides the STATE.md pointers line or the courier argv.
const STATE_POINTER = /^[A-Za-z0-9._/-]+$/

// The next-action KEY table: each key resolves to one fixed operator hint, with the
// current stage and active slice filled in. relaunch-* name their own forward stage, so
// they ignore the current stage. An unknown key returns null and the verb fails closed.
function stateNextAction(key, stage, slice) {
  const hasSlice = slice !== 'none'
  switch (key) {
    case 'run-complete': return 'Run complete'
    case 'relaunch-law': return 'Relaunch the kernel workflow with stage=law'
    case 'relaunch-build': return 'Relaunch the kernel workflow with stage=build'
    case 'relaunch-validate': return 'Relaunch the kernel workflow with stage=validate'
    case 'relaunch-report': return 'Relaunch the kernel workflow with stage=report'
    case 'reopen-slice': return `Reopen slice ${slice}: LAW is red — relaunch stage ${stage}`
    case 'operator-ruling': return hasSlice
      ? `Operator ruling: the run is blocked for slice ${slice} — rule, then relaunch stage ${stage}`
      : `Operator ruling: the run is blocked — rule, then relaunch stage ${stage}`
    case 'restore-gate': return `Rerun stage ${stage} after restoring the gate tool`
    case 'restore-codex': return `Restore codex, then relaunch stage ${stage} — the second family is needed`
    case 'acknowledge-degrade': return `Acknowledge single-family degradation, then relaunch stage ${stage}`
    case 'repair-failed': return hasSlice
      ? `Rerun stage ${stage}: the repair pass did not land for slice ${slice}`
      : `Rerun stage ${stage}: the repair pass did not land`
    case 'rerun-onboarding': return `Rerun onboarding, then relaunch stage ${stage}`
    // A "Rerun stage X" hint names its TARGET stage, which may differ from the current
    // stage — a build with no slice list must return to the LAW producer, never rerun
    // build. rerun-stage stays as the same-stage fallback when no target is parsed.
    case 'rerun-law': return 'Rerun stage law'
    case 'rerun-build': return 'Rerun stage build'
    case 'rerun-validate': return 'Rerun stage validate'
    case 'rerun-report': return 'Rerun stage report'
    case 'rerun-stage': return `Rerun stage ${stage}`
    default: return null
  }
}

// W2-S2 (H6 / B02): the eight-line STATE.md rendered from a typed record. This is the ONE
// render template, shared by a fresh commit and by crash reconciliation, so the rendered view
// is byte-identical either way — the exact former stateDoc format, incl. `seals: .kiln/seals.log`.
function renderStateDoc(rec) {
  return [
    '# STATE',
    'stage: ' + rec.stage,
    'active_slice: ' + rec.active_slice,
    'next_action: ' + rec.next_action,
    'density: ' + rec.density,
    'pointers: ' + rec.pointers.join(' '),
    'seals: ' + rec.seals,
    'updated_at: ' + rec.updated_at,
  ].join('\n') + '\n'
}

// Crash reconciliation. state.json is written and renamed BEFORE STATE.md, so a crash between
// the two renames (or a torn/deleted STATE.md) leaves the rendered view lagging the canonical
// record. On the next trusted write we heal it FIRST: if STATE.md does not hash to the
// render_digest in the record, re-render it from the typed record before advancing — the drift is
// bounded to one write and the STATE.md-only conductor read never sees a torn document. A prior that
// cannot be re-rendered (missing fields) is left for the new commit below to overwrite whole.
function reconcileStateDoc(kilnDir, prior) {
  if (typeof prior.render_digest !== 'string') return
  const docPath = join(kilnDir, 'STATE.md')
  let current = null
  try {
    current = readFileSync(docPath)
  } catch {
    current = null
  }
  const currentDigest = current === null ? null : createHash('sha256').update(current).digest('hex')
  if (currentDigest === prior.render_digest) return
  let healed
  try {
    healed = renderStateDoc(prior)
  } catch {
    return
  }
  try {
    mkdirSync(kilnDir, { recursive: true })
    const temporary = join(kilnDir, `.STATE.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(temporary, healed)
    renameSync(temporary, docPath)
  } catch {
    // A failed heal is not fatal on its own — the STATE.md write in the new commit below is the
    // next chance to re-render the view from the canonical record.
  }
}

// ── W2-S1 (H2 / B01): the CONDUCTOR-OWNED run lock ──────────────────────────
// A per-RUN concurrency guard at .kiln/run.lock — deliberately distinct from the per-PLAN
// law/lock.hash attestation. The conductor acquires ONCE before the sweep and passes run_id
// plus an opaque owner token to every workflow; the workflows JOIN with the exact token,
// never a second acquire. The record is NEVER destroyed: release and a stale takeover both
// append it to run-history.jsonl before the live lock is replaced or removed, so the run
// record always survives somewhere durable.
const LOCK_FILE = 'run.lock'
const LOCK_HISTORY = 'run-history.jsonl'
const LOCK_DENIED = 12
// The availability-panel choices the lock record carries. The stored word has NO reader anywhere in
// the tree — every later boot re-decides from the two marker files — so it is a record of what was
// answered, not a switch. S10 wired the panel that produces it: the conductor passes follow-ladders
// at all four of its call sites, so in practice only that word is stored, while this set is what the
// verbs would accept.
const LOCK_CHOICES = new Set(['follow-ladders', 'stop-at-boundary', 'edit-ladders'])
// run_id and owner are minted as UUIDs; join/release/takeover echo them back over argv, so a
// closed token grammar rejects any shell metacharacter, whitespace, or control byte.
const LOCK_TOKEN = /^[A-Za-z0-9._-]+$/
// A takeover needs BOTH a dead holder pid AND a lock aged past this floor — never time alone.
// The floor clears the run-s4 resume window (the lock is far older than this by the resume)
// while staying short enough that a genuinely abandoned lock frees quickly.
const LOCK_AGE_FLOOR_MS = 5000

// The plugin version stamped into a fresh lock record — read from the shipped manifest,
// honest or fail-closed, never fabricated.
function pluginVersion() {
  try {
    const meta = JSON.parse(readFileSync(join(__dirname, '..', '.claude-plugin', 'plugin.json'), 'utf8'))
    return typeof meta.version === 'string' && meta.version.trim() !== '' ? meta.version : null
  } catch {
    return null
  }
}

// Read the lock record, distinguishing absent (no file) from present-but-unreadable (a torn
// or hand-broken lock): join and release refuse on either, and takeover refuses to prove an
// unreadable lock stale rather than steal it.
function readLockRecord(lockPath) {
  let raw
  try {
    raw = readFileSync(lockPath, 'utf8')
  } catch {
    return { exists: false, record: null }
  }
  try {
    const record = JSON.parse(raw)
    return { exists: true, record: isObject(record) ? record : null }
  } catch {
    return { exists: true, record: null }
  }
}

// The never-delete guarantee: append the full record plus the lock event and an archive
// timestamp to run-history.jsonl BEFORE the live lock is replaced or removed. A lock is never
// a bare unlink that loses the record.
function archiveLockRecord(kilnDir, record, event) {
  const row = JSON.stringify({ ...record, lock_event: event, archived_at: new Date().toISOString() })
  appendFileSync(join(kilnDir, LOCK_HISTORY), `${row}\n`)
}

// W2-S10: presence decided by PRESENCE, for the two sites S10 wires. lstat answers on shapes
// readFileSync cannot open — an unreadable file, a directory, a dangling link, a loop, a socket —
// where readLockRecord reports all of them as absent. The four S1 verbs keep their sealed
// fail-closed reads. THREE-valued deliberately: this returns absent for ENOENT and indeterminate for
// every other error, and both call sites route indeterminate to a hold ahead of the probe (two call
// sites, count-pinned). Two-valued was the same defect one line down from the one it cured.
function lockPresence(kilnDir) {
  try {
    lstatSync(join(kilnDir, LOCK_FILE))
    return 'present'
  } catch (error) {
    return error.code === 'ENOENT' ? 'absent' : 'indeterminate'
  }
}

// W2-S10 (10a) + S10d: the ONE marker removal here, serving both rulings a minting verb may issue —
// a `degraded` refuted live by the classifier that wrote it, and a `degraded-ack` with no detection
// under it, which is RESIDUE: a word with no subject, removed so no later detection can complete it
// into a pair the operator never spoke. Both are trust-bearing, so both leave a receipt: the row
// lands BEFORE the removal and a failed append HOLDs with the marker standing, the never-a-bare-
// unlink discipline archiveAndDrop keeps one screen up. Bounded: marker transitions do not generally
// earn rows, and the kernel clears of the same shape (clearPerceptualMarker at kernel.js:1185, the
// ratify candidate rm at :1431) stay rowless. ENOENT means a contender got there first — the same end
// state, so the rm is idempotent and races converge.
function clearMarker(kilnDir, verb, name, event) {
  try {
    archiveLockRecord(kilnDir, { marker: name, verb }, event)
  } catch {
    stop('transport_failure', `run-lock ${verb} could not record the ${event} ruling — the marker stands, nothing lost`, TRANSPORT_FAILURE)
  }
  try {
    unlinkSync(join(kilnDir, name))
  } catch (error) {
    if (error.code !== 'ENOENT') {
      stop('transport_failure', `run-lock ${verb} could not clear the ${name} marker: ${error.message}`, TRANSPORT_FAILURE)
    }
  }
}

// W2-S10: the availability probe the two MINTING verbs share. The two marker files differ by their
// WRITERS, counted over the whole shipped plugin rather than assumed (the S10 count-pin): FIVE sites
// touch `degraded` alone — kernel law ratify, milestone audit, degradedStop, the sweep feasibility
// ratify, and the builder card telling the agent to mark its own codex-absent build — while the
// single conductor touch is the only write of `degraded-ack` in the tree. So `degraded` is CLASSIFIED
// absence and the ack is the OPERATOR WORD. Both standing IS the word: mint, unquestioned. Otherwise
// the probe rules three ways — a clean exit 0 answers; a failure the REAL gate calls
// codex_unavailable panels; any other failure is unknown and mints, since the word has no remover
// but the operator hand and no low-fidelity detector may earn it. A detection with no word still
// steers the seats that read it, so the verbs rule it: an answer REFUTES it live — clear and go
// dual; anything less is a stop nobody answered — the panel. What that buys, stated as exactly what
// it is: a mint never completes over degraded-without-ack. Detections raised later in the run are
// each guarded where they are read, not here. join calls none of this (two call sites, pinned); it
// boots mid-run, already settled.
function refuseWithoutCodex(kilnDir, verb) {
  // Read as the other five readers read them (test -f): a REGULAR file, so a directory wearing a
  // marker name is absent here exactly as it is there, rather than a sixth detector disagreeing with
  // the five. A stat that FAILS is a different question, and only ENOENT proves absence — any other
  // failure holds, which is stricter than the five and never more permissive than them.
  const marker = (name) => {
    try {
      return statSync(join(kilnDir, name)).isFile()
    } catch (error) {
      if (error.code === 'ENOENT') return false
      stop('transport_failure', `run-lock ${verb} could not read the degradation marker ${name}: ${error.message}`, TRANSPORT_FAILURE)
    }
  }
  const detected = marker('degraded')
  // The fourth state: an ack with no detection under it. Inert to every reader — the defect is
  // COMPLETION, since a later detection would finish the pair and counterfeit a word nobody spoke.
  if (!detected && marker('degraded-ack')) clearMarker(kilnDir, verb, 'degraded-ack', 'ack_orphaned')
  if (detected && marker('degraded-ack')) return
  // SIGKILL, not the default TERM, or a binary that ignores TERM runs straight past the bound.
  const probe = spawnSync('codex', ['--version'], { encoding: 'utf8', timeout: 10000, killSignal: 'SIGKILL' })
  if (!probe.error && probe.status === 0) {
    // Cleared BEFORE the mint, never after: a crash in between would launch a run over the standing
    // stale marker. Clearing first leaves every crash state clean — marker gone, no lock, next
    // acquire mints dual — at the price that an invocation may clear and then LOSE the race. That
    // price is correct: the refutation is a fact about codex, not about who wins the lock.
    // BOTH markers are RE-READ here, after a probe that may have taken seconds. A word that landed
    // while it ran leaves the full pair standing and the verb mints under that acknowledged
    // degradation rather than destroying it; a detection that vanished while it ran leaves nothing
    // to refute, and a row asserting otherwise would be a receipt for a ruling never made. The
    // pre-probe read decides whether to ASK; only this read decides whether to ACT.
    if (marker('degraded') && !marker('degraded-ack')) clearMarker(kilnDir, verb, 'degraded', 'degradation_refuted')
    return
  }
  if (!detected && classifyFailure(probe) !== CODEX_UNAVAILABLE) return
  stop('codex_unavailable', `run-lock ${verb} refused: codex did not answer the availability probe and no acknowledged degradation stands — the availability panel rules first`, CODEX_UNAVAILABLE)
}

// ── W2-S5 (C3a / B05 / ruling 3): the immutable verdict archive ─────────────
// Every review family — build review, LAW ratify, feasibility ratify, milestone audit, and
// perceptual screen — publishes its verdict by renaming a candidate over the mutable gate file,
// a content-free overwrite that destroys the prior verdict. This ledger is the archive that
// overwrite never touches: every newly validated verdict is appended here BEFORE the rename, so
// the full reject/changes_required/blocked history of a repair→recheck→accept lineage survives
// the accept that lands. Ruling 3: the mutable gate files and all their readers are UNCHANGED —
// this is archive-only, never a P.gate split.
const REVIEWS_FILE = 'reviews.jsonl'
// The family is the review family the verdict belongs to, not the reviewer model family and not
// the seal's dual/single cohort (a per-seal fact unavailable at per-verdict publish time). The
// build gate and LAW ratify share one gate FILE, so the family is what tells their verdicts apart
// in the archive; feasibility keeps its own family though it reuses the ratify verb.
const REVIEW_FAMILIES = new Set(['review', 'ratify', 'feasibility', 'audit', 'screen'])

// run_id provenance: the CLI reads the CLI-owned run.lock ITSELF and trusts run_id ONLY from a
// record in the W2-S1 shape (run_id + owner in the LOCK_TOKEN grammar, a positive-integer
// conductor_pid). An absent, unreadable, or non-conforming lock records run_id honestly as null
// (a legacy launch), never a model-authorable string dressed as authoritative identity.
function runIdFromLock(kilnDir) {
  const lock = readLockRecord(join(kilnDir, LOCK_FILE)).record
  const conforms = isObject(lock)
    && typeof lock.run_id === 'string' && LOCK_TOKEN.test(lock.run_id)
    && typeof lock.owner === 'string' && LOCK_TOKEN.test(lock.owner)
    && Number.isInteger(lock.conductor_pid) && lock.conductor_pid > 0
  return conforms ? lock.run_id : null
}

// W2-S7a (B08 hash-block prerequisite / Sol ruling): the durable receipt digest, captured AT
// publication. The gate judged .kiln/check-receipt.txt, which is MUTABLE — a later slice reruns the
// checks and overwrites it — so the digest is taken here, at the archive, never reconstructed at
// seal. Only the review and audit families judge a receipt (the kernel runs check.sh into it before
// those gates); ratify grades an artifact against a rubric and screen grades pixels, so they judge
// NO receipt and their receipt digest is an honest null. A receipt-family verdict whose receipt is
// absent records null too (S7b prevents a full reviewed seal on a null digest — honest absence, not
// a fabricated hash). A PRESENT-but-unreadable receipt is untrusted and fails the archive closed,
// the unreadable-is-hold discipline sealMembers and writeProjectionIfStale already follow — never a
// digest that silently reads the anomaly as absence.
const RECEIPT_FAMILIES = new Set(['review', 'audit'])
function receiptDigestAtPublication(kilnDir, family) {
  if (!RECEIPT_FAMILIES.has(family)) return { digest: null }
  const path = join(kilnDir, 'check-receipt.txt')
  // lstat FIRST to tell genuine absence from present-but-unreadable (B002): a dangling symlink is
  // PRESENT (lstat stats the link itself and succeeds) yet its READ fails ENOENT — following that
  // ENOENT to a null digest would forge honest absence over a receipt that exists. lstat ENOENT is
  // the only genuinely-absent case; any other lstat fault, or a read fault after a successful lstat
  // (dangling symlink, EACCES, EISDIR), is present-but-unreadable and HOLDS.
  try {
    lstatSync(path)
  } catch (error) {
    if (error.code === 'ENOENT') return { digest: null }
    return { error: `archive could not stat the check receipt for its durable digest: ${error.message}` }
  }
  let bytes
  try {
    bytes = readFileSync(path)
  } catch (error) {
    return { error: `archive could not read the present check receipt for its durable digest: ${error.message}` }
  }
  return { digest: createHash('sha256').update(bytes).digest('hex') }
}

// Append the validated verdict to the archive, keyed idempotently by (family, review_id,
// verdict_sha256): a retry re-presenting the exact bytes appends nothing, so retries never create
// ambiguous rounds. The round is the COUNT of rows already in the lineage — its true position in
// that history, never a stateful counter a retry could advance. The complete verdict is preserved,
// plus the sha256 of the EXACT original bytes as the integrity digest. The run lock serializes runs,
// so appends never race. Returns null on success or an idempotent no-op, an error string otherwise,
// so the caller fails closed and never publishes an un-archived verdict.
// verdictBytes is the RAW Buffer of the bytes about to be renamed into the gate file, because the
// digest must bind THOSE bytes: hashing a utf8-decoded string would diverge on any byte that is not
// valid utf8 (decoded to U+FFFD, then re-encoded) and the archived digest would no longer cover what
// was published. The readable fields come from the parsed JSON — the archive content, not its
// integrity binding. The four bindings this row carries (receipt, reviewer leg, manifest, contract)
// each ride as their own field and are re-checked on a retry through the one ownership table below.

// The contract FACT SETS, each defined ONCE and fed to both transports. The codex verbs resolve
// their inputs from the packet they already built; contract-prepare resolves the same inputs from
// the sealed law and the request. The sources differ legitimately — the field SET must not, or a
// field added for one transport silently omits itself from the contract the other composes and
// judges. The recheck fields ride as an explicit tail so an initial contract carries none.
const sliceReviewFacts = (kilnDir, base, recheck) => ({
  slice_id: base.slice_id, law_hash: base.law_hash, law_text: base.law_text,
  builder_hints: base.builder_hints, receipt_sha256: base.receipt_sha256,
  reviewed_manifest: reviewedManifestForSlice(kilnDir, base.slice_id),
  ...(recheck || {}),
})
const milestoneAuditFacts = (kilnDir, base, recheck) => ({
  law_hash: base.law_hash, seam_slice: base.seam_slice, milestone: base.milestone,
  closing_block: base.closing_block, sealed_prefix: base.sealed_prefix,
  covered: coverageTuples(kilnDir, base.sealed_prefix), receipt_sha256: base.receipt_sha256,
  ...(recheck || {}),
})

// The ONE publication path both transports take. The gate-file overwrite is content-free and
// destroys the prior verdict, so the archive to the immutable ledger happens BEFORE the rename — the
// archive is the only surviving history, and a failed archive publishes nothing at all. The codex
// path additionally surfaces its minted reviewer leg as a sidecar beside the gate file, written
// before the rename so a sidecar fault fails the publish closed too. The ORDER is the invariant this
// helper exists to hold in one place; the caller words the fault and owns cleanup, because the codex
// path must discard its own temp while the claude path must leave the caller candidate untouched.
function publishVerdict(kilnDir, family, bytes, bindings, from, to) {
  const archiveError = archiveVerdict(kilnDir, family, bytes, bindings.legId, bindings.manifestSha, bindings.contractSha)
  if (archiveError) return { step: 'archive', message: archiveError }
  if (bindings.sidecar) {
    try {
      writeFileSync(bindings.sidecar.path, bindings.sidecar.bytes)
    } catch (error) {
      return { step: 'sidecar', message: error.message }
    }
  }
  try {
    renameSync(from, to)
  } catch (error) {
    return { step: 'rename', message: error.message }
  }
  return null
}

// The content-addressed COMMIT discipline the three durable stores share — baselines, prepared
// manifests, contracts. The name IS the digest, so the write is O_EXCL: an identical name is an
// idempotent no-op ONLY once its bytes are re-read and still hash to it, and a name colliding with
// foreign or corrupt bytes is a torn store that THROWS rather than silently accepting. A concurrent
// writer with different bytes therefore lands a different, inert name and can never overwrite a
// committed one. `what` and `store` name the fault in the words of each caller: a shared helper must
// not flatten an externally surfaced diagnostic, because a fault message is a contract line.
function commitContentAddressed(path, bytes, sha, what, store) {
  try {
    writeFileSync(path, bytes, { flag: 'wx' })
  } catch (error) {
    if (error.code !== 'EEXIST') throw error
    let existing
    try {
      existing = readFileSync(path)
    } catch (e) {
      throw new Error(`the ${what} could not be read: ${e.message}`)
    }
    if (createHash('sha256').update(existing).digest('hex') !== sha) {
      throw new Error(`a ${what} file does not match its own name — a torn ${store} store`)
    }
  }
}

// The append-only write discipline every JSONL ledger shares: a crash mid-append can leave a torn
// final line with no trailing newline, so a row is prefixed with one when the file is non-empty and
// does not end in one. Both the torn line and the new row then stay independently recoverable. The
// caller passes bytes it has already read, so this is a byte check rather than a re-read, and it
// returns the fault rather than deciding it — each ledger words its own failure and chooses whether
// to hold or report. Directory creation stays with the callers that need it, so no caller gains a
// mkdir it did not have.
function appendJsonlRow(path, raw, row) {
  const prefix = raw.length > 0 && !raw.endsWith('\n') ? '\n' : ''
  try {
    appendFileSync(path, prefix + JSON.stringify(row) + '\n')
    return null
  } catch (error) {
    return error.message
  }
}

function archiveVerdict(kilnDir, family, verdictBytes, reviewerLegId, manifestSha256, contractSha256) {
  if (!REVIEW_FAMILIES.has(family)) return `archive family ${family} is not a review family`
  let verdict
  try {
    verdict = JSON.parse(verdictBytes.toString('utf8'))
  } catch (error) {
    return `archive could not parse the verdict: ${error.message}`
  }
  if (!isObject(verdict) || typeof verdict.review_id !== 'string' || verdict.review_id.trim() === '') {
    return 'archive verdict carries no review_id'
  }
  const sha = createHash('sha256').update(verdictBytes).digest('hex')
  const path = join(kilnDir, REVIEWS_FILE)
  // Read the whole ledger once (absent = empty). A genuine IO fault (not ENOENT) fails closed, but a
  // single TORN line — a partial final append a crash left with no trailing newline, on an append-only
  // ledger that can never be deleted (never-delete) — must NEVER wedge the archive: an aborting parse
  // would hold every future gate publish forever. The scan skips an unparseable line rather than
  // aborting (the tolerant sealMembers degrade), and a skipped line never counts toward the round.
  let raw = ''
  try {
    raw = readFileSync(path, 'utf8')
  } catch (error) {
    if (error.code !== 'ENOENT') return `archive could not read the ledger: ${error.message}`
  }
  const lineage = []
  for (const line of raw.split('\n')) {
    if (line.trim() === '') continue
    let row
    try { row = JSON.parse(line) } catch { continue }
    if (isObject(row) && row.family === family && row.review_id === verdict.review_id) lineage.push(row)
  }
  // W2-S7a: read and validate the receipt the gate judged BEFORE any return — including the
  // idempotent-retry shortcut (B001). A present-but-unreadable receipt fails closed on EVERY publish,
  // so no verdict ever publishes with an untrusted digest.
  const receipt = receiptDigestAtPublication(kilnDir, family)
  if (receipt.error) return receipt.error
  // W2-S7a (FORK 1 ruling: publication REQUIRES the fresh receipt digest == the contract reference):
  // when a contract rides this publish, the receipt digest recomputed HERE must equal the receipt_sha256
  // the contract embedded when it was composed. A write-capable claude reviewer that overwrote
  // .kiln/check-receipt.txt during its turn (outside the FORK-3 manifest, invisible to the drift check)
  // would otherwise archive an incoherent {contract_sha256, receipt_sha256} composite. A non-receipt
  // kind (artifact-ratify, perceptual-screen) carries no receipt reference, so both sides are null; a
  // mismatch HOLDs closed with a distinct message on EVERY publish, before the retry shortcut too.
  if (typeof contractSha256 === 'string' && LAW_HASH.test(contractSha256)) {
    let contractBytes
    try {
      contractBytes = readFileSync(contractStoreFile(kilnDir, contractSha256))
    } catch (error) {
      return `archive could not read the contract for its receipt-coherence check: ${error.message}`
    }
    let contract
    try {
      contract = JSON.parse(contractBytes.toString('utf8'))
    } catch (error) {
      return `archive could not parse the contract for its receipt-coherence check: ${error.message}`
    }
    const contractReceipt = (isObject(contract) && Object.prototype.hasOwnProperty.call(contract, 'receipt_sha256')) ? contract.receipt_sha256 : null
    if (contractReceipt !== receipt.digest) {
      return 'archive: the fresh check-receipt digest no longer matches the receipt_sha256 the judged contract embedded — a receipt overwritten during the review would archive an incoherent contract-receipt binding'
    }
  }
  const prior = lineage.find((row) => row.verdict_sha256 === sha)
  if (prior !== undefined) {
    // A crash retry re-presents the exact verdict bytes. It is a safe no-op ONLY when the receipt on
    // disk NOW still matches the one archived — a retry over a receipt that changed, vanished, or
    // appeared (per the family rules a non-receipt family archives null and reads null, so they
    // match) would republish a STALE binding, so it HOLDS rather than green-republish (B001).
    // B001-R2 + B-RETRY-LEG + FORK 3 + FORK 1: every binding the row carries is preserved under ONE
    // ownership rule, so a new binding joins the table rather than growing a fourth copy of it. The
    // archived row must OWN the field (a MISSING field is not an archived null — it is a row written
    // before that binding existed, so nothing was ever captured to confirm the retry against), the
    // value must be WELL-FORMED (explicit null, or matching the field pattern), and it must EQUAL what
    // this retry supplies. Any of the three failing HOLDs rather than republishing: an exit 0 here
    // would sever a seal from the exact row it will join.
    const bindings = [
      ['receipt_sha256', receipt.digest, LAW_HASH, 'check receipt', 'the current check receipt no longer matches the archived digest — refusing to republish a stale receipt binding',
        'the archived row predates receipt capture or carries a malformed receipt_sha256 — nothing confirms the historical receipt binding, refusing to republish'],
      ['reviewer_leg_id', (typeof reviewerLegId === 'string' && LEG_ID.test(reviewerLegId)) ? reviewerLegId : null, LEG_ID, 'reviewer', 'the supplied reviewer leg differs from the archived reviewer binding — refusing to sever it'],
      ['manifest_sha256', (typeof manifestSha256 === 'string' && LAW_HASH.test(manifestSha256)) ? manifestSha256 : null, LAW_HASH, 'manifest', 'the supplied manifest digest differs from the archived manifest binding — refusing to sever it'],
      ['contract_sha256', (typeof contractSha256 === 'string' && LAW_HASH.test(contractSha256)) ? contractSha256 : null, LAW_HASH, 'contract', 'the supplied contract digest differs from the archived contract binding — refusing to sever it'],
    ]
    // Each row carries its OWN two messages. The table converges the RULE, never the wording: these
    // faults are read by callers and pinned by tests, so flattening them into one phrasing would be a
    // behaviour change wearing the clothes of a refactor.
    for (const [field, supplied, pattern, what, mismatch, unowned] of bindings) {
      const owns = Object.prototype.hasOwnProperty.call(prior, field)
      const archived = owns ? prior[field] : undefined
      const wellFormed = archived === null || (typeof archived === 'string' && pattern.test(archived))
      if (!owns || !wellFormed) {
        return `archive idempotent retry: ${unowned || `the archived row carries no well-formed ${field} — nothing confirms the historical ${what} binding, refusing to republish`}`
      }
      if (archived !== supplied) return `archive idempotent retry: ${mismatch}`
    }
    return null
  }
  const row = {
    family,
    review_id: verdict.review_id,
    round: lineage.length,
    verdict: verdict.verdict,
    findings: Array.isArray(verdict.findings) ? verdict.findings : [],
    blockers: Array.isArray(verdict.blockers) ? verdict.blockers : [],
    law_hash: verdict.law_hash,
    run_id: runIdFromLock(kilnDir),
    published_at: new Date().toISOString(),
    receipt_sha256: receipt.digest,
    reviewer_leg_id: (typeof reviewerLegId === 'string' && LEG_ID.test(reviewerLegId)) ? reviewerLegId : null,
    manifest_sha256: (typeof manifestSha256 === 'string' && LAW_HASH.test(manifestSha256)) ? manifestSha256 : null,
    contract_sha256: (typeof contractSha256 === 'string' && LAW_HASH.test(contractSha256)) ? contractSha256 : null,
    verdict_sha256: sha,
  }
  const appendError = appendJsonlRow(path, raw, row)
  if (appendError) return `archive could not append the verdict: ${appendError}`
  return null
}

// ── W2-S6 (C3b / B06 / B09): the attestation ledger core ────────────────────
// seals.jsonl and audits.jsonl are the append-only TYPED truth; seals.log and audits.log are the
// CURRENT-VALID rendered projection the kernel reads for membership (ruling 4 keeps membership on
// the .log, JSONL parsing deferred to W4). append-seal/append-audit append the JSONL row THEN
// re-render the whole .log from the JSONL as one atomic temp+rename, so a torn .log never
// accumulates. reconcile heals a crash between the JSONL append and the .log render, and migrates a
// W1 project whose .log predates the JSONL. Every JSONL row renders in
// append order (the plan/seam order the appends already carry — A03); W2-S7b turns that render into
// the full state reduction below, where cutoffs and coverage decide what is still current.
const SEAL_LEDGER = { jsonl: 'seals.jsonl', log: 'seals.log', type: 'seal' }
const AUDIT_LEDGER = { jsonl: 'audits.jsonl', log: 'audits.log', type: 'audit' }

// The closed family-label set a FRESH seal or audit row carries — exactly what append-seal and
// append-audit validate on write, so a real fresh row always conforms. A migrated legacy row is
// exempt: it preserves the verbatim W1 record, whose oldest forms carry no label (a bare-slice
// seals.log line, a pre-S4-D4 two-field `<seam> accept` audit line).
const LEDGER_LABELS = new Set(['dual', 'single-family'])

// One projection line for a CONFORMING ledger row — the EXACT legacy grammar, so every rendered
// .log is byte-identical to what the old append wrote: a seal is `<slice> <label>`, an audit is
// `<seam> accept <label>` (the S4-D4 third field, absent on a pre-S4-D4 legacy audit). Returns null
// for a row that does NOT conform to THIS ledger's S6 schema — a wrong-type row (a seal in the audit
// ledger or an audit in the seal ledger), an audit whose outcome is not the sealed `accept`, or a
// FRESH row without a conforming {dual, single-family} label (the label-less form is legitimate ONLY
// for a migrated legacy:true row, so it never leaks to a fresh row as a two-field audit or a
// trailing-space seal). A non-conforming row is a membership ANOMALY (corruption or a future-bug
// row), never a torn line (a torn line marks the JSONL read incomplete); the reduction HOLDS on the
// null. The S7b event rows (promote, invalidate) are handled by the reduction before they reach here.
function ledgerProjectionLine(descriptor, row) {
  if (!isObject(row) || row.type !== descriptor.type) return null
  const legacy = row.legacy === true
  if (descriptor.type === 'seal') {
    if (typeof row.slice !== 'string' || row.slice === '') return null
    // A legacy seal keeps its W1 form: a labelled line renders `<slice> <label>`, a bare-slice line
    // `<slice>`. A fresh seal must carry a conforming label and always renders `<slice> <label>`.
    if (legacy) return typeof row.label === 'string' && row.label !== '' ? row.slice + ' ' + row.label : row.slice
    return LEDGER_LABELS.has(row.label) ? row.slice + ' ' + row.label : null
  }
  if (typeof row.seam !== 'string' || row.seam === '' || row.outcome !== 'accept') return null
  // A legacy audit keeps its W1 form: a three-field line renders `<seam> accept <label>`, a
  // pre-S4-D4 two-field line `<seam> accept`. A fresh audit must carry a conforming label.
  if (legacy) return typeof row.label === 'string' && row.label !== '' ? row.seam + ' accept ' + row.label : row.seam + ' accept'
  return LEDGER_LABELS.has(row.label) ? row.seam + ' accept ' + row.label : null
}

// ── W2-S7b: the modern candidate shape ──────────────────────────────────────
// The closed attestation kinds a MODERN candidate carries. The kind IS the whole no-review reason,
// which is what makes a verdictless seal distinguishable on the wire from a reviewed one (D3) — so a
// verdictless candidate may never carry a review reference, a reviewer leg or a contract, and a
// reviewed candidate always carries the immutable reference that binds its four captures.
const SEAL_KINDS = new Set(['reviewed', 'verdictless-degraded-ui'])
const AUDIT_KINDS = new Set(['reviewed'])
const trioBlockInvalid = (v) => !isObject(v) || Object.keys(v).length !== TRIO_MEMBERS.length || !TRIO_MEMBERS.every((n) => LAW_HASH.test(v[n]))

// The ordered coverage a reviewed audit candidate stores: one {slice, generation, manifest_sha256}
// tuple per covered member, in verified-prefix order — exactly the shape currentSealTuple mints, so
// a canonical digest comparison decides currency without a byte-exact array compare.
// Each covered name is held to STATE_SLICE_ID, the one slice-id grammar the whole system speaks. A
// nonempty-string check was too loose to be honest coverage: a name outside the grammar can never be
// a slice any build sealed, and a name carrying a delimiter makes the coverage AMBIGUOUS wherever it
// is serialized — one slice named `a,b` is otherwise indistinguishable from the two slices a and b.
function coverageInvalid(covered) {
  if (!Array.isArray(covered) || covered.length === 0) return true
  return covered.some((t) => !isObject(t)
    || Object.keys(t).length !== 3
    || typeof t.slice !== 'string' || !STATE_SLICE_ID.test(t.slice)
    || !Number.isSafeInteger(t.generation) || t.generation < 0
    || !(t.manifest_sha256 === null || LAW_HASH.test(t.manifest_sha256)))
}

// The FIELD LAW of a modern candidate, enforced at the append AND again in the reduction — a row is
// trusted through this ONE function, so a hand-written candidate can never buy the membership the
// append verb would have refused. A legacy-shaped row (no attestation_kind) has no field law here;
// the reduction rejects it only AFTER the modern-shape boundary.
// The FIELDS item 8 forbids on a verdictless candidate: its whole point is that NO review stands
// behind it, so a row claiming any part of one is a contradiction, whatever value it carries. The law
// is literal ABSENCE, not an absent-looking value — a null reviewer leg is still a reviewer-leg claim.
const VERDICTLESS_FORBIDDEN = ['family', 'review_id', 'verdict', 'contract', 'contract_sha256', 'review_ref', 'reviewer_leg_id']
const hasField = (row, name) => Object.prototype.hasOwnProperty.call(row, name)

function candidateShapeInvalid(descriptor, row) {
  const kind = row.attestation_kind
  if (kind === undefined) return null
  const kinds = descriptor.type === 'seal' ? SEAL_KINDS : AUDIT_KINDS
  if (typeof kind !== 'string' || !kinds.has(kind)) return 'carries an attestation kind outside the closed set for this ledger'
  if (kind === 'verdictless-degraded-ui') {
    if (row.label !== 'single-family') return 'is verdictless and must carry the single-family label'
    if (VERDICTLESS_FORBIDDEN.some((name) => hasField(row, name))) return 'is verdictless and must carry no review, verdict, contract or reviewer-leg field at all'
    if (trioBlockInvalid(row.trio_sha256)) return 'is verdictless and must carry the three live trio digests'
    if (!LAW_HASH.test(row.receipt_sha256)) return 'is verdictless and must carry the current receipt digest'
    if (!LAW_HASH.test(row.manifest_sha256)) return 'is verdictless and must carry its recomputed manifest digest'
    if (!Array.isArray(row.builder_leg_ids) || row.builder_leg_ids.length === 0 || !row.builder_leg_ids.every((id) => typeof id === 'string' && LEG_ID.test(id))) {
      return 'is verdictless and must carry its complete builder identities'
    }
    return null
  }
  // The reference is family-SPECIFIC: a seal is attested by a slice review and an audit by a
  // milestone audit, never by whatever other family happened to publish an accept. It also names the
  // identity that reviewed — that leg is what promotion waits on, so a reference without it would let
  // membership land while the reviewer it claims is still an unresolved intent.
  const ref = row.review_ref
  if (!isObject(ref)
    || ref.family !== (descriptor.type === 'seal' ? 'review' : 'audit')
    || typeof ref.review_id !== 'string' || ref.review_id.trim() === ''
    || !LAW_HASH.test(ref.verdict_sha256)
    || typeof ref.reviewer_leg_id !== 'string' || !LEG_ID.test(ref.reviewer_leg_id)) {
    return 'is reviewed and must carry an immutable reference naming the family, review_id, verdict digest and reviewer identity of its own ledger'
  }
  if (descriptor.type === 'audit') {
    if (coverageInvalid(row.covered)) return 'is a reviewed audit and must carry its validated ordered coverage'
    // Generation 0 is how a current tuple says ABSENT — the reduction must refuse it here too, or a
    // covered-versus-current comparison of two absences would render an audit over a prefix nothing
    // seals (both sides equal, both sides empty).
    if (row.covered.some((tuple) => tuple.generation < 1)) return 'is a reviewed audit and must not cover a slice at no generation'
  }
  return null
}

// One invalidate event — the ONE atomic batch cutoff both reopen and milestone rejection append.
// Every target names a slice and the ordinal THROUGH which its candidates are excluded. A malformed
// event is a membership anomaly the reduction HOLDs on: a cutoff misread as absent would resurrect
// an invalidated seal, the exact failure D1 and D2 exist to prevent.
function invalidateInvalid(row) {
  if (!Array.isArray(row.targets) || row.targets.length === 0) return true
  return row.targets.some((t) => !isObject(t)
    || typeof t.slice !== 'string' || t.slice === ''
    || !Number.isSafeInteger(t.through_generation) || t.through_generation < 1)
}

// Reduce one ledger to its CURRENT state (W2-S7b items 1-3). Three event classes join the
// candidates: a promote row confers membership on its provisional candidate (S7a); an invalidate row
// carries the batch cutoff; every other row is a candidate. A candidate GENERATION is its 1-based
// POSITIONAL ordinal among the candidates of its key — legacy and provisional candidates COUNT,
// events never do — so an ordinal is never reused and a cutoff excludes every candidate at or below
// it, rendered or provisional. Current membership is the SOLE latest eligible candidate, rendered
// only when non-provisional or validly promoted, so an older seal can never resurrect behind a
// fresher one. An audit is current only when it is finalized AND its stored coverage equals the
// CURRENT seal tuples (a legacy audit carrying no coverage goes inactive after any seal cutoff) —
// derived, never stored, so no cross-ledger partial write can leave a stale audit standing. Any
// non-conforming row is a membership anomaly the reduction HOLDs on rather than drop (which could
// hide a real seal) or misrender (A02).
function reduceLedger(kilnDir, descriptor, read) {
  const anomaly = (why) => stop('transport_failure', `${descriptor.jsonl} ${why} — a membership anomaly; the reduction holds rather than drop or misrender it`, TRANSPORT_FAILURE)
  const promoted = new Set()
  const provisionalIds = new Set()
  const cutoffs = new Map()
  const groups = new Map()
  const order = []
  let modern = false
  for (const row of read.rows) {
    if (!isObject(row)) anomaly('carries a row that is not an object')
    if (row.type === 'promote') {
      if (typeof row.candidate_id !== 'string' || row.candidate_id === '') anomaly('carries a promote row with no candidate id')
      promoted.add(row.candidate_id)
      continue
    }
    if (row.type === 'invalidate') {
      if (descriptor.type !== 'seal') anomaly('carries an invalidate event outside the seal ledger')
      if (invalidateInvalid(row)) anomaly('carries a malformed invalidate event')
      // A cutoff DELETES membership, so the reduction validates every target against the history that
      // existed WHEN THE EVENT LANDED — the candidates seen so far, at this position in the ledger.
      // A target naming a slice with no candidate yet, or a cutoff above the ordinals that existed,
      // is not a validated cutoff: honouring it would let one malformed event withdraw membership no
      // candidate ever had, and would silently cover candidates appended after it.
      const named = new Set()
      for (const target of row.targets) {
        if (named.has(target.slice)) anomaly('carries an invalidate event naming one slice twice')
        named.add(target.slice)
        const history = groups.get(target.slice)
        if (history === undefined) anomaly('carries an invalidate event for a slice with no candidate history at that point')
        if (target.through_generation > history.length) anomaly('carries an invalidate event whose cutoff is above the candidates that existed when it landed')
        cutoffs.set(target.slice, Math.max(cutoffs.get(target.slice) ?? 0, target.through_generation))
      }
      modern = true
      continue
    }
    const line = ledgerProjectionLine(descriptor, row)
    if (line === null) anomaly(`carries a row that does not conform to the ${descriptor.type} ledger schema`)
    const shape = candidateShapeInvalid(descriptor, row)
    if (shape) anomaly(`carries a candidate that ${shape}`)
    // The legacy boundary is IMPLICIT, not versioned: the first valid S7b-shaped event — an
    // invalidate, or a candidate carrying an explicit attestation kind — is the modern boundary, and
    // a legacy-shaped candidate appearing after it is a downgrade the reduction refuses to trust.
    if (row.attestation_kind === undefined) {
      if (modern) anomaly('carries a legacy-shaped candidate after its modern-shape boundary')
    } else modern = true
    if (row.provisional === true) {
      if (typeof row.candidate_id !== 'string' || row.candidate_id === '') anomaly('carries a provisional candidate with no candidate id')
      provisionalIds.add(row.candidate_id)
    }
    const key = descriptor.type === 'seal' ? row.slice : row.seam
    if (!groups.has(key)) { groups.set(key, []); order.push(key) }
    const bucket = groups.get(key)
    bucket.push({ row, line, generation: bucket.length + 1 })
  }
  for (const id of promoted) {
    if (!provisionalIds.has(id)) anomaly('carries a promote row for no provisional candidate')
  }
  const finalized = (candidate) => candidate.row.provisional !== true || promoted.has(candidate.row.candidate_id)
  const seals = descriptor.type === 'audit' ? sealState(kilnDir) : null
  const carriesCoverage = (row) => Object.prototype.hasOwnProperty.call(row, 'covered')
  const auditCurrent = (row) => {
    if (!carriesCoverage(row)) return seals.cutoffs.size === 0
    // Malformed coverage on ANY row is an ANOMALY, never a quiet not-current. The field law above
    // validates coverage only on a row that DECLARES its attestation kind, so a kindless pre-boundary
    // row can still carry a covered field and reach here; answering false would drop it into the
    // no-member answer, and a caller reads that as PROVEN ABSENCE. Coverage that cannot be read has
    // not been judged stale — it has not been judged at all, so the reduction holds on it.
    if (coverageInvalid(row.covered)) anomaly('carries an audit candidate whose coverage cannot be read — unreadable coverage is never judged current, and reporting it as absent would answer for a seam nothing covered')
    return canonicalDigest(row.covered) === canonicalDigest(row.covered.map((t) => currentSealTuple(seals, kilnDir, t.slice)))
  }
  const members = []
  const reasons = new Map()
  const current = new Map()
  let candidateCount = 0
  for (const key of order) {
    const bucket = groups.get(key)
    candidateCount += bucket.length
    if (descriptor.type === 'seal') {
      const eligible = bucket.filter((candidate) => candidate.generation > (cutoffs.get(key) ?? 0))
      if (eligible.length === 0) { reasons.set(key, 'cutoff'); continue }
      const latest = eligible[eligible.length - 1]
      if (!finalized(latest)) { reasons.set(key, 'provisional'); continue }
      members.push(latest)
      current.set(key, latest)
      continue
    }
    const settled = bucket.filter(finalized)
    // Item 3, no resurrection: a coverage-less candidate answers for a seam only while nothing has
    // SUPERSEDED it. Once a LATER settled candidate for this seam carries coverage, the older row is
    // spent — without this, the moment that later audit went stale the reduction would walk backward
    // and re-elect it, and a coverage-less row would then permanently mask the staleness of every
    // audit after it, leaving the seam rendering as audited over a prefix nothing valid ever covered.
    // Chronological supersession only: cutoffs are the OTHER deactivator (they are sufficient, not
    // necessary), and nothing here reaches for one.
    const lastCovered = settled.map((candidate) => carriesCoverage(candidate.row)).lastIndexOf(true)
    const eligible = settled.filter((candidate, position) => carriesCoverage(candidate.row) || position > lastCovered)
    const member = [...eligible].reverse().find((candidate) => auditCurrent(candidate.row))
    if (member === undefined) { reasons.set(key, settled.length > 0 ? 'coverage' : 'provisional'); continue }
    members.push(member)
    current.set(key, member)
  }
  return {
    // An audit reduction is only as complete as the SEAL read it derived its currency from: a hole in
    // the seal truth could mark a live audit inactive, so that incompleteness rides along. The two
    // are reported separately as well as combined, so each refusal names the ledger that actually
    // has the hole rather than inheriting the other guards answer.
    complete: read.complete && (seals === null || seals.complete),
    derived: seals === null || seals.complete,
    modern,
    projection: members.length ? members.map((member) => member.line).join('\n') + '\n' : '',
    candidateCount,
    cutoffs,
    groups,
    promoted,
    reasons,
    current,
  }
}

// Seals reduce FIRST, audits second: audit currency is DERIVED from the seal state, so every audit
// reduction resolves the seal ledger through this one entry. An absent seal ledger is an honest
// empty state (no cutoff, no current member), never a hold — a project may audit nothing yet.
function sealState(kilnDir) {
  const read = readLedgerRows(join(kilnDir, SEAL_LEDGER.jsonl))
  return reduceLedger(kilnDir, SEAL_LEDGER, read === null ? { rows: [], complete: true } : read)
}

// The SOLE current tuple for a slice (W2-S7b item 5): its current rendered generation and that
// generations manifest digest, derived from the reduction. A slice with NO current rendered member —
// unsealed, invalidated, or holding only an unpromoted provisional — is an honest generation 0 with a
// null manifest. A HISTORICAL row count may never author coverage, which is why nothing here counts
// rows. A torn manifest store HOLDs through coveredManifestDigest.
function currentSealTuple(seals, kilnDir, slice) {
  const member = seals.current.get(slice)
  if (member === undefined) return { slice, generation: 0, manifest_sha256: null }
  return { slice, generation: member.generation, manifest_sha256: coveredManifestDigest(kilnDir, slice, member.generation) }
}

// Parse the append-only JSONL truth into rows WITH its completeness (W2-S7b item 4). A line that
// does not parse — a torn final fragment a crash left, or a corrupt interior line — is never a
// silent skip: it marks the read INCOMPLETE, and neither a membership-affecting append nor a
// withdrawal of rendered membership may proceed from input the reduction could not fully see. The
// surviving rows still render, so one torn byte never wedges every future projection.
function parseLedger(raw) {
  const rows = []
  let complete = true
  for (const line of raw.split('\n')) {
    if (line.trim() === '') continue
    let row
    try { row = JSON.parse(line) } catch { complete = false; continue }
    rows.push(row)
  }
  return { rows, complete }
}

// Read the JSONL truth. Returns null when the file is ABSENT (the caller then considers a W1
// migration), distinct from present-but-empty; a genuine IO fault other than ENOENT THROWS.
function readLedgerRows(path) {
  let raw = ''
  try {
    raw = readFileSync(path, 'utf8')
  } catch (error) {
    if (error.code === 'ENOENT') return null
    throw error
  }
  return parseLedger(raw)
}

// Re-render the .log from the rows as one atomic temp+rename, but ONLY when the current .log differs
// — a matching projection (the common reconcile no-op, and every byte-exact migration) is left
// untouched so no spurious write churns the file.
function writeProjectionIfStale(kilnDir, descriptor, reduction) {
  const projection = reduction.projection
  const logPath = join(kilnDir, descriptor.log)
  let current = null
  try {
    current = readFileSync(logPath, 'utf8')
  } catch (error) {
    // ENOENT is a legitimately absent .log (a fresh project). ANY other error — EACCES on a
    // chmod-000 log, EISDIR, a genuine IO fault — is an UNREADABLE membership log, and unreadable is
    // UNTRUSTED: coercing it to null would let the wipe-guard read it as absent, skip the hold, and
    // the kernel would then judge membership over a log it could not read. Hold fail-closed instead,
    // mirroring readLedgerRows and the S3 sealMembers "unreadable ledger = HOLD" discipline.
    if (error.code !== 'ENOENT') {
      stop('transport_failure', `${descriptor.log} could not be read — an unreadable membership log is untrusted; reconcile holds rather than judge it absent`, TRANSPORT_FAILURE)
    }
    current = null
  }
  if (current === projection) return
  // A zero-row projection is legitimate ONLY for a genuinely empty ledger — a fresh project with no
  // .log yet writes nothing, so reconcile never creates an empty seals.log a scenario poll would
  // misread.
  if (projection === '' && current === null) return
  // W2-S7b (item 4): membership is only ever WITHDRAWN with a reason. Any member the .log still
  // claims that the new projection does not carry must be proven inactive by a validated cutoff or by
  // derived coverage invalidity, over a COMPLETE read — otherwise the overwrite silently drops sealed
  // work and the next boot rebuilds it, the exact B09 failure the ledger exists to prevent. An
  // unpromoted provisional explains nothing (its candidate may still promote), a torn or anomalous
  // read explains nothing, and a member the truth never knew explains nothing — each HOLDs. Members
  // are compared by their FIRST FIELD, the membership anchor, so a row that merely changed its family
  // label is not a withdrawal.
  // WHY completeness gates THIS branch and not the whole overwrite (ruled, do not re-raise): a crash
  // between the JSONL append and the .log render leaves exactly an incomplete read, and excluding that
  // torn tail is the CORRECT projection — the row never became durable. Gating every write on
  // completeness would turn each crash-mid-append into a permanent hold instead of the heal reconcile
  // exists to perform. Incompleteness is disqualifying only where it could COST membership, which is
  // this branch.
  const membersOf = (text) => (text === null ? [] : text.split('\n').filter((line) => line !== '').map((line) => line.split(' ')[0]))
  const carried = new Set(membersOf(projection))
  const withdrawn = membersOf(current).filter((key) => !carried.has(key))
  if (withdrawn.length > 0) {
    const explained = reduction.complete && reduction.candidateCount > 0 && withdrawn.every((key) => {
      const why = reduction.reasons.get(key)
      return why === 'cutoff' || why === 'coverage'
    })
    if (!explained) {
      stop('transport_failure', `${descriptor.log} claims members its JSONL truth no longer renders, and no validated cutoff or coverage change accounts for them — refusing to withdraw sealed membership`, TRANSPORT_FAILURE)
    }
  }
  mkdirSync(kilnDir, { recursive: true })
  const temporary = join(kilnDir, '.' + descriptor.log + '.tmp-' + process.pid + '-' + randomUUID())
  writeFileSync(temporary, projection)
  renameSync(temporary, logPath)
}

// Parse one legacy .log line into a LEGACY-marked typed row for the W1->W2 migration (B09). The
// readable fields are recovered; run_id and ts are honestly ABSENT (a legacy line records neither),
// never fabricated. legacy:true lets S7 require re-verification before conferring full-trust
// attestation; for S6 the row still renders and still grants membership, preserving the exact W1
// resume behaviour the migration must never rebuild.
function legacyLedgerRow(descriptor, line) {
  if (descriptor.type === 'seal') {
    const space = line.indexOf(' ')
    return space === -1
      ? { type: 'seal', slice: line, label: '', legacy: true }
      : { type: 'seal', slice: line.slice(0, space), label: line.slice(space + 1), legacy: true }
  }
  const tokens = line.split(' ')
  const row = { type: 'audit', seam: tokens[0], outcome: tokens[1] !== undefined ? tokens[1] : 'accept', legacy: true }
  if (tokens[2] !== undefined) row.label = tokens[2]
  return row
}

// W1->W2 migration (B09). A nonempty legacy .log with no JSONL is a project sealed before the
// ledger existed: import each line as a legacy row so the JSONL becomes the truth WITHOUT rebuilding
// sealed work or fabricating hashes. Written atomically; an absent or empty legacy .log migrates
// nothing (there is no sealed record to preserve).
function migrateLegacyLog(kilnDir, descriptor) {
  let legacy = ''
  try {
    legacy = readFileSync(join(kilnDir, descriptor.log), 'utf8')
  } catch (error) {
    if (error.code === 'ENOENT') return
    throw error
  }
  if (legacy.trim() === '') return
  const rows = []
  for (const line of legacy.split('\n')) {
    if (line === '') continue
    rows.push(legacyLedgerRow(descriptor, line))
  }
  const body = rows.map((row) => JSON.stringify(row) + '\n').join('')
  mkdirSync(kilnDir, { recursive: true })
  const temporary = join(kilnDir, '.' + descriptor.jsonl + '.tmp-' + process.pid + '-' + randomUUID())
  writeFileSync(temporary, body)
  renameSync(temporary, join(kilnDir, descriptor.jsonl))
}

// Reconcile one ledger: the JSONL is truth. Present -> re-render the .log from it if stale. Absent
// -> migrate a legacy .log into JSONL first (a W1 project), then render. Idempotent: a second call
// finds the JSONL present and the .log already matching, and writes nothing. A genuine IO fault
// fails closed through stop so a caller never advances on an unreconciled ledger.
function reconcileLedger(kilnDir, descriptor) {
  try {
    let read = readLedgerRows(join(kilnDir, descriptor.jsonl))
    if (read === null) {
      migrateLegacyLog(kilnDir, descriptor)
      read = readLedgerRows(join(kilnDir, descriptor.jsonl))
      if (read === null) return
    }
    writeProjectionIfStale(kilnDir, descriptor, reduceLedger(kilnDir, descriptor, read))
  } catch (error) {
    stop('transport_failure', `reconcile could not heal the ${descriptor.log} projection: ${error.message}`, TRANSPORT_FAILURE)
  }
}

// W2-S7b (item 2): every membership-affecting operation reduces SEALS FIRST, AUDITS SECOND. Audit
// currency is derived from the seal state, so an audit rendered before its seals would publish a
// judgement one step stale — a seal cutoff or a fresh seal generation must land in the seal
// projection before any audit claims to cover it.
function reconcileLedgers(kilnDir) {
  reconcileLedger(kilnDir, SEAL_LEDGER)
  reconcileLedger(kilnDir, AUDIT_LEDGER)
}

// Append a typed row to the JSONL truth, then re-render the .log from the JSONL. The append prefixes
// a newline when a crash left the ledger without a trailing one, so the new row lands on its own line
// and the torn line stays independently recoverable (the archiveVerdict write discipline). Callers
// reconcile FIRST so a stale .log or an un-migrated W1 log never misleads the render.
function appendLedgerRow(kilnDir, descriptor, row) {
  const jsonlPath = join(kilnDir, descriptor.jsonl)
  let raw = ''
  try {
    raw = readFileSync(jsonlPath, 'utf8')
  } catch (error) {
    if (error.code !== 'ENOENT') stop('transport_failure', `${descriptor.jsonl} could not be read: ${error.message}`, TRANSPORT_FAILURE)
  }
  // W2-S7b (item 4): the append is membership-affecting, so it may never proceed from an INCOMPLETE
  // read. A torn or corrupt line means the reduction cannot see the whole truth — appending a
  // candidate onto it would fix a generation ordinal, or a cutoff, against a history with a hole.
  const before = parseLedger(raw)
  if (!before.complete) {
    stop('transport_failure', `${descriptor.jsonl} carries a torn or unparseable line — no membership-affecting append proceeds from an incomplete ledger read`, TRANSPORT_FAILURE)
  }
  // The row is held to the SAME field law and the SAME modern-shape boundary the reduction applies,
  // BEFORE it lands. The ledger is append-only and nothing is ever deleted from it, so a row the
  // reduction would refuse must never be written at all — otherwise one bad append wedges every
  // future render of a ledger that cannot be repaired.
  const shape = candidateShapeInvalid(descriptor, row)
  if (shape) stop('transport_failure', `${descriptor.jsonl} refuses a candidate that ${shape}`, TRANSPORT_FAILURE)
  const state = reduceLedger(kilnDir, descriptor, before)
  // The same refusal one ledger deeper, and it is a DISTINCT one: this ledger reads whole, but the
  // ledger it derives its state from does not. An audit appended over a seal history with a hole
  // would fix a coverage claim against seals the reduction could not see.
  if (!state.derived) {
    stop('transport_failure', `${descriptor.jsonl} derives its state from a ledger carrying a torn or unparseable line — no membership-affecting append proceeds from an incomplete read`, TRANSPORT_FAILURE)
  }
  if (row.type === descriptor.type && row.attestation_kind === undefined && state.modern) {
    stop('transport_failure', `${descriptor.jsonl} has crossed its modern-shape boundary — a candidate carrying no attestation kind is never appended after it`, TRANSPORT_FAILURE)
  }
  mkdirSync(kilnDir, { recursive: true })
  const appendError = appendJsonlRow(jsonlPath, raw, row)
  if (appendError) {
    stop('transport_failure', `${descriptor.jsonl} could not be appended: ${appendError}`, TRANSPORT_FAILURE)
  }
  try {
    const read = readLedgerRows(jsonlPath)
    writeProjectionIfStale(kilnDir, descriptor, reduceLedger(kilnDir, descriptor, read === null ? { rows: [], complete: true } : read))
  } catch (error) {
    stop('transport_failure', `${descriptor.log} projection could not be rendered: ${error.message}`, TRANSPORT_FAILURE)
  }
}

// ── W2-S7a (ruling A-prime): the driver-closed identity ledger ──────────────
// .kiln/identity.jsonl is an append-only, event-typed truth with NO rendered projection — nothing
// reads identity for membership yet (S7b binds it). Three row types key by {run_id, leg_id}:
//   intent          {type, run_id, leg_id, role, requested_alias, subject, expected_label, ts}
//   codex-identity  {type, run_id, leg_id, role, requested_alias, resolved_model, source, confirmation, subject, ts}
//   resolved        {type, run_id, leg_id, agent_id, resolved_model, source, driver_session, cross_check, ts}
// A leg with an intent row and no resolved row is PENDING; the state is derived, never stored. The
// leg_id is a random 128-bit value (32 lowercase hex) so its expected_label is globally unique, and
// the reserved leg: prefix is minted NOWHERE else in the plugin.
const IDENTITY_FILE = 'identity.jsonl'
const IDENTITY_ROLES = new Set(['builder', 'repair', 'gate-reviewer', 'auditor', 'audit-repair', 'ratifier', 'screen-grader'])
const LEG_ID = /^[0-9a-f]{32}$/
const LEG_LABEL = /^leg:[0-9a-f]{32}$/
const IDENTITY_SOURCE = new Set(['workflow_progress', 'argv'])
// The roles admissible in each candidate leg position (append-seal / append-audit / publish-gate).
// W2-S7a (B-CODEX-ROLE): position validation is UNIFORM — a codex-identity leg occupying a position
// must carry the same reviewer-class role a claude leg would, never a cross-duty substitution.
const BUILDER_LEG_ROLES = new Set(['builder', 'repair', 'audit-repair'])
const REVIEWER_LEG_ROLES = new Set(['gate-reviewer', 'auditor', 'ratifier', 'screen-grader'])
// The codex reviewer role by review family — a codex-identity row always carries a closed
// reviewer-class role, matching the intent side so S7b reads one vocabulary.
const CODEX_ROLE = { review: 'gate-reviewer', audit: 'auditor', ratify: 'ratifier', feasibility: 'ratifier', screen: 'screen-grader' }

// W2-S7a (B-LEDGER-SCHEMA): the semantic schema of one PARSEABLE identity row of a known type.
// Returns a reason string when the row CLAIMS a known type but is malformed — a schema anomaly the
// reduction HOLDs on, never silently resolving or dropping it. A torn (unparseable) line never
// reaches here; a row without a recognized type is not a reduction input and is ignored
// (forward-compat for S7b types). A resolved row counts only with a well-formed leg_id, non-empty
// agent_id and resolved_model, and a closed source; a codex-identity only with a well-formed leg_id,
// a closed role, a non-empty resolved_model; an intent only with a well-formed leg_id, a closed
// role, and the matching reserved expected_label.
function identityRowInvalid(row) {
  if (!isObject(row) || typeof row.type !== 'string') return null
  if (row.type === 'intent') {
    if (typeof row.leg_id !== 'string' || !LEG_ID.test(row.leg_id)) return 'intent row carries a malformed leg_id'
    if (!IDENTITY_ROLES.has(row.role)) return 'intent row carries a role outside the closed set'
    if (row.expected_label !== 'leg:' + row.leg_id) return 'intent row carries a malformed expected_label'
    return null
  }
  if (row.type === 'codex-identity') {
    if (typeof row.leg_id !== 'string' || !LEG_ID.test(row.leg_id)) return 'codex-identity row carries a malformed leg_id'
    if (!IDENTITY_ROLES.has(row.role)) return 'codex-identity row carries a role outside the closed set'
    if (typeof row.resolved_model !== 'string' || row.resolved_model.trim() === '') return 'codex-identity row carries no resolved_model'
    return null
  }
  if (row.type === 'resolved') {
    if (typeof row.leg_id !== 'string' || !LEG_ID.test(row.leg_id)) return 'resolved row carries a malformed leg_id'
    if (typeof row.agent_id !== 'string' || row.agent_id.trim() === '') return 'resolved row carries no agent_id'
    if (typeof row.resolved_model !== 'string' || row.resolved_model.trim() === '') return 'resolved row carries no resolved_model'
    if (!IDENTITY_SOURCE.has(row.source)) return 'resolved row carries an unrecognized source'
    return null
  }
  return null
}

// Read identity.jsonl into rows, tolerating a torn final line (the archiveVerdict degrade). Returns
// [] when ABSENT; a genuine IO fault other than ENOENT THROWS so the caller fails closed.
function readIdentityRows(kilnDir) {
  let raw = ''
  try {
    raw = readFileSync(join(kilnDir, IDENTITY_FILE), 'utf8')
  } catch (error) {
    if (error.code === 'ENOENT') return []
    throw error
  }
  const rows = []
  for (const line of raw.split('\n')) {
    if (line.trim() === '') continue
    try { rows.push(JSON.parse(line)) } catch { continue }
  }
  return rows
}

// Append one identity row, newline-prefixing a torn tail so it lands on its own line (the
// archiveVerdict/appendLedgerRow write discipline). Returns null on success, an error string on
// failure so the caller fails closed.
function appendIdentityRow(kilnDir, row) {
  const path = join(kilnDir, IDENTITY_FILE)
  let raw = ''
  try {
    raw = readFileSync(path, 'utf8')
  } catch (error) {
    if (error.code !== 'ENOENT') return `identity ledger could not be read: ${error.message}`
  }
  let appendError = null
  try { mkdirSync(kilnDir, { recursive: true }) } catch (error) { appendError = error.message }
  if (appendError === null) appendError = appendJsonlRow(path, raw, row)
  if (appendError) return `identity ledger could not be appended: ${appendError}`
  return null
}

// Index the identity ledger: for every leg_id its role, run_id, and whether it is RESOLVED (a
// codex-identity row is resolved by construction; an intent becomes resolved when a resolved row
// for its leg_id lands). The first intent for a leg_id wins its role/run_id — an immutable intent
// is never rewritten. Also returns the intent rows for the pending derivation. This is the SINGLE
// reduction point — every consumer reads identity through it. W2-S7a (B-LEDGER-SCHEMA): each
// parseable known-type row is semantically validated; a schema anomaly HOLDs the whole reduction
// fail-closed (the S6 discipline), never silently resolving or dropping it. A genuine IO fault (not
// ENOENT) HOLDs too.
function identityIndex(kilnDir) {
  let rows
  try {
    rows = readIdentityRows(kilnDir)
  } catch (error) {
    stop('transport_failure', `the identity ledger could not be read: ${error.message}`, TRANSPORT_FAILURE)
  }
  const legs = new Map()
  const resolvedIds = new Set()
  // W2-S7b (item 7): promotion requires EXACTLY ONE complete resolved record per referenced pending
  // leg, so the reduction counts them — two resolved rows for one leg are contradictory identity
  // evidence, and membership is never conferred on a leg whose identity is ambiguous.
  const resolvedCounts = new Map()
  const intents = []
  for (const row of rows) {
    const invalid = identityRowInvalid(row)
    if (invalid) stop('transport_failure', `the identity ledger carries a schema anomaly: ${invalid} — the reduction holds rather than resolve or drop it`, TRANSPORT_FAILURE)
    if (!isObject(row) || typeof row.leg_id !== 'string') continue
    if (row.type === 'intent') {
      if (!legs.has(row.leg_id)) legs.set(row.leg_id, { role: row.role, run_id: row.run_id ?? null, kind: 'intent' })
      intents.push({ leg_id: row.leg_id, expected_label: row.expected_label, run_id: row.run_id ?? null, role: row.role })
    } else if (row.type === 'codex-identity') {
      legs.set(row.leg_id, { role: row.role, run_id: row.run_id ?? null, kind: 'codex' })
      resolvedIds.add(row.leg_id)
    } else if (row.type === 'resolved') {
      resolvedIds.add(row.leg_id)
      resolvedCounts.set(row.leg_id, (resolvedCounts.get(row.leg_id) ?? 0) + 1)
    }
  }
  return { legs, resolvedIds, resolvedCounts, intents }
}

// Locate the current driver transcript by session id, the kiln-meter discovery: the munged-cwd dir
// first (the common case), then a scan of every project dir. Returns the path or null (never dies)
// so capture-and-finalize can fall to its recovery scan.
function discoverDriverTranscript() {
  const sid = process.env.CLAUDE_CODE_SESSION_ID
  if (!sid) return null
  const projects = join(homedir(), '.claude', 'projects')
  const munged = process.cwd().replace(/[^A-Za-z0-9]/g, '-')
  const direct = join(projects, munged, `${sid}.jsonl`)
  if (existsSync(direct)) return direct
  let entries = []
  try { entries = readdirSync(projects, { withFileTypes: true }) } catch { return null }
  for (const entry of entries) {
    if (!entry.isDirectory()) continue
    const cand = join(projects, entry.name, `${sid}.jsonl`)
    if (existsSync(cand)) return cand
  }
  return null
}

// Every .jsonl under every project dir — the recovery scan corpus for an outstanding leg whose own
// driver session did not resolve it (a crashed session). Unreadable dirs are skipped.
function allProjectTranscripts() {
  const projects = join(homedir(), '.claude', 'projects')
  const out = []
  let dirs = []
  try { dirs = readdirSync(projects, { withFileTypes: true }) } catch { return out }
  for (const dir of dirs) {
    if (!dir.isDirectory()) continue
    let files = []
    try { files = readdirSync(join(projects, dir.name)) } catch { continue }
    for (const file of files) if (file.endsWith('.jsonl')) out.push(join(projects, dir.name, file))
  }
  return out
}

// Scan a driver transcript for the completed workflow_progress rows carrying an exact label. A
// task_progress event carries a workflow_progress snapshot that repeats across events as a leg
// transitions, so the distinct COMPLETED (state done) identities are deduped by {agentId, model}.
// A done row missing either field marks the telemetry malformed. The label is globally unique, so a
// clean resolution is EXACTLY one distinct entry and no malformed row.
function scanTranscriptForLabel(text, label) {
  const done = new Map()
  let malformed = false
  let present = false
  for (const line of text.split('\n')) {
    if (line === '') continue
    let ev
    try { ev = JSON.parse(line) } catch { continue }
    if (!isObject(ev) || ev.type !== 'system' || ev.subtype !== 'task_progress' || !Array.isArray(ev.workflow_progress)) continue
    for (const entry of ev.workflow_progress) {
      if (!isObject(entry) || entry.type !== 'workflow_agent' || entry.label !== label) continue
      // W2-S7a (B-RECOVERY-CORPUS): the label appearing at all — any state, clean or dirty — marks
      // this transcript present in the recovery census; ambiguity never hides a transcript.
      present = true
      if (entry.state !== 'done') continue
      if (typeof entry.agentId !== 'string' || entry.agentId === '' || typeof entry.model !== 'string' || entry.model === '') { malformed = true; continue }
      done.set(entry.agentId + '\0' + entry.model, { agentId: entry.agentId, model: entry.model })
    }
  }
  return { entries: [...done.values()], malformed, present }
}

// The OPTIONAL per-agent cross-check. W2-S7a (B-CROSSCHECK): live Workflow per-agent transcripts sit
// under <driver path WITHOUT its .jsonl suffix>/subagents/workflows/wf_*/agent-<agentId>.jsonl — a
// sibling DIRECTORY named for the session, NOT beside the driver file. A present transcript MUST
// agree with the driver telemetry model (a disagreement HOLDS). GENUINE absence (ENOENT on the wf
// root or the agent file) is cross_check absent, since the optional cross-check simply is not there.
// A PRESENT-but-unreadable source (EACCES, EISDIR, a non-ENOENT fault) is UNTRUSTED evidence and
// HOLDS — the wave discipline, never silently coerced to absent. Returns message.model-agree,
// absent, disagree, or unreadable (the caller HOLDs on disagree and unreadable).
function crossCheckModel(driverPath, agentId, model) {
  if (!/^[A-Za-z0-9_-]+$/.test(agentId)) return 'absent'
  const wfRoot = join(driverPath.replace(/\.jsonl$/, ''), 'subagents', 'workflows')
  let wfDirs
  try {
    wfDirs = readdirSync(wfRoot, { withFileTypes: true })
  } catch (error) {
    return error.code === 'ENOENT' ? 'absent' : 'unreadable'
  }
  for (const dir of wfDirs) {
    if (!dir.isDirectory() || dir.name.slice(0, 3) !== 'wf_') continue
    let text
    try {
      text = readFileSync(join(wfRoot, dir.name, `agent-${agentId}.jsonl`), 'utf8')
    } catch (error) {
      if (error.code === 'ENOENT') continue
      return 'unreadable'
    }
    let sawModel = false
    for (const line of text.split('\n')) {
      if (line === '') continue
      let ev
      try { ev = JSON.parse(line) } catch { continue }
      if (isObject(ev) && ev.type === 'assistant' && isObject(ev.message) && typeof ev.message.model === 'string' && ev.message.model !== '') {
        sawModel = true
        if (ev.message.model !== model) return 'disagree'
      }
    }
    return sawModel ? 'message.model-agree' : 'absent'
  }
  return 'absent'
}

// process.kill(pid, 0) probes liveness without delivering a signal. Only ESRCH PROVES the
// holder is gone; success and EPERM prove it alive; any other error, or a missing or
// non-positive pid, is UNKNOWN. Takeover requires PROVEN dead, so it treats UNKNOWN as
// not-dead and fails closed — a lock is never taken over on unproven death (B03).
function pidState(pid) {
  if (!Number.isInteger(pid) || pid <= 0) return 'unknown'
  try {
    process.kill(pid, 0)
    return 'alive'
  } catch (error) {
    if (error.code === 'ESRCH') return 'dead'
    if (error.code === 'EPERM') return 'alive'
    return 'unknown'
  }
}

// Is a lock record takeover-stale? BOTH the holder pid must be PROVEN dead AND the lock aged
// past the floor — never time alone. Returns the reason on a refusal so the honest fact can
// name why (fail closed on an unprobeable pid or an unreadable start time).
function takeoverStale(record) {
  const state = pidState(record.conductor_pid)
  if (state === 'alive') return { stale: false, fact: 'live' }
  if (state !== 'dead') return { stale: false, fact: 'unprobeable' }
  const startedAt = Date.parse(record.started_at)
  if (!Number.isFinite(startedAt)) return { stale: false, fact: 'no-start' }
  if (Date.now() - startedAt < LOCK_AGE_FLOOR_MS) return { stale: false, fact: 'young' }
  return { stale: true, fact: 'stale' }
}

// Claim-by-rename: rename(2) on ONE source path has exactly one winner — the loser gets ENOENT.
// After a successful claim the caller holds the ONLY reference to those bytes, so every decision
// (takeover staleness, release identity) is re-made on the CLAIMED bytes, never on the pre-claim
// read a concurrent contender may already have invalidated. Returns {claimPath, record} on the
// win, or null when the claim was lost (ENOENT). Crash residue between claim and its terminal
// move leaves an orphaned .run.lock.claim-* file and an empty lock path — acceptable: the record
// bytes survive on disk (never-delete) and the next acquire proceeds fresh; there is no janitor.
function claimLock(kilnDir) {
  const claimPath = join(kilnDir, `.run.lock.claim-${process.pid}-${randomUUID()}`)
  try {
    renameSync(join(kilnDir, LOCK_FILE), claimPath)
  } catch (error) {
    if (error.code === 'ENOENT') return null
    throw error
  }
  return { claimPath, record: readLockRecord(claimPath).record }
}

// The claimed record is NOT the one this verb may end (a fresh lock landed in the claim window):
// put it back. linkSync is create-exclusive — on success the claim is dropped and the lock is
// whole again (returns true). If the path is re-occupied, the displaced record is archived (never
// lost — its owner join-fails into the honest hold) and the claim removed (true). If archival ALSO
// fails (history unavailable), the claim file is the SOLE surviving copy, so it is PRESERVED on
// disk untouched — the documented orphan-claim residue — and false is returned: the claim is NEVER
// unlinked without the record safe somewhere durable, and the caller surfaces the transport failure.
function restoreOrArchive(kilnDir, claimPath, record) {
  try {
    linkSync(claimPath, join(kilnDir, LOCK_FILE))
    try { unlinkSync(claimPath) } catch { /* restored; the claim link can linger harmlessly */ }
    return true
  } catch { /* the lock path is re-occupied — the claimed record cannot go back there */ }
  if (record) {
    try {
      archiveLockRecord(kilnDir, record, 'displaced')
      try { unlinkSync(claimPath) } catch { /* archived; the claim file can linger harmlessly */ }
      return true
    } catch { /* history is unavailable — the claim is the last copy; preserve it, fall through */ }
  }
  return false
}

// The terminal move when this verb IS authorized to end the claimed lock: archive the record,
// then drop the claim. Archive FIRST, unlink second — never an unlink without an archive. If the
// archive fails, the record is the only copy, so it is RESTORED to the lock path rather than
// lost, and the caller fails transport. Returns true on a clean archive+drop.
function archiveAndDrop(kilnDir, claimPath, record, event) {
  try {
    archiveLockRecord(kilnDir, record, event)
  } catch {
    try { linkSync(claimPath, join(kilnDir, LOCK_FILE)); unlinkSync(claimPath) } catch { /* bytes remain in the claim file */ }
    return false
  }
  try { unlinkSync(claimPath) } catch { /* archived; the claim file can linger harmlessly */ }
  return true
}

// ── W2-S7a (FORK 3): the control-derived working-tree manifests ──────────────
// A slice generation's delta is derived from a TRUSTED before/after snapshot of the working tree,
// never the builder's word. manifest-start captures an immutable baseline before the first builder
// mutation; manifest-prepare captures the after-snapshot before each gate, diffs it against the
// baseline, and publishes a content-addressed manifest; publication and the seal RECOMPUTE the
// after-snapshot and reject any drift. Snapshots hash ACTUAL working-tree bytes, never git index or
// HEAD blobs. All artifacts live under .kiln/manifests/<sha256(slice)>/gen-<N>/ — the slice id is
// hashed so a slash-bearing id cannot walk out of the path.
const MANIFEST_DIR = 'manifests'
const MANIFEST_SCHEMA = 1
const MANIFEST_COVERAGE = 'control-derived-slice-delta'

// Every fault surfaces as a returned { error } (the archiveVerdict/receiptDigestAtPublication
// discipline) so each consumer fails closed and discards its own residue before it stops; the
// snapshot helpers throw on a fault and this wrapper converts the throw to that string. A genuine
// ENOENT that MEANS absence (a tracked path gone from the tree, an unstarted generation) is caught
// at its site and never reaches here as a fault.
function manifestResult(build) {
  try {
    return { value: build() }
  } catch (error) {
    return { error: `manifest: ${error.message}` }
  }
}

// Canonical serialization (FORK 1 rules, reused): UTF-8 compact JSON, no BOM, no trailing newline;
// object keys recursively sorted; arrays kept in order; undefined, non-finite numbers and unsafe
// integers rejected (a caller bug, never silently coerced). No Unicode or newline normalization —
// JSON.stringify escapes deterministically and preserves the exact string content, so the digest is
// byte-stable across two runs on identical input.
function canonicalString(value) {
  const encode = (v) => {
    if (v === null) return 'null'
    if (typeof v === 'boolean') return v ? 'true' : 'false'
    if (typeof v === 'number') {
      if (!Number.isFinite(v)) throw new Error('canonical serialization rejects a non-finite number')
      if (Number.isInteger(v) && !Number.isSafeInteger(v)) throw new Error('canonical serialization rejects an unsafe integer')
      return JSON.stringify(v)
    }
    if (typeof v === 'string') return JSON.stringify(v)
    if (Array.isArray(v)) return '[' + v.map((e) => encode(e)).join(',') + ']'
    if (isObject(v)) return '{' + Object.keys(v).sort().map((k) => JSON.stringify(k) + ':' + encode(v[k])).join(',') + '}'
    throw new Error('canonical serialization rejects an unserializable value')
  }
  return encode(value)
}
const canonicalBytes = (value) => Buffer.from(canonicalString(value), 'utf8')
const canonicalDigest = (value) => createHash('sha256').update(canonicalBytes(value)).digest('hex')

// Sort by the UTF-8 byte order of a path — NOT the default UTF-16 code-unit order, which diverges on
// non-BMP characters; every snapshot and every change list orders on this so a digest is byte-stable.
const bytePathCompare = (a, b) => Buffer.compare(Buffer.from(a, 'utf8'), Buffer.from(b, 'utf8'))

const generationDir = (kilnDir, slice, generation) =>
  join(kilnDir, MANIFEST_DIR, createHash('sha256').update(Buffer.from(slice, 'utf8')).digest('hex'), 'gen-' + generation)

// The per-slice generation ordinal: 1 + the count of seal rows for this slice in the append-only
// truth. Provisional rows COUNT — a crashed candidate is a distinct historical attempt, matching the
// S7b "1 + max HISTORICAL ordinal" rule; promote rows are not seals and never count. An absent ledger
// is generation 1; a genuine read fault throws (a hold), never a silent 1. W2-S7b: this stays the
// HISTORICAL allocator and nothing else — an INCOMPLETE read throws, because a hole in the history
// would hand a builder an ordinal an earlier attempt already committed a baseline against, and it
// counts through the REDUCTION so the ordinal it hands out rests on the same candidate schema and
// modern-shape boundary the reduction enforces. Counting parseable rows instead would let a builder
// commit a baseline against a ledger the reduction must hold — one authority, not two.
function sliceGeneration(kilnDir, slice) {
  const read = readLedgerRows(join(kilnDir, SEAL_LEDGER.jsonl))
  if (read === null) return 1
  if (!read.complete) throw new Error('the seal ledger carries a torn or unparseable line — the generation allocator holds rather than reuse an ordinal')
  const history = reduceLedger(kilnDir, SEAL_LEDGER, read).groups.get(slice)
  return 1 + (history === undefined ? 0 : history.length)
}

// Detect the snapshot mode: a real git work tree enumerates through git, anything else (git absent,
// or a directory that is not a work tree) walks deterministically. Any OTHER git failure throws —
// never a silent fallback that would under-cover a broken repo.
function gitWorktree(repo) {
  const r = spawnSync('git', ['-C', repo, 'rev-parse', '--is-inside-work-tree'], { encoding: 'utf8' })
  if (r.error) {
    if (r.error.code === 'ENOENT') return false
    throw new Error(`git probe failed: ${r.error.message}`)
  }
  if (r.status === 0) {
    const out = (r.stdout || '').trim()
    if (out === 'true') return true
    if (out === 'false') return false
    throw new Error(`git probe returned an unexpected result: ${out}`)
  }
  if (/not a git repository/i.test(r.stderr || '')) return false
  throw new Error(`git probe failed: ${(r.stderr || '').trim().slice(-500)}`)
}

// Enumerate NUL-separated paths from git; a spawn error or a nonzero exit throws.
function gitPaths(repo, extra) {
  const r = spawnSync('git', ['-C', repo, 'ls-files', '-z', ...extra], { maxBuffer: 64 * 1024 * 1024 })
  if (r.error) throw new Error(`git ls-files failed: ${r.error.message}`)
  if (r.status !== 0) throw new Error(`git ls-files exited ${r.status}: ${(r.stderr ? r.stderr.toString('utf8') : '').trim().slice(-500)}`)
  return r.stdout.toString('utf8').split('\0').filter((p) => p !== '')
}

// The always-excluded roots: .git and .kiln (and the manifests dir transitively) — the working root's
// VCS metadata and Kiln's own state, never part of a slice delta.
const manifestExcluded = (rel) => rel === '.git' || rel === '.kiln' || rel.slice(0, 5) === '.git/' || rel.slice(0, 6) === '.kiln/'

// One snapshot entry for a working-tree path, hashing ACTUAL bytes. A symlink records its link text
// and is NEVER followed. A regular file is opened O_RDONLY|O_NOFOLLOW and re-verified by fstat (a
// regular file with the same dev+ino the lstat saw) before its bytes are read FROM THE FD, so a
// file-to-symlink or file-to-other-file swap between the lstat and the read is caught rather than
// followed or mis-hashed. ENOENT AFTER ENUMERATION splits by SOURCE (M-04, driver-decided): an
// INDEX-derived tracked path already gone from the working tree is a durable builder deletion — it
// stays out of the snapshot (null) and the diff renders its delete tombstone; a WORKING-TREE-derived
// path (git --others or the non-git walk) that vanishes between enumeration and the snapshot is an
// UNSTABLE read and HOLDs, never a silent drop. A fifo, socket, device, gitlink, a swap, or any other
// lstat/open/read fault HOLDs.
function snapshotEntry(repo, rel, source) {
  const abs = join(repo, rel)
  let st
  try {
    st = lstatSync(abs)
  } catch (error) {
    if (error.code === 'ENOENT') {
      if (source === 'index') return null
      throw new Error(`the working-tree path ${rel} vanished between enumeration and the snapshot — an unstable read`)
    }
    throw new Error(`could not stat ${rel}: ${error.message}`)
  }
  if (st.isSymbolicLink()) {
    let target
    try {
      target = readlinkSync(abs)
    } catch (error) {
      throw new Error(`could not read the symlink ${rel}: ${error.message}`)
    }
    return { path: rel, type: 'symlink', target }
  }
  if (st.isFile()) {
    let fd
    try {
      fd = openSync(abs, FS.O_RDONLY | FS.O_NOFOLLOW)
    } catch (error) {
      throw new Error(`could not open ${rel} without following a link — an unstable path or a file-to-symlink swap: ${error.message}`)
    }
    try {
      const fst = fstatSync(fd)
      if (!fst.isFile()) throw new Error(`${rel} was not a regular file when opened — an unstable path`)
      if (fst.dev !== st.dev || fst.ino !== st.ino) throw new Error(`${rel} was swapped between the stat and the open — an unstable path`)
      const bytes = readFileSync(fd)
      return { path: rel, type: 'file', mode_executable: (st.mode & 0o111) !== 0, sha256: createHash('sha256').update(bytes).digest('hex') }
    } finally {
      try { closeSync(fd) } catch { /* the fd read result stands even if the close fails */ }
    }
  }
  throw new Error(`cannot snapshot an unsupported special path: ${rel}`)
}

// A deterministic, sorted recursive walk of the working root for the non-git mode: every regular file
// and symlink, excluding .git (VCS metadata at any depth) and the root .kiln. Directories recurse in
// sorted order so the enumerated path list is stable across runs. M-04: the walk is a WORKING-TREE
// source — a child that vanishes between the readdir and its lstat is an UNSTABLE read and HOLDs (any
// lstat fault throws, ENOENT included), never a silent continue that would drop a path mid-snapshot.
function walkPaths(repo) {
  const out = []
  const walk = (rel) => {
    let names
    try {
      names = readdirSync(rel === '' ? repo : join(repo, rel))
    } catch (error) {
      throw new Error(`could not read the directory ${rel || '.'}: ${error.message}`)
    }
    for (const name of names.slice().sort()) {
      if (name === '.git' || (rel === '' && name === '.kiln')) continue
      const child = rel === '' ? name : rel + '/' + name
      let st
      try {
        st = lstatSync(join(repo, child))
      } catch (error) {
        throw new Error(`could not stat ${child} during the walk — an unstable read: ${error.message}`)
      }
      if (st.isDirectory()) { walk(child); continue }
      out.push(child)
    }
  }
  walk('')
  return out
}

// The shared enumerator: git tracked + untracked-non-ignored (tracked-ignored INCLUDED, ignored-
// untracked EXCLUDED and declared), else the deterministic walk. Both modes hash working-tree bytes,
// sort entries by UTF-8 path bytes, and exclude .git/** and .kiln/**. Returns { enumerator,
// exclusions, entries } — the canonical snapshot object whose sha256 anchors the baseline and the
// after-digest.
function captureSnapshot(repo) {
  const git = gitWorktree(repo)
  const enumerator = git ? 'git' : 'walk'
  const exclusions = git ? ['.git', '.kiln', 'ignored-untracked'] : ['.git', '.kiln']
  const seen = new Set()
  const tagged = []
  const add = (rel, source) => {
    if (manifestExcluded(rel) || seen.has(rel)) return
    seen.add(rel)
    tagged.push({ rel, source })
  }
  if (git) {
    // M-04: INDEX-derived tracked paths carry the 'index' source (a missing one is a durable
    // deletion); untracked-non-ignored paths carry 'worktree' (a missing one is an unstable read).
    // The seen-dedupe keeps the index source authoritative on the (impossible) overlap.
    for (const p of gitPaths(repo, [])) add(p, 'index')
    for (const p of gitPaths(repo, ['--others', '--exclude-standard'])) add(p, 'worktree')
  } else {
    for (const p of walkPaths(repo)) add(p, 'worktree')
  }
  tagged.sort((a, b) => bytePathCompare(a.rel, b.rel))
  const entries = []
  for (const { rel, source } of tagged) {
    const entry = snapshotEntry(repo, rel, source)
    if (entry !== null) entries.push(entry)
  }
  return { enumerator, exclusions, entries }
}

// Diff two snapshot entry lists into the canonical change list. A path only in the baseline is a
// delete, only in the after is an add, in both with any difference (content, type, or mode) is a
// modify; identical entries yield no change. Renames are a delete plus an add — never inferred.
// Sorted by UTF-8 path bytes.
function diffSnapshots(baseEntries, afterEntries) {
  const index = (list) => { const m = new Map(); for (const e of list) m.set(e.path, e); return m }
  const before = index(baseEntries)
  const after = index(afterEntries)
  const changes = []
  const paths = new Set()
  for (const e of baseEntries) paths.add(e.path)
  for (const e of afterEntries) paths.add(e.path)
  for (const path of paths) {
    const b = before.get(path)
    const a = after.get(path)
    if (b && !a) changes.push({ path, change: 'delete', before: b, after: null })
    else if (!b && a) changes.push({ path, change: 'add', before: null, after: a })
    else if (b && a && canonicalString(b) !== canonicalString(a)) changes.push({ path, change: 'modify', before: b, after: a })
  }
  changes.sort((x, y) => bytePathCompare(x.path, y.path))
  return changes
}

// The content-addressed baseline file for a generation — its name IS its digest, so no write ever
// targets a name a committed key can already reference; a late or concurrent writer with different
// bytes lands a different, inert file rather than clobbering a committed baseline.
const baselineFile = (genDir, sha) => join(genDir, 'baseline-' + sha + '.json')

// ENOENT-only absence at a manifest-store boundary: a path component genuinely absent is a clean
// no-manifest (false); ANY other fault — a file planted where a directory belongs (ENOTDIR), an
// unreadable store (EACCES), a genuine IO fault — is untrusted and throws, so a manifest check never
// falls OPEN into the legacy path over an anomaly it cannot read (the S6 untrusted-read-holds
// discipline on a trust boundary).
function manifestPathPresent(path) {
  try {
    lstatSync(path)
    return true
  } catch (error) {
    if (error.code === 'ENOENT') return false
    throw new Error(`the manifest store path could not be stated: ${error.message}`)
  }
}

// The exact field set a committed key carries — the sentinel is only trustworthy if it fully declares
// its {slice, generation} identity, so any extra or missing field is a torn key that HOLDs.
const KEY_FIELDS = ['schema_version', 'run_id', 'slice', 'generation', 'enumerator', 'exclusions', 'baseline_sha256', 'created_ts']

// Read and FULLY validate the immutable baseline for a generation (M-03). A missing key means prepare
// or a recompute ran before manifest-start (a wiring bug). The committed key must declare exactly this
// {slice, generation}: its slice and generation must equal the addressed pair, its schema_version must
// be the committed schema, its enumerator must be in the closed set, its exclusions well-formed, its
// baseline_sha256 a 64-hex digest, its run_id string-or-null, and its field set exact — so the sentinel
// reliably establishes the declared key rather than reusing a contradictory one. baseline_sha256 rides
// the key so a truncated baseline is caught here, and the baseline file is content-addressed by it.
function readBaseline(genDir, expectedSlice, expectedGeneration) {
  let key
  try {
    key = JSON.parse(readFileSync(join(genDir, 'key.json'), 'utf8'))
  } catch (error) {
    throw new Error(`the baseline key for this generation is missing or unreadable (manifest-start runs first): ${error.message}`)
  }
  if (!isObject(key)) throw new Error('the baseline key is not a JSON object')
  const keys = Object.keys(key)
  if (keys.length !== KEY_FIELDS.length || KEY_FIELDS.some((f) => !keys.includes(f))) throw new Error('the baseline key field set does not match the committed schema')
  if (key.schema_version !== MANIFEST_SCHEMA) throw new Error('the baseline key schema_version is not the committed schema')
  if (typeof key.slice !== 'string' || key.slice === '') throw new Error('the baseline key slice is malformed')
  if (!Number.isInteger(key.generation)) throw new Error('the baseline key generation is not an integer')
  if (key.enumerator !== 'git' && key.enumerator !== 'walk') throw new Error('the baseline key enumerator is outside the closed set')
  if (!Array.isArray(key.exclusions) || !key.exclusions.every((x) => typeof x === 'string' && x !== '')) throw new Error('the baseline key exclusions are malformed')
  if (!LAW_HASH.test(key.baseline_sha256)) throw new Error('the baseline key baseline_sha256 is not a 64-hex digest')
  if (!(key.run_id === null || typeof key.run_id === 'string')) throw new Error('the baseline key run_id must be a string or null')
  if (typeof key.created_ts !== 'string' || key.created_ts === '') throw new Error('the baseline key created_ts is malformed')
  if (key.slice !== expectedSlice) throw new Error(`the committed baseline key names slice ${key.slice}, not the addressed slice ${expectedSlice}`)
  if (key.generation !== expectedGeneration) throw new Error(`the committed baseline key names generation ${key.generation}, not the addressed generation ${expectedGeneration}`)
  let bytes
  try {
    bytes = readFileSync(baselineFile(genDir, key.baseline_sha256))
  } catch (error) {
    throw new Error(`the baseline snapshot could not be read: ${error.message}`)
  }
  if (createHash('sha256').update(bytes).digest('hex') !== key.baseline_sha256) {
    throw new Error('the baseline snapshot no longer matches its sealed digest — a torn baseline')
  }
  let snapshot
  try {
    snapshot = JSON.parse(bytes.toString('utf8'))
  } catch (error) {
    throw new Error(`the baseline snapshot is not valid JSON: ${error.message}`)
  }
  if (!isObject(snapshot) || !Array.isArray(snapshot.entries)) throw new Error('the baseline snapshot is malformed')
  return { key, snapshot }
}

// Build the canonical manifest for a generation from its immutable baseline and a FRESH after-
// snapshot. The enumerator must match the baseline's (a repo that changed git-ness mid-generation
// throws). Returns the manifest object, its canonical bytes, and its digest — the ONE builder
// manifest-prepare writes and every drift recompute re-runs, so an unchanged tree yields a byte-
// identical digest.
function buildManifest(kilnDir, repo, slice) {
  const generation = sliceGeneration(kilnDir, slice)
  const genDir = generationDir(kilnDir, slice, generation)
  const { key, snapshot } = readBaseline(genDir, slice, generation)
  const after = captureSnapshot(repo)
  if (after.enumerator !== key.enumerator) {
    throw new Error(`the working tree changed enumerator mid-generation: baseline ${key.enumerator}, now ${after.enumerator}`)
  }
  const manifest = {
    schema_version: MANIFEST_SCHEMA,
    coverage_mode: MANIFEST_COVERAGE,
    run_id: key.run_id ?? null,
    slice,
    generation,
    enumerator: key.enumerator,
    exclusions: after.exclusions,
    baseline_sha256: key.baseline_sha256,
    after_sha256: canonicalDigest(after),
    changes: diffSnapshots(snapshot.entries, after.entries),
  }
  const bytes = canonicalBytes(manifest)
  return { generation, genDir, manifest, bytes, sha: createHash('sha256').update(bytes).digest('hex') }
}

// manifest-start: capture the immutable baseline of a generation, or reuse an existing one. A
// committed generation (key.json present) is immutable — a resume or a concurrent-mint loser verifies
// and reuses its baseline rather than re-capturing a tree the builder may already have touched.
// Returns the closed fact `<generation> <baseline_sha256>`.
function manifestStart(kilnDir, repo, slice) {
  return manifestResult(() => {
    const generation = sliceGeneration(kilnDir, slice)
    const genDir = generationDir(kilnDir, slice, generation)
    const keyPath = join(genDir, 'key.json')
    if (existsSync(keyPath)) {
      const { key } = readBaseline(genDir, slice, generation)
      return key.generation + ' ' + key.baseline_sha256
    }
    const snapshot = captureSnapshot(repo)
    const bytes = canonicalBytes(snapshot)
    const baselineSha = createHash('sha256').update(bytes).digest('hex')
    const key = {
      schema_version: MANIFEST_SCHEMA, run_id: runIdFromLock(kilnDir), slice, generation,
      enumerator: snapshot.enumerator, exclusions: snapshot.exclusions, baseline_sha256: baselineSha,
      created_ts: new Date().toISOString(),
    }
    mkdirSync(genDir, { recursive: true })
    // The baseline is CONTENT-ADDRESSED: its name is its own digest, committed 'wx'. An identical name
    // is an idempotent no-op (its bytes are re-verified); a late or concurrent writer whose bytes
    // differ lands a DIFFERENT, inert file and never overwrites a committed baseline. key.json is the
    // O_EXCL commit sentinel and its baseline_sha256 names which baseline file is the committed one, so
    // a loser reuses the intact committed baseline rather than a clobbered one — no generation wedges.
    const baselinePath = baselineFile(genDir, baselineSha)
    commitContentAddressed(baselinePath, bytes, baselineSha, 'content-addressed baseline', 'baseline')
    try {
      writeFileSync(keyPath, canonicalBytes(key), { flag: 'wx' })
    } catch (error) {
      if (error.code === 'EEXIST') {
        const { key: committed } = readBaseline(genDir, slice, generation)
        return committed.generation + ' ' + committed.baseline_sha256
      }
      throw error
    }
    return generation + ' ' + baselineSha
  })
}

// manifest-prepare: capture the after-snapshot, diff it against the baseline, and publish a content-
// addressed manifest plus the current.json pointer (atomic). Returns `<generation> <manifest_sha256>`.
function manifestPrepare(kilnDir, repo, slice) {
  return manifestResult(() => {
    const built = buildManifest(kilnDir, repo, slice)
    const preparedDir = join(built.genDir, 'prepared')
    mkdirSync(preparedDir, { recursive: true })
    // M-01: the prepared manifest is durable content-addressed evidence. An identical name is an
    // idempotent no-op ONLY when its bytes still hash to the name; a name colliding with corrupt or
    // foreign bytes is a torn store that HOLDs, never a silent accept — the baseline commit discipline.
    const preparedPath = join(preparedDir, built.sha + '.json')
    commitContentAddressed(preparedPath, built.bytes, built.sha, 'prepared manifest', 'manifest')
    const tmp = join(built.genDir, '.current.json.tmp-' + process.pid + '-' + randomUUID())
    writeFileSync(tmp, canonicalBytes({ manifest_sha256: built.sha }))
    renameSync(tmp, join(built.genDir, 'current.json'))
    return built.generation + ' ' + built.sha
  })
}

// The drift recompute the publication and seal paths share. A generation NEVER started (no key.json)
// is a legacy pass ({ sha: null }); a STARTED generation whose pointer is missing HOLDs (M-02 — never
// a legacy fall-through). A present pointer requires TWO checks: the durable prepared artifact it
// names must exist and hash to the pointer (M-01), and the freshly recomputed tree digest must equal
// the pointer — either failure throws, so nothing publishes or seals over corrupt evidence or a
// drifted tree.
function manifestRecompute(kilnDir, repo, slice) {
  return manifestResult(() => {
    const generation = sliceGeneration(kilnDir, slice)
    const genDir = generationDir(kilnDir, slice, generation)
    const currentPath = join(genDir, 'current.json')
    if (!manifestPathPresent(currentPath)) {
      if (manifestPathPresent(join(genDir, 'key.json'))) {
        throw new Error('the generation is started but its prepared manifest pointer is missing — refusing to fall through to a legacy publish or seal')
      }
      return { sha: null }
    }
    let current
    try {
      current = JSON.parse(readFileSync(currentPath, 'utf8'))
    } catch (error) {
      throw new Error(`the prepared manifest pointer could not be read: ${error.message}`)
    }
    if (!isObject(current) || !LAW_HASH.test(current.manifest_sha256)) throw new Error('the prepared manifest pointer is malformed')
    let preparedBytes
    try {
      preparedBytes = readFileSync(join(genDir, 'prepared', current.manifest_sha256 + '.json'))
    } catch (error) {
      throw new Error(`the prepared manifest evidence is missing or unreadable: ${error.message}`)
    }
    if (createHash('sha256').update(preparedBytes).digest('hex') !== current.manifest_sha256) {
      throw new Error('the prepared manifest evidence does not match the pointer digest — a torn manifest store')
    }
    const built = buildManifest(kilnDir, repo, slice)
    if (built.sha !== current.manifest_sha256) {
      throw new Error('the working tree drifted from the prepared manifest — refusing to publish or seal a review the diff no longer matches')
    }
    return { sha: built.sha }
  })
}

// The bypass guard (M-02): a generation is STARTED once its key.json exists. A publish or seal that
// omits the repo while a started generation exists would silence the required manifest recompute, so
// the caller HOLDs — a started generation always requires a manifest, never a legacy fall-through.
function manifestGenerationStarted(kilnDir, slice) {
  return manifestResult(() => manifestPathPresent(join(generationDir(kilnDir, slice, sliceGeneration(kilnDir, slice)), 'key.json')))
}

// ── W2-S7a (FORK 1): the canonical contract — the ONE authoritative facts block every transport
// judges ─────────────────────────────────────────────────────────────────────────────────────────
// A contract is the exact set of authoritative facts a review family judged, serialized once through
// canonicalBytes and content-addressed under .kiln/contracts/sha256/<sha>.json. Codex embeds those
// bytes verbatim; the claude legs judge the stored file; publication recomputes the digest and binds
// it beside receipt_sha256 on the reviews row. review_id, timestamps, output paths, model identity,
// transport family and raw mode are EXCLUDED — they are transport, not judged facts. operation is a
// closed value the invoking verb synthesizes: the authorized finding/evidence scope differs per
// operation, so omitting it is rejected.
const CONTRACT_VERSION = 1
const CONTRACT_DIR = 'contracts'
const CONTRACT_OPERATIONS = {
  'slice-review': ['initial', 'recheck'],
  'milestone-audit': ['initial', 'recheck'],
  'artifact-ratify': ['initial', 'recheck'],
  'perceptual-screen': ['initial', 'recheck', 'escalation'],
}
// finding_ids are an insertion-ordered SET in the packet; the contract SORTS them by UTF-8 bytes so
// two composes over the same cohort in any discovery order are byte-identical. prior_findings and
// every other ordered array keep their order.
const sortedFindingIds = (ids) => [...ids].sort(bytePathCompare)

// Read and digest-verify the prepared manifest for a generation dir. A current.json genuinely absent
// with no started key is a legacy pass (null). A started generation whose pointer is missing, a
// malformed pointer, or prepared bytes that no longer hash to it is a torn store that THROWS — the
// untrusted-read-holds discipline (manifestRecompute), never a silent legacy fall-through.
function readPreparedManifest(genDir) {
  const currentPath = join(genDir, 'current.json')
  if (!manifestPathPresent(currentPath)) {
    if (manifestPathPresent(join(genDir, 'key.json'))) {
      throw new Error('the generation is started but its prepared manifest pointer is missing')
    }
    return null
  }
  let current
  try {
    current = JSON.parse(readFileSync(currentPath, 'utf8'))
  } catch (error) {
    throw new Error(`the prepared manifest pointer could not be read: ${error.message}`)
  }
  if (!isObject(current) || !LAW_HASH.test(current.manifest_sha256)) throw new Error('the prepared manifest pointer is malformed')
  let bytes
  try {
    bytes = readFileSync(join(genDir, 'prepared', current.manifest_sha256 + '.json'))
  } catch (error) {
    throw new Error(`the prepared manifest evidence is missing or unreadable: ${error.message}`)
  }
  if (createHash('sha256').update(bytes).digest('hex') !== current.manifest_sha256) {
    throw new Error('the prepared manifest evidence does not match the pointer digest — a torn manifest store')
  }
  let manifest
  try {
    manifest = JSON.parse(bytes.toString('utf8'))
  } catch (error) {
    throw new Error(`the prepared manifest is not valid JSON: ${error.message}`)
  }
  if (!isObject(manifest)) throw new Error('the prepared manifest is not a JSON object')
  return { sha: current.manifest_sha256, manifest }
}

// The reviewed_manifest a slice-review contract embeds: the COMPLETE prepared manifest object for the
// slice's CURRENT generation, digest-verified. A legacy generation with no manifest is an honest null.
function reviewedManifestForSlice(kilnDir, slice) {
  const built = readPreparedManifest(generationDir(kilnDir, slice, sliceGeneration(kilnDir, slice)))
  return built === null ? null : built.manifest
}

// The manifest digest bound to a covered slice generation: the pointer digest when the store exists,
// an honest null for a legacy/pre-manifest sealed generation, a HOLD (throws) on a torn store.
// generation 0 (no current member) is null with no store lookup.
function coveredManifestDigest(kilnDir, slice, generation) {
  if (generation < 1) return null
  const built = readPreparedManifest(generationDir(kilnDir, slice, generation))
  return built === null ? null : built.sha
}

// The milestone-audit coverage tuples over the sealed prefix, in slices.json order — the ONE
// reducer-derived helper (W2-S7b item 5) called for every ordered verified-prefix member. Each tuple
// is the slices SOLE CURRENT rendered generation and that generations manifest digest. A historical
// row count may never author coverage: an invalidated or still-provisional candidate is not
// membership, so it contributes an honest generation 0 rather than a number no seal stands behind.
function coverageTuples(kilnDir, sealedPrefix) {
  const seals = sealState(kilnDir)
  if (!seals.complete) throw new Error('the seal ledger carries a torn or unparseable line — coverage is never authored from a history with a hole')
  return sealedPrefix.map((slice) => currentSealTuple(seals, kilnDir, slice))
}

// Hash the RAW bytes of an evidence image for a perceptual-screen contract — a Buffer digest, so a
// 0xff byte is covered exactly and never utf8-decoded. Unreadable HOLDs (throws); the image paths are
// already realpath-contained by screenEvidence, so this is the byte-capture the manifest digest alone
// cannot prove.
function hashImageBytes(abs) {
  let bytes
  try {
    bytes = readFileSync(abs)
  } catch (error) {
    throw new Error(`a screen evidence image could not be read for its digest: ${error.message}`)
  }
  return createHash('sha256').update(bytes).digest('hex')
}

// The perceptual-screen contract facts: the screen packet body with the attached and reference images
// resolved to ORDERED {name, sha256} arrays (evidence order preserved) and the evidence-manifest
// digest named distinctly from any FORK-3 control manifest.
function screenContractFacts(packetBody, generation, evidence) {
  const attached_images = evidence.imageNames.map((name, i) => ({ name, sha256: hashImageBytes(evidence.images[i]) }))
  const reference_images = attached_images.slice(evidence.imageNames.length - evidence.references.length)
  return {
    law_lock_hash: packetBody.law_lock_hash,
    evidence_manifest_sha256: generation.digest,
    generation: generation.number,
    perceptual_criteria: packetBody.perceptual_criteria,
    rubric: packetBody.rubric,
    attached_images,
    reference_images,
    meta: packetBody.meta,
    console_log: packetBody.console_log,
    dom_excerpt: packetBody.dom_excerpt,
  }
}

// The ONE composer every transport shares: assemble the closed payload for a kind+operation from
// trusted facts, canonicalize, digest. A kind or operation outside the closed set THROWS (a caller
// bug, never a silent accept). Returns { contract, bytes, sha }.
function composeContract(kind, operation, facts) {
  const ops = CONTRACT_OPERATIONS[kind]
  if (!ops) throw new Error(`contract kind ${kind} is outside the closed set`)
  if (!ops.includes(operation)) throw new Error(`contract operation ${operation} is not valid for ${kind}`)
  let payload
  if (kind === 'slice-review') {
    payload = {
      contract_version: CONTRACT_VERSION,
      contract_kind: kind,
      operation,
      slice_id: facts.slice_id,
      law_hash: facts.law_hash,
      law_text: facts.law_text,
      builder_hints: facts.builder_hints,
      receipt_sha256: facts.receipt_sha256,
      reviewed_manifest: facts.reviewed_manifest,
    }
    if (operation === 'recheck') {
      payload.finding_ids = sortedFindingIds(facts.finding_ids)
      payload.prior_findings = facts.prior_findings
      payload.repair_delta = facts.repair_delta
    }
  } else if (kind === 'milestone-audit') {
    payload = {
      contract_version: CONTRACT_VERSION,
      contract_kind: kind,
      operation,
      law_hash: facts.law_hash,
      seam_slice: facts.seam_slice,
      milestone: facts.milestone,
      closing_block: facts.closing_block,
      sealed_prefix: facts.sealed_prefix,
      covered: facts.covered,
      receipt_sha256: facts.receipt_sha256,
    }
    if (operation === 'recheck') {
      payload.finding_ids = sortedFindingIds(facts.finding_ids)
      payload.prior_findings = facts.prior_findings
      payload.repair_delta = facts.repair_delta
    }
  } else if (kind === 'artifact-ratify') {
    // W2-S7a (F4): purpose is a CLOSED set — the ratify family word, never an arbitrary review family.
    // Enforced HERE so both transports (the codex ratify verbs and contract-prepare) reject uniformly;
    // a caller copying a review family like screen into purpose is a caller bug, never a silent accept.
    if (facts.purpose !== 'ratify' && facts.purpose !== 'feasibility') {
      throw new Error(`artifact-ratify purpose must be ratify or feasibility, not ${facts.purpose}`)
    }
    payload = {
      contract_version: CONTRACT_VERSION,
      contract_kind: kind,
      operation,
      purpose: facts.purpose,
      artifact_path: facts.artifact_path,
      artifact_sha256: facts.artifact_sha256,
      artifact: facts.artifact,
      rubric: facts.rubric,
      receipt_sha256: null,
    }
    if (operation === 'recheck') {
      payload.finding_ids = sortedFindingIds(facts.finding_ids)
      payload.prior_findings = facts.prior_findings
    }
  } else {
    // perceptual-screen: escalation carries the survivor rows in perceptual_criteria (the caller filters
    // them), and — W2-S7a (F1) — ALSO the scoped cohort exactly as recheck does: the sorted finding_ids
    // and ordered prior_findings drawn from the held verdict. Without the cohort two held verdicts with
    // different findings but identical surviving criteria compose identical bytes, and the kernel would
    // have to recover the missing authority from the mutable prior gate.
    payload = {
      contract_version: CONTRACT_VERSION,
      contract_kind: kind,
      operation,
      law_lock_hash: facts.law_lock_hash,
      evidence_manifest_sha256: facts.evidence_manifest_sha256,
      generation: facts.generation,
      perceptual_criteria: facts.perceptual_criteria,
      rubric: facts.rubric,
      attached_images: facts.attached_images,
      reference_images: facts.reference_images,
      meta: facts.meta,
      console_log: facts.console_log,
      dom_excerpt: facts.dom_excerpt,
    }
    if (operation === 'recheck' || operation === 'escalation') {
      payload.finding_ids = sortedFindingIds(facts.finding_ids)
      payload.prior_findings = facts.prior_findings
    }
  }
  const bytes = canonicalBytes(payload)
  return { contract: payload, bytes, sha: createHash('sha256').update(bytes).digest('hex') }
}

const contractStoreFile = (kilnDir, sha) => join(kilnDir, CONTRACT_DIR, 'sha256', sha + '.json')

// ── W2-S7b (items 6-8): the candidate attestations ───────────────────────────────────────────────
// A MODERN candidate is only ever appended over evidence this CLI validated itself. A REVIEWED
// candidate binds BY REFERENCE to exactly one fully valid reviews.jsonl row: that single reference
// carries all four S7a captures — the check receipt, the reviewer identity, the control-derived
// manifest and the canonical contract — so none of their bodies is duplicated onto the ledger row
// (D4 closes by reference, not by copy). A VERDICTLESS candidate had no gate at all, so it carries
// its own validated digests instead, and the kind itself is the whole no-review reason (D3). Every
// non-pending validation happens ONCE, here at the append; promotion later re-checks only what can
// still change — pending identity, eligibility, coverage — and never rehashes an advanced tree.
const GATE_FILE = { review: 'gate-review.json', audit: 'audit-review.json' }

// The LIVE trio, verified in the act of reading it (the run-checks discipline): a drifted member is
// the integrity class and holds at 22, so no candidate is ever attested over a law that moved.
function liveTrioDigests(kilnDir, label) {
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', `${label} requires the sealed law`, TRANSPORT_FAILURE)
  const digests = {}
  for (const name of TRIO_MEMBERS) digests[name] = createHash('sha256').update(verifyMember(auth, kilnDir, name, label)).digest('hex')
  return { lockHash: auth.lockHash, digests }
}

// Parse the FIXED gate file of a family into the reference key a reviewed candidate binds by. The
// published verdict must be an ACCEPT — a candidate attested by a verdict that did not pass is the
// forgery this reference exists to make impossible. verdict_sha256 digests the EXACT published bytes
// (the Buffer, never a utf8 re-encode), the same key archiveVerdict filed the row under.
function reviewedReference(kilnDir, family) {
  let bytes
  try {
    bytes = readFileSync(join(kilnDir, GATE_FILE[family]))
  } catch (error) {
    return { error: `the published ${family} verdict could not be read for the candidate reference: ${error.message}` }
  }
  let verdict
  try {
    verdict = JSON.parse(bytes.toString('utf8'))
  } catch (error) {
    return { error: `the published ${family} verdict could not be parsed for the candidate reference: ${error.message}` }
  }
  if (!isObject(verdict) || typeof verdict.review_id !== 'string' || verdict.review_id.trim() === '') {
    return { error: `the published ${family} verdict carries no review_id` }
  }
  if (verdict.verdict !== 'accept') {
    return { error: `the published ${family} verdict is not an accept — no candidate is attested by a verdict that did not pass` }
  }
  return { ref: { family, review_id: verdict.review_id, verdict_sha256: createHash('sha256').update(bytes).digest('hex') } }
}

// Select EXACTLY ONE archive row by the reference key. Zero rows means the verdict on disk was never
// archived (a torn publish); more than one is contradictory history. Either way the append HOLDs
// rather than bind a candidate to a row it cannot name uniquely.
function referencedArchiveRow(kilnDir, ref) {
  let raw = ''
  try {
    raw = readFileSync(join(kilnDir, REVIEWS_FILE), 'utf8')
  } catch (error) {
    if (error.code !== 'ENOENT') return { error: `the review archive could not be read: ${error.message}` }
  }
  const matched = []
  for (const line of raw.split('\n')) {
    if (line.trim() === '') continue
    let row
    try { row = JSON.parse(line) } catch { continue }
    if (isObject(row) && row.family === ref.family && row.review_id === ref.review_id && row.verdict_sha256 === ref.verdict_sha256) matched.push(row)
  }
  if (matched.length !== 1) return { error: 'the referenced verdict does not match exactly one archived review row' }
  return { row: matched[0] }
}

// The evidence a reviewed archive row must OWN before it can attest anything: the accept verdict, a
// reviewer identity this ledger knows in the reviewer-class role of its family, a NON-NULL receipt
// digest, and the canonical contract the gate judged, still whole in the store. A missing or
// malformed field is a row written before a capture existed or outside the trusted path — it attests
// nothing, so the append HOLDs rather than seal on a reference that proves less than it claims.
function archiveRowEvidenceInvalid(kilnDir, row, family) {
  if (row.verdict !== 'accept') return 'the archived row is not an accept'
  if (typeof row.reviewer_leg_id !== 'string' || !LEG_ID.test(row.reviewer_leg_id)) return 'the archived row carries no reviewer identity'
  const leg = identityIndex(kilnDir).legs.get(row.reviewer_leg_id)
  if (!leg) return 'the archived reviewer identity is unknown to the identity ledger'
  if (leg.role !== CODEX_ROLE[family]) return 'the archived reviewer identity does not carry the reviewer role of its family'
  if (!LAW_HASH.test(row.receipt_sha256)) return 'the archived row carries no check-receipt digest'
  if (!LAW_HASH.test(row.contract_sha256)) return 'the archived row carries no canonical contract digest'
  return verifyContractStore(kilnDir, row.contract_sha256)
}

function readStoredContract(kilnDir, sha) {
  let contract
  try {
    contract = JSON.parse(readFileSync(contractStoreFile(kilnDir, sha), 'utf8'))
  } catch (error) {
    return { error: `the referenced contract could not be read: ${error.message}` }
  }
  if (!isObject(contract)) return { error: 'the referenced contract is not a JSON object' }
  return { contract }
}

// The reviewed SEAL attestation, validated before the manifest recompute so the recompute stays the
// last operation before the append. It returns the reference the row carries and the manifest digest
// the archive row bound — the caller proves that digest is still what the tree yields. The contract
// SEMANTICS are parsed, not trusted: the judged contract must name THIS slice, the law sealed right
// now, the same receipt the row bound, and the same manifest, so a contract that judged something
// else can never attest this candidate.
function reviewedSealAttestation(kilnDir, slice, lockHash) {
  const reference = reviewedReference(kilnDir, 'review')
  if (reference.error) return reference
  const archived = referencedArchiveRow(kilnDir, reference.ref)
  if (archived.error) return archived
  const row = archived.row
  const evidence = archiveRowEvidenceInvalid(kilnDir, row, 'review')
  if (evidence) return { error: evidence }
  if (!LAW_HASH.test(row.manifest_sha256)) return { error: 'the archived row carries no control-derived manifest digest' }
  const read = readStoredContract(kilnDir, row.contract_sha256)
  if (read.error) return read
  const contract = read.contract
  if (contract.contract_kind !== 'slice-review') return { error: 'the referenced contract is not a slice review' }
  if (contract.slice_id !== slice) return { error: 'the referenced contract judged another slice' }
  if (contract.law_hash !== lockHash) return { error: 'the referenced contract judged another law than the one sealed now' }
  if (contract.receipt_sha256 !== row.receipt_sha256) return { error: 'the referenced contract judged another check receipt than the archived row bound' }
  let judged
  try {
    judged = canonicalDigest(contract.reviewed_manifest)
  } catch (error) {
    return { error: `the referenced contract carries an unserializable reviewed manifest: ${error.message}` }
  }
  if (judged !== row.manifest_sha256) return { error: 'the referenced contract judged another working-tree manifest than the archived row bound' }
  // The reference names the identity the ARCHIVE ROW owns, never the one argv offered: that is the
  // leg that actually reviewed, and it is what promotion is made to wait on.
  return { ref: { ...reference.ref, reviewer_leg_id: row.reviewer_leg_id }, manifestSha256: row.manifest_sha256 }
}

// The reviewed AUDIT attestation, the symmetric form. An audit binds no manifest of its own: its
// working-tree evidence IS the ordered coverage its contract judged, and the serialized append RELIES
// on that just-prepared contract rather than re-deriving the current tuples a second time — currency
// is re-proved once, at promotion, and the reduction refuses membership to any audit whose coverage
// has stopped matching. What IS validated here is the coverage the row will carry: well-formed
// tuples, and every covered member at a real generation — a generation 0 is an absence, and an audit
// never claims to have covered a slice nothing seals.
function reviewedAuditAttestation(kilnDir, seam, lockHash) {
  const reference = reviewedReference(kilnDir, 'audit')
  if (reference.error) return reference
  const archived = referencedArchiveRow(kilnDir, reference.ref)
  if (archived.error) return archived
  const row = archived.row
  const evidence = archiveRowEvidenceInvalid(kilnDir, row, 'audit')
  if (evidence) return { error: evidence }
  if (!LAW_HASH.test(row.receipt_sha256)) return { error: 'the archived row carries no check-receipt digest' }
  const read = readStoredContract(kilnDir, row.contract_sha256)
  if (read.error) return read
  const contract = read.contract
  if (contract.contract_kind !== 'milestone-audit') return { error: 'the referenced contract is not a milestone audit' }
  if (contract.seam_slice !== seam) return { error: 'the referenced contract judged another seam' }
  if (contract.law_hash !== lockHash) return { error: 'the referenced contract judged another law than the one sealed now' }
  if (contract.receipt_sha256 !== row.receipt_sha256) return { error: 'the referenced contract judged another check receipt than the archived row bound' }
  if (coverageInvalid(contract.covered)) return { error: 'the referenced contract carries no well-formed ordered coverage' }
  if (contract.covered.some((tuple) => tuple.generation < 1)) return { error: 'the referenced contract covers a slice with no current sealed membership' }
  return { ref: { ...reference.ref, reviewer_leg_id: row.reviewer_leg_id }, covered: contract.covered }
}

// Is a stored ordered coverage still exactly the current seal tuples? The PROMOTION check (item 7):
// seals may have moved while an audit identity resolved, so the one moment membership is conferred is
// the one moment currency is re-proved. The comparison is canonical, not byte-exact: two structurally
// identical tuple lists compare equal whatever key order they were written in. A torn manifest store
// surfaces as an error, never as a silent mismatch.
function coverageStillCurrent(kilnDir, covered) {
  try {
    const seals = sealState(kilnDir)
    if (!seals.complete) return { error: 'the seal ledger carries a torn or unparseable line — coverage is never proven against a history with a hole' }
    const fresh = covered.map((tuple) => currentSealTuple(seals, kilnDir, tuple.slice))
    return { current: canonicalDigest(covered) === canonicalDigest(fresh) }
  } catch (error) {
    return { error: `the current seal tuples could not be derived for the coverage check: ${error.message}` }
  }
}

// Join the archive-bound reviewer identity to the candidate. The identity that actually reviewed is
// the one promotion must wait on, so an argv leg naming anyone else is a claim the append refuses
// outright, and a bound leg that is still a pending intent makes the row PROVISIONAL whatever argv
// offered. Without this a candidate could take membership while the reviewer its reference names was
// never resolved — a seal whose review nobody can prove happened. The bound leg rides the reference,
// so promotion tracks it from the row itself.
function bindAttestedIdentity(kilnDir, row, argvLeg, verb) {
  const bound = row.review_ref.reviewer_leg_id
  if (typeof argvLeg === 'string' && LEG_ID.test(argvLeg) && argvLeg !== bound) {
    stop('transport_failure', `${verb} was handed a reviewer identity the referenced review does not name — refusing to bind a review to another leg`, TRANSPORT_FAILURE)
  }
  const idx = identityIndex(kilnDir)
  const leg = idx.legs.get(bound)
  if (!leg) stop('transport_failure', `${verb} cannot find the referenced reviewer identity in the identity ledger`, TRANSPORT_FAILURE)
  if (leg.kind === 'intent' && !idx.resolvedIds.has(bound)) {
    row.provisional = true
    if (typeof row.candidate_id !== 'string') row.candidate_id = randomBytes(16).toString('hex')
  }
}

// The VERDICTLESS attestation (item 8): the kind IS the reason, so there is no gate file, no review
// row and no contract to reference. The candidate carries its own validated evidence instead — the
// live trio digests, the current check receipt, and (checked by the caller after the recompute) the
// manifest of this generation. Its builder identities are validated in the leg block, exactly as any
// other seal, so a degraded seal still names who built it.
function verdictlessAttestation(kilnDir, trio) {
  const receipt = receiptDigestAtPublication(kilnDir, 'review')
  if (receipt.error) return receipt
  if (receipt.digest === null) return { error: 'no check receipt stands behind the verdictless seal' }
  return { fields: { trio_sha256: trio, receipt_sha256: receipt.digest } }
}

// Commit the contract bytes CONTENT-ADDRESSED (wx), the baseline/prepared discipline: an identical
// name whose bytes still hash to it is an idempotent no-op; a name colliding with foreign bytes is a
// torn store that THROWS, never a silent accept.
function writeContractStore(kilnDir, bytes, sha) {
  const dir = join(kilnDir, CONTRACT_DIR, 'sha256')
  mkdirSync(dir, { recursive: true })
  const path = contractStoreFile(kilnDir, sha)
  commitContentAddressed(path, bytes, sha, 'content-addressed contract', 'contract')
}

// Compose and store in one step; the built { bytes, sha } feed the embed and the publication binding.
function prepareContract(kilnDir, kind, operation, facts) {
  const built = composeContract(kind, operation, facts)
  writeContractStore(kilnDir, built.bytes, built.sha)
  return built
}

// The publication binding every transport runs before it archives and renames: the store entry named
// by the supplied digest must exist and its bytes must re-hash to that digest. Returns null on match,
// an error string on any fault so the caller fails closed.
function verifyContractStore(kilnDir, sha) {
  if (typeof sha !== 'string' || !LAW_HASH.test(sha)) return `the supplied contract digest is not a 64-hex digest`
  let bytes
  try {
    bytes = readFileSync(contractStoreFile(kilnDir, sha))
  } catch (error) {
    return `the contract store entry is missing or unreadable: ${error.message}`
  }
  if (createHash('sha256').update(bytes).digest('hex') !== sha) {
    return 'the contract store entry does not match the supplied digest — a torn or mismatched contract'
  }
  return null
}

const [mode, ...args] = process.argv.slice(2)
if (mode === 'review' && args.length === 8) {
  // W2-S4: the AUTHORITATIVE facts ride argv (the audit-verb pattern) and the sealed trio —
  // repo, kilnDir, the named slice, the reviewer model, alias and effort (kernel-resolved from
  // validated tiers), then the builder request (hints only) and the output. law_hash and
  // law_text derive from the sealed LAW; the builder authors neither. W2-S7a (B-D1): the alias
  // rides adjacent to the model as the durable tiers fact the codex identity records.
  const [repoPath, kilnDir, sliceId, model, alias, effort, requestFile, outputFile] = args
  const request = auditRequest(model, alias, effort, 'review')
  const facts = buildGateFacts(kilnDir, sliceId)
  const packet = {
    mode: 'review',
    review_id: randomUUID(),
    slice_id: sliceId,
    law_hash: facts.lawHash,
    law_text: facts.lawText,
    builder_hints: hintsFrom(requestFile),
  }
  invoke(repository(repoPath), kilnDir, request, packet, outputFile)
} else if (mode === 'recheck' && args.length === 10) {
  const [repoPath, kilnDir, sliceId, model, alias, effort, requestFile, priorFile, repairDeltaFile, outputFile] = args
  const request = auditRequest(model, alias, effort, 'recheck')
  const facts = buildGateFacts(kilnDir, sliceId)
  const hints = hintsFrom(requestFile)
  const prior = readJson(priorFile, 'invalid prior gate review')
  const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
  const priorError = priorShape ? validateShape(prior, prior.review_id, prior.law_hash) : 'prior gate review is malformed'
  if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
  if (prior.verdict !== 'changes_required') {
    stop('transport_failure', 'recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
  }
  // The recheck rides the SEALED law hash, and the prior round rode the same seal (a LAW edit
  // is a reopen, never a silent recheck), so the two must agree; a disagreement is a torn cohort.
  if (prior.law_hash !== facts.lawHash) stop('transport_failure', 'the sealed LAW hash differs from the prior review', TRANSPORT_FAILURE)

  let repairDelta
  try {
    repairDelta = readFileSync(resolve(repairDeltaFile), 'utf8')
  } catch (error) {
    stop('transport_failure', `invalid repair delta: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (repairDelta.trim() === '') stop('transport_failure', 'repair delta must not be empty', TRANSPORT_FAILURE)

  const findingIds = new Set(prior.findings.map((finding) => finding.id))
  const packet = {
    mode: 'recheck',
    review_id: prior.review_id,
    slice_id: sliceId,
    law_hash: facts.lawHash,
    law_text: facts.lawText,
    builder_hints: hints,
    finding_ids: [...findingIds],
    // FIX-1: every recheck packet carries the prior findings IN FULL beside their ids —
    // a fresh-context reviewer cannot verify resolution from bare ids (fatal on
    // ratify-recheck, whose reviewer sees only the artifact text). Context only; the
    // finding_ids cohort rule is unchanged.
    prior_findings: prior.findings,
    repair_delta: repairDelta,
  }
  invoke(repository(repoPath), kilnDir, request, packet, outputFile, findingIds)
} else if (mode === 'gate-facts' && args.length === 4) {
  // W2-S4 (B02/B03/B04): the ONE authority the claude gate leg shares with the codex packet. The
  // kernel claude reviewer is an agent, not this CLI, so it cannot run sealedAuthority itself; it
  // calls here. buildGateFacts binds law_hash to the CROSS-BOUND sealed trio (trio[LAW.md] ===
  // lock.hash === lock.seal digest) and holds TRIO_MISMATCH on any torn or swapped seal — so a
  // lock.hash quietly changed to a valid-but-different digest never rides an accept. hintsFrom
  // FILTERS the builder request to its four hint fields, written to a trusted facts file the
  // reviewer reads instead of the raw request, so a forged law_text/slice_id/law_hash or an
  // injected instruction field never reaches the model. The cross-bound digest prints to stdout
  // for the kernel to bind and to validate the reviewer echo against.
  const [kilnDir, sliceId, requestFile, outputFile] = args
  const facts = buildGateFacts(kilnDir, sliceId)
  const hints = hintsFrom(requestFile)
  const output = resolve(outputFile)
  const temporary = join(dirname(output), `.gate-facts.tmp-${process.pid}-${randomUUID()}`)
  writeFileSync(temporary, JSON.stringify({ slice_id: sliceId, builder_hints: hints }, null, 2))
  renameSync(temporary, output)
  process.stdout.write(facts.lawHash + '\n')
  process.exit(ACCEPT)
} else if (mode === 'append-seal' && (args.length === 3 || args.length === 5 || args.length === 6 || args.length === 7)) {
  // The recovered v3 "Thoth scribe": an opaque, trusted seal-append verb. The kernel courier calls
  // it instead of a bare shell append it declines to moralize; the seal ledger semantics live here.
  // Closed label, nonempty slice. W2-S6: the row lands in seals.jsonl (the append-only truth) and
  // seals.log is re-rendered from it as the current-valid projection. reconcile FIRST so a crash
  // between a prior append and its render, or a W1 project whose seals.log predates the JSONL, is
  // healed before this append reads the ledger. The row carries the run_id from the CLI-owned lock
  // (S5) and an ISO stamp.
  // W2-S7a (ruling A-prime): a FIFTH and SIXTH argv word carry the generation leg references —
  // builder_leg_ids as a comma list (build + repair legs) and a reviewer position (a leg_id — a
  // claude gate-reviewer leg, or the codex reviewer leg the kernel read from the gate sidecar; the -
  // sentinel only for the verdictless no-gate degraded-ui seal). Every supplied leg must EXIST with
  // a role consistent with its position and a matching run_id. When ANY
  // referenced Claude leg is a still-pending intent the row is written PROVISIONAL with a
  // candidate_id — it renders no membership until capture-and-finalize promotes it. When every
  // referenced leg is already resolved (a codex reviewer) the row is non-provisional.
  // W2-S11 (Sol r1 003): the short arities are boundary-guarded COMPATIBILITY SURFACE, kept for the
  // test surface that exercises them. Production never mints a kind-less row through them — the
  // kernel supplies an attestation kind at both of its append sites (kernel.js:2691 seal, :2260
  // audit) — and once a ledger carries any modern event, a kind-less candidate is refused outright
  // at the append (the boundary stop below at :1919, pinned by kiln-review.test.mjs:3941). So they
  // guard no reachable production hazard. Retiring them is a TEST-SURFACE decision, unscheduled and
  // unowned: it closes no demonstrated defect and earns a slice only when a wave shows its cost.
  // This comment deliberately makes NO claim about how many producers a kind-less row has. Two
  // earlier versions of it did — first about shell callers, then about sole production — and both
  // were false; the enumerations cited here were run against these bytes, not inherited.
  // W2-S7a (FORK 3): a SIXTH argv word carries the repo — the seal RECOMPUTES the control-derived
  // manifest immediately before the candidate write and REJECTS any drift, so a gate-side mutation or
  // a change between publication and seal cannot inherit the review. A prepared manifest for the slice
  // generation with no repo arg would silence the check, so it HOLDs; no prepared manifest is a legacy
  // append (the S6-era seals stay byte-identical).
  // W2-S7b (items 6 and 8): a SEVENTH argv word carries the attestation kind — reviewed, or the
  // closed verdictless-degraded-ui. It makes the candidate MODERN: reviewed binds by reference to the
  // one accepted reviews row (and through it to the receipt, the reviewer identity, the manifest and
  // the contract), verdictless carries its own validated trio, receipt and manifest digests. The kind
  // is what makes the two distinguishable on the wire, and the first modern candidate closes the
  // legacy shape for this ledger — every later candidate must declare its kind too.
  const [kilnDir, slice, label, builderCsv, reviewerRef, repoArg, attestationKind] = args
  if (label !== 'dual' && label !== 'single-family') {
    stop('transport_failure', 'append-seal label must be dual or single-family', TRANSPORT_FAILURE)
  }
  if (typeof slice !== 'string' || slice.trim() === '') {
    stop('transport_failure', 'append-seal slice id must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (attestationKind !== undefined && !SEAL_KINDS.has(attestationKind)) {
    stop('transport_failure', `append-seal attestation kind must be one of ${[...SEAL_KINDS].join('|')}`, TRANSPORT_FAILURE)
  }
  // A verdictless seal had no gate, so it can have been handed no reviewer. The field is ABSENT on
  // the row (item 8), which means a supplied leg would otherwise be silently dropped — it is refused
  // instead, so the caller learns its call contradicted itself.
  if (attestationKind === 'verdictless-degraded-ui' && reviewerRef !== '-') {
    stop('transport_failure', 'append-seal was handed a reviewer leg for a verdictless seal — a seal with no gate names no reviewer', TRANSPORT_FAILURE)
  }
  const sealRow = { type: 'seal', slice, label, run_id: runIdFromLock(kilnDir), ts: new Date().toISOString() }
  if (args.length >= 5) {
    const runId = runIdFromLock(kilnDir)
    const idx = identityIndex(kilnDir)
    const builderLegs = builderCsv === '' ? [] : builderCsv.split(',')
    for (const legId of builderLegs) {
      const leg = idx.legs.get(legId)
      if (!LEG_ID.test(legId) || !leg) stop('transport_failure', 'append-seal builder leg is unknown to the identity ledger', TRANSPORT_FAILURE)
      if (!BUILDER_LEG_ROLES.has(leg.role)) stop('transport_failure', 'append-seal builder leg role is not a build-class leg', TRANSPORT_FAILURE)
      if (leg.run_id !== runId) stop('transport_failure', 'append-seal builder leg belongs to another run', TRANSPORT_FAILURE)
    }
    if (reviewerRef !== '-') {
      const leg = idx.legs.get(reviewerRef)
      if (!LEG_ID.test(reviewerRef) || !leg) stop('transport_failure', 'append-seal reviewer leg is unknown to the identity ledger', TRANSPORT_FAILURE)
      // W2-S7a (B-CODEX-ROLE): position validation is uniform — a codex leg in the seal reviewer
      // position must carry the gate-reviewer role, exactly as a claude leg must; no kind bypass.
      if (leg.role !== 'gate-reviewer') stop('transport_failure', 'append-seal reviewer leg is not a gate-reviewer leg', TRANSPORT_FAILURE)
      if (leg.run_id !== runId) stop('transport_failure', 'append-seal reviewer leg belongs to another run', TRANSPORT_FAILURE)
    }
    const referenced = reviewerRef === '-' ? builderLegs : [...builderLegs, reviewerRef]
    const pending = referenced.some((legId) => idx.legs.get(legId).kind === 'intent' && !idx.resolvedIds.has(legId))
    sealRow.builder_leg_ids = builderLegs
    // Item 8 forbids the reviewer-leg FIELD on a verdictless candidate — literal absence, since a
    // null is still a claim about a reviewer that never existed.
    if (attestationKind !== 'verdictless-degraded-ui') sealRow.reviewer_leg_id = reviewerRef === '-' ? null : reviewerRef
    if (pending) {
      sealRow.provisional = true
      sealRow.candidate_id = randomBytes(16).toString('hex')
    }
  }
  // M-05: reconcile FIRST, so the manifest recompute is LITERALLY the last operation before the
  // candidate append — the unprotected interval between the drift check and the write is minimal.
  reconcileLedger(kilnDir, SEAL_LEDGER)
  // W2-S7b: the modern attestation is validated HERE, before the recompute, so the recompute keeps
  // its place as the last operation. Everything it proves is immutable evidence (a published verdict,
  // an archived row, a stored contract); the one fact that can still move is the working tree, and
  // that is exactly what the recompute below re-establishes.
  let attested = null
  if (attestationKind !== undefined) {
    const trio = liveTrioDigests(kilnDir, 'append-seal')
    attested = attestationKind === 'reviewed'
      ? reviewedSealAttestation(kilnDir, slice, trio.lockHash)
      : verdictlessAttestation(kilnDir, trio.digests)
    if (attested.error) stop('transport_failure', `append-seal: ${attested.error}`, TRANSPORT_FAILURE)
    sealRow.attestation_kind = attestationKind
    if (attested.ref) {
      sealRow.review_ref = attested.ref
      bindAttestedIdentity(kilnDir, sealRow, reviewerRef, 'append-seal')
    }
    if (attested.fields) Object.assign(sealRow, attested.fields)
  }
  // W2-S7a (FORK 3): recompute the manifest and reject drift immediately before the append — nothing
  // seals over a diff the review no longer matches. With a repo the recompute enforces the match (a
  // legacy pass only when the generation was never started); with no repo but a STARTED generation
  // (M-02: key.json present), the bypass HOLDs.
  if (repoArg !== undefined) {
    const drift = manifestRecompute(kilnDir, repository(repoArg), slice)
    if (drift.error) stop('transport_failure', drift.error, TRANSPORT_FAILURE)
    if (attested !== null) {
      // A modern candidate always stands on a prepared manifest: a legacy generation has no
      // control-derived delta to attest, and a digest that no longer matches the tree is the drift
      // the seal exists to refuse.
      if (drift.value.sha === null) {
        stop('transport_failure', 'append-seal found no prepared manifest for this generation — an attested candidate is never appended over a legacy generation', TRANSPORT_FAILURE)
      }
      if (attestationKind === 'reviewed' && drift.value.sha !== attested.manifestSha256) {
        stop('transport_failure', 'append-seal: the archived manifest digest differs from the manifest recomputed at the seal', TRANSPORT_FAILURE)
      }
      if (attestationKind === 'verdictless-degraded-ui') sealRow.manifest_sha256 = drift.value.sha
    }
  } else {
    const started = manifestGenerationStarted(kilnDir, slice)
    if (started.error) stop('transport_failure', started.error, TRANSPORT_FAILURE)
    if (started.value) {
      stop('transport_failure', 'append-seal found a started manifest generation but no repo to recompute it — refusing to seal past the drift check', TRANSPORT_FAILURE)
    }
  }
  appendLedgerRow(kilnDir, SEAL_LEDGER, sealRow)
  // Seals first, audits second: a fresh seal generation can retire an audit whose coverage named the
  // one it replaced, so the audit projection is re-derived before this verb returns.
  reconcileLedger(kilnDir, AUDIT_LEDGER)
  process.exit(ACCEPT)
} else if (mode === 'invalidate' && args.length === 2) {
  // W2-S7b (item 1): the ONE atomic batch cutoff event, and the only way membership is ever
  // withdrawn. One event serves both callers — a single target for reopen, the whole covered prefix
  // for a milestone rejection — so a rejection can never leave half a prefix invalidated. The cutoff
  // for each target is DERIVED here, never supplied: it is that slices MAXIMUM historical candidate
  // ordinal, so every candidate it has ever had, rendered or provisional, falls below it and the
  // rebuild takes the next ordinal. Cutoffs only ever rise. A retry that would change nothing — every
  // target already covered by an equal-or-higher cutoff, with no newer candidate since — appends
  // nothing and reports the no-op, so a crash between the append and its render costs nothing.
  const [kilnDir, sliceCsv] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'invalidate kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const slices = sliceCsv === '' ? [] : sliceCsv.split(',')
  if (slices.length === 0 || slices.some((slice) => !STATE_SLICE_ID.test(slice))) {
    stop('transport_failure', 'invalidate takes a nonempty comma list of slice ids', TRANSPORT_FAILURE)
  }
  if (new Set(slices).size !== slices.length) {
    stop('transport_failure', 'invalidate targets must be distinct — one cutoff per slice in the batch', TRANSPORT_FAILURE)
  }
  reconcileLedger(kilnDir, SEAL_LEDGER)
  const read = readLedgerRows(join(kilnDir, SEAL_LEDGER.jsonl))
  if (read === null) {
    stop('transport_failure', 'invalidate found no seal ledger — there is no membership to withdraw', TRANSPORT_FAILURE)
  }
  if (!read.complete) {
    stop('transport_failure', 'invalidate refuses an incomplete seal ledger read — a cutoff derived from a history with a hole could leave a candidate standing', TRANSPORT_FAILURE)
  }
  const state = reduceLedger(kilnDir, SEAL_LEDGER, read)
  const targets = []
  let covered = 0
  for (const slice of slices) {
    const bucket = state.groups.get(slice)
    if (bucket === undefined) {
      stop('transport_failure', 'invalidate names a slice with no seal candidate — nothing to withdraw', TRANSPORT_FAILURE)
    }
    const through = bucket.length
    const already = state.cutoffs.get(slice) ?? 0
    if (already > through) {
      stop('transport_failure', 'invalidate found a cutoff above the historical candidate count — the seal ledger cannot have shrunk', TRANSPORT_FAILURE)
    }
    if (already === through) covered += 1
    targets.push({ slice, through_generation: through })
  }
  if (covered === targets.length) {
    process.stdout.write('invalidate noop ' + targets.length + '\n')
    process.exit(ACCEPT)
  }
  appendLedgerRow(kilnDir, SEAL_LEDGER, {
    type: 'invalidate', targets, run_id: runIdFromLock(kilnDir), ts: new Date().toISOString(),
  })
  // Seals first, audits second: an audit whose coverage named an invalidated generation is no longer
  // current, and its projection must reflect that before this verb returns.
  reconcileLedger(kilnDir, AUDIT_LEDGER)
  process.stdout.write('invalidate appended ' + targets.length + '\n')
  process.exit(ACCEPT)
} else if (mode === 'seal-law' && args.length === 2) {
  // The trusted LAW lock, content-blind. W2-S3: the seal now covers the whole trio —
  // LAW.md, law/check.sh and slices.json — each digested individually into
  // .kiln/law/trio.hash (fixed order, strict shape). A missing member is a transport stop:
  // the law is not whole enough to seal. lock.hash stays exactly the LAW.md digest a card
  // shell computes via `sha256sum .kiln/LAW.md | cut -d' ' -f1` (64-hex + one trailing
  // newline — audit and screen require that shape); S4-D4: the family label
  // (dual|single-family) rides the DIGEST-BOUND sidecar .kiln/law/lock.seal = `<digest>
  // <label>`. trio.hash is promoted FIRST, then lock.seal, then lock.hash, so a reseal never
  // leaves a stale trio or label beside a fresh lock — the sidecar-ordering discipline one
  // member deeper.
  const [kilnDir, label] = args
  if (label !== 'dual' && label !== 'single-family') {
    stop('transport_failure', 'seal-law label must be dual or single-family', TRANSPORT_FAILURE)
  }
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'seal-law kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const memberDigests = {}
  for (const name of TRIO_MEMBERS) {
    try {
      memberDigests[name] = createHash('sha256').update(readFileSync(trioMemberPath(kilnDir, name))).digest('hex')
    } catch (error) {
      stop('transport_failure', `seal-law could not read the trio member ${name}: ${error.message}`, TRANSPORT_FAILURE)
    }
  }
  const digest = memberDigests['LAW.md']
  const target = join(kilnDir, 'law', 'lock.hash')
  const sidecar = join(kilnDir, 'law', 'lock.seal')
  const trio = trioHashPath(kilnDir)
  try {
    mkdirSync(dirname(target), { recursive: true })
    const trioTemporary = join(dirname(trio), `.trio.hash.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(trioTemporary, TRIO_MEMBERS.map((name) => `${name} ${memberDigests[name]}\n`).join(''))
    renameSync(trioTemporary, trio)
    const sidecarTemporary = join(dirname(sidecar), `.lock.seal.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(sidecarTemporary, `${digest} ${label}\n`)
    renameSync(sidecarTemporary, sidecar)
    const temporary = join(dirname(target), `.lock.hash.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(temporary, `${digest}\n`)
    renameSync(temporary, target)
  } catch (error) {
    stop('transport_failure', `seal-law could not write the seal: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.exit(ACCEPT)
} else if (mode === 'run-checks' && args.length === 1) {
  // W2-S3 (B04): the fused verify-and-run. ONE trusted operation replaces the bare
  // `bash .kiln/law/check.sh` hands wherever a sealed trio exists — sealedAuthority confirms
  // the whole cross-bound seal, every live member is re-verified against law/trio.hash, and
  // ONLY on a complete match does check.sh execute in-process (argv spawn, no shell string).
  // EXIT LAW: a torn or partial seal, or a live file drifted from its sealed digest, exits
  // TRIO_MISMATCH (22) — the integrity class the kernel holds on at every post-seal site, so
  // check.sh NEVER runs. TRANSPORT_FAILURE (20) is reserved for an unsealed law (a seal is
  // required here) or a genuine check.sh spawn fault AFTER a verified seal. On a match check.sh
  // streams its stdout verbatim and its exit code passes through, so every consumer of the
  // check output — the owning-slice ids the red path prints on stdout, and the kernel-side
  // receipt capture — keeps working unchanged.
  const [kilnDir] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-checks kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) {
    stop('transport_failure', 'run-checks requires the sealed law — the law must be sealed before its checks run', TRANSPORT_FAILURE)
  }
  for (const name of TRIO_MEMBERS) {
    let live
    try {
      live = createHash('sha256').update(readFileSync(trioMemberPath(kilnDir, name))).digest('hex')
    } catch (error) {
      stop('trio_mismatch', `run-checks: the sealed trio member ${name} could not be read — a torn seal; check.sh will not run`, TRIO_MISMATCH)
    }
    if (live !== auth.trio[name]) {
      stop('trio_mismatch', `run-checks: ${name} no longer matches the sealed law/trio.hash digest — check.sh will not run`, TRIO_MISMATCH)
    }
  }
  const check = spawnSync('bash', [trioMemberPath(kilnDir, 'check.sh')], { stdio: 'inherit' })
  if (check.error) {
    stop('transport_failure', `run-checks could not execute check.sh: ${check.error.message}`, TRANSPORT_FAILURE)
  }
  process.exit(check.status === null ? TRANSPORT_FAILURE : check.status)
} else if (mode === 'slices' && args.length === 1) {
  // W2-S3 (B03): the fused build-order fetch. verify-and-parse slices.json against the sealed
  // trio in ONE operation, then print the descriptor projection the kernel dispatches builders
  // from — a bare id string, or "obj|<id>|<surface>|<milestone>". The build stage is always
  // sealed, so an unsealed law holds; a tampered slices.json is a TRIO_MISMATCH hold, so a
  // write-capable builder is never dispatched over drifted facts. The projection is
  // byte-compatible with the former node -p leg the kernel slices:fetch used.
  const [kilnDir] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'slices kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'slices requires the sealed law — the build order is only fetched after the seal', TRANSPORT_FAILURE)
  let slices
  try {
    slices = JSON.parse(verifyMember(auth, kilnDir, 'slices.json', 'slices').toString('utf8'))
  } catch (error) {
    stop('transport_failure', `invalid slices projection: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (!Array.isArray(slices)) stop('transport_failure', 'slices.json must be a JSON array', TRANSPORT_FAILURE)
  const proj = slices.map((s) => (typeof s === 'string'
    ? s
    : 'obj|' + String((s && s.id) || '') + '|' + String((s && s.surface) || '') + '|' + String((s && s.milestone) || '')))
  process.stdout.write(JSON.stringify(proj))
  process.exit(ACCEPT)
} else if (mode === 'screen-criteria' && args.length === 1) {
  // W2-S3 (B04): the Perceptual criterion ids for the claude screen ownership enforcement,
  // derived over VERIFIED LAW.md — screenLawFacts fuses the read with the sealed-trio check,
  // so the ids the kernel enforces rest on sealed bytes, not a raw re-read.
  const [kilnDir] = args
  const facts = screenLawFacts(kilnDir)
  process.stdout.write(JSON.stringify(facts.rows.map((r) => r.criterion)))
  process.exit(ACCEPT)
} else if (mode === 'perceptual-family' && args.length === 1) {
  // W2-S3 (B04): the perceptual family routing, over the VERIFIED trio — exit 0 iff a
  // ui-surfaced slice owns a Perceptual row (the GPT screen family), else 1. The
  // write-capable screen routing rests on sealed bytes; a torn seal holds (TRIO_MISMATCH).
  const [kilnDir] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'perceptual-family kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'perceptual-family requires the sealed law', TRANSPORT_FAILURE)
  const facts = screenLawFacts(kilnDir)
  let slices
  try {
    slices = JSON.parse(verifyMember(auth, kilnDir, 'slices.json', 'perceptual-family').toString('utf8'))
  } catch (error) {
    stop('transport_failure', `invalid slices projection: ${error.message}`, TRANSPORT_FAILURE)
  }
  const surf = {}
  for (const s of (Array.isArray(slices) ? slices : [])) {
    if (typeof s === 'string') surf[s.trim()] = 'mixed'
    else surf[String((s && s.id) || '').trim()] = String((s && s.surface) || '').trim()
  }
  process.exit(facts.rows.some((r) => surf[r.slice] === 'ui') ? 0 : 1)
} else if (mode === 'ratify' && args.length === 5) {
  // Ratify a readable artifact against a rubric — the reusable "review an artifact
  // against a rubric" path whose first consumer is the not-yet-sealed LAW. There is
  // no locked digest to compare against yet (the seal is written only after accept),
  // so this path never runs the slice's locked-LAW equality; it asserts the echoed
  // law_hash against the artifact's OWN candidate digest, computed exactly as seal-law
  // computes lock.hash so the ratified bytes and the sealed digest are byte-identical.
  // W2-S5: this ONE verb serves two review families (the kernel LAW ratify and the
  // research-sweep feasibility ratify), so the archive family rides argv — the caller
  // that knows which review this is passes the label the verdict is filed under.
  // W2-S7a (F5): kilnDir is now an EXPLICIT argv word (the ratify family alone lacked one) — the
  // trust root runGate binds the store and archive to, no longer inferred from the output path.
  const [repoPath, kilnDir, requestFile, outputFile, family] = args
  const request = ratifyRequestFrom(requestFile)
  const repo = repository(repoPath)
  // W2-S8: the artifact path is the ONE path this verb still takes from the request the model
  // wrote, so it is proven inside the repository before it is opened; the rubric is shipped.
  const rubric = shippedRubric(family, 'ratify')
  const artifactPath = containedPath(repo, request.artifact, 'ratify artifact')
  let artifactBytes
  try {
    artifactBytes = readFileSync(artifactPath)
  } catch (error) {
    stop('transport_failure', `ratify artifact unreadable: ${error.message}`, TRANSPORT_FAILURE)
  }
  const candidateDigest = createHash('sha256').update(artifactBytes).digest('hex')
  const packet = {
    mode: 'ratify',
    review_id: request.reviewId,
    law_hash: candidateDigest,
    rubric,
    artifact: artifactBytes.toString('utf8'),
  }
  // W2-S7a (FORK 1): the artifact-ratify contract — purpose is the ratify family word, the artifact
  // path and its candidate digest, the exact artifact text the reviewer grades, and the rubric
  // criteria. receipt_sha256 is null by contract; ratify judges an artifact against a rubric, no receipt.
  let contract
  try {
    contract = composeContract('artifact-ratify', 'initial', {
      purpose: family, artifact_path: request.artifact, artifact_sha256: candidateDigest,
      artifact: packet.artifact, rubric,
    })
  } catch (error) {
    stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
  }
  runGate(repo, request, ratifyInstructions(packet, contract.bytes), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id)
    if (shape) return shape
    if (gate.law_hash !== candidateDigest) return 'law_hash does not match the ratified artifact digest'
    return null
  }, family, undefined, packet.review_id, contract, kilnDir)
} else if (mode === 'ratify-recheck' && args.length === 6) {
  // W6-02: the ratify verb gains the cohort lineage it lacked. A recheck of an
  // already-graded artifact reuses the prior review_id and constrains the reviewer to
  // the prior finding cohort — the SAME allowedFindingIds + prior changes_required
  // discipline the build recheck enforces (validateShape's out-of-scope rule), so a
  // ratify repair round cannot introduce a finding id out of nowhere. The artifact is
  // regenerated between rounds (the LAW-ratify repair rewrites the whole LAW), so
  // law_hash tracks the CURRENT artifact digest, not the prior one; the reused
  // review_id carries the lineage instead.
  // W2-S7a (F5): kilnDir is an EXPLICIT argv word, threaded to runGate as the trust root.
  const [repoPath, kilnDir, requestFile, priorFile, outputFile, family] = args
  const request = ratifyRequestFrom(requestFile)
  const prior = readJson(priorFile, 'invalid prior ratify review')
  const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
  const priorError = priorShape ? validateShape(prior, prior.review_id, prior.law_hash) : 'prior ratify review is malformed'
  if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
  if (prior.verdict !== 'changes_required') {
    stop('transport_failure', 'ratify-recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
  }
  if (prior.review_id !== request.reviewId) {
    stop('transport_failure', 'ratify-recheck request review_id differs from the prior review', TRANSPORT_FAILURE)
  }
  const repo = repository(repoPath)
  const rubric = shippedRubric(family, 'ratify-recheck')
  const artifactPath = containedPath(repo, request.artifact, 'ratify artifact')
  let artifactBytes
  try {
    artifactBytes = readFileSync(artifactPath)
  } catch (error) {
    stop('transport_failure', `ratify artifact unreadable: ${error.message}`, TRANSPORT_FAILURE)
  }
  const candidateDigest = createHash('sha256').update(artifactBytes).digest('hex')
  const findingIds = new Set(prior.findings.map((finding) => finding.id))
  const packet = {
    mode: 'ratify-recheck',
    review_id: request.reviewId,
    law_hash: candidateDigest,
    rubric,
    artifact: artifactBytes.toString('utf8'),
    finding_ids: [...findingIds],
    prior_findings: prior.findings,
  }
  // W2-S7a (FORK 1): the recheck contract adds the sorted finding_ids cohort and the prior findings.
  let contract
  try {
    contract = composeContract('artifact-ratify', 'recheck', {
      purpose: family, artifact_path: request.artifact, artifact_sha256: candidateDigest,
      artifact: packet.artifact, rubric, finding_ids: packet.finding_ids, prior_findings: prior.findings,
    })
  } catch (error) {
    stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
  }
  runGate(repo, request, ratifyInstructions(packet, contract.bytes), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, undefined, findingIds)
    if (shape) return shape
    if (gate.law_hash !== candidateDigest) return 'law_hash does not match the ratified artifact digest'
    return null
  }, family, undefined, packet.review_id, contract, kilnDir)
} else if (mode === 'audit' && args.length === 7) {
  // W7-A1: the milestone-seam audit — one fresh goal-backward GPT reviewer over the
  // cumulative sealed prefix. argv carries closed facts only; every derived fact — the
  // closing block, the cumulative prefix, the milestone label (which may contain spaces
  // and rides only inside the composed prompt, never argv, never a log line) — is
  // computed here from the checked slices.json projection. law_hash binds to the sealed
  // lock.hash, the review_id is minted fresh exactly as review does, and the transport
  // is the review verb's: codex, read-only sandbox, schema-forced output, closed exits.
  // W2-S7a (B-D1): the reviewer alias rides argv beside the model.
  const [repoPath, kilnDir, seamSliceId, model, alias, effort, outputFile] = args
  const request = auditRequest(model, alias, effort)
  const repo = repository(repoPath)
  const facts = auditFacts(kilnDir, seamSliceId)
  const packet = {
    mode: 'audit',
    review_id: randomUUID(),
    law_hash: facts.lawHash,
    seam_slice: seamSliceId,
    milestone: facts.milestone,
    closing_block: facts.closingBlock,
    sealed_prefix: facts.sealedPrefix,
  }
  invokeAudit(repo, kilnDir, request, packet, outputFile)
} else if (mode === 'audit-recheck' && args.length === 9) {
  // W7-A1: the audit recheck mirrors recheck with two deliberate widenings: the prior
  // verdict may be changes_required OR blocked (audit blockers reopen their owning
  // slices, so a blocked milestone is recoverable at this gate), and the law binding is
  // the sealed lock.hash rather than a request law_hash. The cohort is the prior finding
  // ids — reuse-or-clear, no new or renamed ids — and the same audit verb-level shape
  // rules gate the prior (an artifact invalid for the audit family establishes no
  // lineage) and the current output. W2-S7a (B-D1): the alias rides argv beside the model.
  const [repoPath, kilnDir, seamSliceId, model, alias, effort, priorFile, repairDeltaFile, outputFile] = args
  const request = auditRequest(model, alias, effort)
  const repo = repository(repoPath)
  const facts = auditFacts(kilnDir, seamSliceId)
  const prior = readJson(priorFile, 'invalid prior audit review')
  const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
  // The prior must satisfy the FULL audit-family shape — shared validateShape plus the
  // audit verb-level rules — before it can seed a cohort: a blocked prior with empty
  // findings or an orphan blocker id was never a publishable audit, so it cannot
  // establish recheck lineage here either.
  const priorError = priorShape
    ? (validateShape(prior, prior.review_id, prior.law_hash) || auditShapeInvalid(prior))
    : 'prior audit review is malformed'
  if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
  if (prior.verdict !== 'changes_required' && prior.verdict !== 'blocked') {
    stop('transport_failure', 'audit-recheck requires a prior changes_required or blocked verdict', TRANSPORT_FAILURE)
  }
  if (prior.law_hash !== facts.lawHash) {
    stop('transport_failure', 'prior audit law_hash differs from the sealed law/lock.hash', TRANSPORT_FAILURE)
  }
  let repairDelta
  try {
    repairDelta = readFileSync(resolve(repairDeltaFile), 'utf8')
  } catch (error) {
    stop('transport_failure', `invalid repair delta: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (repairDelta.trim() === '') stop('transport_failure', 'repair delta must not be empty', TRANSPORT_FAILURE)
  const findingIds = new Set(prior.findings.map((finding) => finding.id))
  const packet = {
    mode: 'audit-recheck',
    review_id: prior.review_id,
    law_hash: facts.lawHash,
    seam_slice: seamSliceId,
    milestone: facts.milestone,
    closing_block: facts.closingBlock,
    sealed_prefix: facts.sealedPrefix,
    finding_ids: [...findingIds],
    prior_findings: prior.findings,
    repair_delta: repairDelta,
  }
  invokeAudit(repo, kilnDir, request, packet, outputFile, findingIds)
} else if (mode === 'append-audit' && (args.length === 3 || args.length === 4 || args.length === 5 || args.length === 6)) {
  // W7: the ONLY writer of audits.log — append-seal's milestone-seam mirror. The kernel
  // promotes an accepted audit through this trusted verb, never a bare shell append; the
  // audits.log semantics live here. The outcome label is the fixed `accept`, and S4-D4
  // adds the family label (dual|single-family) as a THIRD field: `<seam> accept <label>`.
  // The membership grep anchors the first field only and sealMembers splits on the first
  // field, so a third field is compatible. The seam slice id is gated with the SAME
  // slice-id charset the kernel enforces at slice intake (parseSliceEntry SLICE_ID) — one
  // contract, so every id a build can carry publishes. The id becomes the grep anchor
  // `^<id> `, where whitespace or control bytes could forge or split a log line; slash is
  // inside the set (path-like ids such as feature/ui are anchor-safe).
  // W2-S7a (ruling A-prime + B-AUDIT-REPAIR-REF): a FOURTH argv word carries the auditor leg (a
  // leg_id, or - when the codex auditor identity lives on reviews.jsonl), and an OPTIONAL FIFTH
  // carries a comma list of the audit-repair legs that mutated the sealed content this generation.
  // Every supplied leg must EXIST with a role consistent with its position (B-CODEX-ROLE: uniform,
  // no kind bypass) and a matching run_id. Any still-pending referenced Claude intent makes the row
  // PROVISIONAL with a candidate_id; the legacy three-word arity is byte-identical to today.
  // W2-S7b (item 6, the symmetric form): a SIXTH argv word carries the attestation kind. A reviewed
  // audit binds by reference to the one accepted audit-family reviews row and stores the ORDERED
  // coverage its contract judged — re-derived here from the current seal tuples, so an audit never
  // records a prefix it did not actually cover. Its currency stays DERIVED from that coverage
  // afterwards: no audit invalidation event exists, and none is needed.
  const [kilnDir, seamSliceId, label, auditorRef, repairCsv, attestationKind] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'append-audit kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof seamSliceId !== 'string' || !/^[A-Za-z0-9._/-]+$/.test(seamSliceId)) {
    stop('transport_failure', 'append-audit seam slice id must be nonempty using only letters, digits, dot, underscore, hyphen or slash', TRANSPORT_FAILURE)
  }
  if (label !== 'dual' && label !== 'single-family') {
    stop('transport_failure', 'append-audit label must be dual or single-family', TRANSPORT_FAILURE)
  }
  const auditRow = { type: 'audit', seam: seamSliceId, outcome: 'accept', label, run_id: runIdFromLock(kilnDir), ts: new Date().toISOString() }
  if (args.length >= 4) {
    const runId = runIdFromLock(kilnDir)
    const idx = identityIndex(kilnDir)
    const referenced = []
    if (auditorRef !== '-') {
      const leg = idx.legs.get(auditorRef)
      if (!LEG_ID.test(auditorRef) || !leg) stop('transport_failure', 'append-audit auditor leg is unknown to the identity ledger', TRANSPORT_FAILURE)
      if (leg.role !== 'auditor') stop('transport_failure', 'append-audit auditor leg is not an auditor leg', TRANSPORT_FAILURE)
      if (leg.run_id !== runId) stop('transport_failure', 'append-audit auditor leg belongs to another run', TRANSPORT_FAILURE)
      auditRow.auditor_leg_id = auditorRef
      referenced.push(auditorRef)
    } else {
      auditRow.auditor_leg_id = null
    }
    if (args.length >= 5) {
      const repairLegs = repairCsv === '' ? [] : repairCsv.split(',')
      for (const legId of repairLegs) {
        const leg = idx.legs.get(legId)
        if (!LEG_ID.test(legId) || !leg) stop('transport_failure', 'append-audit repair leg is unknown to the identity ledger', TRANSPORT_FAILURE)
        if (leg.role !== 'audit-repair' && leg.role !== 'repair') stop('transport_failure', 'append-audit repair leg is not a repair-class leg', TRANSPORT_FAILURE)
        if (leg.run_id !== runId) stop('transport_failure', 'append-audit repair leg belongs to another run', TRANSPORT_FAILURE)
      }
      auditRow.repair_leg_ids = repairLegs
      referenced.push(...repairLegs)
    }
    const pending = referenced.some((legId) => idx.legs.get(legId).kind === 'intent' && !idx.resolvedIds.has(legId))
    if (pending) {
      auditRow.provisional = true
      auditRow.candidate_id = randomBytes(16).toString('hex')
    }
  }
  if (attestationKind !== undefined && !AUDIT_KINDS.has(attestationKind)) {
    stop('transport_failure', `append-audit attestation kind must be one of ${[...AUDIT_KINDS].join('|')}`, TRANSPORT_FAILURE)
  }
  // W2-S6: the row lands in audits.jsonl (append-only truth) and audits.log is re-rendered from it
  // as the current-valid projection, exactly as append-seal treats the seal ledger. reconcile first
  // so a stale or un-migrated audits.log never misleads this append — seals FIRST, since the audit
  // projection is derived from the current seal tuples.
  reconcileLedgers(kilnDir)
  if (attestationKind !== undefined) {
    const trio = liveTrioDigests(kilnDir, 'append-audit')
    const attested = reviewedAuditAttestation(kilnDir, seamSliceId, trio.lockHash)
    if (attested.error) stop('transport_failure', `append-audit: ${attested.error}`, TRANSPORT_FAILURE)
    auditRow.attestation_kind = attestationKind
    auditRow.review_ref = attested.ref
    auditRow.covered = attested.covered
    bindAttestedIdentity(kilnDir, auditRow, auditorRef, 'append-audit')
  }
  appendLedgerRow(kilnDir, AUDIT_LEDGER, auditRow)
  process.exit(ACCEPT)
} else if (mode === 'reconcile' && args.length === 1) {
  // W2-S6 (B06): the trusted reconcile the kernel calls once at boot before its membership reads,
  // and the append verbs call on entry. Renders seals.log and audits.log from their JSONL truth when
  // stale or absent, migrating a W1 legacy .log into JSONL first. Idempotent and content-blind — an
  // absent ledger reconciles to nothing, so a fresh project creates no empty projection.
  const [kilnDir] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'reconcile kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  reconcileLedgers(kilnDir)
  process.exit(ACCEPT)
} else if (mode === 'audit-member' && args.length === 2) {
  // W2-S7b (item 11): the audited-skip answer, derived from the SAME reduction that renders the
  // projection — no membership-bearing decision is ever taken by string-matching a rendered line.
  // stdout carries the current members ORDERED covered slice ids, so the caller can require that the
  // audit SPANS the prefix it is about to skip: without that, a narrower covered audit re-elected once
  // the wider one went stale would render the seam audited over a slice nothing ever judged.
  // Read-only — it writes nothing, not even a reconcile; the caller reconciles at boot.
  // The two answers are TAGGED and disjoint: `covered:<csv>` for a coverage-carrying member,
  // `legacy` alone for a coverage-less W1 one. Untagged, they share a namespace — a slice may
  // legitimately be NAMED legacy, so a modern audit covering exactly that slice would be read as the
  // coverage-less answer and skip a milestone it never spanned.
  // This line is injective because BOTH its separators are excluded by the id grammar, and the
  // argument needs both halves: STATE_SLICE_ID admits no COLON, so no csv of slice ids can forge the
  // `covered:` tag, and it admits no COMMA, so a single covered name can never be read as two. The
  // comma half rests on coverageInvalid holding every covered name to that grammar — a looser check
  // there makes one slice named `a,b` serialize exactly like the two slices a and b.
  const [kilnDir, seam] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'audit-member kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof seam !== 'string' || !STATE_SLICE_ID.test(seam)) {
    stop('transport_failure', 'audit-member seam must be a slice id', TRANSPORT_FAILURE)
  }
  // EVERY read on the way to an answer is caught, not merely the first: the reduction consults the
  // SEAL ledger and the manifest store to decide currency, and any of them can throw. An uncaught
  // throw exits node with code 1 — the exact code this verb reserves for a PROVEN absence — so a
  // faulted read would reach the caller as no current member and send it into a re-audit over a
  // ledger nothing could read. Exit 1 is reachable ONLY from the deliberate null answer below.
  let answer
  try {
    const read = readLedgerRows(join(kilnDir, AUDIT_LEDGER.jsonl))
    if (read === null) {
      answer = null
    } else {
      const state = reduceLedger(kilnDir, AUDIT_LEDGER, read)
      if (!state.complete) {
        stop('transport_failure', 'audit-member refuses an incomplete read — a hole in the audit ledger, or in the seal ledger its currency derives from, could hide a current member', TRANSPORT_FAILURE)
      }
      const member = state.current.get(seam)
      const covered = member === undefined ? undefined : member.row.covered
      answer = member === undefined ? null
        : Array.isArray(covered) ? 'covered:' + covered.map((tuple) => tuple.slice).join(',')
        : 'legacy'
    }
  } catch (error) {
    stop('transport_failure', `audit-member could not derive the current audit member: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (answer === null) process.exit(NO_MEMBER)
  process.stdout.write(answer + '\n')
  process.exit(ACCEPT)
} else if (mode === 'manifest-start' && args.length === 3) {
  // W2-S7a (FORK 3): capture the immutable baseline of a slice generation before its first builder
  // mutation, so dirty or untracked pre-run files are attributed to the baseline, never the slice. The
  // generation derives from the seal count; the baseline is content-addressed under
  // .kiln/manifests/<sha256(slice)>/gen-<N>/ and reused verbatim on a resume. Any capture or write
  // fault holds transport 20. stdout is one line of closed facts: <generation> <baseline_sha256>.
  const [repoPath, kilnDir, slice] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'manifest-start kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof slice !== 'string' || !STATE_SLICE_ID.test(slice)) {
    stop('transport_failure', 'manifest-start slice must be a slice-id charset token', TRANSPORT_FAILURE)
  }
  const started = manifestStart(kilnDir, repository(repoPath), slice)
  if (started.error) stop('transport_failure', started.error, TRANSPORT_FAILURE)
  process.stdout.write(started.value + '\n')
  process.exit(ACCEPT)
} else if (mode === 'manifest-prepare' && args.length === 3) {
  // W2-S7a (FORK 3): capture the after-snapshot, diff it against the immutable baseline, and publish a
  // content-addressed manifest plus the current.json pointer. The generation's baseline MUST exist
  // (manifest-start runs first) — a missing one is a wiring bug that holds. stdout is one line of
  // closed facts: <generation> <manifest_sha256>.
  const [repoPath, kilnDir, slice] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'manifest-prepare kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof slice !== 'string' || !STATE_SLICE_ID.test(slice)) {
    stop('transport_failure', 'manifest-prepare slice must be a slice-id charset token', TRANSPORT_FAILURE)
  }
  const prepared = manifestPrepare(kilnDir, repository(repoPath), slice)
  if (prepared.error) stop('transport_failure', prepared.error, TRANSPORT_FAILURE)
  process.stdout.write(prepared.value + '\n')
  process.exit(ACCEPT)
} else if (mode === 'contract-prepare' && args.length >= 4) {
  // W2-S7a (FORK 1): the trusted contract composer the CLAUDE reviewer legs run BEFORE dispatch. It
  // derives the SAME authoritative facts the matching codex verb embeds (buildGateFacts, hintsFrom,
  // auditFacts, coverageTuples, the ratify artifact + its shipped rubric, the screen evidence), composes
  // and content-addresses the canonical contract, and prints its digest as the ONE closed stdout fact
  // the kernel threads into the reviewer prompt and the publish-gate binding. The kind-specific args
  // MIRROR the matching gate verb argv minus model, alias, effort and the output path. Any derivation,
  // read, image-hash, or store fault holds transport 20 — an unattested contract never binds a publish.
  const [repoPath, kilnDir, kind, operation, ...rest] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'contract-prepare kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const repo = repository(repoPath)
  let built
  try {
    if (kind === 'slice-review') {
      const [sliceId, requestFile, priorFile, repairDeltaFile] = rest
      if (typeof sliceId !== 'string' || !STATE_SLICE_ID.test(sliceId)) {
        stop('transport_failure', 'contract-prepare slice must be a slice-id charset token', TRANSPORT_FAILURE)
      }
      const gf = buildGateFacts(kilnDir, sliceId)
      const receipt = receiptDigestAtPublication(kilnDir, 'review')
      if (receipt.error) stop('transport_failure', receipt.error, TRANSPORT_FAILURE)
      const facts = sliceReviewFacts(kilnDir, {
        slice_id: sliceId, law_hash: gf.lawHash, law_text: gf.lawText,
        builder_hints: hintsFrom(requestFile), receipt_sha256: receipt.digest,
      })
      if (operation === 'recheck') {
        // W2-S7a (F2): the SAME prior-eligibility the codex recheck verb enforces — full shape, an
        // eligible changes_required verdict, the sealed-law binding, and a nonempty repair delta.
        const prior = readJson(priorFile, 'invalid prior gate review')
        const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
        const priorError = priorShape ? validateShape(prior, prior.review_id, prior.law_hash) : 'prior gate review is malformed'
        if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
        if (prior.verdict !== 'changes_required') stop('transport_failure', 'contract-prepare recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
        if (prior.law_hash !== gf.lawHash) stop('transport_failure', 'contract-prepare recheck prior law_hash differs from the sealed law', TRANSPORT_FAILURE)
        let repairDelta
        try {
          repairDelta = readFileSync(resolve(repairDeltaFile), 'utf8')
        } catch (error) {
          stop('transport_failure', `contract-prepare invalid repair delta: ${error.message}`, TRANSPORT_FAILURE)
        }
        if (repairDelta.trim() === '') stop('transport_failure', 'contract-prepare repair delta must not be empty', TRANSPORT_FAILURE)
        facts.finding_ids = [...new Set(prior.findings.map((finding) => finding.id))]
        facts.prior_findings = prior.findings
        facts.repair_delta = repairDelta
      }
      built = prepareContract(kilnDir, kind, operation, facts)
    } else if (kind === 'milestone-audit') {
      const [seamSliceId, priorFile, repairDeltaFile] = rest
      const af = auditFacts(kilnDir, seamSliceId)
      const receipt = receiptDigestAtPublication(kilnDir, 'audit')
      if (receipt.error) stop('transport_failure', receipt.error, TRANSPORT_FAILURE)
      const facts = milestoneAuditFacts(kilnDir, {
        law_hash: af.lawHash, seam_slice: seamSliceId, milestone: af.milestone,
        closing_block: af.closingBlock, sealed_prefix: af.sealedPrefix, receipt_sha256: receipt.digest,
      })
      if (operation === 'recheck') {
        // W2-S7a (F2): the SAME prior-eligibility the codex audit-recheck verb enforces — full audit
        // shape, an eligible changes_required OR blocked verdict, the sealed-law binding, a nonempty delta.
        const prior = readJson(priorFile, 'invalid prior audit review')
        const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
        const priorError = priorShape ? (validateShape(prior, prior.review_id, prior.law_hash) || auditShapeInvalid(prior)) : 'prior audit review is malformed'
        if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
        if (prior.verdict !== 'changes_required' && prior.verdict !== 'blocked') stop('transport_failure', 'contract-prepare audit recheck requires a prior changes_required or blocked verdict', TRANSPORT_FAILURE)
        if (prior.law_hash !== af.lawHash) stop('transport_failure', 'contract-prepare audit recheck prior law_hash differs from the sealed law', TRANSPORT_FAILURE)
        let repairDelta
        try {
          repairDelta = readFileSync(resolve(repairDeltaFile), 'utf8')
        } catch (error) {
          stop('transport_failure', `contract-prepare invalid repair delta: ${error.message}`, TRANSPORT_FAILURE)
        }
        if (repairDelta.trim() === '') stop('transport_failure', 'contract-prepare repair delta must not be empty', TRANSPORT_FAILURE)
        facts.finding_ids = [...new Set(prior.findings.map((finding) => finding.id))]
        facts.prior_findings = prior.findings
        facts.repair_delta = repairDelta
      }
      built = prepareContract(kilnDir, kind, operation, facts)
    } else if (kind === 'artifact-ratify') {
      const [family, artifactPath, priorFile] = rest
      // W2-S8: the claude transport derives the artifact and the instrument under the SAME two
      // rules the codex verb applies — the shipped rubric its family selects, and an artifact
      // proven inside the repository — so neither transport can contract over facts the other
      // would refuse.
      const rubric = shippedRubric(family, 'contract-prepare ratify')
      const artifactAbs = containedPath(repo, artifactPath, 'contract-prepare ratify artifact')
      let artifactBytes
      try {
        artifactBytes = readFileSync(artifactAbs)
      } catch (error) {
        stop('transport_failure', `contract-prepare ratify artifact unreadable: ${error.message}`, TRANSPORT_FAILURE)
      }
      const facts = {
        purpose: family, artifact_path: artifactPath,
        artifact_sha256: createHash('sha256').update(artifactBytes).digest('hex'),
        artifact: artifactBytes.toString('utf8'), rubric,
      }
      if (operation === 'recheck') {
        // W2-S7a (F2): the SAME prior-eligibility the codex ratify-recheck verb enforces — full shape
        // and an eligible changes_required verdict. ratify binds no law hash (the artifact digest is
        // recomputed per round); the review_id-match is a codex-request concern the claude path lacks.
        const prior = readJson(priorFile, 'invalid prior ratify review')
        const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
        const priorError = priorShape ? validateShape(prior, prior.review_id, prior.law_hash) : 'prior ratify review is malformed'
        if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
        if (prior.verdict !== 'changes_required') stop('transport_failure', 'contract-prepare ratify recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
        facts.finding_ids = [...new Set(prior.findings.map((finding) => finding.id))]
        facts.prior_findings = prior.findings
      }
      built = prepareContract(kilnDir, kind, operation, facts)
    } else if (kind === 'perceptual-screen') {
      // W2-S7a (F2): validate the prior/held with the SAME screen-family rules the codex verbs enforce
      // — full shape, the screen table criteria, an eligible changes_required verdict, and (recheck) the
      // fresh-evidence binding — BEFORE deriving the cohort. W2-S7a (F1): both recheck AND escalation
      // carry the scoped cohort from the validated prior/held verdict.
      const [priorOrHeldFile] = rest
      const sf = screenLawFacts(kilnDir)
      const criterionIds = new Set(sf.rows.map((row) => row.criterion))
      const generation = currentGeneration(kilnDir)
      const evidence = screenEvidence(generation)
      let rows = sf.rows
      let cohort = null
      if (operation === 'recheck') {
        const prior = readJson(priorOrHeldFile, 'invalid prior screen review')
        const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
        const priorError = priorShape ? (validateShape(prior, prior.review_id, prior.law_hash, undefined, SCREEN_LOCATION) || screenShapeInvalid(prior, criterionIds)) : 'prior screen review is malformed'
        if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
        if (prior.verdict !== 'changes_required') stop('transport_failure', 'contract-prepare screen recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
        if (generation.digest === prior.law_hash) stop('transport_failure', 'contract-prepare screen recheck requires fresh evidence — the CURRENT manifest digest equals the prior graded generation', TRANSPORT_FAILURE)
        cohort = prior.findings
      } else if (operation === 'escalation') {
        const held = readJson(priorOrHeldFile, 'invalid held screen review')
        const heldShape = isObject(held) && typeof held.review_id === 'string' && typeof held.law_hash === 'string'
        const heldError = heldShape ? (validateShape(held, held.review_id, held.law_hash, undefined, SCREEN_LOCATION) || screenShapeInvalid(held, criterionIds)) : 'held screen review is malformed'
        if (heldError) stop('transport_failure', heldError, TRANSPORT_FAILURE)
        if (held.verdict !== 'changes_required') stop('transport_failure', 'contract-prepare screen escalation requires a held changes_required verdict', TRANSPORT_FAILURE)
        rows = sf.rows.filter((row) => new Set(held.findings.map((finding) => finding.criterion)).has(row.criterion))
        cohort = held.findings
      }
      const body = screenPacket({ ...sf, rows }, generation, evidence)
      const facts = screenContractFacts(body, generation, evidence)
      if (cohort) {
        facts.finding_ids = [...new Set(cohort.map((finding) => finding.id))]
        facts.prior_findings = cohort
      }
      built = prepareContract(kilnDir, kind, operation, facts)
    } else {
      stop('transport_failure', `contract-prepare kind ${kind} is outside the closed set`, TRANSPORT_FAILURE)
    }
  } catch (error) {
    stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.stdout.write(built.sha + '\n')
  process.exit(ACCEPT)
} else if (mode === 'identity-begin' && args.length === 4) {
  // W2-S7a (ruling A-prime): mint a random 128-bit leg_id, append the IMMUTABLE intent, and print
  // `<leg_id> <expected_label>` — the two facts the kernel swaps in as the dispatched agent label.
  // The role is a CLOSED set; requested_alias rides the LOCK_TOKEN charset (the resolved tier alias);
  // subject carries the slice/seam id on the same SLICE_ID charset the kernel enforces at intake. The
  // expected_label is the RESERVED leg: prefix + the id — the one label capture-and-finalize matches
  // in the driver telemetry, minted nowhere else. Any validation or write failure holds transport 20.
  const [kilnDir, role, requestedAlias, subject] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'identity-begin kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!IDENTITY_ROLES.has(role)) {
    stop('transport_failure', `identity-begin role must be one of ${[...IDENTITY_ROLES].join('|')}`, TRANSPORT_FAILURE)
  }
  if (typeof requestedAlias !== 'string' || !LOCK_TOKEN.test(requestedAlias)) {
    stop('transport_failure', 'identity-begin requested_alias must be a closed token of letters, digits, dot, underscore or hyphen', TRANSPORT_FAILURE)
  }
  if (typeof subject !== 'string' || !STATE_SLICE_ID.test(subject)) {
    stop('transport_failure', 'identity-begin subject must be a slice-id charset token', TRANSPORT_FAILURE)
  }
  const legId = randomBytes(16).toString('hex')
  const expectedLabel = 'leg:' + legId
  const err = appendIdentityRow(kilnDir, {
    type: 'intent', run_id: runIdFromLock(kilnDir), leg_id: legId, role,
    requested_alias: requestedAlias, subject, expected_label: expectedLabel, ts: new Date().toISOString(),
  })
  if (err) stop('transport_failure', err, TRANSPORT_FAILURE)
  process.stdout.write(legId + ' ' + expectedLabel + '\n')
  process.exit(ACCEPT)
} else if (mode === 'capture-and-finalize' && (args.length === 1 || args.length === 2)) {
  // W2-S7a (ruling A-prime): the trusted resolution + promotion the conductor runs after EVERY
  // Workflow terminal return, before it emits the beat, launches the next stage, or releases the run
  // lock. It resolves every PENDING intent to exactly ONE completed workflow_progress row in the
  // driver transcript, cross-checks the per-agent transcript, and promotes the provisional seals and
  // audits whose referenced legs have all resolved. Any genuine fault, a per-agent disagreement, or a
  // recovery leg matched in more than one transcript HOLDS transport 20 — an unattested generation
  // never gains membership.
  const [kilnDir, transcriptArg] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'capture-and-finalize kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  // a. Reduce identity through the SINGLE validated index — a schema anomaly or IO fault HOLDs here
  // (B-LEDGER-SCHEMA). resolvedIds accumulates the rows this run writes, so promotion below sees them.
  const { legs, resolvedIds, resolvedCounts, intents } = identityIndex(kilnDir)
  const pending = intents.filter((intent) => !resolvedIds.has(intent.leg_id))
  // b. Locate the driver transcript: an explicit path (a real production affordance, and what
  // recovery and tests use) else the kiln-meter discovery. A LOCATED but unreadable transcript
  // holds; a transcript that could not be found at all falls to the recovery scan below.
  const located = transcriptArg !== undefined ? transcriptArg : discoverDriverTranscript()
  let primaryText = null
  if (located !== undefined && located !== null) {
    try {
      primaryText = readFileSync(located, 'utf8')
    } catch (error) {
      stop('transport_failure', `capture could not read the located driver transcript: ${error.message}`, TRANSPORT_FAILURE)
    }
  }
  const sessionOf = (path) => basename(path).replace(/\.jsonl$/, '')
  const writeResolved = (intent, path, agentId, model) => {
    // W2-S7a (B-CROSSCHECK): a disagreeing OR present-but-unreadable per-agent cross-check source is
    // untrusted evidence and HOLDs; genuine absence resolves with cross_check absent.
    const cross = crossCheckModel(path, agentId, model)
    if (cross === 'disagree') {
      stop('transport_failure', `capture: the per-agent transcript model disagrees with the driver telemetry for leg ${intent.leg_id} — refusing to resolve`, TRANSPORT_FAILURE)
    }
    if (cross === 'unreadable') {
      stop('transport_failure', `capture: the per-agent cross-check source for leg ${intent.leg_id} is present but unreadable — untrusted evidence, the run holds`, TRANSPORT_FAILURE)
    }
    const err = appendIdentityRow(kilnDir, {
      type: 'resolved', run_id: intent.run_id ?? null, leg_id: intent.leg_id, agent_id: agentId,
      resolved_model: model, source: 'workflow_progress', driver_session: sessionOf(path),
      cross_check: cross, ts: new Date().toISOString(),
    })
    if (err) stop('transport_failure', err, TRANSPORT_FAILURE)
    resolvedIds.add(intent.leg_id)
    resolvedCounts.set(intent.leg_id, (resolvedCounts.get(intent.leg_id) ?? 0) + 1)
  }
  // c/d. Resolve each pending leg from the primary transcript. A clean single completed row resolves;
  // a label PRESENT in the primary but dirty or incomplete stays UNRESOLVED (the leg ran here and did
  // not finish cleanly — never recovered from elsewhere); a label ABSENT from the primary falls to
  // recovery.
  let resolvedCount = 0
  const recovery = []
  for (const intent of pending) {
    if (primaryText === null) { recovery.push(intent); continue }
    const scan = scanTranscriptForLabel(primaryText, intent.expected_label)
    if (scan.entries.length === 1 && !scan.malformed) {
      writeResolved(intent, located, scan.entries[0].agentId, scan.entries[0].model)
      resolvedCount += 1
    } else if (!scan.present) {
      recovery.push(intent)
    }
  }
  // Recovery census (B-RECOVERY-CORPUS): a leg is sought across every readable prior transcript, and
  // the HOLD counts EVERY transcript in which the label APPEARS AT ALL — a duplicate or model-less
  // matching transcript is ambiguity that counts, never hidden from the census. More than one
  // matching transcript HOLDs; exactly one matching transcript resolves ONLY if its rows are a clean
  // single completed entry, else it stays UNRESOLVED; none stays pending.
  if (recovery.length > 0) {
    const hits = new Map()
    for (const intent of recovery) hits.set(intent.leg_id, [])
    const primaryResolved = located ? resolve(located) : null
    for (const path of allProjectTranscripts()) {
      if (primaryResolved !== null && resolve(path) === primaryResolved) continue
      let text
      try { text = readFileSync(path, 'utf8') } catch { continue }
      for (const intent of recovery) {
        const scan = scanTranscriptForLabel(text, intent.expected_label)
        if (scan.present) hits.get(intent.leg_id).push({ path, scan })
      }
    }
    for (const intent of recovery) {
      const matched = hits.get(intent.leg_id)
      if (matched.length > 1) {
        stop('transport_failure', `capture recovery: leg ${intent.leg_id} appears in more than one transcript — refusing an ambiguous identity`, TRANSPORT_FAILURE)
      }
      if (matched.length === 1) {
        const { path, scan } = matched[0]
        if (scan.entries.length === 1 && !scan.malformed) {
          writeResolved(intent, path, scan.entries[0].agentId, scan.entries[0].model)
          resolvedCount += 1
        }
      }
    }
  }
  // e. Promote every provisional candidate whose referenced legs have ALL resolved (a codex-identity
  // leg counts as resolved), then reconcile both ledgers so the promoted rows render. A candidate
  // with any pending reference stays provisional — an honest count, no promote row. W2-S7a
  // (B-LEDGER-SCHEMA): a candidate whose candidate_id or leg-ref fields are malformed or EMPTY is a
  // schema anomaly the scan HOLDs on — never a vacuous refs.every() that promotes an unreferenced row.
  const candidateRefs = (cand, descriptor) => {
    if (typeof cand.candidate_id !== 'string' || !LEG_ID.test(cand.candidate_id)) return null
    const hex = (v) => typeof v === 'string' && LEG_ID.test(v)
    const refs = []
    // W2-S7b (B002): the identity the REFERENCE names is a promotion dependency in its own right —
    // it is the leg that actually reviewed, whatever the candidate position was handed. A reviewed
    // candidate therefore never promotes while its reviewer is an unresolved intent.
    if (isObject(cand.review_ref) && hex(cand.review_ref.reviewer_leg_id)) refs.push(cand.review_ref.reviewer_leg_id)
    if (descriptor.type === 'seal') {
      // The builder list may be EMPTY on a reviewed candidate whose only pending identity is the
      // reviewer its reference names; what may never happen is a candidate with no references at
      // all, and the refs.length check below is what forbids that — never a vacuous refs.every().
      if (!Array.isArray(cand.builder_leg_ids) || !cand.builder_leg_ids.every(hex)) return null
      // A verdictless candidate carries no reviewer-leg field at all (item 8), so absence is lawful
      // here; a present field must still be a null or a well-formed leg.
      if (!(cand.reviewer_leg_id === null || cand.reviewer_leg_id === undefined || hex(cand.reviewer_leg_id))) return null
      refs.push(...cand.builder_leg_ids)
      if (hex(cand.reviewer_leg_id)) refs.push(cand.reviewer_leg_id)
    } else {
      if (!(cand.auditor_leg_id === null || cand.auditor_leg_id === undefined || hex(cand.auditor_leg_id))) return null
      if (cand.repair_leg_ids !== undefined && !(Array.isArray(cand.repair_leg_ids) && cand.repair_leg_ids.every(hex))) return null
      if (hex(cand.auditor_leg_id)) refs.push(cand.auditor_leg_id)
      if (Array.isArray(cand.repair_leg_ids)) refs.push(...cand.repair_leg_ids)
    }
    return refs.length === 0 ? null : refs
  }
  // W2-S7b (item 7): a referenced leg counts as resolved only with EXACTLY ONE complete resolved
  // record. A codex leg is resolved by construction — its concrete model was decided at spawn — but
  // two resolved rows for one claude leg is contradictory identity evidence, and contradictory
  // evidence never becomes membership.
  const resolvedOnce = (legId) => {
    const leg = legs.get(legId)
    if (leg !== undefined && leg.kind === 'codex') return true
    return (resolvedCounts.get(legId) ?? 0) === 1
  }
  // W2-S7b (item 7): promotion is the ONE moment a candidate becomes membership, so eligibility is
  // re-derived from the CURRENT reduction — the candidate must still be the LATEST candidate for its
  // key and still above the latest cutoff, and a seal key that already holds an active generation
  // takes no second member. An invalidated or superseded candidate can never resurrect. An audit
  // additionally re-proves its stored coverage against the current seal tuples, since seals may have
  // moved while its identities resolved. Nothing here rehashes the working tree: the tree may have
  // legitimately advanced, and the facts frozen on the candidate at its append are the truth.
  const promotable = (descriptor, state, cand) => {
    const key = descriptor.type === 'seal' ? cand.slice : cand.seam
    const bucket = state.groups.get(key)
    if (bucket === undefined) return false
    const position = bucket.findIndex((entry) => entry.row.candidate_id === cand.candidate_id)
    if (position !== bucket.length - 1) return false
    if (bucket[position].generation <= (state.cutoffs.get(key) ?? 0)) return false
    if (descriptor.type === 'seal') return !state.current.has(key)
    if (!Object.prototype.hasOwnProperty.call(cand, 'covered')) return true
    const still = coverageStillCurrent(kilnDir, cand.covered)
    if (still.error) stop('transport_failure', `capture: ${still.error}`, TRANSPORT_FAILURE)
    return still.current
  }
  const promoteLedger = (descriptor) => {
    const read = readLedgerRows(join(kilnDir, descriptor.jsonl))
    if (read === null) return 0
    if (!read.complete) {
      stop('transport_failure', `${descriptor.jsonl} carries a torn or unparseable line — the promotion scan holds rather than confer membership from an incomplete read`, TRANSPORT_FAILURE)
    }
    const state = reduceLedger(kilnDir, descriptor, read)
    const candidates = []
    for (const row of read.rows) {
      if (isObject(row) && row.provisional === true && row.type === descriptor.type) candidates.push(row)
    }
    let count = 0
    for (const cand of candidates) {
      const refs = candidateRefs(cand, descriptor)
      if (refs === null) {
        stop('transport_failure', `${descriptor.jsonl} carries a provisional candidate with malformed or empty leg references — the promotion scan holds`, TRANSPORT_FAILURE)
      }
      if (state.promoted.has(cand.candidate_id)) continue
      if (refs.every(resolvedOnce) && promotable(descriptor, state, cand)) {
        appendLedgerRow(kilnDir, descriptor, { type: 'promote', candidate_id: cand.candidate_id, run_id: runIdFromLock(kilnDir), ts: new Date().toISOString() })
        count += 1
      }
    }
    return count
  }
  // Seals promote and reduce FIRST, audits second: an audit promoted before its seals would re-prove
  // its coverage against a state one step stale.
  let promoted = 0
  try {
    promoted += promoteLedger(SEAL_LEDGER)
    reconcileLedger(kilnDir, SEAL_LEDGER)
    promoted += promoteLedger(AUDIT_LEDGER)
  } catch (error) {
    stop('transport_failure', `capture could not promote the provisional candidates: ${error.message}`, TRANSPORT_FAILURE)
  }
  reconcileLedgers(kilnDir)
  // f. One line of closed facts.
  process.stdout.write('resolved ' + resolvedCount + ' pending ' + (pending.length - resolvedCount) + ' promoted ' + promoted + '\n')
  process.exit(ACCEPT)
} else if (mode === 'screen' && args.length === 6) {
  // W8-S2: the perceptual screen — one fresh grader over the CURRENT evidence
  // generation's bounded pixels. argv carries closed facts only; the verb derives the
  // LAW Perceptual rows, the sealed lock.hash (packet text), and the CURRENT
  // generation itself. Pre-spawn rejects (exit 20, nothing published, no codex): no
  // CURRENT generation, a manifest missing any required class, any bound exceeded.
  // The transport is the review family's — read-only codex, the byte-untouched
  // review-schema.json, closed exits — plus the manifest's images on `-i`. Binding:
  // the schema's law_hash = sha256 of the graded generation's manifest.json, asserted
  // post-run exactly as ratify asserts its artifact digest. W2-S7a (B-D1): alias beside the model.
  const [repoPath, kilnDir, model, alias, effort, outputFile] = args
  const request = auditRequest(model, alias, effort, 'screen')
  const repo = repository(repoPath)
  const facts = screenLawFacts(kilnDir)
  const generation = currentGeneration(kilnDir)
  const evidence = screenEvidence(generation)
  const criterionIds = new Set(facts.rows.map((row) => row.criterion))
  const body = screenPacket(facts, generation, evidence)
  const packet = {
    mode: 'screen',
    review_id: randomUUID(),
    law_hash: generation.digest,
    ...body,
  }
  // W2-S7a (FORK 1): the perceptual-screen contract — the packet body with the attached and reference
  // images resolved to ordered {name, sha256} arrays over their RAW bytes (the manifest digest alone
  // does not prove the image bytes) and the evidence-manifest digest named distinctly. An unreadable
  // image HOLDs.
  let contract
  try {
    contract = composeContract('perceptual-screen', 'initial', screenContractFacts(body, generation, evidence))
  } catch (error) {
    stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
  }
  runGate(repo, request, screenInstructions(packet, contract.bytes), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, undefined, undefined, SCREEN_LOCATION)
    if (shape) return shape
    if (gate.law_hash !== generation.digest) return 'law_hash does not match the graded generation manifest digest'
    return screenShapeInvalid(gate, criterionIds)
  }, 'screen', evidence.images, String(generation.number), contract, kilnDir)
} else if (mode === 'screen-recheck' && args.length === 8) {
  // W8-S2: the screen recheck — the recheck discipline pointed at fresh pixels. Same
  // review_id lineage, cohort reuse-or-clear over the prior finding ids, and
  // FRESHNESS: the CURRENT manifest digest MUST DIFFER from the prior verdict's
  // law_hash, so a regrade can never re-grade the very evidence that already failed.
  // delta IS the fresh CURRENT manifest: the argv path must resolve to it, and the
  // bytes read must re-hash to the selected digest — path- and digest-bound, so no
  // free text ever rides the packet as repair_delta. W2-S7a (B-D1): alias beside the model.
  const [repoPath, kilnDir, model, alias, effort, priorFile, deltaFile, outputFile] = args
  const request = auditRequest(model, alias, effort, 'screen')
  const repo = repository(repoPath)
  const facts = screenLawFacts(kilnDir)
  const criterionIds = new Set(facts.rows.map((row) => row.criterion))
  const prior = readJson(priorFile, 'invalid prior screen review')
  const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
  // The prior must satisfy the FULL screen-family shape — a blocked verdict, a
  // blocker, or an off-table criterion was never a publishable screen verdict, so it
  // establishes no recheck lineage (the audit-recheck precedent).
  const priorError = priorShape
    ? (validateShape(prior, prior.review_id, prior.law_hash, undefined, SCREEN_LOCATION) || screenShapeInvalid(prior, criterionIds))
    : 'prior screen review is malformed'
  if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
  if (prior.verdict !== 'changes_required') {
    stop('transport_failure', 'screen-recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
  }
  const generation = currentGeneration(kilnDir)
  if (generation.digest === prior.law_hash) {
    stop('transport_failure', 'screen-recheck requires fresh evidence — the CURRENT manifest digest equals the prior graded generation', TRANSPORT_FAILURE)
  }
  const evidence = screenEvidence(generation)
  if (resolve(deltaFile) !== join(generation.dir, 'manifest.json')) {
    stop('transport_failure', 'screen-recheck delta must be the CURRENT generation manifest path', TRANSPORT_FAILURE)
  }
  let deltaBytes
  try {
    deltaBytes = readFileSync(resolve(deltaFile))
  } catch (error) {
    stop('transport_failure', `invalid fresh-manifest delta: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (createHash('sha256').update(deltaBytes).digest('hex') !== generation.digest) {
    stop('transport_failure', 'fresh-manifest delta bytes do not match the CURRENT manifest digest', TRANSPORT_FAILURE)
  }
  const delta = deltaBytes.toString('utf8')
  const findingIds = new Set(prior.findings.map((finding) => finding.id))
  const body = screenPacket(facts, generation, evidence)
  const packet = {
    mode: 'screen-recheck',
    review_id: prior.review_id,
    law_hash: generation.digest,
    ...body,
    finding_ids: [...findingIds],
    prior_findings: prior.findings,
    repair_delta: delta,
  }
  // W2-S7a (FORK 1): the recheck contract adds the sorted finding_ids cohort and the prior findings on
  // the FRESH evidence generation; the repair_delta is transport, not a contract fact.
  let contract
  try {
    contract = composeContract('perceptual-screen', 'recheck', {
      ...screenContractFacts(body, generation, evidence), finding_ids: packet.finding_ids, prior_findings: prior.findings,
    })
  } catch (error) {
    stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
  }
  runGate(repo, request, screenInstructions(packet, contract.bytes), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, undefined, findingIds, SCREEN_LOCATION)
    if (shape) return shape
    if (gate.law_hash !== generation.digest) return 'law_hash does not match the graded generation manifest digest'
    return screenShapeInvalid(gate, criterionIds)
  }, 'screen', evidence.images, String(generation.number), contract, kilnDir)
} else if (mode === 'screen-escalate' && args.length === 7) {
  // W8-S3 (ONLY-survivors): the bounded second-family escalation of a HELD screen
  // verdict. The held verdict rides argv as a closed path; the verb re-validates it
  // with the FULL screen-family shape (an artifact invalid for the family names no
  // survivors), derives the surviving criterion ids from its findings, and packets
  // ONLY the surviving rows — the grader never sees the rest of the table. A fresh
  // review_id: this is a second mind's scoped grade, not a lineage recheck. Scope is
  // enforced pre-publish exactly as table membership is on screen: a finding outside
  // the survivors is exit 20, and the off-scope verdict is never published.
  // W2-S7a (B-D1): the alias rides argv beside the model.
  const [repoPath, kilnDir, model, alias, effort, heldFile, outputFile] = args
  const request = auditRequest(model, alias, effort, 'screen')
  const repo = repository(repoPath)
  const facts = screenLawFacts(kilnDir)
  const criterionIds = new Set(facts.rows.map((row) => row.criterion))
  const held = readJson(heldFile, 'invalid held screen review')
  const heldShape = isObject(held) && typeof held.review_id === 'string' && typeof held.law_hash === 'string'
  const heldError = heldShape
    ? (validateShape(held, held.review_id, held.law_hash, undefined, SCREEN_LOCATION) || screenShapeInvalid(held, criterionIds))
    : 'held screen review is malformed'
  if (heldError) stop('transport_failure', heldError, TRANSPORT_FAILURE)
  if (held.verdict !== 'changes_required') {
    stop('transport_failure', 'screen-escalate requires a held changes_required verdict', TRANSPORT_FAILURE)
  }
  const survivors = new Set(held.findings.map((finding) => finding.criterion))
  const generation = currentGeneration(kilnDir)
  const evidence = screenEvidence(generation)
  const body = screenPacket({ ...facts, rows: facts.rows.filter((row) => survivors.has(row.criterion)) }, generation, evidence)
  const packet = {
    mode: 'screen-escalate',
    review_id: randomUUID(),
    law_hash: generation.digest,
    ...body,
  }
  // W2-S7a (FORK 1 / F1): the escalation contract carries the surviving perceptual rows AND the scoped
  // cohort drawn from the held verdict — the sorted finding_ids and the ordered held findings — so two
  // held verdicts with identical surviving criteria but different findings compose different bytes and
  // the kernel needs no authority from the mutable prior gate.
  let contract
  try {
    contract = composeContract('perceptual-screen', 'escalation', {
      ...screenContractFacts(body, generation, evidence),
      finding_ids: [...new Set(held.findings.map((finding) => finding.id))],
      prior_findings: held.findings,
    })
  } catch (error) {
    stop('transport_failure', `contract: ${error.message}`, TRANSPORT_FAILURE)
  }
  runGate(repo, request, screenInstructions(packet, contract.bytes), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, undefined, undefined, SCREEN_LOCATION)
    if (shape) return shape
    if (gate.law_hash !== generation.digest) return 'law_hash does not match the graded generation manifest digest'
    const shapeInvalid = screenShapeInvalid(gate, criterionIds)
    if (shapeInvalid) return shapeInvalid
    const off = gate.findings.find((finding) => !survivors.has(finding.criterion))
    if (off !== undefined) return `finding ${off.id} criterion ${off.criterion} is outside the surviving escalation scope`
    return null
  }, 'screen', evidence.images, String(generation.number), contract, kilnDir)
} else if (mode === 'publish-gate' && (args.length === 4 || args.length === 5 || args.length === 6 || args.length === 7 || args.length === 8)) {
  // W2-S5 (C3a / B05 / ruling 3): the claude-path publish. The kernel and research-sweep claude
  // legs cannot author files, so they hand this trusted verb the validated candidate they just
  // graded; the verb reads the candidate bytes, archives them to the immutable ledger, THEN renames
  // the candidate over the gate file — the same content-free overwrite the bare mv performed, now
  // with the prior verdict preserved first. The kernel stays content-blind: this verb, not the
  // kernel, parses and digests the bytes. A failed archive fails closed — nothing is renamed, so no
  // verdict is ever published without its archive row. The family rides argv because the caller,
  // not the file path, knows which review family this verdict belongs to (build and LAW ratify
  // share one gate file).
  const [kilnDir, family, candidatePath, gatePath, reviewerLegId] = args
  // W2-S7a (FORK 3): the review family carries the manifest pair (repo, slice) at positions 5 and 6.
  // W2-S7a (FORK 1): the canonical contract digest is ALWAYS the LAST word — position 7 when the
  // manifest pair rides (arity 8, review), position 5 otherwise (arity 6, every other family). The
  // legacy arities (4, 5 leg-only, 7 review+manifest) carry no contract and publish it null.
  const hasManifestPair = args.length === 7 || args.length === 8
  const repoArg = hasManifestPair ? args[5] : undefined
  const sliceArg = hasManifestPair ? args[6] : undefined
  const contractSha256 = args.length === 8 ? args[7] : args.length === 6 ? args[5] : undefined
  // W2-S7a (ruling A-prime): the OPTIONAL trailing reviewer_leg_id is the claude reviewer leg the
  // kernel minted for this gate — it must EXIST in identity.jsonl and a run_id matching this run, or
  // the publish holds. W2-S7a (B-CODEX-ROLE): the role check is UNIFORM and FAMILY-SPECIFIC — the
  // leg role must be the reviewer-class role of this publish family (gate-reviewer for review,
  // auditor for audit, ratifier for ratify/feasibility, screen-grader for screen), no kind bypass.
  // It rides the archive row as reviews.jsonl reviewer_leg_id; the leg is still PENDING at publish
  // (capture-and-finalize resolves it after the workflow returns) — the reference is captured now.
  if (reviewerLegId !== undefined) {
    if (!LEG_ID.test(reviewerLegId)) stop('transport_failure', 'publish-gate reviewer_leg_id must be 32 lowercase hex', TRANSPORT_FAILURE)
    const idx = identityIndex(kilnDir)
    const leg = idx.legs.get(reviewerLegId)
    if (!leg) stop('transport_failure', 'publish-gate reviewer_leg_id is unknown to the identity ledger', TRANSPORT_FAILURE)
    if (leg.role !== CODEX_ROLE[family]) stop('transport_failure', 'publish-gate reviewer_leg_id role does not match this publish family', TRANSPORT_FAILURE)
    if (leg.run_id !== runIdFromLock(kilnDir)) stop('transport_failure', 'publish-gate reviewer_leg_id belongs to another run', TRANSPORT_FAILURE)
  }
  // W2-S7a (FORK 3): the review family recomputes its control-derived manifest before the archive and
  // rename, and archives the matched digest on the row. The kernel supplies the repo and slice as the
  // trailing pair; a prepared manifest with the pair OMITTED would silence the drift check, so it
  // HOLDs (bypass prevention). No prepared manifest for the slice is a legacy publish (null digest).
  // Non-review families carry no manifest — the drift check and the digest are theirs to skip.
  let manifestSha = null
  if (family === 'review') {
    if (repoArg !== undefined) {
      if (typeof sliceArg !== 'string' || !STATE_SLICE_ID.test(sliceArg)) {
        stop('transport_failure', 'publish-gate slice must be a slice-id charset token', TRANSPORT_FAILURE)
      }
      const drift = manifestRecompute(kilnDir, repository(repoArg), sliceArg)
      if (drift.error) stop('transport_failure', drift.error, TRANSPORT_FAILURE)
      manifestSha = drift.value.sha
    } else {
      // Bypass guard, ENOENT-only: a genuinely absent manifest store is a legacy project (null
      // digest, proceed); a present store with the args OMITTED HOLDs; an unreadable store or a file
      // planted where the store belongs is untrusted and HOLDs, never a silent legacy publish.
      const present = manifestResult(() => manifestPathPresent(join(kilnDir, MANIFEST_DIR)))
      if (present.error) stop('transport_failure', present.error, TRANSPORT_FAILURE)
      if (present.value) {
        stop('transport_failure', 'publish-gate review family omitted the repo and slice while control-derived manifests exist — refusing to bypass the drift check', TRANSPORT_FAILURE)
      }
    }
  }
  // W2-S7a (FORK 1): the contract binding, family-agnostic — every contracted publish supplies the
  // digest. The store entry it names must exist and re-hash to it before archive+rename, or the publish
  // HOLDs. A missing digest arg while a contracts store EXISTS is a bypass (HOLD); a legacy project with
  // no .kiln/contracts publishes a null digest exactly as before this unit — the manifest bypass mirror.
  let contractSha = null
  if (contractSha256 !== undefined) {
    const contractError = verifyContractStore(kilnDir, contractSha256)
    if (contractError) stop('transport_failure', contractError, TRANSPORT_FAILURE)
    contractSha = contractSha256
  } else {
    const present = manifestResult(() => manifestPathPresent(join(kilnDir, CONTRACT_DIR)))
    if (present.error) stop('transport_failure', present.error, TRANSPORT_FAILURE)
    if (present.value) {
      stop('transport_failure', 'publish-gate omitted the contract digest while canonical contracts exist — refusing to bypass the contract binding', TRANSPORT_FAILURE)
    }
  }
  let verdictBytes
  try {
    verdictBytes = readFileSync(resolve(candidatePath))
  } catch (error) {
    stop('transport_failure', `publish-gate candidate unreadable: ${error.message}`, TRANSPORT_FAILURE)
  }
  const failure = publishVerdict(kilnDir, family, verdictBytes, { legId: reviewerLegId, manifestSha, contractSha },
    resolve(candidatePath), resolve(gatePath))
  if (failure) {
    stop('transport_failure', failure.step === 'archive' ? failure.message : `publish-gate could not publish: ${failure.message}`, TRANSPORT_FAILURE)
  }
  process.exit(ACCEPT)
} else if (mode === 'state-commit' && args.length >= 6) {
  // W1-S2 (Defect B): the trusted, content-blind STATE.md writer. The courier carries
  // only closed words; this verb validates the transition, derives the next-action prose
  // from the closed key, and stamps updated_at itself. Any invalid word halts by name
  // before any write — a stale or unsupported transition never lands, and no next-action
  // prose ever rode the courier for a leg to refuse.
  // W2-S2 (H6 / B02): the verb now persists a typed canonical .kiln/state.json and renders
  // the eight-line STATE.md (the exact former stateDoc format) FROM it, state.json landing
  // first — see the compose-and-write block below for the crash rule and reconciliation.
  const [kilnDir, token, stage, activeSlice, key, density, ...pointers] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'state-commit kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!STATE_TOKENS.has(token)) {
    stop('transport_failure', `state-commit token must be one of ${[...STATE_TOKENS].join('|')}`, TRANSPORT_FAILURE)
  }
  if (!STATE_STAGES.has(stage)) {
    stop('transport_failure', `state-commit stage must be one of ${[...STATE_STAGES].join('|')}`, TRANSPORT_FAILURE)
  }
  if (activeSlice !== 'none' && !STATE_SLICE_ID.test(activeSlice)) {
    stop('transport_failure', 'state-commit active_slice must be none or a slice id of letters, digits, dot, underscore, hyphen or slash', TRANSPORT_FAILURE)
  }
  if (density !== 'broad' && density !== 'engineer') {
    stop('transport_failure', 'state-commit density must be broad or engineer', TRANSPORT_FAILURE)
  }
  const nextAction = stateNextAction(key, stage, activeSlice)
  if (nextAction === null) {
    stop('transport_failure', 'state-commit next_action_key is not a known key', TRANSPORT_FAILURE)
  }
  // A1: token and key must agree on direction — a forward token (advance, seal-advance)
  // carries only a forward key (run-complete, relaunch-*), a stop token only a stop key.
  // The kernel never emits a contradiction; the trusted verb enforces its own contract so
  // a bypassed or tampered call fails closed.
  const forwardToken = token === 'advance' || token === 'seal-advance'
  const forwardKey = key === 'run-complete' || key.startsWith('relaunch-')
  if (forwardToken !== forwardKey) {
    stop('transport_failure', 'state-commit token and next_action_key disagree on the transition direction', TRANSPORT_FAILURE)
  }
  // B1: every pointer re-validated against the strict repo-relative grammar — no shell
  // metacharacter, whitespace, or parent-escape — belt-and-suspenders behind the kernel
  // filter and the shq quoting. A malformed pointer fails closed, nothing written.
  if (pointers.some((p) => !STATE_POINTER.test(p) || p.includes('..'))) {
    stop('transport_failure', 'state-commit pointers must be repo-relative safe paths', TRANSPORT_FAILURE)
  }
  const updatedAt = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z')
  const seals = '.kiln/seals.log'
  const statePath = join(kilnDir, 'state.json')
  // Read the canonical prior. A present-but-unparseable state.json is transport-class: the
  // canonical ledger is torn and guessing a revision would silently break monotonicity, so we
  // stop before touching disk rather than reset. Absent is the honest legacy/first-write case.
  let prior = null
  if (existsSync(statePath)) {
    let priorRaw
    try {
      priorRaw = readFileSync(statePath, 'utf8')
    } catch (error) {
      stop('transport_failure', `state-commit could not read state.json: ${error.message}`, TRANSPORT_FAILURE)
    }
    try {
      prior = JSON.parse(priorRaw)
    } catch (error) {
      stop('transport_failure', `state-commit found a malformed state.json — refusing to guess the canonical state: ${error.message}`, TRANSPORT_FAILURE)
    }
    if (!isObject(prior)) {
      stop('transport_failure', 'state-commit found a state.json that is not a JSON object — refusing to guess the canonical state', TRANSPORT_FAILURE)
    }
    // A present record MUST carry a positive counter. Resetting a damaged one to 1 would erase
    // monotonic history, so a missing or non-positive revision is torn-ledger, transport-class —
    // stopped BEFORE reconcile so nothing is written. Only a truly ABSENT file starts fresh at 1.
    if (!Number.isSafeInteger(prior.revision) || prior.revision <= 0) {
      stop('transport_failure', 'state-commit found a state.json whose revision is not a positive integer — refusing to reset monotonic history', TRANSPORT_FAILURE)
    }
    reconcileStateDoc(kilnDir, prior)
  }
  const revision = prior === null ? 1 : prior.revision + 1
  // run_id provenance: the CLI reads the CLI-owned run.lock ITSELF — never an argv relay. run_id is
  // trusted ONLY from a record in the CLI-minted W2-S1 shape (run_id + owner in the LOCK_TOKEN
  // grammar, a positive-integer conductor_pid — the same constants the run-lock verbs mint and
  // check against). A syntactically absent/unreadable lock AND a semantically non-conforming object
  // alike record run_id honestly as null (a legacy launch), never an unvalidated model-authorable
  // string dressed as authoritative identity.
  const lock = readLockRecord(join(kilnDir, LOCK_FILE)).record
  const lockConforms = isObject(lock)
    && typeof lock.run_id === 'string' && LOCK_TOKEN.test(lock.run_id)
    && typeof lock.owner === 'string' && LOCK_TOKEN.test(lock.owner)
    && Number.isInteger(lock.conductor_pid) && lock.conductor_pid > 0
  const runId = lockConforms ? lock.run_id : null
  const record = {
    revision,
    stage,
    active_slice: activeSlice,
    next_action_key: key,
    next_action: nextAction,
    density,
    pointers,
    seals,
    run_id: runId,
    updated_at: updatedAt,
  }
  const doc = renderStateDoc(record)
  record.render_digest = createHash('sha256').update(doc).digest('hex')
  // The crash rule: state.json (the canonical truth) lands FIRST, then STATE.md (the rendered
  // projection). If a crash falls between the renames, the reconcile in the next commit heals the
  // view; the reverse order could publish a rendered view with no canonical record behind it.
  try {
    mkdirSync(kilnDir, { recursive: true })
    const stateTmp = join(kilnDir, `.state.json.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(stateTmp, JSON.stringify(record) + '\n')
    renameSync(stateTmp, statePath)
    const docTmp = join(kilnDir, `.STATE.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(docTmp, doc)
    renameSync(docTmp, join(kilnDir, 'STATE.md'))
  } catch (error) {
    stop('transport_failure', `state-commit could not write the canonical state: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.exit(ACCEPT)
} else if (mode === 'run-lock' && args[0] === 'acquire' && args.length === 4) {
  // Acquire the run lock ONCE for a fresh run: an atomic O_EXCL create (writeFileSync with
  // the wx flag) so exactly one acquirer wins. An existing lock is never overwritten here —
  // the caller JOINs it with the token or takes a genuinely stale lock over. run_id + owner
  // print to stdout as the two closed facts the conductor hands every workflow.
  const [, kilnDir, choice, conductorPid] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-lock acquire kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!LOCK_CHOICES.has(choice)) {
    stop('transport_failure', `run-lock acquire choice must be one of ${[...LOCK_CHOICES].join('|')}`, TRANSPORT_FAILURE)
  }
  const pid = Number(conductorPid)
  if (!Number.isInteger(pid) || pid <= 0) {
    stop('transport_failure', 'run-lock acquire conductor pid must be a positive integer', TRANSPORT_FAILURE)
  }
  const version = pluginVersion()
  if (version === null) {
    stop('transport_failure', 'run-lock acquire could not read the plugin version from .claude-plugin/plugin.json', TRANSPORT_FAILURE)
  }
  const target = join(kilnDir, LOCK_FILE)
  // Question economy, never race authority: an already-held lock earns the SAME refusal the wx
  // create below would earn, spoken before the availability probe spends a question on a run this
  // verb was never going to mint. Presence is asked of lstat, so the two readers agree on every
  // shape the create refuses; the record is read only to name the holder. A true race is still
  // arbitrated by the wx create below and by nothing here — the lock is created at exactly two sites
  // in this file, this one and the takeover create, both O_EXCL (count-pinned). A presence question
  // this process cannot answer holds transport-class here, ahead of any probe.
  const presence = lockPresence(kilnDir)
  if (presence === 'indeterminate') {
    stop('transport_failure', 'run-lock acquire could not determine whether a run lock exists — inspect .kiln/run.lock and its directory', TRANSPORT_FAILURE)
  }
  if (presence === 'present') {
    const held = readLockRecord(target).record
    const heldId = held && typeof held.run_id === 'string' ? held.run_id : ''
    stop(heldId, 'run-lock acquire refused: a run lock already exists — join it with the token or take it over if it is stale', LOCK_DENIED)
  }
  refuseWithoutCodex(kilnDir, 'acquire')
  const record = {
    run_id: randomUUID(), owner: randomUUID(), conductor_pid: pid,
    started_at: new Date().toISOString(), ladder_choice: choice, plugin_version: version,
  }
  try {
    mkdirSync(kilnDir, { recursive: true })
    writeFileSync(target, `${JSON.stringify(record)}\n`, { flag: 'wx' })
  } catch (error) {
    if (error.code === 'EEXIST') {
      const holder = readLockRecord(target).record
      const heldId = holder && typeof holder.run_id === 'string' ? holder.run_id : ''
      stop(heldId, 'run-lock acquire refused: a run lock already exists — join it with the token or take it over if it is stale', LOCK_DENIED)
    }
    stop('transport_failure', `run-lock acquire could not create the lock: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.stdout.write(`${record.run_id} ${record.owner}\n`)
  process.exit(ACCEPT)
} else if (mode === 'run-lock' && args[0] === 'join' && args.length === 4) {
  // JOIN is read-only: exit 0 IFF the on-disk lock matches BOTH the run_id and the owner
  // token exactly. Absent, unreadable, or foreign — refuse, and print the holding run_id
  // (when readable) so the caller can name the running owner in its honest hold.
  const [, kilnDir, runId, owner] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-lock join kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!LOCK_TOKEN.test(runId) || !LOCK_TOKEN.test(owner)) {
    stop('transport_failure', 'run-lock join run_id and owner must be closed tokens', TRANSPORT_FAILURE)
  }
  const { record } = readLockRecord(join(kilnDir, LOCK_FILE))
  if (!record || record.run_id !== runId || record.owner !== owner) {
    const heldId = record && typeof record.run_id === 'string' ? record.run_id : ''
    stop(heldId, 'run-lock join refused: no run lock matches this run_id and owner token', LOCK_DENIED)
  }
  process.stdout.write('joined\n')
  process.exit(ACCEPT)
} else if (mode === 'run-lock' && args[0] === 'release' && args.length === 4) {
  // Exact-token release, serialized against the takeover race (B02). A cheap pre-read refuses a
  // foreign or absent lock; then the lock is CLAIMED by rename (one winner) and the identity is
  // re-verified on the CLAIMED bytes — never unlinked by pathname after a comparison. Only the
  // claim file this process exclusively holds is ever removed. If a takeover landed in the claim
  // window, the claimed record is restored (or archived if the path was re-occupied), not lost.
  const [, kilnDir, runId, owner] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-lock release kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!LOCK_TOKEN.test(runId) || !LOCK_TOKEN.test(owner)) {
    stop('transport_failure', 'run-lock release run_id and owner must be closed tokens', TRANSPORT_FAILURE)
  }
  const pre = readLockRecord(join(kilnDir, LOCK_FILE))
  if (!pre.record || pre.record.run_id !== runId || pre.record.owner !== owner) {
    stop('denied', 'run-lock release refused: no run lock matches this run_id and owner token', LOCK_DENIED)
  }
  const claim = claimLock(kilnDir)
  if (!claim) {
    stop('contended', 'run-lock release refused: the lock is already gone or claimed by a contender', LOCK_DENIED)
  }
  if (claim.record && claim.record.run_id === runId && claim.record.owner === owner) {
    if (!archiveAndDrop(kilnDir, claim.claimPath, claim.record, 'released')) {
      stop('transport_failure', 'run-lock release could not archive the lock — the lock survives, nothing lost', TRANSPORT_FAILURE)
    }
    process.stdout.write('released\n')
    process.exit(ACCEPT)
  }
  // A takeover displaced our lock between the pre-read and the claim — restore or preserve it. A
  // clean restore/archive is a plain contended refusal; a double failure leaves the displaced
  // record only as claim residue, which is a transport-class failure the caller must hear.
  if (restoreOrArchive(kilnDir, claim.claimPath, claim.record)) {
    stop('contended', 'run-lock release refused: the lock changed under the release', LOCK_DENIED)
  }
  stop('transport_failure', 'run-lock release could not restore or archive the displaced lock — its record survives only as a claim residue at .kiln/.run.lock.claim-*; inspect it', TRANSPORT_FAILURE)
} else if (mode === 'run-lock' && args[0] === 'takeover' && args.length === 4) {
  // Takeover replaces a genuinely stale lock with no token — the resume-after-crash path,
  // serialized against a second contender (B01). BOTH conditions gate it, never time alone:
  // the holder pid PROVEN dead (ESRCH only — B03) AND the lock aged past the floor. A cheap
  // pre-read refuses an obviously live/young lock; then the lock is CLAIMED by rename (one
  // winner) and re-validated on the CLAIMED bytes (same holder, still stale). Only then is the
  // stale record archived, the claim dropped, and a fresh lock wx-created; a NEW run_id + owner
  // print as acquire does. If a fresh lock landed in the claim window, it is restored, not stolen.
  const [, kilnDir, choice, conductorPid] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-lock takeover kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!LOCK_CHOICES.has(choice)) {
    stop('transport_failure', `run-lock takeover choice must be one of ${[...LOCK_CHOICES].join('|')}`, TRANSPORT_FAILURE)
  }
  const pid = Number(conductorPid)
  if (!Number.isInteger(pid) || pid <= 0) {
    stop('transport_failure', 'run-lock takeover conductor pid must be a positive integer', TRANSPORT_FAILURE)
  }
  const pre = readLockRecord(join(kilnDir, LOCK_FILE))
  // A lock that is present but unreadable in any shape is NOT a no-lock directory: it routes to the
  // cannot-prove-stale hold below, so the resume ladder never says a lock is missing one call after
  // acquire said it exists. An indeterminate presence takes that same hold, and both stand ahead of
  // the probe — only PROVEN absence reaches the no-lock words.
  if (!pre.exists && lockPresence(kilnDir) === 'absent') {
    stop('transport_failure', 'run-lock takeover found no lock to take over — acquire a fresh lock instead', TRANSPORT_FAILURE)
  }
  if (!pre.record) {
    stop('transport_failure', 'run-lock takeover found an unreadable lock — it cannot be proven stale; inspect .kiln/run.lock', TRANSPORT_FAILURE)
  }
  // Cheap pre-gate before claiming: an obviously live, young, or unprobeable lock is refused
  // without disturbing it. The claimed re-validation below is the authoritative proof.
  const preStale = takeoverStale(pre.record)
  if (!preStale.stale) {
    stop(preStale.fact, `run-lock takeover refused: the lock is not takeover-stale (${preStale.fact})`, LOCK_DENIED)
  }
  const version = pluginVersion()
  if (version === null) {
    stop('transport_failure', 'run-lock takeover could not read the plugin version from .claude-plugin/plugin.json', TRANSPORT_FAILURE)
  }
  // Last, and before the claim: a live or young lock has already held above, so the probe only ever
  // fires on a run this verb would otherwise mint, and its refusal disturbs nothing.
  refuseWithoutCodex(kilnDir, 'takeover')
  const claim = claimLock(kilnDir)
  if (!claim) {
    stop('contended', 'run-lock takeover refused: another contender claimed the lock first', LOCK_DENIED)
  }
  // Re-validate on the CLAIMED bytes: the same holder the pre-read saw AND still stale. A fresh
  // lock that landed in the window is a different run_id (or newly live) and must be restored.
  const claimedStale = claim.record
    && claim.record.run_id === pre.record.run_id
    && takeoverStale(claim.record).stale
  if (!claimedStale) {
    if (restoreOrArchive(kilnDir, claim.claimPath, claim.record)) {
      stop('contended', 'run-lock takeover refused: the lock changed under the takeover — restored, not stolen', LOCK_DENIED)
    }
    stop('transport_failure', 'run-lock takeover could not restore or archive the displaced lock — its record survives only as a claim residue at .kiln/.run.lock.claim-*; inspect it', TRANSPORT_FAILURE)
  }
  const fresh = {
    run_id: randomUUID(), owner: randomUUID(), conductor_pid: pid,
    started_at: new Date().toISOString(), ladder_choice: choice, plugin_version: version,
  }
  // Archive the stale record and drop the claim (leaves the lock path empty), then wx-create the
  // fresh lock. If the archive fails the stale lock is restored (archiveAndDrop), nothing lost.
  if (!archiveAndDrop(kilnDir, claim.claimPath, claim.record, 'taken_over')) {
    stop('transport_failure', 'run-lock takeover could not archive the stale lock — the lock survives, nothing lost', TRANSPORT_FAILURE)
  }
  try {
    writeFileSync(join(kilnDir, LOCK_FILE), `${JSON.stringify(fresh)}\n`, { flag: 'wx' })
  } catch (error) {
    if (error.code === 'EEXIST') {
      // A fresh acquire won the empty path first; the stale record is already archived, no loss.
      stop('contended', 'run-lock takeover refused: a fresh acquire won the lock before takeover completed', LOCK_DENIED)
    }
    stop('transport_failure', `run-lock takeover could not write the fresh lock: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.stdout.write(`${fresh.run_id} ${fresh.owner}\n`)
  process.exit(ACCEPT)
} else {
  stop(
    'transport_failure',
