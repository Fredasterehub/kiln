#!/usr/bin/env node
'use strict'

const { createHash, randomUUID } = require('node:crypto')
const {
  appendFileSync,
  existsSync,
  linkSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  realpathSync,
  renameSync,
  statSync,
  unlinkSync,
  writeFileSync,
} = require('node:fs')
const { dirname, join, resolve, sep } = require('node:path')
const { spawnSync } = require('node:child_process')

const ACCEPT = 0
const REJECT = 10
const BLOCKED = 11
const TRANSPORT_FAILURE = 20
const CODEX_UNAVAILABLE = 21
// W2-S3 (C2 / B04 / ruling 2): the LAW seal covers all THREE trio files — LAW.md, the
// executable law/check.sh, and the slice plan slices.json — each digested individually into
// .kiln/law/trio.hash. TRIO_MISMATCH is the closed exit a live file that no longer matches
// its sealed digest earns; it is DISTINCT from a transport failure (an absent or torn
// trio.hash) so a caller can tell a tamper apart from a missing seal.
const TRIO_MISMATCH = 22
const EFFORTS = ['low', 'medium', 'high', 'xhigh']
const LAW_HASH = /^[0-9a-f]{64}$/
const BROKEN_CODEX = /(?:unknown|unrecognized|unexpected|invalid).*(?:argument|option|subcommand)|(?:argument|option).*(?:not found|not recognized)/i
const SCHEMA = join(__dirname, 'review-schema.json')
// W8-S2: the screen family's shipped instrument and bounds. Keyframes ≤6, references ≤2,
// and the TOTAL image transport (2 required viewports + keyframes + references) capped
// at 10 — the whole pixel budget a grader ever sees. The DOM rides as a bounded text
// excerpt: enough to substantiate a clip-vs-authored call without flooding the packet.
const PERCEPTUAL_RUBRIC = join(__dirname, '..', 'data', 'perceptual-rubric.json')
const SCREEN_KEYFRAMES_MAX = 6
const SCREEN_REFERENCES_MAX = 2
const SCREEN_IMAGES_MAX = 10
const SCREEN_DOM_EXCERPT_LIMIT = 20000
// Screen findings pin evidence, not source: a viewport capture has no line number, so
// the location is an evidence path with an OPTIONAL :frame (film.webm:3) — the one
// place the screen family relaxes the shared path:line discipline.
const SCREEN_LOCATION = { pattern: /^[^:]+(?::\d+)?$/, message: 'location must be an evidence path with an optional :frame' }

function stop(fact, message, code) {
  process.stdout.write(`${fact}\n`)
  process.stderr.write(`kiln-review: ${message}\n`)
  process.exit(code)
}

function discard(file) {
  try {
    if (existsSync(file)) unlinkSync(file)
  } catch {
    // The original failure remains the machine fact.
  }
}

function readJson(file, label, discardOnFailure) {
  try {
    return JSON.parse(readFileSync(resolve(file), 'utf8'))
  } catch (error) {
    if (discardOnFailure) discard(discardOnFailure)
    stop('transport_failure', `${label}: ${error.message}`, TRANSPORT_FAILURE)
  }
}

function isObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value)
}

function stringArray(value) {
  return Array.isArray(value) && value.every((item) => typeof item === 'string')
}

// W2-S4 (C1 / B03 / Sol Model A): the builder request survives ONLY as non-authoritative
// evidence hints — what the builder covered, touched, observed and ran. The authoritative gate
// facts (law_hash, law_text, reviewer model/effort, slice) are derived CLI-side over the sealed
// trio and ride argv; a hint may orient the reviewer but never narrows or overrides the LAW.
// The request stays a required, well-formed deliverable (its absence is the existing
// builder-failure hold); its contents are demoted, not removed. reviewer_model/reviewer_effort/
// law_hash are no longer read here — the builder no longer authors the contract.
function hintsFrom(file) {
  const raw = readJson(file, 'invalid request')
  if (!isObject(raw)) stop('transport_failure', 'request must be a JSON object', TRANSPORT_FAILURE)
  if (typeof raw.criteria !== 'string' || raw.criteria.trim() === '') {
    stop('transport_failure', 'request criteria must be a nonempty string', TRANSPORT_FAILURE)
  }
  for (const field of ['paths', 'failures', 'commands']) {
    if (!stringArray(raw[field])) stop('transport_failure', `request ${field} must be an array of strings`, TRANSPORT_FAILURE)
  }
  return { criteria: raw.criteria, paths: raw.paths, failures: raw.failures, commands: raw.commands }
}

// A ratify request names the readable artifact and the rubric it is graded against,
// carries its own review_id (the caller issues it — unlike a slice review, which
// mints one), and picks the reviewer. There is no law_hash to supply: the ratified
// artifact's own bytes become the digest, computed at dispatch.
function ratifyRequestFrom(file) {
  const raw = readJson(file, 'invalid ratify request')
  if (!isObject(raw)) stop('transport_failure', 'ratify request must be a JSON object', TRANSPORT_FAILURE)
  if (typeof raw.review_id !== 'string' || raw.review_id.trim() === '') {
    stop('transport_failure', 'ratify request review_id must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof raw.reviewer_model !== 'string' || raw.reviewer_model.trim() === '') {
    stop('transport_failure', 'ratify request reviewer_model must be a nonempty string', TRANSPORT_FAILURE)
  }
  const reviewerEffort = raw.reviewer_effort === undefined ? 'high' : raw.reviewer_effort
  if (!EFFORTS.includes(reviewerEffort)) {
    stop('reviewer_effort_invalid', `request reviewer_effort must be one of ${EFFORTS.join('|')} (absent defaults to high); ultra and unknown values are rejected`, TRANSPORT_FAILURE)
  }
  if (typeof raw.artifact !== 'string' || raw.artifact.trim() === '') {
    stop('transport_failure', 'ratify request artifact must be a nonempty path string', TRANSPORT_FAILURE)
  }
  if (typeof raw.rubric !== 'string' || raw.rubric.trim() === '') {
    stop('transport_failure', 'ratify request rubric must be a nonempty path string', TRANSPORT_FAILURE)
  }
  return {
    reviewerModel: raw.reviewer_model,
    reviewerEffort,
    reviewId: raw.review_id,
    artifact: raw.artifact,
    rubric: raw.rubric,
  }
}

function rubricFrom(file) {
  const raw = readJson(file, 'invalid rubric')
  if (!isObject(raw) || !Array.isArray(raw.criteria) || raw.criteria.length === 0) {
    stop('transport_failure', 'rubric must be a JSON object with a nonempty criteria array', TRANSPORT_FAILURE)
  }
  for (const criterion of raw.criteria) {
    if (!isObject(criterion) || ['id', 'requirement', 'pass', 'fail'].some((key) => typeof criterion[key] !== 'string' || criterion[key].trim() === '')) {
      stop('transport_failure', 'each rubric criterion needs nonempty id, requirement, pass and fail strings', TRANSPORT_FAILURE)
    }
  }
  return raw.criteria
}

// W7-A1: the audit argv contract — closed facts only ride argv. Model and effort arrive
// as argv words (the kernel resolves them from tiers.json); the effort gate halts an unknown
// effort by name before any spawn. W8-S2: the screen family shares the identical contract, so
// the family label parameterizes the halt message and nothing else. W2-S4: the build review
// and recheck verbs join this contract — model and effort ride argv, no longer builder-relayed.
function auditRequest(model, effort, family = 'audit') {
  if (typeof model !== 'string' || model.trim() === '') {
    stop('transport_failure', `${family} reviewer model must be a nonempty string`, TRANSPORT_FAILURE)
  }
  if (!EFFORTS.includes(effort)) {
    stop('reviewer_effort_invalid', `${family} effort must be one of ${EFFORTS.join('|')}; ultra and unknown values are rejected`, TRANSPORT_FAILURE)
  }
  return { reviewerModel: model, reviewerEffort: effort }
}

// W2-S3: the sealed trio, in the fixed order seal-law writes and every reader checks.
// LAW.md and slices.json sit at the kiln root; the executable check.sh sits under law/.
const TRIO_MEMBERS = ['LAW.md', 'check.sh', 'slices.json']
const trioMemberPath = (kilnDir, name) => (name === 'check.sh' ? join(kilnDir, 'law', name) : join(kilnDir, name))
const trioHashPath = (kilnDir) => join(kilnDir, 'law', 'trio.hash')

// W2-S3 (B01): the sealed law is ONE coherent authority, not three loose files. seal-law
// writes trio.hash (per-member digests), lock.hash (the LAW.md digest) and the lock.seal
// sidecar (`<digest> <label>`); a crashed reseal could otherwise promote a new trio.hash
// beside stale locks. sealedAuthority admits ONLY a whole, cross-bound seal — all three
// present and well-formed, and trio[LAW.md] === lock.hash === the lock.seal digest — and
// returns its verified facts. Any PARTIAL or MISMATCHED combination is a TRIO_MISMATCH hold,
// the integrity class (B02) every sealed consumer holds on. NONE of the three present is an
// honest unsealed law (returns {sealed:false}) for the pre-seal flows. This is the single
// gate so the rule cannot drift per-site.
function sealedAuthority(kilnDir) {
  const read = (p) => {
    try {
      return readFileSync(p, 'utf8')
    } catch (error) {
      if (error.code === 'ENOENT') return null
      stop('trio_mismatch', `the sealed law could not be read: ${error.message}`, TRIO_MISMATCH)
    }
  }
  const trioRaw = read(trioHashPath(kilnDir))
  const lockRaw = read(join(kilnDir, 'law', 'lock.hash'))
  const sealRaw = read(join(kilnDir, 'law', 'lock.seal'))
  if (trioRaw === null && lockRaw === null && sealRaw === null) return { sealed: false }
  // Some seal artifact exists — the law claims to be sealed, so ALL THREE must be whole.
  const fail = (why) => stop('trio_mismatch', `the sealed law is not whole: ${why} — reseal the law before it is consumed`, TRIO_MISMATCH)
  if (trioRaw === null) fail('law/trio.hash is absent beside a lock')
  const lines = trioRaw.split('\n')
  if (lines.length !== TRIO_MEMBERS.length + 1 || lines[TRIO_MEMBERS.length] !== '') fail('law/trio.hash is not three trailing-newline lines')
  const trio = {}
  for (let i = 0; i < TRIO_MEMBERS.length; i += 1) {
    const parts = lines[i].split(' ')
    if (parts.length !== 2 || parts[0] !== TRIO_MEMBERS[i] || !LAW_HASH.test(parts[1])) fail(`law/trio.hash line ${i + 1} is malformed`)
    trio[TRIO_MEMBERS[i]] = parts[1]
  }
  // The authority gate holds the legacy locks to their BYTE-EXACT shipped shapes — no trim, no
  // first-token parse — so an extra newline, surrounding space, wrong label, or trailing
  // garbage is a torn seal, never a whole one. (The ratify and audit consumers that trim their
  // OWN lock.hash reads stay as they are; only this gate is byte-exact.)
  if (lockRaw === null) fail('law/lock.hash is absent beside the trio')
  if (!/^[0-9a-f]{64}\n$/.test(lockRaw)) fail('law/lock.hash is not exactly a 64-hex digest and one newline')
  const lockHash = lockRaw.slice(0, 64)
  if (sealRaw === null) fail('law/lock.seal is absent beside the trio')
  if (!/^[0-9a-f]{64} (?:dual|single-family)\n$/.test(sealRaw)) fail('law/lock.seal is not exactly <digest> <dual|single-family> and one newline')
  const sealDigest = sealRaw.slice(0, 64)
  if (trio['LAW.md'] !== lockHash || lockHash !== sealDigest) fail('trio.hash, lock.hash and lock.seal disagree on the LAW digest')
  return { sealed: true, trio, lockHash, sealDigest }
}

// Read the bytes a verb is about to parse and, if the law is sealed, confirm they still match
// the sealed trio digest BEFORE the parse — verification and consumption are ONE operation
// over the SAME bytes (B04), never a verify call a tamper can slip between and a separate
// read. auth is the sealedAuthority result: sealed verifies, unsealed passes bytes through for
// the pre-seal flows. A member that vanished from a sealed law is a torn seal (TRIO_MISMATCH).
function verifyMember(auth, kilnDir, name, label) {
  let bytes
  try {
    bytes = readFileSync(trioMemberPath(kilnDir, name))
  } catch (error) {
    stop(auth.sealed ? 'trio_mismatch' : 'transport_failure', `${label} could not read ${name}: ${error.message}`, auth.sealed ? TRIO_MISMATCH : TRANSPORT_FAILURE)
  }
  if (auth.sealed && createHash('sha256').update(bytes).digest('hex') !== auth.trio[name]) {
    stop('trio_mismatch', `${label}: ${name} no longer matches the sealed law/trio.hash digest`, TRIO_MISMATCH)
  }
  return bytes
}
function readSealedMember(kilnDir, name, label) {
  return verifyMember(sealedAuthority(kilnDir), kilnDir, name, label)
}

// The audit CLI reads the CHECKED slices.json projection itself and derives every
// milestone fact: the closing block is the maximal contiguous run of same-label slices
// ending at the seam slice; the cumulative prefix is every slice up to and including it.
// Milestone labels may contain spaces — they ride only inside the composed prompt, so no
// stop() on this path ever interpolates a label into a log line. law_hash binds to the
// sealed digest at <kilnDir>/law/lock.hash, required present.
function auditFacts(kilnDir, seamSliceId) {
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'audit kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof seamSliceId !== 'string' || seamSliceId.trim() === '') {
    stop('transport_failure', 'audit seam slice id must be a nonempty string', TRANSPORT_FAILURE)
  }
  // W2-S3 (B01): the audit rests on ONE coherent sealed authority. law_hash binds to the
  // cross-bound lock.hash it returns, and the slices.json it derives scope from is verified
  // against the same seal in one operation — the bytes parsed are the bytes verified.
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'audit requires the sealed law', TRANSPORT_FAILURE)
  let slices
  try {
    slices = JSON.parse(verifyMember(auth, kilnDir, 'slices.json', 'audit').toString('utf8'))
  } catch (error) {
    stop('transport_failure', `invalid slices projection: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (!Array.isArray(slices) || slices.length === 0) {
    stop('transport_failure', 'slices.json must be a nonempty array', TRANSPORT_FAILURE)
  }
  // The kernel slice contract (parseSliceEntry), not a stricter one: a legacy bare
  // string entry is its own id with no label; an object entry carries id + optional
  // milestone. Ids and labels normalize by trim — the projection-agreement normalization
  // — so the audit, the kernel seam fact and the checked projection read identical
  // bytes, and every kernel-valid slices.json can derive its audit facts.
  const entries = slices.map((slice) => (typeof slice === 'string'
    ? { id: slice.trim(), milestone: '' }
    : {
      id: String((slice && slice.id) || '').trim(),
      milestone: String((slice && slice.milestone) || '').trim(),
    }))
  if (entries.some((entry) => entry.id === '')) {
    stop('transport_failure', 'every slices.json entry must carry a nonempty id', TRANSPORT_FAILURE)
  }
  const seam = entries.findIndex((entry) => entry.id === seamSliceId)
  if (seam < 0) stop('transport_failure', 'seam slice id not found in slices.json', TRANSPORT_FAILURE)
  let start = seam
  while (start > 0 && entries[start - 1].milestone === entries[seam].milestone) start -= 1
  return {
    lawHash: auth.lockHash,
    milestone: entries[seam].milestone,
    closingBlock: entries.slice(start, seam + 1).map((entry) => entry.id),
    sealedPrefix: entries.slice(0, seam + 1).map((entry) => entry.id),
  }
}

// W2-S4 (C1 / B03 / Sol Model A): the verified-whole-LAW gate facts. The build gate's
// authority is the SEALED LAW.md itself — verified against the trio in the act of reading it
// (B04), the auditFacts/screenLawFacts discipline — never a builder-relayed contract. law_hash
// binds the cross-bound lock.hash the authority returns; law_text is the SAME verified bytes,
// embedded so the reviewer judges the exact sealed LAW (embedding over digest-plus-reread: the
// ratify full-artifact and screen verifier-row precedent). The reviewer scopes law_text to the
// named slice; a torn seal or a post-seal LAW.md drift holds TRIO_MISMATCH before any spawn.
function buildGateFacts(kilnDir, sliceId) {
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'build gate kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof sliceId !== 'string' || sliceId.trim() === '') {
    stop('transport_failure', 'build gate slice id must be a nonempty string', TRANSPORT_FAILURE)
  }
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'build gate requires the sealed law', TRANSPORT_FAILURE)
  const lawText = verifyMember(auth, kilnDir, 'LAW.md', 'build gate').toString('utf8')
  return { lawHash: auth.lockHash, lawText }
}

// W8-S2: the screen-family law facts — the verb derives the LAW Perceptual table rows
// ITSELF, with the PERCEPTUAL_TABLE_CHECK parser discipline (heading anchor, exact
// seven-cell header, GFM delimiter row, split on UNESCAPED `|` only so a lawful proxy
// command's GFM `\|` unescapes to the real operator), and binds the sealed lock.hash
// as packet TEXT — the schema's law_hash field belongs to the evidence digest here.
function screenLawFacts(kilnDir) {
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'screen kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  // W2-S3 (B01/B04): verify-and-parse over ONE coherent sealed authority. The screen binds to
  // the SEALED ALL-THREE trio — every live member is re-verified against the seal, so a
  // post-seal check.sh or slices.json drift is a TRIO_MISMATCH hold, not just a LAW.md check —
  // and law_lock_hash binds to the cross-bound lock.hash the authority returns.
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'screen requires the sealed law', TRANSPORT_FAILURE)
  for (const name of TRIO_MEMBERS) if (name !== 'LAW.md') verifyMember(auth, kilnDir, name, 'screen')
  const law = verifyMember(auth, kilnDir, 'LAW.md', 'screen').toString('utf8')
  const head = ['criterion id', 'owning slice', 'dim', 'requirement', 'proxy command', 'expected', 'reference']
  const cells = (s) => s.split(/(?<!\\)\|/).slice(1, -1).map((x) => x.replace(/\\\|/g, '|').trim())
  const rows = []
  let state = 0
  for (const line of law.split('\n')) {
    const t = line.trim()
    const row = t.slice(0, 1) === '|'
    if (state === 0) {
      if (t.slice(0, 3) === '## ' && t.slice(3).trim().toLowerCase() === 'perceptual') state = 1
      continue
    }
    if (state === 1) {
      if (t.slice(0, 1) === '#') break
      if (!row) continue
      const c = cells(t)
      if (c.length === 7 && c.every((x, i) => x.toLowerCase() === head[i])) { state = 2; continue }
      stop('transport_failure', 'the LAW Perceptual table header row is malformed', TRANSPORT_FAILURE)
    }
    if (state === 2) {
      const c = t.split('|').slice(1, -1).map((x) => x.trim())
      if (row && c.length === 7 && c.every((x) => /^:?-{3,}:?$/.test(x))) { state = 3; continue }
      stop('transport_failure', 'the LAW Perceptual table delimiter row is malformed', TRANSPORT_FAILURE)
    }
    if (!row) break
    const c = cells(t)
    if (c.length !== 7) stop('transport_failure', 'every LAW Perceptual row must carry seven cells', TRANSPORT_FAILURE)
    rows.push({ criterion: c[0], slice: c[1], dim: c[2], requirement: c[3], proxy: c[4], expected: c[5], reference: c[6] })
  }
  if (state !== 3 || rows.length === 0) {
    stop('transport_failure', 'screen requires the sealed LAW.md to carry a Perceptual table with at least one row', TRANSPORT_FAILURE)
  }
  return { rows, lockHash: auth.lockHash }
}

// W8-S2 (Sol r3, adopted verbatim): CURRENT generation = the highest
// .kiln/evidence/gen-<n> dir containing a valid manifest.json. Validity here is the
// reader's floor — the bytes parse as a JSON object — because completeness is judged
// AFTER selection: an incomplete CURRENT manifest is an honest reject, never a silent
// fall-back onto a stale generation's evidence. A manifest-less dir (crash residue)
// occupies its number for the allocator but is invisible to every reader.
function currentGeneration(kilnDir) {
  const root = join(kilnDir, 'evidence')
  let names = []
  try {
    names = readdirSync(root)
  } catch {
    // No evidence root at all — the same honest no-CURRENT outcome as an empty one.
  }
  const numbers = names
    .map((name) => /^gen-(\d+)$/.exec(name))
    .filter(Boolean)
    .map((found) => Number(found[1]))
    .sort((a, b) => b - a)
  for (const number of numbers) {
    const dir = resolve(join(root, `gen-${number}`))
    let bytes, manifest
    try {
      bytes = readFileSync(join(dir, 'manifest.json'))
      manifest = JSON.parse(bytes.toString('utf8'))
    } catch {
      continue
    }
    if (!isObject(manifest)) continue
    return { number, dir, manifest, digest: createHash('sha256').update(bytes).digest('hex') }
  }
  stop('transport_failure', 'no CURRENT evidence generation — no .kiln/evidence/gen-* dir carries a valid manifest.json; the capture recipe runs first', TRANSPORT_FAILURE)
}

// W8-S2: the manifest completeness gate + the bounded image transport. Metadata floor:
// the manifest's gen number matches its dir, the probed runtime versions are recorded,
// and the counts equal the named files — a manifest that misdescribes itself never
// grades. Required classes: meta, dom, console, the two viewports, the film, and at
// least one labeled keyframe; references are optional. Bounds: keyframes ≤6,
// references ≤2, TOTAL image transport ≤10. Every named file resolves INSIDE the
// generation dir AND exists there physically — realpath containment, because a symlink
// pointing out is an outside path wearing an inside name. Any violation is a pre-spawn
// reject: exit 20, nothing published.
function screenEvidence(generation) {
  if (generation.manifest.generation !== generation.number) {
    stop('transport_failure', `manifest generation must equal its dir number ${generation.number}`, TRANSPORT_FAILURE)
  }
  const runtimes = isObject(generation.manifest.runtimes) ? generation.manifest.runtimes : {}
  for (const runtime of ['playwright', 'ffmpeg']) {
    if (typeof runtimes[runtime] !== 'string' || runtimes[runtime].trim() === '') {
      stop('transport_failure', `manifest missing recorded runtime version: ${runtime}`, TRANSPORT_FAILURE)
    }
  }
  const files = isObject(generation.manifest.files) ? generation.manifest.files : {}
  const entry = (name) => (typeof files[name] === 'string' && files[name].trim() !== '' ? files[name] : null)
  const list = (name) => (Array.isArray(files[name]) && files[name].every((p) => typeof p === 'string' && p.trim() !== '') ? files[name] : null)
  const required = {
    meta: entry('meta'),
    dom: entry('dom'),
    console: entry('console'),
    viewport_desktop: entry('viewport_desktop'),
    viewport_mobile: entry('viewport_mobile'),
    film: entry('film'),
  }
  const missing = Object.keys(required).find((name) => required[name] === null)
  if (missing) stop('transport_failure', `manifest missing required class ${missing}`, TRANSPORT_FAILURE)
  const keyframes = list('keyframes')
  if (!keyframes || keyframes.length === 0) {
    stop('transport_failure', 'manifest missing required class keyframes — at least one labeled keyframe', TRANSPORT_FAILURE)
  }
  const references = files.references === undefined ? [] : list('references')
  if (!references) stop('transport_failure', 'manifest references must be an array of nonempty paths', TRANSPORT_FAILURE)
  if (keyframes.length > SCREEN_KEYFRAMES_MAX) {
    stop('transport_failure', `manifest exceeds the keyframe bound: ${keyframes.length} > ${SCREEN_KEYFRAMES_MAX}`, TRANSPORT_FAILURE)
  }
  if (references.length > SCREEN_REFERENCES_MAX) {
    stop('transport_failure', `manifest exceeds the reference bound: ${references.length} > ${SCREEN_REFERENCES_MAX}`, TRANSPORT_FAILURE)
  }
  const imageNames = [required.viewport_desktop, required.viewport_mobile, ...keyframes, ...references]
  if (imageNames.length > SCREEN_IMAGES_MAX) {
    stop('transport_failure', `manifest exceeds the total image transport cap: ${imageNames.length} > ${SCREEN_IMAGES_MAX}`, TRANSPORT_FAILURE)
  }
  const counts = isObject(generation.manifest.counts) ? generation.manifest.counts : {}
  if (counts.keyframes !== keyframes.length || counts.references !== references.length || counts.images !== imageNames.length) {
    stop('transport_failure', 'manifest counts do not match its named files', TRANSPORT_FAILURE)
  }
  let dirReal
  try {
    dirReal = realpathSync(generation.dir)
  } catch (error) {
    stop('transport_failure', `generation dir unreadable: ${error.message}`, TRANSPORT_FAILURE)
  }
  const inside = (p) => {
    const abs = resolve(generation.dir, p)
    if (!abs.startsWith(generation.dir + sep)) {
      stop('transport_failure', `manifest names a path outside its generation dir: ${p}`, TRANSPORT_FAILURE)
    }
    let real
    try {
      real = realpathSync(abs)
      if (!statSync(real).isFile()) {
        stop('transport_failure', `manifest names a path that is not a regular file: ${p}`, TRANSPORT_FAILURE)
      }
    } catch (error) {
      stop('transport_failure', `manifest names a file that is not on disk: ${p}: ${error.message}`, TRANSPORT_FAILURE)
    }
    if (!real.startsWith(dirReal + sep)) {
      stop('transport_failure', `manifest names a file physically outside its generation dir: ${p}`, TRANSPORT_FAILURE)
    }
    return abs
  }
  // The film never rides the transport (its keyframes carry the story), but it is a
  // required class of the generation — it must exist physically like every other file.
  inside(required.film)
  return {
    images: imageNames.map(inside),
    imageNames,
    references,
    meta: inside(required.meta),
    dom: inside(required.dom),
    console: inside(required.console),
  }
}

// W8-S2: the shared screen packet body — the LAW Perceptual rows the verb derived, the
// whole shipped instrument (the rows' dims select from it), the evidence text (meta +
// console verbatim, the DOM as a bounded excerpt), and the attachment naming so the
// grader knows what each `-i` image is. The sealed LAW lock rides as text only — the
// schema's law_hash belongs to the manifest digest.
function screenPacket(facts, generation, evidence) {
  const text = (file, label) => {
    try {
      return readFileSync(file, 'utf8')
    } catch (error) {
      stop('transport_failure', `screen could not read ${label}: ${error.message}`, TRANSPORT_FAILURE)
    }
  }
  return {
    law_lock_hash: facts.lockHash,
    generation: generation.number,
    perceptual_criteria: facts.rows,
    rubric: rubricFrom(PERCEPTUAL_RUBRIC),
    attached_images: evidence.imageNames,
    reference_images: evidence.references,
    meta: text(evidence.meta, 'meta.json'),
    console_log: text(evidence.console, 'console.log'),
    dom_excerpt: text(evidence.dom, 'dom.html').slice(0, SCREEN_DOM_EXCERPT_LIMIT),
  }
}

function validateShape(value, expectedReviewId, expectedLawHash, allowedFindingIds, location) {
  // Every family but screen pins findings to source as path:line; the screen family
  // passes SCREEN_LOCATION because its findings pin evidence files where a line
  // number does not exist. Absent, the default preserves the baseline byte-for-byte.
  const locationRule = location || { pattern: /^.+:\d+(?::\d+)?$/, message: 'location must be path:line' }
  if (!isObject(value)) return 'gate output must be a JSON object'
  const keys = Object.keys(value)
  const expectedKeys = ['review_id', 'law_hash', 'findings', 'blockers', 'verdict']
  if (keys.length !== expectedKeys.length || expectedKeys.some((key) => !keys.includes(key))) {
    return 'gate output fields do not match review-schema.json'
  }
  if (typeof value.review_id !== 'string' || value.review_id.trim() === '') return 'review_id must be a nonempty string'
  if (!LAW_HASH.test(value.law_hash)) return 'law_hash must be a lowercase SHA-256 hex digest'
  if (value.review_id !== expectedReviewId) return 'review_id does not match the issued review id'
  // Locked-LAW equality holds its baseline precedence — right here, after the
  // review_id match and before the findings/verdict checks — so the slice and recheck
  // paths stay byte-for-byte behavior-identical. Ratify grades a not-yet-sealed LAW
  // and omits expectedLawHash, so this is skipped and ratify asserts the artifact's
  // own candidate digest instead.
  if (expectedLawHash !== undefined && value.law_hash !== expectedLawHash) return 'law_hash does not match the locked LAW'
  if (!Array.isArray(value.findings) || !stringArray(value.blockers)) return 'findings and blockers must be arrays'
  if (value.blockers.some((blocker) => blocker.trim() === '')) return 'blockers must be nonempty strings'
  if (!['accept', 'changes_required', 'blocked'].includes(value.verdict)) return 'verdict is not recognized'

  const ids = new Set()
  const findingKeys = ['id', 'criterion', 'location', 'failure_mode', 'evidence', 'minimal_fix']
  for (const finding of value.findings) {
    if (!isObject(finding)) return 'each finding must be an object'
    const keys = Object.keys(finding)
    if (keys.length !== findingKeys.length || findingKeys.some((key) => !keys.includes(key))) {
      return 'finding fields do not match review-schema.json'
    }
    if (findingKeys.some((key) => typeof finding[key] !== 'string' || finding[key].trim() === '')) {
      return 'finding fields must be nonempty strings'
    }
    if (!locationRule.pattern.test(finding.location)) return `finding ${finding.id} ${locationRule.message}`
    if (ids.has(finding.id)) return `duplicate finding id ${finding.id}`
    if (allowedFindingIds && !allowedFindingIds.has(finding.id)) return `recheck introduced out-of-scope finding id ${finding.id}`
    ids.add(finding.id)
  }

  if (value.verdict === 'accept' && (value.findings.length !== 0 || value.blockers.length !== 0)) {
    return 'accept requires empty findings and blockers'
  }
  if (value.verdict === 'changes_required' && (value.findings.length === 0 || value.blockers.length !== 0)) {
    return 'changes_required requires nonempty findings and empty blockers'
  }
  if (value.verdict === 'blocked' && value.blockers.length === 0) {
    return 'blocked requires nonempty blockers'
  }
  return null
}

// W7-02: the audit verb-level shape rules, layered ON TOP of the shared validateShape —
// review-schema.json stays byte-untouched. Every blockers entry must equal a findings id,
// so a blocker always carries criterion, location and minimal_fix through its finding; a
// blocked verdict with empty findings has nothing behind its blockers and is invalid.
// Violations take the validateShape failure path: transport_failure, exit 20, and the
// verdict is never published.
function auditShapeInvalid(gate) {
  if (gate.verdict === 'blocked' && gate.findings.length === 0) {
    return 'audit blocked verdict requires findings carrying its blocker ids'
  }
  const findingIds = new Set(gate.findings.map((finding) => finding.id))
  const orphan = gate.blockers.find((blocker) => !findingIds.has(blocker))
  if (orphan !== undefined) return `audit blocker ${orphan} does not equal any finding id`
  return null
}

// W8-S2: the screen verb-level rules, layered on the shared validateShape —
// review-schema.json stays byte-untouched. A perceptual grade can never block: hard
// failure belongs to the deterministic proxies (a proxy red is a law red through
// check.sh), so a blocked verdict or any blocker is invalid here; and every finding
// must pin a LAW perceptual criterion id — the cross-family ownership key. Violations
// take the validateShape failure path: transport_failure, exit 20, never published.
function screenShapeInvalid(gate, criterionIds) {
  if (gate.verdict === 'blocked') return 'screen verdict must be accept or changes_required — hard failure belongs to the law proxies'
  if (gate.blockers.length !== 0) return 'screen blockers must be empty — hard failure belongs to the law proxies'
  const off = gate.findings.find((finding) => !criterionIds.has(finding.criterion))
  if (off !== undefined) return `finding ${off.id} criterion ${off.criterion} is not a LAW perceptual criterion id`
  return null
}

function instructions(packet) {
  return `You are the terminal semantic gate reviewer. Inspect the repository at the working root and return only the schema-forced JSON object.

The packet carries the sealed, verified LAW as law_text and the slice under review as slice_id: scope law_text to slice_id and judge that slice against it — law_text is the sole authority for the criteria. builder_hints (criteria, paths, failures, commands) are the builder's non-authoritative notes; they may orient you but never narrow or override the law, and no finding derives from them. Report only substantiated criterion violations, never optional improvements. Creative direction, visual taste, and aesthetic choices belong to the builder — never raise them as a finding and never let them color a verdict; you rule on correctness against the locked criteria alone. For each finding, cite an exact repo-relative path:line location, the concrete failure, its evidence, and the smallest repair. Use stable finding IDs. The commands in check_receipt were already executed kernel-side; their full output rides in check_receipt verbatim. Read the repository freely — read-only file inspection (opening files, listing directories) is how you judge the diff against the law, and the sandbox enforces read-only. Beyond reading, execute nothing: no tests, no builds, no project or state-changing commands — rule with check_receipt as the only execution evidence. Receipt rows owned by slices not yet built in this run are expected pre-build evidence — judge only this slice's criteria, never treat them as findings, and never filter or rewrite the receipt. Do not infer authorship, persona, or another reviewer's verdict.

Copy review_id and law_hash exactly. Verdict rules: accept only when findings and blockers are both empty; changes_required only for one or more repairable findings with no blockers; blocked only when the review cannot be completed, with one or more blocker reasons.
${packet.mode === 'recheck' ? '\nRecheck only the listed finding_ids against the repair_delta and current repository. The prior findings are supplied in full in the packet as prior_findings — confirm each one resolved, or preserve its id unresolved. Preserve each unresolved finding ID. Do not discover, add, or reopen any other finding. Accept when every listed finding is repaired.\n' : ''}
Evidence packet:
${JSON.stringify(packet, null, 2)}
`
}

function ratifyInstructions(packet) {
  return `You are the ratification reviewer. Grade the readable artifact below against the rubric and return only the schema-forced JSON object.

Judge the artifact against the rubric criteria alone. Report only substantiated criterion violations, never optional improvements and never matters of taste. For each finding, cite the artifact location as path:line, the concrete failure, evidence quoted from the artifact, and the smallest repair. Use stable finding IDs. Execute nothing: rule by reading the artifact text supplied in full below — do not inspect the repository and do not run any command.

Copy review_id and law_hash exactly into your output. law_hash is the sha256 digest of the artifact bytes; it seals the ratified content, so return it unchanged. Verdict rules: accept only when findings and blockers are both empty; changes_required only for one or more repairable findings with no blockers; blocked only when the review cannot be completed, with one or more blocker reasons.
${packet.mode === 'ratify-recheck' ? '\nRecheck only the listed finding_ids against the regenerated artifact. The prior findings are supplied in full in the packet as prior_findings — confirm each one resolved, or preserve its id unresolved. Preserve each unresolved finding ID. Do not discover, add, or reopen any other finding. Accept when every listed finding is repaired.\n' : ''}
Ratification packet:
${JSON.stringify(packet, null, 2)}
`
}

// W7-A1: the milestone audit prompt — review()'s prompt discipline, milestone-flavored
// instead of slice-flavored. The reviewer derives the milestone goal itself from LAW.md
// and the vision in-repo, judges goal-backward over the cumulative sealed prefix with
// focus on the closing block, pins LAW criterion ids and path:line locations, and
// executes nothing — the kernel-side check receipt rides the packet verbatim as the
// only execution evidence.
function auditInstructions(packet) {
  return `You are the milestone audit reviewer. Inspect the repository at the working root and return only the schema-forced JSON object.

Derive the milestone goal from .kiln/LAW.md and the vision documents in the repository, then judge goal-backward: over the cumulative sealed prefix in the audit packet, with focus on the closing block, check integrated reachability, the connections between slices, and delivery of the milestone goal. Report only substantiated criterion violations, never optional improvements. Creative direction, visual taste, and aesthetic choices belong to the builder — never raise them as a finding and never let them color a verdict. For each finding, pin the failed LAW criterion id in criterion and an exact repo-relative path:line in location, with the concrete failure, its evidence, and the smallest repair. Use stable finding IDs. The commands whose output rides in check_receipt were already executed kernel-side. Read the repository freely — read-only file inspection (opening files, listing directories) is how you judge the milestone against the law, and the sandbox enforces read-only. Beyond reading, execute nothing: no tests, no builds, no project or state-changing commands — rule with check_receipt as the only execution evidence. Do not infer authorship, persona, or another reviewer's verdict.

Copy review_id and law_hash exactly. Every blockers entry must equal the id of one of your findings, so each blocker carries its criterion, location, and minimal fix through that finding. Verdict rules: accept only when findings and blockers are both empty; changes_required only for one or more repairable findings with no blockers; blocked only when the audit cannot be completed or the milestone goal is undeliverable, with one or more blocker ids naming findings.
${packet.mode === 'audit-recheck' ? '\nRecheck only the listed finding_ids against the repair_delta and current repository. The prior findings are supplied in full in the packet as prior_findings — confirm each one resolved, or preserve its id unresolved. Preserve each unresolved finding ID. Do not discover, add, or reopen any other finding. Accept when every listed finding is repaired.\n' : ''}
Audit packet:
${JSON.stringify(packet, null, 2)}
`
}

// W8-S2: the perceptual grading prompt — the review family's discipline pointed at
// pixels. The reviewer judges ONLY the LAW Perceptual rows, each on its named rubric
// dim per the shipped anchors; insufficient evidence is a finding, never a blocker;
// and law_hash binds the grade to the evidence — the sha256 of the graded generation's
// manifest.json (the ratify-family artifact-digest precedent, atomic and in-schema).
function screenInstructions(packet) {
  return `You are the perceptual grading reviewer. The attached images are the evidence generation named in the packet — the two required viewports, then the labeled keyframes, then any reference images, in the packet's attached_images order. Grade the rendered surface and return only the schema-forced JSON object.

Judge ONLY the perceptual criteria rows in the packet, each on its named rubric dim per the shipped rubric's anchors — never any other dimension, and never general taste beyond what a row's requirement pins. Report only substantiated criterion violations. For each finding, pin criterion = the row's LAW perceptual criterion id and location = an evidence path with an optional :frame (for example viewport-mobile.png or film.webm:3), with the concrete failure, its visual evidence, and the smallest repair. Use stable finding IDs. Insufficient evidence on a dim is a finding citing the rubric's insufficient_evidence line as its evidence — never a blocker. Execute nothing and install nothing: rule from the attached images and the packet text alone.

Copy review_id and law_hash exactly — law_hash is the sha256 digest of the graded generation's manifest.json and binds this verdict to that evidence. Verdict rules: accept only when findings and blockers are both empty; changes_required for one or more repairable findings. Never return blocked and never write a blocker: hard failure belongs to the law's deterministic proxies, not to this grade.
${packet.mode === 'screen-recheck' ? '\nRecheck only the listed finding_ids against the fresh evidence generation. The prior findings are supplied in full in the packet as prior_findings — confirm each one resolved, or preserve its id unresolved. Preserve each unresolved finding ID. Do not discover, add, or reopen any other finding. Accept when every listed finding is repaired.\n' : ''}${packet.mode === 'screen-escalate' ? '\nThis is a bounded second-family escalation of a held verdict: the packet carries ONLY the surviving criteria — grade them alone, on the same evidence generation; a finding on any other criterion invalidates the verdict.\n' : ''}
Evidence packet:
${JSON.stringify(packet, null, 2)}
`
}

function classifyFailure(run) {
  if (run.error && ['ENOENT', 'EACCES', 'ENOEXEC'].includes(run.error.code)) return CODEX_UNAVAILABLE
  if (run.error) return TRANSPORT_FAILURE
  const stderr = run.stderr || ''
  const incompatibleCli = BROKEN_CODEX.test(stderr) && /Usage:\s+codex(?: exec)?\b/i.test(stderr)
  if ([126, 127].includes(run.status) || incompatibleCli) return CODEX_UNAVAILABLE
  return TRANSPORT_FAILURE
}

// The shared codex-gate core: spawn the schema-forced reviewer, classify any
// failure honestly, hand the returned gate to the caller's own validator, then
// publish it and exit on the verdict. The prompt and the validator are the only
// things the slice and ratify paths differ on — everything else is identical, so
// both flows converge here rather than duplicate the spawn and the exit mapping.
// W8-S2: the screen family adds bounded `-i` image attachments — absent, the argv
// is byte-identical to the baseline.
function runGate(repo, request, prompt, outputFile, validate, family, images) {
  const output = resolve(outputFile)
  const temporary = join(dirname(output), `.gate-review.tmp-${process.pid}-${randomUUID()}`)
  const args = [
    'exec',
    '--ephemeral',
    '--sandbox', 'read-only',
    '--skip-git-repo-check',
    '-C', repo,
    '--model', request.reviewerModel,
    '-c', `model_reasoning_effort="${request.reviewerEffort}"`,
    '--output-schema', SCHEMA,
  ]
  for (const image of images || []) args.push('-i', image)
  args.push('-o', temporary, '-')
  const run = spawnSync('codex', args, {
    cwd: repo,
    input: prompt,
    encoding: 'utf8',
    maxBuffer: 4 * 1024 * 1024,
  })

  if (run.error || run.status !== 0) {
    discard(temporary)
    const code = classifyFailure(run)
    const detail = run.error ? run.error.message : (run.stderr || `codex exited ${run.status}`).trim().slice(-2000)
    stop(code === CODEX_UNAVAILABLE ? 'codex_unavailable' : 'transport_failure', detail, code)
  }
  if (!existsSync(temporary)) stop('transport_failure', 'codex produced no gate output', TRANSPORT_FAILURE)

  const gate = readJson(temporary, 'invalid codex gate output', temporary)
  const invalid = validate(gate)
  if (invalid) {
    discard(temporary)
    stop('transport_failure', invalid, TRANSPORT_FAILURE)
  }
  // W2-S5: archive the validated verdict to the immutable ledger BEFORE the publish rename — the
  // gate-file overwrite is content-free and destroys the prior verdict, so the archive is the only
  // surviving history. The archive digests the EXACT bytes codex wrote, and the ledger sits beside
  // the gate file in the same .kiln. A failed archive fails closed: the verdict is neither archived
  // nor published, and the caller holds.
  const archiveError = archiveVerdict(dirname(output), family, readFileSync(temporary))
  if (archiveError) {
    discard(temporary)
    stop('transport_failure', archiveError, TRANSPORT_FAILURE)
  }
  try {
    renameSync(temporary, output)
  } catch (error) {
    discard(temporary)
    stop('transport_failure', `could not publish gate output: ${error.message}`, TRANSPORT_FAILURE)
  }

  const exits = { accept: ACCEPT, changes_required: REJECT, blocked: BLOCKED }
  const facts = { accept: 'accept', changes_required: 'reject', blocked: 'blocked' }
  process.stdout.write(`${facts[gate.verdict]}\n`)
  process.exit(exits[gate.verdict])
}

function invoke(repo, request, packet, outputFile, allowedFindingIds) {
  // The reviewer never executes: the kernel side runs the law checks and writes
  // .kiln/check-receipt.txt before every gate call. The receipt rides the packet
  // verbatim; a missing receipt is a broken contract, never a license to execute.
  let checkReceipt
  try {
    checkReceipt = readFileSync(join(repo, '.kiln', 'check-receipt.txt'), 'utf8')
  } catch (error) {
    stop('transport_failure', `check receipt unreadable: ${error.message} — the kernel executes the checks and writes .kiln/check-receipt.txt before the gate call; the reviewer executes nothing`, TRANSPORT_FAILURE)
  }
  packet.check_receipt = checkReceipt
  runGate(repo, request, instructions(packet), outputFile, (gate) =>
    validateShape(gate, packet.review_id, packet.law_hash, allowedFindingIds), 'review')
}

// W7-A1: the audit-family invoke — the SAME receipt gate as invoke() (the kernel runs
// the law checks and writes .kiln/check-receipt.txt before every gate call; the reviewer
// executes nothing; a missing receipt is a broken contract), then the shared runGate
// with the audit prompt and the audit verb-level shape rules layered on validateShape.
function invokeAudit(repo, request, packet, outputFile, allowedFindingIds) {
  let checkReceipt
  try {
    checkReceipt = readFileSync(join(repo, '.kiln', 'check-receipt.txt'), 'utf8')
  } catch (error) {
    stop('transport_failure', `check receipt unreadable: ${error.message} — the kernel executes the checks and writes .kiln/check-receipt.txt before the gate call; the reviewer executes nothing`, TRANSPORT_FAILURE)
  }
  packet.check_receipt = checkReceipt
  runGate(repo, request, auditInstructions(packet), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, packet.law_hash, allowedFindingIds)
    if (shape) return shape
    return auditShapeInvalid(gate)
  }, 'audit')
}

function repository(path) {
  try {
    const root = realpathSync(resolve(path))
    if (!statSync(root).isDirectory()) throw new Error('not a directory')
    return root
  } catch (error) {
    stop('transport_failure', `invalid repository: ${error.message}`, TRANSPORT_FAILURE)
  }
}

// W1-S2 (Defect B): the state-commit vocabulary. The kernel persisted STATE.md by
// handing a courier a bash heredoc that spelled out the whole ledger; a safety-tuned
// model reads that as forging a transition past validation and REFUSES, converting even
// honest holds into persist-failed. Here the courier speaks only closed words — a
// transition token, the stage, the slice, a next-action KEY, the density, and pointer
// paths — and this verb owns the document, the hint prose and the clock. The token names
// the transition kind (advance/seal-advance move forward, hold/degrade/boundary stop);
// an unsupported token, stage, key or density fails closed and nothing is written.
const STATE_TOKENS = new Set(['advance', 'seal-advance', 'hold', 'degrade', 'boundary'])
const STATE_STAGES = new Set(['law', 'build', 'validate', 'report'])
const STATE_SLICE_ID = /^[A-Za-z0-9._/-]+$/
// A pointer is a repo-relative path of safe characters only — no shell metacharacter,
// whitespace, or parent-escape rides the STATE.md pointers line or the courier argv.
const STATE_POINTER = /^[A-Za-z0-9._/-]+$/

// The next-action KEY table: each key resolves to one fixed operator hint, with the
// current stage and active slice filled in. relaunch-* name their own forward stage, so
// they ignore the current stage. An unknown key returns null and the verb fails closed.
function stateNextAction(key, stage, slice) {
  const hasSlice = slice !== 'none'
  switch (key) {
    case 'run-complete': return 'Run complete'
    case 'relaunch-law': return 'Relaunch the kernel workflow with stage=law'
    case 'relaunch-build': return 'Relaunch the kernel workflow with stage=build'
    case 'relaunch-validate': return 'Relaunch the kernel workflow with stage=validate'
    case 'relaunch-report': return 'Relaunch the kernel workflow with stage=report'
    case 'reopen-slice': return `Reopen slice ${slice}: LAW is red — relaunch stage ${stage}`
    case 'operator-ruling': return hasSlice
      ? `Operator ruling: the run is blocked for slice ${slice} — rule, then relaunch stage ${stage}`
      : `Operator ruling: the run is blocked — rule, then relaunch stage ${stage}`
    case 'restore-gate': return `Rerun stage ${stage} after restoring the gate tool`
    case 'restore-codex': return `Restore codex, then relaunch stage ${stage} — the second family is needed`
    case 'acknowledge-degrade': return `Acknowledge single-family degradation, then relaunch stage ${stage}`
    case 'repair-failed': return hasSlice
      ? `Rerun stage ${stage}: the repair pass did not land for slice ${slice}`
      : `Rerun stage ${stage}: the repair pass did not land`
    case 'rerun-onboarding': return `Rerun onboarding, then relaunch stage ${stage}`
    // A "Rerun stage X" hint names its TARGET stage, which may differ from the current
    // stage — a build with no slice list must return to the LAW producer, never rerun
    // build. rerun-stage stays as the same-stage fallback when no target is parsed.
    case 'rerun-law': return 'Rerun stage law'
    case 'rerun-build': return 'Rerun stage build'
    case 'rerun-validate': return 'Rerun stage validate'
    case 'rerun-report': return 'Rerun stage report'
    case 'rerun-stage': return `Rerun stage ${stage}`
    default: return null
  }
}

// W2-S2 (H6 / B02): the eight-line STATE.md rendered from a typed record. This is the ONE
// render template, shared by a fresh commit and by crash reconciliation, so the rendered view
// is byte-identical either way — the exact former stateDoc format, incl. `seals: .kiln/seals.log`.
function renderStateDoc(rec) {
  return [
    '# STATE',
    'stage: ' + rec.stage,
    'active_slice: ' + rec.active_slice,
    'next_action: ' + rec.next_action,
    'density: ' + rec.density,
    'pointers: ' + rec.pointers.join(' '),
    'seals: ' + rec.seals,
    'updated_at: ' + rec.updated_at,
  ].join('\n') + '\n'
}

// Crash reconciliation. state.json is written and renamed BEFORE STATE.md, so a crash between
// the two renames (or a torn/deleted STATE.md) leaves the rendered view lagging the canonical
// record. On the next trusted write we heal it FIRST: if STATE.md does not hash to the
// render_digest in the record, re-render it from the typed record before advancing — the drift is
// bounded to one write and the STATE.md-only conductor read never sees a torn document. A prior that
// cannot be re-rendered (missing fields) is left for the new commit below to overwrite whole.
function reconcileStateDoc(kilnDir, prior) {
  if (typeof prior.render_digest !== 'string') return
  const docPath = join(kilnDir, 'STATE.md')
  let current = null
  try {
    current = readFileSync(docPath)
  } catch {
    current = null
  }
  const currentDigest = current === null ? null : createHash('sha256').update(current).digest('hex')
  if (currentDigest === prior.render_digest) return
  let healed
  try {
    healed = renderStateDoc(prior)
  } catch {
    return
  }
  try {
    mkdirSync(kilnDir, { recursive: true })
    const temporary = join(kilnDir, `.STATE.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(temporary, healed)
    renameSync(temporary, docPath)
  } catch {
    // A failed heal is not fatal on its own — the STATE.md write in the new commit below is the
    // next chance to re-render the view from the canonical record.
  }
}

// ── W2-S1 (H2 / B01): the CONDUCTOR-OWNED run lock ──────────────────────────
// A per-RUN concurrency guard at .kiln/run.lock — deliberately distinct from the per-PLAN
// law/lock.hash attestation. The conductor acquires ONCE before the sweep and passes run_id
// plus an opaque owner token to every workflow; the workflows JOIN with the exact token,
// never a second acquire. The record is NEVER destroyed: release and a stale takeover both
// append it to run-history.jsonl before the live lock is replaced or removed, so the run
// record always survives somewhere durable.
const LOCK_FILE = 'run.lock'
const LOCK_HISTORY = 'run-history.jsonl'
const LOCK_DENIED = 12
// The availability-panel choices ride the lock — stored at acquire, read at every later boot.
// S10 wires the panel that selects among them; S1 owns only the storage contract.
const LOCK_CHOICES = new Set(['follow-ladders', 'stop-at-boundary', 'edit-ladders'])
// run_id and owner are minted as UUIDs; join/release/takeover echo them back over argv, so a
// closed token grammar rejects any shell metacharacter, whitespace, or control byte.
const LOCK_TOKEN = /^[A-Za-z0-9._-]+$/
// A takeover needs BOTH a dead holder pid AND a lock aged past this floor — never time alone.
// The floor clears the run-s4 resume window (the lock is far older than this by the resume)
// while staying short enough that a genuinely abandoned lock frees quickly.
const LOCK_AGE_FLOOR_MS = 5000

// The plugin version stamped into a fresh lock record — read from the shipped manifest,
// honest or fail-closed, never fabricated.
function pluginVersion() {
  try {
    const meta = JSON.parse(readFileSync(join(__dirname, '..', '.claude-plugin', 'plugin.json'), 'utf8'))
    return typeof meta.version === 'string' && meta.version.trim() !== '' ? meta.version : null
  } catch {
    return null
  }
}

// Read the lock record, distinguishing absent (no file) from present-but-unreadable (a torn
// or hand-broken lock): join and release refuse on either, and takeover refuses to prove an
// unreadable lock stale rather than steal it.
function readLockRecord(lockPath) {
  let raw
  try {
    raw = readFileSync(lockPath, 'utf8')
  } catch {
    return { exists: false, record: null }
  }
  try {
    const record = JSON.parse(raw)
    return { exists: true, record: isObject(record) ? record : null }
  } catch {
    return { exists: true, record: null }
  }
}

// The never-delete guarantee: append the full record plus the lock event and an archive
// timestamp to run-history.jsonl BEFORE the live lock is replaced or removed. A lock is never
// a bare unlink that loses the record.
function archiveLockRecord(kilnDir, record, event) {
  const row = JSON.stringify({ ...record, lock_event: event, archived_at: new Date().toISOString() })
  appendFileSync(join(kilnDir, LOCK_HISTORY), `${row}\n`)
}

// ── W2-S5 (C3a / B05 / ruling 3): the immutable verdict archive ─────────────
// Every review family — build review, LAW ratify, feasibility ratify, milestone audit, and
// perceptual screen — publishes its verdict by renaming a candidate over the mutable gate file,
// a content-free overwrite that destroys the prior verdict. This ledger is the archive that
// overwrite never touches: every newly validated verdict is appended here BEFORE the rename, so
// the full reject/changes_required/blocked history of a repair→recheck→accept lineage survives
// the accept that lands. Ruling 3: the mutable gate files and all their readers are UNCHANGED —
// this is archive-only, never a P.gate split.
const REVIEWS_FILE = 'reviews.jsonl'
// The family is the review family the verdict belongs to, not the reviewer model family and not
// the seal's dual/single cohort (a per-seal fact unavailable at per-verdict publish time). The
// build gate and LAW ratify share one gate FILE, so the family is what tells their verdicts apart
// in the archive; feasibility keeps its own family though it reuses the ratify verb.
const REVIEW_FAMILIES = new Set(['review', 'ratify', 'feasibility', 'audit', 'screen'])

// run_id provenance: the CLI reads the CLI-owned run.lock ITSELF and trusts run_id ONLY from a
// record in the W2-S1 shape (run_id + owner in the LOCK_TOKEN grammar, a positive-integer
// conductor_pid). An absent, unreadable, or non-conforming lock records run_id honestly as null
// (a legacy launch), never a model-authorable string dressed as authoritative identity.
function runIdFromLock(kilnDir) {
  const lock = readLockRecord(join(kilnDir, LOCK_FILE)).record
  const conforms = isObject(lock)
    && typeof lock.run_id === 'string' && LOCK_TOKEN.test(lock.run_id)
    && typeof lock.owner === 'string' && LOCK_TOKEN.test(lock.owner)
    && Number.isInteger(lock.conductor_pid) && lock.conductor_pid > 0
  return conforms ? lock.run_id : null
}

// Append the validated verdict to the archive, keyed idempotently by (family, review_id, verdict
// sha256): a crash retry that re-presents the exact same verdict bytes appends nothing, so retries
// never create ambiguous rounds. The round is the count of rows already in this lineage, so it is
// the true position in that lineage's history rather than a stateful counter that a retry could
// advance. The complete verdict is preserved — the verdict word, the full findings AND blockers,
// the law_hash — plus the sha256 of the EXACT original bytes as an integrity digest. The run lock
// serializes runs, so appends never race. Returns null on success (or an idempotent no-op) and an
// error string on any failure, so the caller fails closed and never publishes an un-archived
// verdict.
// verdictBytes is the RAW Buffer of the exact bytes about to be renamed into the gate file. The
// digest binds THOSE bytes: hashing a utf8-decoded string instead would diverge on any byte that is
// not valid utf8 (decoded to U+FFFD, then re-encoded), so the archived digest would fail to cover the
// published bytes. The readable content fields come from the parsed JSON — that is fine, they are the
// archive's human content, not its integrity binding.
function archiveVerdict(kilnDir, family, verdictBytes) {
  if (!REVIEW_FAMILIES.has(family)) return `archive family ${family} is not a review family`
  let verdict
  try {
    verdict = JSON.parse(verdictBytes.toString('utf8'))
  } catch (error) {
    return `archive could not parse the verdict: ${error.message}`
  }
  if (!isObject(verdict) || typeof verdict.review_id !== 'string' || verdict.review_id.trim() === '') {
    return 'archive verdict carries no review_id'
  }
  const sha = createHash('sha256').update(verdictBytes).digest('hex')
  const path = join(kilnDir, REVIEWS_FILE)
  // Read the whole ledger once (absent = empty). A genuine IO fault (not ENOENT) fails closed, but a
  // single TORN line — a partial final append a crash left with no trailing newline, on an append-only
  // ledger that can never be deleted (never-delete) — must NEVER wedge the archive: an aborting parse
  // would hold every future gate publish forever. The scan skips an unparseable line rather than
  // aborting (the tolerant sealMembers degrade), and a skipped line never counts toward the round.
  let raw = ''
  try {
    raw = readFileSync(path, 'utf8')
  } catch (error) {
    if (error.code !== 'ENOENT') return `archive could not read the ledger: ${error.message}`
  }
  const lineage = []
  for (const line of raw.split('\n')) {
    if (line.trim() === '') continue
    let row
    try { row = JSON.parse(line) } catch { continue }
    if (isObject(row) && row.family === family && row.review_id === verdict.review_id) lineage.push(row)
  }
  if (lineage.some((row) => row.verdict_sha256 === sha)) return null
  const row = {
    family,
    review_id: verdict.review_id,
    round: lineage.length,
    verdict: verdict.verdict,
    findings: Array.isArray(verdict.findings) ? verdict.findings : [],
    blockers: Array.isArray(verdict.blockers) ? verdict.blockers : [],
    law_hash: verdict.law_hash,
    run_id: runIdFromLock(kilnDir),
    published_at: new Date().toISOString(),
    verdict_sha256: sha,
  }
  // Write safety: a crash mid-append can leave a torn final line with no trailing newline. Prefix a
  // newline when the ledger is non-empty and does not end in one, so the new row lands on its OWN line
  // and never merges into the torn partial — both the torn line and the new row stay independently
  // recoverable. The bytes are already in hand from the scan, so this is a byte check, not a re-read.
  const prefix = raw.length > 0 && !raw.endsWith('\n') ? '\n' : ''
  try {
    appendFileSync(path, prefix + JSON.stringify(row) + '\n')
  } catch (error) {
    return `archive could not append the verdict: ${error.message}`
  }
  return null
}

// ── W2-S6 (C3b / B06 / B09): the attestation ledger core ────────────────────
// seals.jsonl and audits.jsonl are the append-only TYPED truth; seals.log and audits.log are the
// CURRENT-VALID rendered projection the kernel reads for membership (ruling 4 keeps membership on
// the .log, JSONL parsing deferred to W4). append-seal/append-audit append the JSONL row THEN
// re-render the whole .log from the JSONL as one atomic temp+rename, so a torn .log never
// accumulates. reconcile heals a crash between the JSONL append and the .log render, and migrates a
// W1 project whose .log predates the JSONL. S6 has no invalidation, so every JSONL row renders in
// append order (the plan/seam order the appends already carry — A03); S7 will teach the projection
// to drop invalidated rows and the rows to carry the full-hash block, identity and coverage.
const SEAL_LEDGER = { jsonl: 'seals.jsonl', log: 'seals.log', type: 'seal' }
const AUDIT_LEDGER = { jsonl: 'audits.jsonl', log: 'audits.log', type: 'audit' }

// The closed family-label set a FRESH seal or audit row carries — exactly what append-seal and
// append-audit validate on write, so a real fresh row always conforms. A migrated legacy row is
// exempt: it preserves the verbatim W1 record, whose oldest forms carry no label (a bare-slice
// seals.log line, a pre-S4-D4 two-field `<seam> accept` audit line).
const LEDGER_LABELS = new Set(['dual', 'single-family'])

// One projection line for a CONFORMING ledger row — the EXACT legacy grammar, so every rendered
// .log is byte-identical to what the old append wrote: a seal is `<slice> <label>`, an audit is
// `<seam> accept <label>` (the S4-D4 third field, absent on a pre-S4-D4 legacy audit). Returns null
// for a row that does NOT conform to THIS ledger's S6 schema — a wrong-type row (a seal in the audit
// ledger or an audit in the seal ledger), an audit whose outcome is not the sealed `accept`, or a
// FRESH row without a conforming {dual, single-family} label (the label-less form is legitimate ONLY
// for a migrated legacy:true row, so it never leaks to a fresh row as a two-field audit or a
// trailing-space seal). A non-conforming row is a membership ANOMALY (corruption or a future-bug
// row), never a torn line (torn lines are skipped at the JSONL read); renderProjection HOLDS on the
// null. S7 extends the accepted types and outcomes (invalidation/reseal rows), so this grows here.
function ledgerProjectionLine(descriptor, row) {
  if (!isObject(row) || row.type !== descriptor.type) return null
  const legacy = row.legacy === true
  if (descriptor.type === 'seal') {
    if (typeof row.slice !== 'string' || row.slice === '') return null
    // A legacy seal keeps its W1 form: a labelled line renders `<slice> <label>`, a bare-slice line
    // `<slice>`. A fresh seal must carry a conforming label and always renders `<slice> <label>`.
    if (legacy) return typeof row.label === 'string' && row.label !== '' ? row.slice + ' ' + row.label : row.slice
    return LEDGER_LABELS.has(row.label) ? row.slice + ' ' + row.label : null
  }
  if (typeof row.seam !== 'string' || row.seam === '' || row.outcome !== 'accept') return null
  // A legacy audit keeps its W1 form: a three-field line renders `<seam> accept <label>`, a
  // pre-S4-D4 two-field line `<seam> accept`. A fresh audit must carry a conforming label.
  if (legacy) return typeof row.label === 'string' && row.label !== '' ? row.seam + ' accept ' + row.label : row.seam + ' accept'
  return LEDGER_LABELS.has(row.label) ? row.seam + ' accept ' + row.label : null
}

// Render the current-valid projection from the trusted rows. A row that does not conform to the
// ledger schema (ledgerProjectionLine returns null) is a membership anomaly in the append-only
// truth, so the render HOLDS fail-closed rather than SILENTLY drop it (which could hide a real seal)
// or render it as garbage (A02). Torn lines never reach here — they are skipped at the JSONL read.
function renderProjection(descriptor, rows) {
  const lines = []
  for (const row of rows) {
    const line = ledgerProjectionLine(descriptor, row)
    if (line === null) {
      stop('transport_failure', `${descriptor.jsonl} carries a row that does not conform to the ${descriptor.type} ledger schema — a membership anomaly; reconcile holds rather than drop or misrender it`, TRANSPORT_FAILURE)
    }
    lines.push(line)
  }
  return lines.length ? lines.join('\n') + '\n' : ''
}

// Read the append-only JSONL truth into rows, tolerating a torn final line (a crash mid-append on a
// ledger that is never deleted): an unparseable line is skipped, exactly as archiveVerdict and
// sealMembers degrade, so one torn byte never wedges every future render. Returns null when the
// JSONL is ABSENT (the caller then considers a W1 migration), distinct from present-but-empty [].
function readLedgerRows(path) {
  let raw = ''
  try {
    raw = readFileSync(path, 'utf8')
  } catch (error) {
    if (error.code === 'ENOENT') return null
    throw error
  }
  const rows = []
  for (const line of raw.split('\n')) {
    if (line.trim() === '') continue
    try { rows.push(JSON.parse(line)) } catch { continue }
  }
  return rows
}

// Re-render the .log from the rows as one atomic temp+rename, but ONLY when the current .log differs
// — a matching projection (the common reconcile no-op, and every byte-exact migration) is left
// untouched so no spurious write churns the file.
function writeProjectionIfStale(kilnDir, descriptor, rows) {
  const projection = renderProjection(descriptor, rows)
  const logPath = join(kilnDir, descriptor.log)
  let current = null
  try {
    current = readFileSync(logPath, 'utf8')
  } catch (error) {
    // ENOENT is a legitimately absent .log (a fresh project). ANY other error — EACCES on a
    // chmod-000 log, EISDIR, a genuine IO fault — is an UNREADABLE membership log, and unreadable is
    // UNTRUSTED: coercing it to null would let the wipe-guard read it as absent, skip the hold, and
    // the kernel would then judge membership over a log it could not read. Hold fail-closed instead,
    // mirroring readLedgerRows and the S3 sealMembers "unreadable ledger = HOLD" discipline.
    if (error.code !== 'ENOENT') {
      stop('transport_failure', `${descriptor.log} could not be read — an unreadable membership log is untrusted; reconcile holds rather than judge it absent`, TRANSPORT_FAILURE)
    }
    current = null
  }
  if (current === projection) return
  // A zero-row projection is legitimate ONLY for a genuinely empty ledger — a fresh project with no
  // .log yet writes nothing, so reconcile never creates an empty seals.log a scenario poll would
  // misread. But an EMPTY projection beside a NONEMPTY .log is an unreconcilable B09 anomaly: the
  // JSONL truth renders no members while the .log still claims sealed slices (a present-but-empty or
  // torn-only JSONL that skipped migration because it is not ABSENT). Rendering '' would wipe the
  // membership log and the next boot would rebuild already-sealed work — the exact failure the ledger
  // exists to prevent. Hold fail-closed rather than overwrite. In S6 append-only means this is ALWAYS
  // the anomaly; S7 note: once invalidation rows can render null, a legitimately-emptied ledger will
  // need an explicit signal to tell it apart from this wipe.
  if (projection === '') {
    if (current === null) return
    stop('transport_failure', `${descriptor.log} is nonempty but its JSONL truth renders no members — refusing to wipe sealed membership`, TRANSPORT_FAILURE)
  }
  mkdirSync(kilnDir, { recursive: true })
  const temporary = join(kilnDir, '.' + descriptor.log + '.tmp-' + process.pid + '-' + randomUUID())
  writeFileSync(temporary, projection)
  renameSync(temporary, logPath)
}

// Parse one legacy .log line into a LEGACY-marked typed row for the W1->W2 migration (B09). The
// readable fields are recovered; run_id and ts are honestly ABSENT (a legacy line records neither),
// never fabricated. legacy:true lets S7 require re-verification before conferring full-trust
// attestation; for S6 the row still renders and still grants membership, preserving the exact W1
// resume behaviour the migration must never rebuild.
function legacyLedgerRow(descriptor, line) {
  if (descriptor.type === 'seal') {
    const space = line.indexOf(' ')
    return space === -1
      ? { type: 'seal', slice: line, label: '', legacy: true }
      : { type: 'seal', slice: line.slice(0, space), label: line.slice(space + 1), legacy: true }
  }
  const tokens = line.split(' ')
  const row = { type: 'audit', seam: tokens[0], outcome: tokens[1] !== undefined ? tokens[1] : 'accept', legacy: true }
  if (tokens[2] !== undefined) row.label = tokens[2]
  return row
}

// W1->W2 migration (B09). A nonempty legacy .log with no JSONL is a project sealed before the
// ledger existed: import each line as a legacy row so the JSONL becomes the truth WITHOUT rebuilding
// sealed work or fabricating hashes. Written atomically; an absent or empty legacy .log migrates
// nothing (there is no sealed record to preserve).
function migrateLegacyLog(kilnDir, descriptor) {
  let legacy = ''
  try {
    legacy = readFileSync(join(kilnDir, descriptor.log), 'utf8')
  } catch (error) {
    if (error.code === 'ENOENT') return
    throw error
  }
  if (legacy.trim() === '') return
  const rows = []
  for (const line of legacy.split('\n')) {
    if (line === '') continue
    rows.push(legacyLedgerRow(descriptor, line))
  }
  const body = rows.map((row) => JSON.stringify(row) + '\n').join('')
  mkdirSync(kilnDir, { recursive: true })
  const temporary = join(kilnDir, '.' + descriptor.jsonl + '.tmp-' + process.pid + '-' + randomUUID())
  writeFileSync(temporary, body)
  renameSync(temporary, join(kilnDir, descriptor.jsonl))
}

// Reconcile one ledger: the JSONL is truth. Present -> re-render the .log from it if stale. Absent
// -> migrate a legacy .log into JSONL first (a W1 project), then render. Idempotent: a second call
// finds the JSONL present and the .log already matching, and writes nothing. A genuine IO fault
// fails closed through stop so a caller never advances on an unreconciled ledger.
function reconcileLedger(kilnDir, descriptor) {
  try {
    let rows = readLedgerRows(join(kilnDir, descriptor.jsonl))
    if (rows === null) {
      migrateLegacyLog(kilnDir, descriptor)
      rows = readLedgerRows(join(kilnDir, descriptor.jsonl))
      if (rows === null) return
    }
    writeProjectionIfStale(kilnDir, descriptor, rows)
  } catch (error) {
    stop('transport_failure', `reconcile could not heal the ${descriptor.log} projection: ${error.message}`, TRANSPORT_FAILURE)
  }
}

// Append a typed row to the JSONL truth, then re-render the .log from the JSONL. The append prefixes
// a newline when a crash left the ledger without a trailing one, so the new row lands on its own line
// and the torn line stays independently recoverable (the archiveVerdict write discipline). Callers
// reconcile FIRST so a stale .log or an un-migrated W1 log never misleads the render.
function appendLedgerRow(kilnDir, descriptor, row) {
  const jsonlPath = join(kilnDir, descriptor.jsonl)
  let raw = ''
  try {
    raw = readFileSync(jsonlPath, 'utf8')
  } catch (error) {
    if (error.code !== 'ENOENT') stop('transport_failure', `${descriptor.jsonl} could not be read: ${error.message}`, TRANSPORT_FAILURE)
  }
  const prefix = raw.length > 0 && !raw.endsWith('\n') ? '\n' : ''
  mkdirSync(kilnDir, { recursive: true })
  try {
    appendFileSync(jsonlPath, prefix + JSON.stringify(row) + '\n')
  } catch (error) {
    stop('transport_failure', `${descriptor.jsonl} could not be appended: ${error.message}`, TRANSPORT_FAILURE)
  }
  try {
    writeProjectionIfStale(kilnDir, descriptor, readLedgerRows(jsonlPath) || [])
  } catch (error) {
    stop('transport_failure', `${descriptor.log} projection could not be rendered: ${error.message}`, TRANSPORT_FAILURE)
  }
}

// process.kill(pid, 0) probes liveness without delivering a signal. Only ESRCH PROVES the
// holder is gone; success and EPERM prove it alive; any other error, or a missing or
// non-positive pid, is UNKNOWN. Takeover requires PROVEN dead, so it treats UNKNOWN as
// not-dead and fails closed — a lock is never taken over on unproven death (B03).
function pidState(pid) {
  if (!Number.isInteger(pid) || pid <= 0) return 'unknown'
  try {
    process.kill(pid, 0)
    return 'alive'
  } catch (error) {
    if (error.code === 'ESRCH') return 'dead'
    if (error.code === 'EPERM') return 'alive'
    return 'unknown'
  }
}

// Is a lock record takeover-stale? BOTH the holder pid must be PROVEN dead AND the lock aged
// past the floor — never time alone. Returns the reason on a refusal so the honest fact can
// name why (fail closed on an unprobeable pid or an unreadable start time).
function takeoverStale(record) {
  const state = pidState(record.conductor_pid)
  if (state === 'alive') return { stale: false, fact: 'live' }
  if (state !== 'dead') return { stale: false, fact: 'unprobeable' }
  const startedAt = Date.parse(record.started_at)
  if (!Number.isFinite(startedAt)) return { stale: false, fact: 'no-start' }
  if (Date.now() - startedAt < LOCK_AGE_FLOOR_MS) return { stale: false, fact: 'young' }
  return { stale: true, fact: 'stale' }
}

// Claim-by-rename: rename(2) on ONE source path has exactly one winner — the loser gets ENOENT.
// After a successful claim the caller holds the ONLY reference to those bytes, so every decision
// (takeover staleness, release identity) is re-made on the CLAIMED bytes, never on the pre-claim
// read a concurrent contender may already have invalidated. Returns {claimPath, record} on the
// win, or null when the claim was lost (ENOENT). Crash residue between claim and its terminal
// move leaves an orphaned .run.lock.claim-* file and an empty lock path — acceptable: the record
// bytes survive on disk (never-delete) and the next acquire proceeds fresh; there is no janitor.
function claimLock(kilnDir) {
  const claimPath = join(kilnDir, `.run.lock.claim-${process.pid}-${randomUUID()}`)
  try {
    renameSync(join(kilnDir, LOCK_FILE), claimPath)
  } catch (error) {
    if (error.code === 'ENOENT') return null
    throw error
  }
  return { claimPath, record: readLockRecord(claimPath).record }
}

// The claimed record is NOT the one this verb may end (a fresh lock landed in the claim window):
// put it back. linkSync is create-exclusive — on success the claim is dropped and the lock is
// whole again (returns true). If the path is re-occupied, the displaced record is archived (never
// lost — its owner join-fails into the honest hold) and the claim removed (true). If archival ALSO
// fails (history unavailable), the claim file is the SOLE surviving copy, so it is PRESERVED on
// disk untouched — the documented orphan-claim residue — and false is returned: the claim is NEVER
// unlinked without the record safe somewhere durable, and the caller surfaces the transport failure.
function restoreOrArchive(kilnDir, claimPath, record) {
  try {
    linkSync(claimPath, join(kilnDir, LOCK_FILE))
    try { unlinkSync(claimPath) } catch { /* restored; the claim link can linger harmlessly */ }
    return true
  } catch { /* the lock path is re-occupied — the claimed record cannot go back there */ }
  if (record) {
    try {
      archiveLockRecord(kilnDir, record, 'displaced')
      try { unlinkSync(claimPath) } catch { /* archived; the claim file can linger harmlessly */ }
      return true
    } catch { /* history is unavailable — the claim is the last copy; preserve it, fall through */ }
  }
  return false
}

// The terminal move when this verb IS authorized to end the claimed lock: archive the record,
// then drop the claim. Archive FIRST, unlink second — never an unlink without an archive. If the
// archive fails, the record is the only copy, so it is RESTORED to the lock path rather than
// lost, and the caller fails transport. Returns true on a clean archive+drop.
function archiveAndDrop(kilnDir, claimPath, record, event) {
  try {
    archiveLockRecord(kilnDir, record, event)
  } catch {
    try { linkSync(claimPath, join(kilnDir, LOCK_FILE)); unlinkSync(claimPath) } catch { /* bytes remain in the claim file */ }
    return false
  }
  try { unlinkSync(claimPath) } catch { /* archived; the claim file can linger harmlessly */ }
  return true
}

const [mode, ...args] = process.argv.slice(2)
if (mode === 'review' && args.length === 7) {
  // W2-S4: the AUTHORITATIVE facts ride argv (the audit-verb pattern) and the sealed trio —
  // repo, kilnDir, the named slice, the reviewer model and effort (kernel-resolved from
  // validated tiers), then the builder request (hints only) and the output. law_hash and
  // law_text derive from the sealed LAW; the builder authors neither.
  const [repoPath, kilnDir, sliceId, model, effort, requestFile, outputFile] = args
  const request = auditRequest(model, effort, 'review')
  const facts = buildGateFacts(kilnDir, sliceId)
  const packet = {
    mode: 'review',
    review_id: randomUUID(),
    slice_id: sliceId,
    law_hash: facts.lawHash,
    law_text: facts.lawText,
    builder_hints: hintsFrom(requestFile),
  }
  invoke(repository(repoPath), request, packet, outputFile)
} else if (mode === 'recheck' && args.length === 9) {
  const [repoPath, kilnDir, sliceId, model, effort, requestFile, priorFile, repairDeltaFile, outputFile] = args
  const request = auditRequest(model, effort, 'recheck')
  const facts = buildGateFacts(kilnDir, sliceId)
  const hints = hintsFrom(requestFile)
  const prior = readJson(priorFile, 'invalid prior gate review')
  const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
  const priorError = priorShape ? validateShape(prior, prior.review_id, prior.law_hash) : 'prior gate review is malformed'
  if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
  if (prior.verdict !== 'changes_required') {
    stop('transport_failure', 'recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
  }
  // The recheck rides the SEALED law hash, and the prior round rode the same seal (a LAW edit
  // is a reopen, never a silent recheck), so the two must agree; a disagreement is a torn cohort.
  if (prior.law_hash !== facts.lawHash) stop('transport_failure', 'the sealed LAW hash differs from the prior review', TRANSPORT_FAILURE)

  let repairDelta
  try {
    repairDelta = readFileSync(resolve(repairDeltaFile), 'utf8')
  } catch (error) {
    stop('transport_failure', `invalid repair delta: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (repairDelta.trim() === '') stop('transport_failure', 'repair delta must not be empty', TRANSPORT_FAILURE)

  const findingIds = new Set(prior.findings.map((finding) => finding.id))
  const packet = {
    mode: 'recheck',
    review_id: prior.review_id,
    slice_id: sliceId,
    law_hash: facts.lawHash,
    law_text: facts.lawText,
    builder_hints: hints,
    finding_ids: [...findingIds],
    // FIX-1: every recheck packet carries the prior findings IN FULL beside their ids —
    // a fresh-context reviewer cannot verify resolution from bare ids (fatal on
    // ratify-recheck, whose reviewer sees only the artifact text). Context only; the
    // finding_ids cohort rule is unchanged.
    prior_findings: prior.findings,
    repair_delta: repairDelta,
  }
  invoke(repository(repoPath), request, packet, outputFile, findingIds)
} else if (mode === 'gate-facts' && args.length === 4) {
  // W2-S4 (B02/B03/B04): the ONE authority the claude gate leg shares with the codex packet. The
  // kernel claude reviewer is an agent, not this CLI, so it cannot run sealedAuthority itself; it
  // calls here. buildGateFacts binds law_hash to the CROSS-BOUND sealed trio (trio[LAW.md] ===
  // lock.hash === lock.seal digest) and holds TRIO_MISMATCH on any torn or swapped seal — so a
  // lock.hash quietly changed to a valid-but-different digest never rides an accept. hintsFrom
  // FILTERS the builder request to its four hint fields, written to a trusted facts file the
  // reviewer reads instead of the raw request, so a forged law_text/slice_id/law_hash or an
  // injected instruction field never reaches the model. The cross-bound digest prints to stdout
  // for the kernel to bind and to validate the reviewer echo against.
  const [kilnDir, sliceId, requestFile, outputFile] = args
  const facts = buildGateFacts(kilnDir, sliceId)
  const hints = hintsFrom(requestFile)
  const output = resolve(outputFile)
  const temporary = join(dirname(output), `.gate-facts.tmp-${process.pid}-${randomUUID()}`)
  writeFileSync(temporary, JSON.stringify({ slice_id: sliceId, builder_hints: hints }, null, 2))
  renameSync(temporary, output)
  process.stdout.write(facts.lawHash + '\n')
  process.exit(ACCEPT)
} else if (mode === 'append-seal' && args.length === 3) {
  // The recovered v3 "Thoth scribe": an opaque, trusted seal-append verb. The kernel courier calls
  // it instead of a bare shell append it declines to moralize; the seal ledger semantics live here.
  // Closed label, nonempty slice. W2-S6: the row lands in seals.jsonl (the append-only truth) and
  // seals.log is re-rendered from it as the current-valid projection. reconcile FIRST so a crash
  // between a prior append and its render, or a W1 project whose seals.log predates the JSONL, is
  // healed before this append reads the ledger. The S6 row carries the fields cheaply available now
  // — the run_id from the CLI-owned lock (S5) and an ISO stamp; S7 adds the full-hash block.
  const [kilnDir, slice, label] = args
  if (label !== 'dual' && label !== 'single-family') {
    stop('transport_failure', 'append-seal label must be dual or single-family', TRANSPORT_FAILURE)
  }
  if (typeof slice !== 'string' || slice.trim() === '') {
    stop('transport_failure', 'append-seal slice id must be a nonempty string', TRANSPORT_FAILURE)
  }
  reconcileLedger(kilnDir, SEAL_LEDGER)
  appendLedgerRow(kilnDir, SEAL_LEDGER, { type: 'seal', slice, label, run_id: runIdFromLock(kilnDir), ts: new Date().toISOString() })
  process.exit(ACCEPT)
} else if (mode === 'seal-law' && args.length === 2) {
  // The trusted LAW lock, content-blind. W2-S3: the seal now covers the whole trio —
  // LAW.md, law/check.sh and slices.json — each digested individually into
  // .kiln/law/trio.hash (fixed order, strict shape). A missing member is a transport stop:
  // the law is not whole enough to seal. lock.hash stays exactly the LAW.md digest a card
  // shell computes via `sha256sum .kiln/LAW.md | cut -d' ' -f1` (64-hex + one trailing
  // newline — audit and screen require that shape); S4-D4: the family label
  // (dual|single-family) rides the DIGEST-BOUND sidecar .kiln/law/lock.seal = `<digest>
  // <label>`. trio.hash is promoted FIRST, then lock.seal, then lock.hash, so a reseal never
  // leaves a stale trio or label beside a fresh lock — the sidecar-ordering discipline one
  // member deeper.
  const [kilnDir, label] = args
  if (label !== 'dual' && label !== 'single-family') {
    stop('transport_failure', 'seal-law label must be dual or single-family', TRANSPORT_FAILURE)
  }
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'seal-law kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const memberDigests = {}
  for (const name of TRIO_MEMBERS) {
    try {
      memberDigests[name] = createHash('sha256').update(readFileSync(trioMemberPath(kilnDir, name))).digest('hex')
    } catch (error) {
      stop('transport_failure', `seal-law could not read the trio member ${name}: ${error.message}`, TRANSPORT_FAILURE)
    }
  }
  const digest = memberDigests['LAW.md']
  const target = join(kilnDir, 'law', 'lock.hash')
  const sidecar = join(kilnDir, 'law', 'lock.seal')
  const trio = trioHashPath(kilnDir)
  try {
    mkdirSync(dirname(target), { recursive: true })
    const trioTemporary = join(dirname(trio), `.trio.hash.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(trioTemporary, TRIO_MEMBERS.map((name) => `${name} ${memberDigests[name]}\n`).join(''))
    renameSync(trioTemporary, trio)
    const sidecarTemporary = join(dirname(sidecar), `.lock.seal.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(sidecarTemporary, `${digest} ${label}\n`)
    renameSync(sidecarTemporary, sidecar)
    const temporary = join(dirname(target), `.lock.hash.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(temporary, `${digest}\n`)
    renameSync(temporary, target)
  } catch (error) {
    stop('transport_failure', `seal-law could not write the seal: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.exit(ACCEPT)
} else if (mode === 'run-checks' && args.length === 1) {
  // W2-S3 (B04): the fused verify-and-run. ONE trusted operation replaces the bare
  // `bash .kiln/law/check.sh` hands wherever a sealed trio exists — sealedAuthority confirms
  // the whole cross-bound seal, every live member is re-verified against law/trio.hash, and
  // ONLY on a complete match does check.sh execute in-process (argv spawn, no shell string).
  // EXIT LAW: a torn or partial seal, or a live file drifted from its sealed digest, exits
  // TRIO_MISMATCH (22) — the integrity class the kernel holds on at every post-seal site, so
  // check.sh NEVER runs. TRANSPORT_FAILURE (20) is reserved for an unsealed law (a seal is
  // required here) or a genuine check.sh spawn fault AFTER a verified seal. On a match check.sh
  // streams its stdout verbatim and its exit code passes through, so every consumer of the
  // check output — the owning-slice ids the red path prints on stdout, and the kernel-side
  // receipt capture — keeps working unchanged.
  const [kilnDir] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-checks kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) {
    stop('transport_failure', 'run-checks requires the sealed law — the law must be sealed before its checks run', TRANSPORT_FAILURE)
  }
  for (const name of TRIO_MEMBERS) {
    let live
    try {
      live = createHash('sha256').update(readFileSync(trioMemberPath(kilnDir, name))).digest('hex')
    } catch (error) {
      stop('trio_mismatch', `run-checks: the sealed trio member ${name} could not be read — a torn seal; check.sh will not run`, TRIO_MISMATCH)
    }
    if (live !== auth.trio[name]) {
      stop('trio_mismatch', `run-checks: ${name} no longer matches the sealed law/trio.hash digest — check.sh will not run`, TRIO_MISMATCH)
    }
  }
  const check = spawnSync('bash', [trioMemberPath(kilnDir, 'check.sh')], { stdio: 'inherit' })
  if (check.error) {
    stop('transport_failure', `run-checks could not execute check.sh: ${check.error.message}`, TRANSPORT_FAILURE)
  }
  process.exit(check.status === null ? TRANSPORT_FAILURE : check.status)
} else if (mode === 'slices' && args.length === 1) {
  // W2-S3 (B03): the fused build-order fetch. verify-and-parse slices.json against the sealed
  // trio in ONE operation, then print the descriptor projection the kernel dispatches builders
  // from — a bare id string, or "obj|<id>|<surface>|<milestone>". The build stage is always
  // sealed, so an unsealed law holds; a tampered slices.json is a TRIO_MISMATCH hold, so a
  // write-capable builder is never dispatched over drifted facts. The projection is
  // byte-compatible with the former node -p leg the kernel slices:fetch used.
  const [kilnDir] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'slices kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'slices requires the sealed law — the build order is only fetched after the seal', TRANSPORT_FAILURE)
  let slices
  try {
    slices = JSON.parse(verifyMember(auth, kilnDir, 'slices.json', 'slices').toString('utf8'))
  } catch (error) {
    stop('transport_failure', `invalid slices projection: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (!Array.isArray(slices)) stop('transport_failure', 'slices.json must be a JSON array', TRANSPORT_FAILURE)
  const proj = slices.map((s) => (typeof s === 'string'
    ? s
    : 'obj|' + String((s && s.id) || '') + '|' + String((s && s.surface) || '') + '|' + String((s && s.milestone) || '')))
  process.stdout.write(JSON.stringify(proj))
  process.exit(ACCEPT)
} else if (mode === 'screen-criteria' && args.length === 1) {
  // W2-S3 (B04): the Perceptual criterion ids for the claude screen ownership enforcement,
  // derived over VERIFIED LAW.md — screenLawFacts fuses the read with the sealed-trio check,
  // so the ids the kernel enforces rest on sealed bytes, not a raw re-read.
  const [kilnDir] = args
  const facts = screenLawFacts(kilnDir)
  process.stdout.write(JSON.stringify(facts.rows.map((r) => r.criterion)))
  process.exit(ACCEPT)
} else if (mode === 'perceptual-family' && args.length === 1) {
  // W2-S3 (B04): the perceptual family routing, over the VERIFIED trio — exit 0 iff a
  // ui-surfaced slice owns a Perceptual row (the GPT screen family), else 1. The
  // write-capable screen routing rests on sealed bytes; a torn seal holds (TRIO_MISMATCH).
  const [kilnDir] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'perceptual-family kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  const auth = sealedAuthority(kilnDir)
  if (!auth.sealed) stop('transport_failure', 'perceptual-family requires the sealed law', TRANSPORT_FAILURE)
  const facts = screenLawFacts(kilnDir)
  let slices
  try {
    slices = JSON.parse(verifyMember(auth, kilnDir, 'slices.json', 'perceptual-family').toString('utf8'))
  } catch (error) {
    stop('transport_failure', `invalid slices projection: ${error.message}`, TRANSPORT_FAILURE)
  }
  const surf = {}
  for (const s of (Array.isArray(slices) ? slices : [])) {
    if (typeof s === 'string') surf[s.trim()] = 'mixed'
    else surf[String((s && s.id) || '').trim()] = String((s && s.surface) || '').trim()
  }
  process.exit(facts.rows.some((r) => surf[r.slice] === 'ui') ? 0 : 1)
} else if (mode === 'ratify' && args.length === 4) {
  // Ratify a readable artifact against a rubric — the reusable "review an artifact
  // against a rubric" path whose first consumer is the not-yet-sealed LAW. There is
  // no locked digest to compare against yet (the seal is written only after accept),
  // so this path never runs the slice's locked-LAW equality; it asserts the echoed
  // law_hash against the artifact's OWN candidate digest, computed exactly as seal-law
  // computes lock.hash so the ratified bytes and the sealed digest are byte-identical.
  // W2-S5: this ONE verb serves two review families (the kernel LAW ratify and the
  // research-sweep feasibility ratify), so the archive family rides argv — the caller
  // that knows which review this is passes the label the verdict is filed under.
  const [repoPath, requestFile, outputFile, family] = args
  const request = ratifyRequestFrom(requestFile)
  const repo = repository(repoPath)
  let artifactBytes
  try {
    artifactBytes = readFileSync(resolve(repo, request.artifact))
  } catch (error) {
    stop('transport_failure', `ratify artifact unreadable: ${error.message}`, TRANSPORT_FAILURE)
  }
  const candidateDigest = createHash('sha256').update(artifactBytes).digest('hex')
  const packet = {
    mode: 'ratify',
    review_id: request.reviewId,
    law_hash: candidateDigest,
    rubric: rubricFrom(request.rubric),
    artifact: artifactBytes.toString('utf8'),
  }
  runGate(repo, request, ratifyInstructions(packet), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id)
    if (shape) return shape
    if (gate.law_hash !== candidateDigest) return 'law_hash does not match the ratified artifact digest'
    return null
  }, family)
} else if (mode === 'ratify-recheck' && args.length === 5) {
  // W6-02: the ratify verb gains the cohort lineage it lacked. A recheck of an
  // already-graded artifact reuses the prior review_id and constrains the reviewer to
  // the prior finding cohort — the SAME allowedFindingIds + prior changes_required
  // discipline the build recheck enforces (validateShape's out-of-scope rule), so a
  // ratify repair round cannot introduce a finding id out of nowhere. The artifact is
  // regenerated between rounds (the LAW-ratify repair rewrites the whole LAW), so
  // law_hash tracks the CURRENT artifact digest, not the prior one; the reused
  // review_id carries the lineage instead.
  const [repoPath, requestFile, priorFile, outputFile, family] = args
  const request = ratifyRequestFrom(requestFile)
  const prior = readJson(priorFile, 'invalid prior ratify review')
  const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
  const priorError = priorShape ? validateShape(prior, prior.review_id, prior.law_hash) : 'prior ratify review is malformed'
  if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
  if (prior.verdict !== 'changes_required') {
    stop('transport_failure', 'ratify-recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
  }
  if (prior.review_id !== request.reviewId) {
    stop('transport_failure', 'ratify-recheck request review_id differs from the prior review', TRANSPORT_FAILURE)
  }
  const repo = repository(repoPath)
  let artifactBytes
  try {
    artifactBytes = readFileSync(resolve(repo, request.artifact))
  } catch (error) {
    stop('transport_failure', `ratify artifact unreadable: ${error.message}`, TRANSPORT_FAILURE)
  }
  const candidateDigest = createHash('sha256').update(artifactBytes).digest('hex')
  const findingIds = new Set(prior.findings.map((finding) => finding.id))
  const packet = {
    mode: 'ratify-recheck',
    review_id: request.reviewId,
    law_hash: candidateDigest,
    rubric: rubricFrom(request.rubric),
    artifact: artifactBytes.toString('utf8'),
    finding_ids: [...findingIds],
    prior_findings: prior.findings,
  }
  runGate(repo, request, ratifyInstructions(packet), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, undefined, findingIds)
    if (shape) return shape
    if (gate.law_hash !== candidateDigest) return 'law_hash does not match the ratified artifact digest'
    return null
  }, family)
} else if (mode === 'audit' && args.length === 6) {
  // W7-A1: the milestone-seam audit — one fresh goal-backward GPT reviewer over the
  // cumulative sealed prefix. argv carries closed facts only; every derived fact — the
  // closing block, the cumulative prefix, the milestone label (which may contain spaces
  // and rides only inside the composed prompt, never argv, never a log line) — is
  // computed here from the checked slices.json projection. law_hash binds to the sealed
  // lock.hash, the review_id is minted fresh exactly as review does, and the transport
  // is the review verb's: codex, read-only sandbox, schema-forced output, closed exits.
  const [repoPath, kilnDir, seamSliceId, model, effort, outputFile] = args
  const request = auditRequest(model, effort)
  const repo = repository(repoPath)
  const facts = auditFacts(kilnDir, seamSliceId)
  const packet = {
    mode: 'audit',
    review_id: randomUUID(),
    law_hash: facts.lawHash,
    seam_slice: seamSliceId,
    milestone: facts.milestone,
    closing_block: facts.closingBlock,
    sealed_prefix: facts.sealedPrefix,
  }
  invokeAudit(repo, request, packet, outputFile)
} else if (mode === 'audit-recheck' && args.length === 8) {
  // W7-A1: the audit recheck mirrors recheck with two deliberate widenings: the prior
  // verdict may be changes_required OR blocked (audit blockers reopen their owning
  // slices, so a blocked milestone is recoverable at this gate), and the law binding is
  // the sealed lock.hash rather than a request law_hash. The cohort is the prior finding
  // ids — reuse-or-clear, no new or renamed ids — and the same audit verb-level shape
  // rules gate the prior (an artifact invalid for the audit family establishes no
  // lineage) and the current output.
  const [repoPath, kilnDir, seamSliceId, model, effort, priorFile, repairDeltaFile, outputFile] = args
  const request = auditRequest(model, effort)
  const repo = repository(repoPath)
  const facts = auditFacts(kilnDir, seamSliceId)
  const prior = readJson(priorFile, 'invalid prior audit review')
  const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
  // The prior must satisfy the FULL audit-family shape — shared validateShape plus the
  // audit verb-level rules — before it can seed a cohort: a blocked prior with empty
  // findings or an orphan blocker id was never a publishable audit, so it cannot
  // establish recheck lineage here either.
  const priorError = priorShape
    ? (validateShape(prior, prior.review_id, prior.law_hash) || auditShapeInvalid(prior))
    : 'prior audit review is malformed'
  if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
  if (prior.verdict !== 'changes_required' && prior.verdict !== 'blocked') {
    stop('transport_failure', 'audit-recheck requires a prior changes_required or blocked verdict', TRANSPORT_FAILURE)
  }
  if (prior.law_hash !== facts.lawHash) {
    stop('transport_failure', 'prior audit law_hash differs from the sealed law/lock.hash', TRANSPORT_FAILURE)
  }
  let repairDelta
  try {
    repairDelta = readFileSync(resolve(repairDeltaFile), 'utf8')
  } catch (error) {
    stop('transport_failure', `invalid repair delta: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (repairDelta.trim() === '') stop('transport_failure', 'repair delta must not be empty', TRANSPORT_FAILURE)
  const findingIds = new Set(prior.findings.map((finding) => finding.id))
  const packet = {
    mode: 'audit-recheck',
    review_id: prior.review_id,
    law_hash: facts.lawHash,
    seam_slice: seamSliceId,
    milestone: facts.milestone,
    closing_block: facts.closingBlock,
    sealed_prefix: facts.sealedPrefix,
    finding_ids: [...findingIds],
    prior_findings: prior.findings,
    repair_delta: repairDelta,
  }
  invokeAudit(repo, request, packet, outputFile, findingIds)
} else if (mode === 'append-audit' && args.length === 3) {
  // W7: the ONLY writer of audits.log — append-seal's milestone-seam mirror. The kernel
  // promotes an accepted audit through this trusted verb, never a bare shell append; the
  // audits.log semantics live here. The outcome label is the fixed `accept`, and S4-D4
  // adds the family label (dual|single-family) as a THIRD field: `<seam> accept <label>`.
  // The membership grep anchors the first field only and sealMembers splits on the first
  // field, so a third field is compatible. The seam slice id is gated with the SAME
  // slice-id charset the kernel enforces at slice intake (parseSliceEntry SLICE_ID) — one
  // contract, so every id a build can carry publishes. The id becomes the grep anchor
  // `^<id> `, where whitespace or control bytes could forge or split a log line; slash is
  // inside the set (path-like ids such as feature/ui are anchor-safe).
  const [kilnDir, seamSliceId, label] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'append-audit kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (typeof seamSliceId !== 'string' || !/^[A-Za-z0-9._/-]+$/.test(seamSliceId)) {
    stop('transport_failure', 'append-audit seam slice id must be nonempty using only letters, digits, dot, underscore, hyphen or slash', TRANSPORT_FAILURE)
  }
  if (label !== 'dual' && label !== 'single-family') {
    stop('transport_failure', 'append-audit label must be dual or single-family', TRANSPORT_FAILURE)
  }
  // W2-S6: the row lands in audits.jsonl (append-only truth) and audits.log is re-rendered from it
  // as the current-valid projection, exactly as append-seal treats the seal ledger. reconcile first
  // so a stale or un-migrated audits.log never misleads this append.
  reconcileLedger(kilnDir, AUDIT_LEDGER)
  appendLedgerRow(kilnDir, AUDIT_LEDGER, { type: 'audit', seam: seamSliceId, outcome: 'accept', label, run_id: runIdFromLock(kilnDir), ts: new Date().toISOString() })
  process.exit(ACCEPT)
} else if (mode === 'reconcile' && args.length === 1) {
  // W2-S6 (B06): the trusted reconcile the kernel calls once at boot before its membership reads,
  // and the append verbs call on entry. Renders seals.log and audits.log from their JSONL truth when
  // stale or absent, migrating a W1 legacy .log into JSONL first. Idempotent and content-blind — an
  // absent ledger reconciles to nothing, so a fresh project creates no empty projection.
  const [kilnDir] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'reconcile kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  reconcileLedger(kilnDir, SEAL_LEDGER)
  reconcileLedger(kilnDir, AUDIT_LEDGER)
  process.exit(ACCEPT)
} else if (mode === 'screen' && args.length === 5) {
  // W8-S2: the perceptual screen — one fresh grader over the CURRENT evidence
  // generation's bounded pixels. argv carries closed facts only; the verb derives the
  // LAW Perceptual rows, the sealed lock.hash (packet text), and the CURRENT
  // generation itself. Pre-spawn rejects (exit 20, nothing published, no codex): no
  // CURRENT generation, a manifest missing any required class, any bound exceeded.
  // The transport is the review family's — read-only codex, the byte-untouched
  // review-schema.json, closed exits — plus the manifest's images on `-i`. Binding:
  // the schema's law_hash = sha256 of the graded generation's manifest.json, asserted
  // post-run exactly as ratify asserts its artifact digest.
  const [repoPath, kilnDir, model, effort, outputFile] = args
  const request = auditRequest(model, effort, 'screen')
  const repo = repository(repoPath)
  const facts = screenLawFacts(kilnDir)
  const generation = currentGeneration(kilnDir)
  const evidence = screenEvidence(generation)
  const criterionIds = new Set(facts.rows.map((row) => row.criterion))
  const packet = {
    mode: 'screen',
    review_id: randomUUID(),
    law_hash: generation.digest,
    ...screenPacket(facts, generation, evidence),
  }
  runGate(repo, request, screenInstructions(packet), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, undefined, undefined, SCREEN_LOCATION)
    if (shape) return shape
    if (gate.law_hash !== generation.digest) return 'law_hash does not match the graded generation manifest digest'
    return screenShapeInvalid(gate, criterionIds)
  }, 'screen', evidence.images)
} else if (mode === 'screen-recheck' && args.length === 7) {
  // W8-S2: the screen recheck — the recheck discipline pointed at fresh pixels. Same
  // review_id lineage, cohort reuse-or-clear over the prior finding ids, and
  // FRESHNESS: the CURRENT manifest digest MUST DIFFER from the prior verdict's
  // law_hash, so a regrade can never re-grade the very evidence that already failed.
  // delta IS the fresh CURRENT manifest: the argv path must resolve to it, and the
  // bytes read must re-hash to the selected digest — path- and digest-bound, so no
  // free text ever rides the packet as repair_delta.
  const [repoPath, kilnDir, model, effort, priorFile, deltaFile, outputFile] = args
  const request = auditRequest(model, effort, 'screen')
  const repo = repository(repoPath)
  const facts = screenLawFacts(kilnDir)
  const criterionIds = new Set(facts.rows.map((row) => row.criterion))
  const prior = readJson(priorFile, 'invalid prior screen review')
  const priorShape = isObject(prior) && typeof prior.review_id === 'string' && typeof prior.law_hash === 'string'
  // The prior must satisfy the FULL screen-family shape — a blocked verdict, a
  // blocker, or an off-table criterion was never a publishable screen verdict, so it
  // establishes no recheck lineage (the audit-recheck precedent).
  const priorError = priorShape
    ? (validateShape(prior, prior.review_id, prior.law_hash, undefined, SCREEN_LOCATION) || screenShapeInvalid(prior, criterionIds))
    : 'prior screen review is malformed'
  if (priorError) stop('transport_failure', priorError, TRANSPORT_FAILURE)
  if (prior.verdict !== 'changes_required') {
    stop('transport_failure', 'screen-recheck requires a prior changes_required verdict', TRANSPORT_FAILURE)
  }
  const generation = currentGeneration(kilnDir)
  if (generation.digest === prior.law_hash) {
    stop('transport_failure', 'screen-recheck requires fresh evidence — the CURRENT manifest digest equals the prior graded generation', TRANSPORT_FAILURE)
  }
  const evidence = screenEvidence(generation)
  if (resolve(deltaFile) !== join(generation.dir, 'manifest.json')) {
    stop('transport_failure', 'screen-recheck delta must be the CURRENT generation manifest path', TRANSPORT_FAILURE)
  }
  let deltaBytes
  try {
    deltaBytes = readFileSync(resolve(deltaFile))
  } catch (error) {
    stop('transport_failure', `invalid fresh-manifest delta: ${error.message}`, TRANSPORT_FAILURE)
  }
  if (createHash('sha256').update(deltaBytes).digest('hex') !== generation.digest) {
    stop('transport_failure', 'fresh-manifest delta bytes do not match the CURRENT manifest digest', TRANSPORT_FAILURE)
  }
  const delta = deltaBytes.toString('utf8')
  const findingIds = new Set(prior.findings.map((finding) => finding.id))
  const packet = {
    mode: 'screen-recheck',
    review_id: prior.review_id,
    law_hash: generation.digest,
    ...screenPacket(facts, generation, evidence),
    finding_ids: [...findingIds],
    prior_findings: prior.findings,
    repair_delta: delta,
  }
  runGate(repo, request, screenInstructions(packet), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, undefined, findingIds, SCREEN_LOCATION)
    if (shape) return shape
    if (gate.law_hash !== generation.digest) return 'law_hash does not match the graded generation manifest digest'
    return screenShapeInvalid(gate, criterionIds)
  }, 'screen', evidence.images)
} else if (mode === 'screen-escalate' && args.length === 6) {
  // W8-S3 (ONLY-survivors): the bounded second-family escalation of a HELD screen
  // verdict. The held verdict rides argv as a closed path; the verb re-validates it
  // with the FULL screen-family shape (an artifact invalid for the family names no
  // survivors), derives the surviving criterion ids from its findings, and packets
  // ONLY the surviving rows — the grader never sees the rest of the table. A fresh
  // review_id: this is a second mind's scoped grade, not a lineage recheck. Scope is
  // enforced pre-publish exactly as table membership is on screen: a finding outside
  // the survivors is exit 20, and the off-scope verdict is never published.
  const [repoPath, kilnDir, model, effort, heldFile, outputFile] = args
  const request = auditRequest(model, effort, 'screen')
  const repo = repository(repoPath)
  const facts = screenLawFacts(kilnDir)
  const criterionIds = new Set(facts.rows.map((row) => row.criterion))
  const held = readJson(heldFile, 'invalid held screen review')
  const heldShape = isObject(held) && typeof held.review_id === 'string' && typeof held.law_hash === 'string'
  const heldError = heldShape
    ? (validateShape(held, held.review_id, held.law_hash, undefined, SCREEN_LOCATION) || screenShapeInvalid(held, criterionIds))
    : 'held screen review is malformed'
  if (heldError) stop('transport_failure', heldError, TRANSPORT_FAILURE)
  if (held.verdict !== 'changes_required') {
    stop('transport_failure', 'screen-escalate requires a held changes_required verdict', TRANSPORT_FAILURE)
  }
  const survivors = new Set(held.findings.map((finding) => finding.criterion))
  const generation = currentGeneration(kilnDir)
  const evidence = screenEvidence(generation)
  const packet = {
    mode: 'screen-escalate',
    review_id: randomUUID(),
    law_hash: generation.digest,
    ...screenPacket({ ...facts, rows: facts.rows.filter((row) => survivors.has(row.criterion)) }, generation, evidence),
  }
  runGate(repo, request, screenInstructions(packet), outputFile, (gate) => {
    const shape = validateShape(gate, packet.review_id, undefined, undefined, SCREEN_LOCATION)
    if (shape) return shape
    if (gate.law_hash !== generation.digest) return 'law_hash does not match the graded generation manifest digest'
    const shapeInvalid = screenShapeInvalid(gate, criterionIds)
    if (shapeInvalid) return shapeInvalid
    const off = gate.findings.find((finding) => !survivors.has(finding.criterion))
    if (off !== undefined) return `finding ${off.id} criterion ${off.criterion} is outside the surviving escalation scope`
    return null
  }, 'screen', evidence.images)
} else if (mode === 'publish-gate' && args.length === 4) {
  // W2-S5 (C3a / B05 / ruling 3): the claude-path publish. The kernel and research-sweep claude
  // legs cannot author files, so they hand this trusted verb the validated candidate they just
  // graded; the verb reads the candidate bytes, archives them to the immutable ledger, THEN renames
  // the candidate over the gate file — the same content-free overwrite the bare mv performed, now
  // with the prior verdict preserved first. The kernel stays content-blind: this verb, not the
  // kernel, parses and digests the bytes. A failed archive fails closed — nothing is renamed, so no
  // verdict is ever published without its archive row. The family rides argv because the caller,
  // not the file path, knows which review family this verdict belongs to (build and LAW ratify
  // share one gate file).
  const [kilnDir, family, candidatePath, gatePath] = args
  let verdictBytes
  try {
    verdictBytes = readFileSync(resolve(candidatePath))
  } catch (error) {
    stop('transport_failure', `publish-gate candidate unreadable: ${error.message}`, TRANSPORT_FAILURE)
  }
  const archiveError = archiveVerdict(kilnDir, family, verdictBytes)
  if (archiveError) stop('transport_failure', archiveError, TRANSPORT_FAILURE)
  try {
    renameSync(resolve(candidatePath), resolve(gatePath))
  } catch (error) {
    stop('transport_failure', `publish-gate could not publish: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.exit(ACCEPT)
} else if (mode === 'state-commit' && args.length >= 6) {
  // W1-S2 (Defect B): the trusted, content-blind STATE.md writer. The courier carries
  // only closed words; this verb validates the transition, derives the next-action prose
  // from the closed key, and stamps updated_at itself. Any invalid word halts by name
  // before any write — a stale or unsupported transition never lands, and no next-action
  // prose ever rode the courier for a leg to refuse.
  // W2-S2 (H6 / B02): the verb now persists a typed canonical .kiln/state.json and renders
  // the eight-line STATE.md (the exact former stateDoc format) FROM it, state.json landing
  // first — see the compose-and-write block below for the crash rule and reconciliation.
  const [kilnDir, token, stage, activeSlice, key, density, ...pointers] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'state-commit kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!STATE_TOKENS.has(token)) {
    stop('transport_failure', `state-commit token must be one of ${[...STATE_TOKENS].join('|')}`, TRANSPORT_FAILURE)
  }
  if (!STATE_STAGES.has(stage)) {
    stop('transport_failure', `state-commit stage must be one of ${[...STATE_STAGES].join('|')}`, TRANSPORT_FAILURE)
  }
  if (activeSlice !== 'none' && !STATE_SLICE_ID.test(activeSlice)) {
    stop('transport_failure', 'state-commit active_slice must be none or a slice id of letters, digits, dot, underscore, hyphen or slash', TRANSPORT_FAILURE)
  }
  if (density !== 'broad' && density !== 'engineer') {
    stop('transport_failure', 'state-commit density must be broad or engineer', TRANSPORT_FAILURE)
  }
  const nextAction = stateNextAction(key, stage, activeSlice)
  if (nextAction === null) {
    stop('transport_failure', 'state-commit next_action_key is not a known key', TRANSPORT_FAILURE)
  }
  // A1: token and key must agree on direction — a forward token (advance, seal-advance)
  // carries only a forward key (run-complete, relaunch-*), a stop token only a stop key.
  // The kernel never emits a contradiction; the trusted verb enforces its own contract so
  // a bypassed or tampered call fails closed.
  const forwardToken = token === 'advance' || token === 'seal-advance'
  const forwardKey = key === 'run-complete' || key.startsWith('relaunch-')
  if (forwardToken !== forwardKey) {
    stop('transport_failure', 'state-commit token and next_action_key disagree on the transition direction', TRANSPORT_FAILURE)
  }
  // B1: every pointer re-validated against the strict repo-relative grammar — no shell
  // metacharacter, whitespace, or parent-escape — belt-and-suspenders behind the kernel
  // filter and the shq quoting. A malformed pointer fails closed, nothing written.
  if (pointers.some((p) => !STATE_POINTER.test(p) || p.includes('..'))) {
    stop('transport_failure', 'state-commit pointers must be repo-relative safe paths', TRANSPORT_FAILURE)
  }
  const updatedAt = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z')
  const seals = '.kiln/seals.log'
  const statePath = join(kilnDir, 'state.json')
  // Read the canonical prior. A present-but-unparseable state.json is transport-class: the
  // canonical ledger is torn and guessing a revision would silently break monotonicity, so we
  // stop before touching disk rather than reset. Absent is the honest legacy/first-write case.
  let prior = null
  if (existsSync(statePath)) {
    let priorRaw
    try {
      priorRaw = readFileSync(statePath, 'utf8')
    } catch (error) {
      stop('transport_failure', `state-commit could not read state.json: ${error.message}`, TRANSPORT_FAILURE)
    }
    try {
      prior = JSON.parse(priorRaw)
    } catch (error) {
      stop('transport_failure', `state-commit found a malformed state.json — refusing to guess the canonical state: ${error.message}`, TRANSPORT_FAILURE)
    }
    if (!isObject(prior)) {
      stop('transport_failure', 'state-commit found a state.json that is not a JSON object — refusing to guess the canonical state', TRANSPORT_FAILURE)
    }
    // A present record MUST carry a positive counter. Resetting a damaged one to 1 would erase
    // monotonic history, so a missing or non-positive revision is torn-ledger, transport-class —
    // stopped BEFORE reconcile so nothing is written. Only a truly ABSENT file starts fresh at 1.
    if (!Number.isSafeInteger(prior.revision) || prior.revision <= 0) {
      stop('transport_failure', 'state-commit found a state.json whose revision is not a positive integer — refusing to reset monotonic history', TRANSPORT_FAILURE)
    }
    reconcileStateDoc(kilnDir, prior)
  }
  const revision = prior === null ? 1 : prior.revision + 1
  // run_id provenance: the CLI reads the CLI-owned run.lock ITSELF — never an argv relay. run_id is
  // trusted ONLY from a record in the CLI-minted W2-S1 shape (run_id + owner in the LOCK_TOKEN
  // grammar, a positive-integer conductor_pid — the same constants the run-lock verbs mint and
  // check against). A syntactically absent/unreadable lock AND a semantically non-conforming object
  // alike record run_id honestly as null (a legacy launch), never an unvalidated model-authorable
  // string dressed as authoritative identity.
  const lock = readLockRecord(join(kilnDir, LOCK_FILE)).record
  const lockConforms = isObject(lock)
    && typeof lock.run_id === 'string' && LOCK_TOKEN.test(lock.run_id)
    && typeof lock.owner === 'string' && LOCK_TOKEN.test(lock.owner)
    && Number.isInteger(lock.conductor_pid) && lock.conductor_pid > 0
  const runId = lockConforms ? lock.run_id : null
  const record = {
    revision,
    stage,
    active_slice: activeSlice,
    next_action_key: key,
    next_action: nextAction,
    density,
    pointers,
    seals,
    run_id: runId,
    updated_at: updatedAt,
  }
  const doc = renderStateDoc(record)
  record.render_digest = createHash('sha256').update(doc).digest('hex')
  // The crash rule: state.json (the canonical truth) lands FIRST, then STATE.md (the rendered
  // projection). If a crash falls between the renames, the reconcile in the next commit heals the
  // view; the reverse order could publish a rendered view with no canonical record behind it.
  try {
    mkdirSync(kilnDir, { recursive: true })
    const stateTmp = join(kilnDir, `.state.json.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(stateTmp, JSON.stringify(record) + '\n')
    renameSync(stateTmp, statePath)
    const docTmp = join(kilnDir, `.STATE.tmp-${process.pid}-${randomUUID()}`)
    writeFileSync(docTmp, doc)
    renameSync(docTmp, join(kilnDir, 'STATE.md'))
  } catch (error) {
    stop('transport_failure', `state-commit could not write the canonical state: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.exit(ACCEPT)
} else if (mode === 'run-lock' && args[0] === 'acquire' && args.length === 4) {
  // Acquire the run lock ONCE for a fresh run: an atomic O_EXCL create (writeFileSync with
  // the wx flag) so exactly one acquirer wins. An existing lock is never overwritten here —
  // the caller JOINs it with the token or takes a genuinely stale lock over. run_id + owner
  // print to stdout as the two closed facts the conductor hands every workflow.
  const [, kilnDir, choice, conductorPid] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-lock acquire kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!LOCK_CHOICES.has(choice)) {
    stop('transport_failure', `run-lock acquire choice must be one of ${[...LOCK_CHOICES].join('|')}`, TRANSPORT_FAILURE)
  }
  const pid = Number(conductorPid)
  if (!Number.isInteger(pid) || pid <= 0) {
    stop('transport_failure', 'run-lock acquire conductor pid must be a positive integer', TRANSPORT_FAILURE)
  }
  const version = pluginVersion()
  if (version === null) {
    stop('transport_failure', 'run-lock acquire could not read the plugin version from .claude-plugin/plugin.json', TRANSPORT_FAILURE)
  }
  const record = {
    run_id: randomUUID(), owner: randomUUID(), conductor_pid: pid,
    started_at: new Date().toISOString(), ladder_choice: choice, plugin_version: version,
  }
  const target = join(kilnDir, LOCK_FILE)
  try {
    mkdirSync(kilnDir, { recursive: true })
    writeFileSync(target, `${JSON.stringify(record)}\n`, { flag: 'wx' })
  } catch (error) {
    if (error.code === 'EEXIST') {
      const holder = readLockRecord(target).record
      const heldId = holder && typeof holder.run_id === 'string' ? holder.run_id : ''
      stop(heldId, 'run-lock acquire refused: a run lock already exists — join it with the token or take it over if it is stale', LOCK_DENIED)
    }
    stop('transport_failure', `run-lock acquire could not create the lock: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.stdout.write(`${record.run_id} ${record.owner}\n`)
  process.exit(ACCEPT)
} else if (mode === 'run-lock' && args[0] === 'join' && args.length === 4) {
  // JOIN is read-only: exit 0 IFF the on-disk lock matches BOTH the run_id and the owner
  // token exactly. Absent, unreadable, or foreign — refuse, and print the holding run_id
  // (when readable) so the caller can name the running owner in its honest hold.
  const [, kilnDir, runId, owner] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-lock join kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!LOCK_TOKEN.test(runId) || !LOCK_TOKEN.test(owner)) {
    stop('transport_failure', 'run-lock join run_id and owner must be closed tokens', TRANSPORT_FAILURE)
  }
  const { record } = readLockRecord(join(kilnDir, LOCK_FILE))
  if (!record || record.run_id !== runId || record.owner !== owner) {
    const heldId = record && typeof record.run_id === 'string' ? record.run_id : ''
    stop(heldId, 'run-lock join refused: no run lock matches this run_id and owner token', LOCK_DENIED)
  }
  process.stdout.write('joined\n')
  process.exit(ACCEPT)
} else if (mode === 'run-lock' && args[0] === 'release' && args.length === 4) {
  // Exact-token release, serialized against the takeover race (B02). A cheap pre-read refuses a
  // foreign or absent lock; then the lock is CLAIMED by rename (one winner) and the identity is
  // re-verified on the CLAIMED bytes — never unlinked by pathname after a comparison. Only the
  // claim file this process exclusively holds is ever removed. If a takeover landed in the claim
  // window, the claimed record is restored (or archived if the path was re-occupied), not lost.
  const [, kilnDir, runId, owner] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-lock release kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!LOCK_TOKEN.test(runId) || !LOCK_TOKEN.test(owner)) {
    stop('transport_failure', 'run-lock release run_id and owner must be closed tokens', TRANSPORT_FAILURE)
  }
  const pre = readLockRecord(join(kilnDir, LOCK_FILE))
  if (!pre.record || pre.record.run_id !== runId || pre.record.owner !== owner) {
    stop('denied', 'run-lock release refused: no run lock matches this run_id and owner token', LOCK_DENIED)
  }
  const claim = claimLock(kilnDir)
  if (!claim) {
    stop('contended', 'run-lock release refused: the lock is already gone or claimed by a contender', LOCK_DENIED)
  }
  if (claim.record && claim.record.run_id === runId && claim.record.owner === owner) {
    if (!archiveAndDrop(kilnDir, claim.claimPath, claim.record, 'released')) {
      stop('transport_failure', 'run-lock release could not archive the lock — the lock survives, nothing lost', TRANSPORT_FAILURE)
    }
    process.stdout.write('released\n')
    process.exit(ACCEPT)
  }
  // A takeover displaced our lock between the pre-read and the claim — restore or preserve it. A
  // clean restore/archive is a plain contended refusal; a double failure leaves the displaced
  // record only as claim residue, which is a transport-class failure the caller must hear.
  if (restoreOrArchive(kilnDir, claim.claimPath, claim.record)) {
    stop('contended', 'run-lock release refused: the lock changed under the release', LOCK_DENIED)
  }
  stop('transport_failure', 'run-lock release could not restore or archive the displaced lock — its record survives only as a claim residue at .kiln/.run.lock.claim-*; inspect it', TRANSPORT_FAILURE)
} else if (mode === 'run-lock' && args[0] === 'takeover' && args.length === 4) {
  // Takeover replaces a genuinely stale lock with no token — the resume-after-crash path,
  // serialized against a second contender (B01). BOTH conditions gate it, never time alone:
  // the holder pid PROVEN dead (ESRCH only — B03) AND the lock aged past the floor. A cheap
  // pre-read refuses an obviously live/young lock; then the lock is CLAIMED by rename (one
  // winner) and re-validated on the CLAIMED bytes (same holder, still stale). Only then is the
  // stale record archived, the claim dropped, and a fresh lock wx-created; a NEW run_id + owner
  // print as acquire does. If a fresh lock landed in the claim window, it is restored, not stolen.
  const [, kilnDir, choice, conductorPid] = args
  if (typeof kilnDir !== 'string' || kilnDir.trim() === '') {
    stop('transport_failure', 'run-lock takeover kilnDir must be a nonempty string', TRANSPORT_FAILURE)
  }
  if (!LOCK_CHOICES.has(choice)) {
    stop('transport_failure', `run-lock takeover choice must be one of ${[...LOCK_CHOICES].join('|')}`, TRANSPORT_FAILURE)
  }
  const pid = Number(conductorPid)
  if (!Number.isInteger(pid) || pid <= 0) {
    stop('transport_failure', 'run-lock takeover conductor pid must be a positive integer', TRANSPORT_FAILURE)
  }
  const pre = readLockRecord(join(kilnDir, LOCK_FILE))
  if (!pre.exists) {
    stop('transport_failure', 'run-lock takeover found no lock to take over — acquire a fresh lock instead', TRANSPORT_FAILURE)
  }
  if (!pre.record) {
    stop('transport_failure', 'run-lock takeover found an unreadable lock — it cannot be proven stale; inspect .kiln/run.lock', TRANSPORT_FAILURE)
  }
  // Cheap pre-gate before claiming: an obviously live, young, or unprobeable lock is refused
  // without disturbing it. The claimed re-validation below is the authoritative proof.
  const preStale = takeoverStale(pre.record)
  if (!preStale.stale) {
    stop(preStale.fact, `run-lock takeover refused: the lock is not takeover-stale (${preStale.fact})`, LOCK_DENIED)
  }
  const version = pluginVersion()
  if (version === null) {
    stop('transport_failure', 'run-lock takeover could not read the plugin version from .claude-plugin/plugin.json', TRANSPORT_FAILURE)
  }
  const claim = claimLock(kilnDir)
  if (!claim) {
    stop('contended', 'run-lock takeover refused: another contender claimed the lock first', LOCK_DENIED)
  }
  // Re-validate on the CLAIMED bytes: the same holder the pre-read saw AND still stale. A fresh
  // lock that landed in the window is a different run_id (or newly live) and must be restored.
  const claimedStale = claim.record
    && claim.record.run_id === pre.record.run_id
    && takeoverStale(claim.record).stale
  if (!claimedStale) {
    if (restoreOrArchive(kilnDir, claim.claimPath, claim.record)) {
      stop('contended', 'run-lock takeover refused: the lock changed under the takeover — restored, not stolen', LOCK_DENIED)
    }
    stop('transport_failure', 'run-lock takeover could not restore or archive the displaced lock — its record survives only as a claim residue at .kiln/.run.lock.claim-*; inspect it', TRANSPORT_FAILURE)
  }
  const fresh = {
    run_id: randomUUID(), owner: randomUUID(), conductor_pid: pid,
    started_at: new Date().toISOString(), ladder_choice: choice, plugin_version: version,
  }
  // Archive the stale record and drop the claim (leaves the lock path empty), then wx-create the
  // fresh lock. If the archive fails the stale lock is restored (archiveAndDrop), nothing lost.
  if (!archiveAndDrop(kilnDir, claim.claimPath, claim.record, 'taken_over')) {
    stop('transport_failure', 'run-lock takeover could not archive the stale lock — the lock survives, nothing lost', TRANSPORT_FAILURE)
  }
  try {
    writeFileSync(join(kilnDir, LOCK_FILE), `${JSON.stringify(fresh)}\n`, { flag: 'wx' })
  } catch (error) {
    if (error.code === 'EEXIST') {
      // A fresh acquire won the empty path first; the stale record is already archived, no loss.
      stop('contended', 'run-lock takeover refused: a fresh acquire won the lock before takeover completed', LOCK_DENIED)
    }
    stop('transport_failure', `run-lock takeover could not write the fresh lock: ${error.message}`, TRANSPORT_FAILURE)
  }
  process.stdout.write(`${fresh.run_id} ${fresh.owner}\n`)
  process.exit(ACCEPT)
} else {
  stop(
    'transport_failure',
    'usage: kiln-review review <repo> <kilnDir> <slice> <model> <effort> <request.json> <gate-review.json> | kiln-review recheck <repo> <kilnDir> <slice> <model> <effort> <request.json> <prior-gate-review.json> <repair-delta> <gate-review.json> | kiln-review gate-facts <kilnDir> <slice> <request.json> <gate-facts.json> | kiln-review append-seal <kilnDir> <slice> <label> | kiln-review seal-law <kilnDir> <label> | kiln-review run-checks <kilnDir> | kiln-review slices <kilnDir> | kiln-review screen-criteria <kilnDir> | kiln-review perceptual-family <kilnDir> | kiln-review ratify <repo> <request.json> <gate-review.json> <family> | kiln-review ratify-recheck <repo> <request.json> <prior-gate-review.json> <gate-review.json> <family> | kiln-review publish-gate <kilnDir> <family> <candidate.json> <gate-review.json> | kiln-review audit <repo> <kilnDir> <seamSliceId> <model> <effort> <gate-review.json> | kiln-review audit-recheck <repo> <kilnDir> <seamSliceId> <model> <effort> <prior-gate-review.json> <repair-delta> <gate-review.json> | kiln-review append-audit <kilnDir> <seamSliceId> <label> | kiln-review reconcile <kilnDir> | kiln-review screen <repo> <kilnDir> <model> <effort> <gate-review.json> | kiln-review screen-recheck <repo> <kilnDir> <model> <effort> <prior-gate-review.json> <fresh-manifest> <gate-review.json> | kiln-review screen-escalate <repo> <kilnDir> <model> <effort> <held-screen-review.json> <gate-review.json> | kiln-review state-commit <kilnDir> <token> <stage> <activeSlice> <next_action_key> <density> [pointers...] | kiln-review run-lock acquire <kilnDir> <choice> <conductorPid> | kiln-review run-lock join <kilnDir> <run_id> <owner> | kiln-review run-lock release <kilnDir> <run_id> <owner> | kiln-review run-lock takeover <kilnDir> <choice> <conductorPid>',
    TRANSPORT_FAILURE,
  )
}
